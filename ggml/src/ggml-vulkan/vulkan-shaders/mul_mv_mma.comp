        const uint b_lane_off = 2u * fm;
        const uint nb = p.K >> 5u;

        for (uint ib = sg_k; ib < nb; ib += NSG) {
            MMA_FVEC2 b0[RT][2];
            MMA_FVEC2 b1[RT][2];
            [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
                if (rt == 0u || (8u * rt < n_valid)) {
                    [[unroll]] for (uint e = 0u; e < 2u; ++e) {
#ifdef MUL_MAT_ID
                        const uint b_base = sh_b_base[min(8u * rt + fn + e, n_valid - 1u)];
#else
                        const uint b_base = b_batch_base + (wg_n0 + min(8u * rt + fn + e, n_valid - 1u)) * p.stride_b;
#endif
                        const uint base = b_base + (ib << 5u) + b_lane_off;
                        b0[rt][e] = MMA_FVEC2(load_b_vec2_aligned_or_scalar(base,       v2_ok));
                        b1[rt][e] = MMA_FVEC2(load_b_vec2_aligned_or_scalar(base + 16u, v2_ok));
                    }
                }
            }

            [[unroll]] for (uint t = 0u; t < NT; ++t) {
                const uint blk_idx = a_row_base[t] + ib;
                float d_a;
                uint raw_u;
                if (FUSE_MODE == 2u && tile_second[t]) {
                    d_a = float(u_q4_0.data[blk_idx].d);
                    raw_u = uint(u_q4_0.data[blk_idx].qs[fn]) | (uint(u_q4_0.data[blk_idx].qs[fn + 1u]) << 16u);
                } else {
                    d_a = float(a_q4_0.data[blk_idx].d);
                    raw_u = uint(a_q4_0.data[blk_idx].qs[fn]) | (uint(a_q4_0.data[blk_idx].qs[fn + 1u]) << 16u);
                }
                const u8vec4 lo = unpack8( raw_u        & 0x0F0F0F0Fu);
                const u8vec4 hi = unpack8((raw_u >> 4u) & 0x0F0F0F0Fu);

                [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
                    if (rt == 0u || (8u * rt < n_valid)) {
                        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> mp = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0f);
                        coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> ma;
                        coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb;
                        ma[0] = MMA_FTYPE(int(lo.x) - 8); ma[1] = MMA_FTYPE(int(lo.z) - 8); mb[0] = b0[rt][0].x; mb[1] = b0[rt][1].x; mp = coopMatMulAdd(ma, mb, mp);
                        ma[0] = MMA_FTYPE(int(lo.y) - 8); ma[1] = MMA_FTYPE(int(lo.w) - 8); mb[0] = b0[rt][0].y; mb[1] = b0[rt][1].y; mp = coopMatMulAdd(ma, mb, mp);
                        ma[0] = MMA_FTYPE(int(hi.x) - 8); ma[1] = MMA_FTYPE(int(hi.z) - 8); mb[0] = b1[rt][0].x; mb[1] = b1[rt][1].x; mp = coopMatMulAdd(ma, mb, mp);
                        ma[0] = MMA_FTYPE(int(hi.y) - 8); ma[1] = MMA_FTYPE(int(hi.w) - 8); mb[0] = b1[rt][0].y; mb[1] = b1[rt][1].y; mp = coopMatMulAdd(ma, mb, mp);
                        mc[rt][t][0] = fma(d_a, mp[0], mc[rt][t][0]);
                        mc[rt][t][1] = fma(d_a, mp[1], mc[rt][t][1]);
                    }
                }

                if (FUSE_MODE == 3u) {
                    const float d_u = float(u_q4_0.data[blk_idx].d);
                    const uint uraw = uint(u_q4_0.data[blk_idx].qs[fn]) | (uint(u_q4_0.data[blk_idx].qs[fn + 1u]) << 16u);
                    const u8vec4 ulo = unpack8( uraw        & 0x0F0F0F0Fu);
                    const u8vec4 uhi = unpack8((uraw >> 4u) & 0x0F0F0F0Fu);
                    [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
                        if (rt == 0u || (8u * rt < n_valid)) {
                            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> mpu = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0f);
                            coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> ma;
                            coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb;
                            ma[0] = MMA_FTYPE(int(ulo.x) - 8); ma[1] = MMA_FTYPE(int(ulo.z) - 8); mb[0] = b0[rt][0].x; mb[1] = b0[rt][1].x; mpu = coopMatMulAdd(ma, mb, mpu);
                            ma[0] = MMA_FTYPE(int(ulo.y) - 8); ma[1] = MMA_FTYPE(int(ulo.w) - 8); mb[0] = b0[rt][0].y; mb[1] = b0[rt][1].y; mpu = coopMatMulAdd(ma, mb, mpu);
                            ma[0] = MMA_FTYPE(int(uhi.x) - 8); ma[1] = MMA_FTYPE(int(uhi.z) - 8); mb[0] = b1[rt][0].x; mb[1] = b1[rt][1].x; mpu = coopMatMulAdd(ma, mb, mpu);
                            ma[0] = MMA_FTYPE(int(uhi.y) - 8); ma[1] = MMA_FTYPE(int(uhi.w) - 8); mb[0] = b1[rt][0].y; mb[1] = b1[rt][1].y; mpu = coopMatMulAdd(ma, mb, mpu);
                            mc_u[rt][t][0] = fma(d_u, mpu[0], mc_u[rt][t][0]);
                            mc_u[rt][t][1] = fma(d_u, mpu[1], mc_u[rt][t][1]);
                        }
                    }
                }
            }
        }
    }
#endif
    else {
        // K-split (MSG == 1, NSG >= 1) 64-weight chunk loop with on-the-fly mb construction
        const bool v4_ok = ((p.stride_b & 3u) == 0u) && ((p.batch_stride_b & 3u) == 0u);
        const uint b_lane_off = 16u * (fm >> 1u) + 8u * (fm & 1u);
        const uint nch = p.K >> 6u;

        for (uint g = sg_k; g < nch; g += NSG) {
            MMA_FVEC4 ba0[RT], ba1[RT], bb0[RT], bb1[RT];
            [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
                if (rt == 0u || (8u * rt < n_valid)) {
#ifdef MUL_MAT_ID
                    const uint base0 = sh_b_base[min(8u * rt + fn + 0u, n_valid - 1u)] + (g << 6u) + b_lane_off;
                    const uint base1 = sh_b_base[min(8u * rt + fn + 1u, n_valid - 1u)] + (g << 6u) + b_lane_off;
#else
                    const uint base0 = b_batch_base + (wg_n0 + min(8u * rt + fn + 0u, n_valid - 1u)) * p.stride_b + (g << 6u) + b_lane_off;
                    const uint base1 = b_batch_base + (wg_n0 + min(8u * rt + fn + 1u, n_valid - 1u)) * p.stride_b + (g << 6u) + b_lane_off;
#endif
                    ba0[rt] = MMA_FVEC4(load_b_vec4_aligned_or_scalar(base0,      v4_ok));
                    ba1[rt] = MMA_FVEC4(load_b_vec4_aligned_or_scalar(base0 + 4u, v4_ok));
                    bb0[rt] = MMA_FVEC4(load_b_vec4_aligned_or_scalar(base1,      v4_ok));
                    bb1[rt] = MMA_FVEC4(load_b_vec4_aligned_or_scalar(base1 + 4u, v4_ok));
                }
            }

            const uint ci = (g << 2u) + (fn >> 1u);

            [[unroll]] for (uint t = 0u; t < NT; ++t) {
                MMA_FVEC4 w0, w1, w2, w3;
                dequant16(FUSE_MODE == 2u && tile_second[t], a_row_base[t], ci, w0, w1, w2, w3);

                [[unroll]] for (uint s = 0u; s < 4u; ++s) {
                    coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> ma0, ma1;
                    ma0[0] = w0[s]; ma0[1] = w2[s];
                    ma1[0] = w1[s]; ma1[1] = w3[s];
                    [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
                        if (rt == 0u || (8u * rt < n_valid)) {
                            coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb0, mb1;
                            mb0[0] = ba0[rt][s]; mb0[1] = bb0[rt][s];
                            mb1[0] = ba1[rt][s]; mb1[1] = bb1[rt][s];
                            mc[rt][t] = coopMatMulAdd(ma0, mb0, mc[rt][t]);
                            mc[rt][t] = coopMatMulAdd(ma1, mb1, mc[rt][t]);
                        }
                    }
                }

                if (FUSE_MODE == 3u) {
                    MMA_FVEC4 uw0, uw1, uw2, uw3;
                    dequant16(true, a_row_base[t], ci, uw0, uw1, uw2, uw3);
                    [[unroll]] for (uint s = 0u; s < 4u; ++s) {
                        coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> mu0, mu1;
                        mu0[0] = uw0[s]; mu0[1] = uw2[s];
                        mu1[0] = uw1[s]; mu1[1] = uw3[s];
                        [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
                            if (rt == 0u || (8u * rt < n_valid)) {
                                coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb0, mb1;
                                mb0[0] = ba0[rt][s]; mb0[1] = bb0[rt][s];
                                mb1[0] = ba1[rt][s]; mb1[1] = bb1[rt][s];
                                mc_u[rt][t] = coopMatMulAdd(mu0, mb0, mc_u[rt][t]);
                                mc_u[rt][t] = coopMatMulAdd(mu1, mb1, mc_u[rt][t]);
                            }
                        }
                    }
                }
            }
        }
    }

    // Store path: when NSG == 1, write directly from registers with ZERO reduction shmem and ZERO barriers!
    if (NSG == 1u) {
        [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
            if (rt == 0u || (8u * rt < n_valid)) {
                [[unroll]] for (uint e = 0u; e < 2u; ++e) {
#ifdef MUL_MAT_ID
                    const uint col_in_tile = 8u * rt + fn + e;
                    if (col_in_tile < tile_ne1) {
                        const uint packed = sh_r_ids[col_in_tile];
                        const u16vec2 rid = u16vec2(packed & 0xFFFFu, packed >> 16u);
                        const uint d_col_base = uint(rid.y) * p.batch_stride_d + uint(rid.x) * p.stride_d;
                        const float col_scale = (FUSE_MODE == 4u) ? sh_col_scale[col_in_tile] : 1.0f;
                        [[unroll]] for (uint t = 0u; t < NT; ++t) {
                            const uint r0 = sg_m0 + 8u * t + fm;
                            if (r0 < p.M) {
                                const uint d_idx = d_col_base + r0;
                                float val = mc[rt][t][e];
                                if (FUSE_MODE == 3u) {
                                    const float u = mc_u[rt][t][e];
                                    val = (val / (1.0f + exp(-val))) * u;
                                } else if (FUSE_MODE == 4u) {
                                    val *= col_scale;
                                } else if (FUSE_MODE == 1u) {
                                    val = mma_apply_id_epilogue(val, expert_idx, rid, r0, d_idx);
                                }
                                data_d[d_idx] = val;
                            }
                        }
                    }
#else
                    const uint col = wg_n0 + 8u * rt + fn + e;
                    if (col < p.N) {
                        [[unroll]] for (uint t = 0u; t < NT; ++t) {
                            const uint r_global = sg_m0 + 8u * t + fm;
                            if (FUSE_MODE == 2u && tile_second[t]) {
                                const uint r1 = r_global - p.pair_m0;
                                const uint m1 = p.M - p.pair_m0;
                                if (r1 < m1) {
                                    const uint d2_idx = batch_idx * p.batch_stride_d2 + col * p.stride_d2 + r1;
                                    data_d2[d2_idx] = mma_apply_dense_epilogue(mc[rt][t][e], r1, col, d2_idx, true);
                                }
                            } else {
                                const uint m_lim = (FUSE_MODE == 2u) ? p.pair_m0 : p.M;
                                if (r_global < m_lim) {
                                    const uint d_idx = batch_idx * p.batch_stride_d + col * p.stride_d + r_global;
                                    float val = mc[rt][t][e];
                                    if (FUSE_MODE == 3u) {
                                        const float u = mc_u[rt][t][e];
                                        val = (val / (1.0f + exp(-val))) * u;
                                    } else if (FUSE_MODE == 4u) {
                                        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0u) {
                                            val += data_aux0[d_idx];
                                        }
                                        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS1) != 0u) {
                                            val += data_aux1[d_idx];
                                        }
                                    } else if (FUSE_MODE == 1u || FUSE_MODE == 2u) {
                                        val = mma_apply_dense_epilogue(val, r_global, col, d_idx, false);
                                    }
                                    data_d[d_idx] = val;
                                }
                            }
                        }
                    }
#endif
                }
            }
        }
        return;
    }

    // NSG > 1 (MSG == 1) reduction through shared memory
    const uint stride_sg = RT * NT * 64u;
    [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
        [[unroll]] for (uint t = 0u; t < NT; ++t) {
            const uint base = sg_k * stride_sg + (rt * NT + t) * 64u + 2u * lane;
            red_shmem[base + 0u] = mc[rt][t][0];
            red_shmem[base + 1u] = mc[rt][t][1];
            if (FUSE_MODE == 3u) {
                const uint ubase = NSG * stride_sg + base;
                red_shmem[ubase + 0u] = mc_u[rt][t][0];
                red_shmem[ubase + 1u] = mc_u[rt][t][1];
            }
        }
    }
    barrier();

    for (uint idx = tid; idx < stride_sg; idx += WG_THREADS) {
        const uint rt = idx / (NT * 64u);
        if (rt > 0u && (8u * rt >= n_valid)) {
            continue;
        }
        const uint t = (idx / 64u) % NT;
        const uint l = (idx & 63u) >> 1u;
        const uint e = idx & 1u;

        float sum = 0.0f;
        float sum_u = 0.0f;
        [[unroll]] for (uint sg = 0u; sg < NSG; ++sg) {
            sum += red_shmem[sg * stride_sg + idx];
            if (FUSE_MODE == 3u) {
                sum_u += red_shmem[(NSG + sg) * stride_sg + idx];
            }
        }

        const uint l_fm = mma_lane_fm(l);
        const uint l_fn = mma_lane_fn(l);

#ifdef MUL_MAT_ID
        const uint col_in_tile = 8u * rt + l_fn + e;
        if (col_in_tile < tile_ne1) {
            const uint packed = sh_r_ids[col_in_tile];
            const u16vec2 rid = u16vec2(packed & 0xFFFFu, packed >> 16u);
            const uint r0 = sg_m0 + 8u * t + l_fm;
            if (r0 < p.M) {
                const uint d_idx = uint(rid.y) * p.batch_stride_d + uint(rid.x) * p.stride_d + r0;
                float val = sum;
                if (FUSE_MODE == 3u) {
                    val = (val / (1.0f + exp(-val))) * sum_u;
                } else if (FUSE_MODE == 4u) {
                    val *= sh_col_scale[col_in_tile];
                } else if (FUSE_MODE == 1u) {
                    val = mma_apply_id_epilogue(val, expert_idx, rid, r0, d_idx);
                }
                data_d[d_idx] = val;
            }
        }
#else
        const uint col = wg_n0 + 8u * rt + l_fn + e;
        if (col < p.N) {
            const uint tile_r = sg_m0 + 8u * t;
            const uint r_global = tile_r + l_fm;
            if (FUSE_MODE == 2u && tile_r >= p.pair_m0) {
                const uint r1 = r_global - p.pair_m0;
                const uint m1 = p.M - p.pair_m0;
                if (r1 < m1) {
                    const uint d2_idx = batch_idx * p.batch_stride_d2 + col * p.stride_d2 + r1;
                    data_d2[d2_idx] = mma_apply_dense_epilogue(sum, r1, col, d2_idx, true);
                }
            } else {
                const uint m_lim = (FUSE_MODE == 2u) ? p.pair_m0 : p.M;
                if (r_global < m_lim) {
                    const uint d_idx = batch_idx * p.batch_stride_d + col * p.stride_d + r_global;
                    float val = sum;
                    if (FUSE_MODE == 3u) {
                        val = (val / (1.0f + exp(-val))) * sum_u;
                    } else if (FUSE_MODE == 4u) {
                        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0u) {
                            val += data_aux0[d_idx];
                        }
                        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS1) != 0u) {
                            val += data_aux1[d_idx];
                        }
                    } else if (FUSE_MODE == 1u || FUSE_MODE == 2u) {
                        val = mma_apply_dense_epilogue(val, r_global, col, d_idx, false);
                    }
                    data_d[d_idx] = val;
                }
            }
        }
#endif
    }
}
