            const f16vec4 w2 = fma(f16vec4(unpack8(ql45 | (qh45 << 4u))), dv, mv);                                       \
            const f16vec4 w3 = fma(f16vec4(unpack8(ql67 | (qh67 << 4u))), dv, mv);                                       \
            FENCE_MACRO();                                                                                               \
            TARGET_MACRO(TARGET_ARR, (s_kp << 4u), w0, w1, w2, w3);                                                      \
