            qh0 = u_q5_k_p32.data[ib].qh[w_lo + 0u]; qh1 = u_q5_k_p32.data[ib].qh[w_lo + 1u];                            \
            qh2 = u_q5_k_p32.data[ib].qh[w_lo + 2u]; qh3 = u_q5_k_p32.data[ib].qh[w_lo + 3u];                            \
        } else {                                                                                                         \
            loadd  = vec2(a_q5_k.data[ib].dm);                                                                           \
            scales = uvec3(a_q5_k_p32.data[ib].scales[0], a_q5_k_p32.data[ib].scales[1], a_q5_k_p32.data[ib].scales[2]); \
            qh0 = a_q5_k_p32.data[ib].qh[w_lo + 0u]; qh1 = a_q5_k_p32.data[ib].qh[w_lo + 1u];                            \
            qh2 = a_q5_k_p32.data[ib].qh[w_lo + 2u]; qh3 = a_q5_k_p32.data[ib].qh[w_lo + 3u];                            \
        }                                                                                                                \
        LOOP_ATTR for (uint s_kp = 0u; s_kp < K_PAIRS; ++s_kp) {                                                         \
            FENCE_MACRO();                                                                                               \
            const uint sub         = sub_base + s_kp;                                                                    \
            const uint is          = (sub << 1u) | (fn2 >> 1u);                                                          \
            const uint scalesoffs  = (is & 3u) * 8u;                                                                     \
            const uint scidxshift1 = (is < 4u) ? scalesoffs : (scalesoffs + 2u);                                         \
            const uint mbidxshift0 = (is < 4u) ? scalesoffs : (scalesoffs + 4u);                                         \
            const uint sc_word     = (is < 4u) ? scales.x : scales.z;                                                    \
            const uint mb_word     = (is < 4u) ? scales.y : scales.z;                                                    \
            const uint sc          = ((sc_word >> scalesoffs) & 0xFu) | ((scales.x >> scidxshift1) & 0x30u);             \
            const uint mbyte       = ((mb_word >> mbidxshift0) & 0xFu) | ((scales.y >> scidxshift1) & 0x30u);            \
            const f16vec4 d        = f16vec4(loadd.x * float(sc));                                                       \
            const f16vec4 m        = f16vec4(-loadd.y * float(mbyte));                                                   \
            const uint w_idx       = (sub << 3u) + w_lo;                                                                 \
            uint ql0, ql1, ql2, ql3;                                                                                     \
            if (USE_U) {                                                                                                 \
                ql0 = u_q5_k_p32.data[ib].qs[w_idx + 0u]; ql1 = u_q5_k_p32.data[ib].qs[w_idx + 1u];                      \
                ql2 = u_q5_k_p32.data[ib].qs[w_idx + 2u]; ql3 = u_q5_k_p32.data[ib].qs[w_idx + 3u];                      \
            } else {                                                                                                     \
                ql0 = a_q5_k_p32.data[ib].qs[w_idx + 0u]; ql1 = a_q5_k_p32.data[ib].qs[w_idx + 1u];                      \
                ql2 = a_q5_k_p32.data[ib].qs[w_idx + 2u]; ql3 = a_q5_k_p32.data[ib].qs[w_idx + 3u];                      \
            }                                                                                                            \
            const bool qh_left = (is <= 4u);                                                                             \
            const uint qh_sh   = qh_left ? (4u - is) : (is - 4u);                                                        \
            const uint qhb0    = (qh_left ? (qh0 << qh_sh) : (qh0 >> qh_sh)) & 0x10101010u;                              \
            const uint qhb1    = (qh_left ? (qh1 << qh_sh) : (qh1 >> qh_sh)) & 0x10101010u;                              \
            const uint qhb2    = (qh_left ? (qh2 << qh_sh) : (qh2 >> qh_sh)) & 0x10101010u;                              \
            const uint qhb3    = (qh_left ? (qh3 << qh_sh) : (qh3 >> qh_sh)) & 0x10101010u;                              \
            const f16vec4 w0 = fma(d, f16vec4(unpack8(((ql0 >> shift) & 0x0F0F0F0Fu) | qhb0)), m);                       \
            const f16vec4 w1 = fma(d, f16vec4(unpack8(((ql1 >> shift) & 0x0F0F0F0Fu) | qhb1)), m);                       \
            const f16vec4 w2 = fma(d, f16vec4(unpack8(((ql2 >> shift) & 0x0F0F0F0Fu) | qhb2)), m);                       \
            const f16vec4 w3 = fma(d, f16vec4(unpack8(((ql3 >> shift) & 0x0F0F0F0Fu) | qhb3)), m);                       \
            FENCE_MACRO();                                                                                               \
            TARGET_MACRO(TARGET_ARR, (s_kp << 4u), w0, w1, w2, w3);                                                      \
        }                                                                                                                \
    } while (false)
#elif defined(DATA_A_Q6_K)
#define MMA_ACCUM_KPAIRS_GEN(LOOP_ATTR, FENCE_MACRO, TARGET_MACRO, TARGET_ARR, USE_U, ROW_BASE)                          \
    do {                                                                                                                 \
        FENCE_MACRO();                                                                                                   \
        const uint ib       = (ROW_BASE) + ((g * K_PAIRS) >> 2u);                                                        \
        const uint sub_base = (g * K_PAIRS) & 3u;                                                                        \
        const uint fn2      = fn >> 1u;                                                                                  \
        const float d_sb    = float((USE_U) ? u_q6_k.data[ib].d : a_q6_k.data[ib].d);                                    \
        LOOP_ATTR for (uint s_kp = 0u; s_kp < K_PAIRS; ++s_kp) {                                                         \
            FENCE_MACRO();                                                                                               \
            const uint il      = ((sub_base + s_kp) << 2u) | fn2;                                                        \
            const uint b       = ((il >> 2u) & 1u) * 4u;                                                                 \
            const uint qhshift = ((il >> 1u) & 3u) * 2u;                                                                 \
            const uint qsi     = ((il & 8u) << 2u) + ((il & 3u) << 3u);                                                  \
            const uint qhi     = ((il & 8u) << 1u) + ((il & 1u) << 3u);                                                  \
            float dscale;                                                                                                \
            uint ql01, ql23, ql45, ql67, qh01, qh23, qh45, qh67;                                                         \
            if (USE_U) {                                                                                                 \
                dscale = d_sb * float(u_q6_k.data[ib].scales[il]);                                                       \
                ql01 = ((uint(u_q6_k_p16.data[ib].ql[qsi + 0u]) | (uint(u_q6_k_p16.data[ib].ql[qsi + 1u]) << 16u)) >> b) & 0x0F0F0F0Fu; \
                ql23 = ((uint(u_q6_k_p16.data[ib].ql[qsi + 2u]) | (uint(u_q6_k_p16.data[ib].ql[qsi + 3u]) << 16u)) >> b) & 0x0F0F0F0Fu; \
