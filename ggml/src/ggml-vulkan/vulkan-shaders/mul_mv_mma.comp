                    v0_a = unpack8(int32_t((uint(int(a_q8_0.data[blk_idx].qs[q_off + 0u])) & 0xFFFFu) | (uint(int(a_q8_0.data[blk_idx].qs[q_off + 1u])) << 16u)));
                    v1_a = unpack8(int32_t((uint(int(a_q8_0.data[blk_idx].qs[q_off + 2u])) & 0xFFFFu) | (uint(int(a_q8_0.data[blk_idx].qs[q_off + 3u])) << 16u)));
