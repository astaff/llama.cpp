                    [[unroll]] for (uint t = 0u; t < NT; ++t) {
                        MMA_SG_FENCE();
                        MMA_FVEC4 w0, w1, w2, w3;
                        dequant16(FUSE_MODE == 2u && tile_second[t], a_row_base[t], ci_kp, w0, w1, w2, w3);
