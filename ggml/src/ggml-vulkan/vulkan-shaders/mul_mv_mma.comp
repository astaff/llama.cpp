                const uint total_mats = NT * ((FUSE_MODE == 3u) ? 2u : 1u);
                [[dont_unroll]] for (uint mi = 0u; mi < total_mats; ++mi) {
                    const bool is_u  = (FUSE_MODE == 3u) && ((mi & 1u) != 0u);
                    const uint ti    = (FUSE_MODE == 3u) ? (mi >> 1u) : mi;
                    const uint rbase = (ti == 0u) ? a_row_base[0] : a_row_base[NT - 1u];
                    const bool use_u = is_u || (FUSE_MODE == 2u && ((ti == 0u) ? tile_second[0] : tile_second[NT - 1u]));
