uint mma_lane_fm(uint l) { return ((l >> 1u) & 3u) | ((l >> 2u) & 4u); }
uint mma_lane_fn(uint l) { return ((l & 1u) << 1u) | ((l >> 1u) & 4u); }

#if defined(DATA_A_IQ4_XS) || defined(DATA_A_IQ4_NL)
float iq4nl_lut(uint idx) {
    switch (idx) {
    case  0u: return -127.0f;
    case  1u: return -104.0f;
    case  2u: return  -83.0f;
    case  3u: return  -65.0f;
    case  4u: return  -49.0f;
    case  5u: return  -35.0f;
    case  6u: return  -22.0f;
    case  7u: return  -10.0f;
    case  8u: return    1.0f;
    case  9u: return   13.0f;
    case 10u: return   25.0f;
    case 11u: return   38.0f;
    case 12u: return   53.0f;
    case 13u: return   69.0f;
    case 14u: return   89.0f;
    default:  return  113.0f;
    }
}
#endif

vec4 load_b_vec4_aligned_or_scalar(uint elem_idx, bool v4_ok) {
    if (v4_ok) {
        return data_b_v4[elem_idx >> 2u];
    }
    return vec4(data_b[elem_idx + 0u], data_b[elem_idx + 1u], data_b[elem_idx + 2u], data_b[elem_idx + 3u]);
}

vec2 load_b_vec2_aligned_or_scalar(uint elem_idx, bool v2_ok) {
    if (v2_ok) {
        return data_b_v2[elem_idx >> 1u];
    }
    return vec2(data_b[elem_idx + 0u], data_b[elem_idx + 1u]);
}

// Unified single-body dequant16 (prevents duplicate temporary live ranges in PAIR_GLU / PAIR_MM!)
void dequant16(bool use_u, uint row_unit_base, uint ci, out MMA_FVEC4 w0, out MMA_FVEC4 w1, out MMA_FVEC4 w2, out MMA_FVEC4 w3) {
#if defined(DATA_A_F32)
    const uint base = row_unit_base + (ci << 4u);
    if ((base & 3u) == 0u) {
        const uint v4 = base >> 2u;
        if (use_u) {
            w0 = u_f32v4.data[v4 + 0u]; w1 = u_f32v4.data[v4 + 1u]; w2 = u_f32v4.data[v4 + 2u]; w3 = u_f32v4.data[v4 + 3u];
        } else {
            w0 = a_f32v4.data[v4 + 0u]; w1 = a_f32v4.data[v4 + 1u]; w2 = a_f32v4.data[v4 + 2u]; w3 = a_f32v4.data[v4 + 3u];
        }
    } else if (use_u) {
        w0 = vec4(u_f32.data[base+0u],  u_f32.data[base+1u],  u_f32.data[base+2u],  u_f32.data[base+3u]);
        w1 = vec4(u_f32.data[base+4u],  u_f32.data[base+5u],  u_f32.data[base+6u],  u_f32.data[base+7u]);
        w2 = vec4(u_f32.data[base+8u],  u_f32.data[base+9u],  u_f32.data[base+10u], u_f32.data[base+11u]);
        w3 = vec4(u_f32.data[base+12u], u_f32.data[base+13u], u_f32.data[base+14u], u_f32.data[base+15u]);
    } else {
        w0 = vec4(a_f32.data[base+0u],  a_f32.data[base+1u],  a_f32.data[base+2u],  a_f32.data[base+3u]);
        w1 = vec4(a_f32.data[base+4u],  a_f32.data[base+5u],  a_f32.data[base+6u],  a_f32.data[base+7u]);
        w2 = vec4(a_f32.data[base+8u],  a_f32.data[base+9u],  a_f32.data[base+10u], a_f32.data[base+11u]);
        w3 = vec4(a_f32.data[base+12u], a_f32.data[base+13u], a_f32.data[base+14u], a_f32.data[base+15u]);
    }
#elif defined(DATA_A_F16)
    const uint base = row_unit_base + (ci << 4u);
    if ((base & 3u) == 0u) {
        const uint v4 = base >> 2u;
        if (use_u) {
            w0 = u_f16v4.data[v4 + 0u]; w1 = u_f16v4.data[v4 + 1u]; w2 = u_f16v4.data[v4 + 2u]; w3 = u_f16v4.data[v4 + 3u];
        } else {
            w0 = a_f16v4.data[v4 + 0u]; w1 = a_f16v4.data[v4 + 1u]; w2 = a_f16v4.data[v4 + 2u]; w3 = a_f16v4.data[v4 + 3u];
        }
    } else if (use_u) {
        w0 = f16vec4(u_f16.data[base+0u],  u_f16.data[base+1u],  u_f16.data[base+2u],  u_f16.data[base+3u]);
        w1 = f16vec4(u_f16.data[base+4u],  u_f16.data[base+5u],  u_f16.data[base+6u],  u_f16.data[base+7u]);
        w2 = f16vec4(u_f16.data[base+8u],  u_f16.data[base+9u],  u_f16.data[base+10u], u_f16.data[base+11u]);
        w3 = f16vec4(u_f16.data[base+12u], u_f16.data[base+13u], u_f16.data[base+14u], u_f16.data[base+15u]);
    } else {
        w0 = f16vec4(a_f16.data[base+0u],  a_f16.data[base+1u],  a_f16.data[base+2u],  a_f16.data[base+3u]);
        w1 = f16vec4(a_f16.data[base+4u],  a_f16.data[base+5u],  a_f16.data[base+6u],  a_f16.data[base+7u]);
        w2 = f16vec4(a_f16.data[base+8u],  a_f16.data[base+9u],  a_f16.data[base+10u], a_f16.data[base+11u]);
        w3 = f16vec4(a_f16.data[base+12u], a_f16.data[base+13u], a_f16.data[base+14u], a_f16.data[base+15u]);
    }
#elif defined(DATA_A_Q8_0)
    const uint ib  = row_unit_base + (ci >> 1u);
    const uint iqs = (ci & 1u) << 3u;
    float16_t d;
    i8vec2 p0, p1, p2, p3, p4, p5, p6, p7;
    if (use_u) {
        d  = u_q8_0.data[ib].d;
        p0 = unpack8(u_q8_0.data[ib].qs[iqs + 0u]); p1 = unpack8(u_q8_0.data[ib].qs[iqs + 1u]);
        p2 = unpack8(u_q8_0.data[ib].qs[iqs + 2u]); p3 = unpack8(u_q8_0.data[ib].qs[iqs + 3u]);
        p4 = unpack8(u_q8_0.data[ib].qs[iqs + 4u]); p5 = unpack8(u_q8_0.data[ib].qs[iqs + 5u]);
        p6 = unpack8(u_q8_0.data[ib].qs[iqs + 6u]); p7 = unpack8(u_q8_0.data[ib].qs[iqs + 7u]);
    } else {
        d  = a_q8_0.data[ib].d;
        p0 = unpack8(a_q8_0.data[ib].qs[iqs + 0u]); p1 = unpack8(a_q8_0.data[ib].qs[iqs + 1u]);
        p2 = unpack8(a_q8_0.data[ib].qs[iqs + 2u]); p3 = unpack8(a_q8_0.data[ib].qs[iqs + 3u]);
        p4 = unpack8(a_q8_0.data[ib].qs[iqs + 4u]); p5 = unpack8(a_q8_0.data[ib].qs[iqs + 5u]);
        p6 = unpack8(a_q8_0.data[ib].qs[iqs + 6u]); p7 = unpack8(a_q8_0.data[ib].qs[iqs + 7u]);
    }
    w0 = d * f16vec4(p0, p1);
    w1 = d * f16vec4(p2, p3);
    w2 = d * f16vec4(p4, p5);
    w3 = d * f16vec4(p6, p7);
#elif defined(DATA_A_Q4_0)
    const uint ib    = row_unit_base + (ci >> 1u);
    const uint shift = (ci & 1u) * 4u;
    float d;
    uint u0, u1, u2, u3;
    if (use_u) {
        d  = float(u_q4_0.data[ib].d);
        u0 = ((uint(u_q4_0.data[ib].qs[0]) | (uint(u_q4_0.data[ib].qs[1]) << 16u)) >> shift) & 0x0F0F0F0Fu;
        u1 = ((uint(u_q4_0.data[ib].qs[2]) | (uint(u_q4_0.data[ib].qs[3]) << 16u)) >> shift) & 0x0F0F0F0Fu;
        u2 = ((uint(u_q4_0.data[ib].qs[4]) | (uint(u_q4_0.data[ib].qs[5]) << 16u)) >> shift) & 0x0F0F0F0Fu;
        u3 = ((uint(u_q4_0.data[ib].qs[6]) | (uint(u_q4_0.data[ib].qs[7]) << 16u)) >> shift) & 0x0F0F0F0Fu;
    } else {
        d  = float(a_q4_0.data[ib].d);
        u0 = ((uint(a_q4_0.data[ib].qs[0]) | (uint(a_q4_0.data[ib].qs[1]) << 16u)) >> shift) & 0x0F0F0F0Fu;
        u1 = ((uint(a_q4_0.data[ib].qs[2]) | (uint(a_q4_0.data[ib].qs[3]) << 16u)) >> shift) & 0x0F0F0F0Fu;
        u2 = ((uint(a_q4_0.data[ib].qs[4]) | (uint(a_q4_0.data[ib].qs[5]) << 16u)) >> shift) & 0x0F0F0F0Fu;
        u3 = ((uint(a_q4_0.data[ib].qs[6]) | (uint(a_q4_0.data[ib].qs[7]) << 16u)) >> shift) & 0x0F0F0F0Fu;
    }
    const f16vec4 dv = f16vec4(d);
    const f16vec4 mv = f16vec4(-8.0f * d);
    w0 = fma(dv, f16vec4(unpack8(u0)), mv);
    w1 = fma(dv, f16vec4(unpack8(u1)), mv);
    w2 = fma(dv, f16vec4(unpack8(u2)), mv);
    w3 = fma(dv, f16vec4(unpack8(u3)), mv);
#elif defined(DATA_A_Q4_1)
    const uint ib    = row_unit_base + (ci >> 1u);
    const uint shift = (ci & 1u) * 4u;
    vec2 dm;
    uint q0, q1, q2, q3;
    if (use_u) {
        dm = vec2(u_q4_1.data[ib].dm);
        q0 = u_q4_1.data[ib].qs[0]; q1 = u_q4_1.data[ib].qs[1]; q2 = u_q4_1.data[ib].qs[2]; q3 = u_q4_1.data[ib].qs[3];
    } else {
        dm = vec2(a_q4_1.data[ib].dm);
        q0 = a_q4_1.data[ib].qs[0]; q1 = a_q4_1.data[ib].qs[1]; q2 = a_q4_1.data[ib].qs[2]; q3 = a_q4_1.data[ib].qs[3];
    }
    const vec4 d = vec4(dm.x), m = vec4(dm.y);
    w0 = f16vec4(fma(d, vec4(unpack8((q0 >> shift) & 0x0F0F0F0Fu)), m));
    w1 = f16vec4(fma(d, vec4(unpack8((q1 >> shift) & 0x0F0F0F0Fu)), m));
    w2 = f16vec4(fma(d, vec4(unpack8((q2 >> shift) & 0x0F0F0F0Fu)), m));
    w3 = f16vec4(fma(d, vec4(unpack8((q3 >> shift) & 0x0F0F0F0Fu)), m));
#elif defined(DATA_A_Q5_0)
    const uint ib     = row_unit_base + (ci >> 1u);
