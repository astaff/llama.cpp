                        ma[0] = MMA_FTYPE(v1_a.y); ma[1] = MMA_FTYPE(v1_a.w); mb[0] = b1[rt][0].y; mb[1] = b1[rt][1].y; mp = coopMatMulAdd(ma, mb, mp);
