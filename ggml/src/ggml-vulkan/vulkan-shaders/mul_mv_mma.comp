#define MMA_ACCUM_KPAIRS(MC_ARR, USE_U, ROW_BASE) \
    MMA_ACCUM_KPAIRS_GEN([[dont_unroll]], MMA_NO_FENCE, MMA_ACCUM_SHB, MC_ARR, USE_U, ROW_BASE)
