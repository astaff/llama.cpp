                ql67 = ((uint(u_q6_k_p16.data[ib].ql[qsi + 6u]) | (uint(u_q6_k_p16.data[ib].ql[qsi + 7u]) << 16u)) >> b) & 0x0F0F0F0Fu; \
                qh01 = ((uint(u_q6_k_p16.data[ib].qh[qhi + 0u]) | (uint(u_q6_k_p16.data[ib].qh[qhi + 1u]) << 16u)) >> qhshift) & 0x03030303u; \
                qh23 = ((uint(u_q6_k_p16.data[ib].qh[qhi + 2u]) | (uint(u_q6_k_p16.data[ib].qh[qhi + 3u]) << 16u)) >> qhshift) & 0x03030303u; \
                qh45 = ((uint(u_q6_k_p16.data[ib].qh[qhi + 4u]) | (uint(u_q6_k_p16.data[ib].qh[qhi + 5u]) << 16u)) >> qhshift) & 0x03030303u; \
                qh67 = ((uint(u_q6_k_p16.data[ib].qh[qhi + 6u]) | (uint(u_q6_k_p16.data[ib].qh[qhi + 7u]) << 16u)) >> qhshift) & 0x03030303u; \
            } else {                                                                                                     \
                dscale = d_sb * float(a_q6_k.data[ib].scales[il]);                                                       \
                ql01 = ((uint(a_q6_k_p16.data[ib].ql[qsi + 0u]) | (uint(a_q6_k_p16.data[ib].ql[qsi + 1u]) << 16u)) >> b) & 0x0F0F0F0Fu; \
                ql23 = ((uint(a_q6_k_p16.data[ib].ql[qsi + 2u]) | (uint(a_q6_k_p16.data[ib].ql[qsi + 3u]) << 16u)) >> b) & 0x0F0F0F0Fu; \
                ql45 = ((uint(a_q6_k_p16.data[ib].ql[qsi + 4u]) | (uint(a_q6_k_p16.data[ib].ql[qsi + 5u]) << 16u)) >> b) & 0x0F0F0F0Fu; \
                ql67 = ((uint(a_q6_k_p16.data[ib].ql[qsi + 6u]) | (uint(a_q6_k_p16.data[ib].ql[qsi + 7u]) << 16u)) >> b) & 0x0F0F0F0Fu; \
                qh01 = ((uint(a_q6_k_p16.data[ib].qh[qhi + 0u]) | (uint(a_q6_k_p16.data[ib].qh[qhi + 1u]) << 16u)) >> qhshift) & 0x03030303u; \
                qh23 = ((uint(a_q6_k_p16.data[ib].qh[qhi + 2u]) | (uint(a_q6_k_p16.data[ib].qh[qhi + 3u]) << 16u)) >> qhshift) & 0x03030303u; \
                qh45 = ((uint(a_q6_k_p16.data[ib].qh[qhi + 4u]) | (uint(a_q6_k_p16.data[ib].qh[qhi + 5u]) << 16u)) >> qhshift) & 0x03030303u; \
                qh67 = ((uint(a_q6_k_p16.data[ib].qh[qhi + 6u]) | (uint(a_q6_k_p16.data[ib].qh[qhi + 7u]) << 16u)) >> qhshift) & 0x03030303u; \
