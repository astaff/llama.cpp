    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0u) {
        val += data_aux0[expert_idx * p.stride_d + d_row];
    }
    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE0) != 0u) {
        const uint s0_idx = uint(row_idx.x) + ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE0_TOK) != 0u ? uint(row_idx.y) * p.nei0 : 0u);
        val *= data_aux0[s0_idx];
    }
    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE1) != 0u) {
        const uint s1_idx = uint(row_idx.x) + ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE1_TOK) != 0u ? uint(row_idx.y) * p.nei0 : 0u);
        val *= data_aux1[s1_idx];
    }
    if ((p.fusion_flags & (MAT_VEC_FUSION_FLAGS_GLU_A | MAT_VEC_FUSION_FLAGS_GLU_B)) != 0u) {
        const float o = data_aux0[d_idx];
        val = ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_GLU_A) != 0u)
            ? (val / (1.0f + exp(-val)) * o)
            : (o / (1.0f + exp(-o)) * val);
    }
    return val;
}
#else
float mma_apply_dense_epilogue(float val, uint d_row, uint d_col, uint d_idx, bool is_pair_second) {
    if (is_pair_second) {
        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_PAIR_MM_SIGMOID1) != 0u) {
            val = 1.0f / (1.0f + exp(-val));
        }
        return val;
    }
    if (FUSE_MODE == 2u) {
        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SOFTPLUS_GATE) != 0u) {
            const float x = val + data_aux1[d_row];
            const float sp = (x > 20.0f) ? x : log(1.0f + exp(x));
            val = sp * data_aux2[d_row];
        }
        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SIGMOID) != 0u) {
            val = 1.0f / (1.0f + exp(-val));
        }
        return val;
    }
    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0u) {
        val += data_aux0[d_idx];
    }
    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS1) != 0u) {
        val += data_aux1[d_idx];
    }
    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SIGMOID) != 0u) {
        val = 1.0f / (1.0f + exp(-val));
    }
    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SOFTPLUS_GATE) != 0u) {
        const float x = val + data_aux0[d_row];
        const float sp = (x > 20.0f) ? x : log(1.0f + exp(x));
        val = sp * data_aux1[d_row];
    }
    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_ROW_SCALE0) != 0u) {
        val *= data_aux0[d_col];
    }
    if ((p.fusion_flags & (MAT_VEC_FUSION_FLAGS_GLU_A | MAT_VEC_FUSION_FLAGS_GLU_B)) != 0u) {
        const float o = data_aux0[d_idx];
        val = ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_GLU_A) != 0u)
            ? (val / (1.0f + exp(-val)) * o)
            : (o / (1.0f + exp(-o)) * val);
    }
    return val;
}
#endif

void main() {
    const uint lane  = gl_LocalInvocationID.x;
    const uint sgitg = gl_LocalInvocationID.y;
    const uint tid   = sgitg * 32u + lane;
    const uint sg_k  = sgitg % NSG;
    const uint sg_m  = sgitg / NSG;
    const uint fm    = mma_lane_fm(lane);
    const uint fn    = mma_lane_fn(lane);

    const uint wg_m0 = gl_WorkGroupID.x * (8u * NT * MSG);
    const uint sg_m0 = wg_m0 + sg_m * (8u * NT);

    const uint stride_a_u = p.stride_a >> MMA_ELEM_SHIFT;

#ifdef MUL_MAT_ID
    const uint tile_idx = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    if (tile_idx >= data_row_map[0]) {
        return;
    }
    const uint expert_idx = data_row_map[1u + 2u * tile_idx];
    const uint row_begin  = tile_idx * (8u * RT);
    const uint tile_ne1   = data_row_map[2u + 2u * tile_idx];
    if (tile_ne1 == 0u || wg_m0 >= p.M) {
        return;
    }
    const uint n_valid = tile_ne1;
    const uint a_batch_base = expert_idx * (p.batch_stride_a >> MMA_ELEM_SHIFT);

    if (tid < 8u * RT) {
        const uint c = min(tid, tile_ne1 - 1u);
        const uint packed = data_row_map[p.row_ids_offset + row_begin + c];
        const uint slot = packed & 0xFFFFu;
        const uint tok  = packed >> 16u;
        sh_r_ids[tid]  = packed;
        sh_b_base[tid] = tok * p.batch_stride_b + (slot % p.ne11) * p.stride_b;
        if (FUSE_MODE == 4u) {
            const uint s0_idx = slot + (((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE0_TOK) != 0u) ? (tok * p.nei0) : 0u);
            sh_col_scale[tid] = data_aux0[s0_idx];
        }
    }
    barrier();
#else
    if (wg_m0 >= p.M) {
        return;
    }
    const uint wg_n0     = gl_WorkGroupID.y * (8u * RT);
    const uint n_valid   = (wg_n0 < p.N) ? min(8u * RT, p.N - wg_n0) : 0u;
    if (n_valid == 0u) {
        return;
    }
    const uint batch_idx   = gl_WorkGroupID.z + p.base_work_group_z;
    const uint i13         = batch_idx / p.ne12;
    const uint i12         = batch_idx % p.ne12;
    const uint i03         = i13 / p.broadcast3;
    const uint i02         = i12 / p.broadcast2;
    const uint batch_idx_a = i03 * p.ne02 + i02;
    const uint a_batch_base = batch_idx_a * (p.batch_stride_a >> MMA_ELEM_SHIFT);
    const uint b_batch_base = batch_idx * p.batch_stride_b;
#endif

    uint a_row_base[NT];
    bool tile_second[NT];
    [[unroll]] for (uint t = 0u; t < NT; ++t) {
        const uint tile_r = sg_m0 + 8u * t;
#ifndef MUL_MAT_ID
        if (FUSE_MODE == 2u && tile_r >= p.pair_m0) {
            tile_second[t] = true;
            const uint m1 = p.M - p.pair_m0;
            const uint r1 = min(tile_r - p.pair_m0 + fm, m1 - 1u);
            a_row_base[t] = a_batch_base + r1 * stride_a_u;
        } else if (FUSE_MODE == 2u) {
            tile_second[t] = false;
            const uint r0 = min(tile_r + fm, p.pair_m0 - 1u);
            a_row_base[t] = a_batch_base + r0 * stride_a_u;
        } else
#endif
        {
            tile_second[t] = false;
            const uint r0 = min(tile_r + fm, p.M - 1u);
            a_row_base[t] = a_batch_base + r0 * stride_a_u;
        }
    }

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> mc[RT][NT];
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> mc_u[RT][NT];
    [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
        [[unroll]] for (uint t = 0u; t < NT; ++t) {
            mc[rt][t]   = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0f);
            mc_u[rt][t] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0f);
        }
    }

    // Cooperative B-tile path when MSG > 1 && USE_SH_B != 0 (NSG == 1, K % 64 == 0)
    if (MSG > 1u && USE_SH_B != 0u) {
        const bool v4_ok = ((p.stride_b & 3u) == 0u) && ((p.batch_stride_b & 3u) == 0u);
        const uint k4_lane_base = 4u * (fm >> 1u) + 2u * (fm & 1u);

#define MMA_ACCUM_SHB_1D(ACC_VEC, SUB_OFF, W0, W1, W2, W3)                                   \
    do {                                                                                     \
        [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {                                       \
            if (rt == 0u || (8u * rt < n_valid)) {                                           \
                const uint c0 = 8u * rt + fn + 0u;                                           \
                const uint c1 = 8u * rt + fn + 1u;                                           \
                const MMA_FVEC4 ba0 = sh_b[c0][(SUB_OFF) + k4_lane_base + 0u];               \
                const MMA_FVEC4 ba1 = sh_b[c0][(SUB_OFF) + k4_lane_base + 1u];               \
                const MMA_FVEC4 bb0 = sh_b[c1][(SUB_OFF) + k4_lane_base + 0u];               \
                const MMA_FVEC4 bb1 = sh_b[c1][(SUB_OFF) + k4_lane_base + 1u];               \
                [[unroll]] for (uint s = 0u; s < 4u; ++s) {                                  \
                    coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> ma0, ma1;      \
                    coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb0, mb1;      \
                    ma0[0] = (W0)[s]; ma0[1] = (W2)[s];                                      \
                    ma1[0] = (W1)[s]; ma1[1] = (W3)[s];                                      \
                    mb0[0] = ba0[s];  mb0[1] = bb0[s];                                       \
                    mb1[0] = ba1[s];  mb1[1] = bb1[s];                                       \
                    ACC_VEC[rt] = coopMatMulAdd(ma0, mb0, ACC_VEC[rt]);                      \
                    ACC_VEC[rt] = coopMatMulAdd(ma1, mb1, ACC_VEC[rt]);                      \
                }                                                                            \
            }                                                                                \
        }                                                                                    \
    } while (false)

#define MMA_ACCUM_SHB(MC_ARR, SUB_OFF, W0, W1, W2, W3)                                       \
    do {                                                                                     \
        [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {                                       \
            if (rt == 0u || (8u * rt < n_valid)) {                                           \
                const uint c0 = 8u * rt + fn + 0u;                                           \
                const uint c1 = 8u * rt + fn + 1u;                                           \
                const MMA_FVEC4 ba0 = sh_b[c0][(SUB_OFF) + k4_lane_base + 0u];               \
                const MMA_FVEC4 ba1 = sh_b[c0][(SUB_OFF) + k4_lane_base + 1u];               \
                const MMA_FVEC4 bb0 = sh_b[c1][(SUB_OFF) + k4_lane_base + 0u];               \
                const MMA_FVEC4 bb1 = sh_b[c1][(SUB_OFF) + k4_lane_base + 1u];               \
                [[unroll]] for (uint s = 0u; s < 4u; ++s) {                                  \
                    coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> ma0, ma1;      \
                    coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb0, mb1;      \
                    ma0[0] = (W0)[s]; ma0[1] = (W2)[s];                                      \
                    ma1[0] = (W1)[s]; ma1[1] = (W3)[s];                                      \
                    mb0[0] = ba0[s];  mb0[1] = bb0[s];                                       \
                    mb1[0] = ba1[s];  mb1[1] = bb1[s];                                       \
                    MC_ARR[rt][t] = coopMatMulAdd(ma0, mb0, MC_ARR[rt][t]);                  \
                    MC_ARR[rt][t] = coopMatMulAdd(ma1, mb1, MC_ARR[rt][t]);                  \
                }                                                                            \
            }                                                                                \
        }                                                                                    \
    } while (false)

#define MMA_SG_FENCE() controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease)
#define MMA_NO_FENCE() do {} while (false)

#if defined(DATA_A_Q4_K)
#define MMA_ACCUM_KPAIRS_GEN(LOOP_ATTR, FENCE_MACRO, TARGET_MACRO, TARGET_ARR, USE_U, ROW_BASE)                          \
    do {                                                                                                                 \
        FENCE_MACRO();                                                                                                   \
        const uint ib       = (ROW_BASE) + ((g * K_PAIRS) >> 2u);                                                        \
        const uint sub_base = (g * K_PAIRS) & 3u;                                                                        \
        const uint fn2      = fn >> 1u;                                                                                  \
        const uint b        = fn2 >> 1u;                                                                                 \
        const float d_hi    = (b == 0u) ? 1.0f : 0.0625f;                                                                \
        const uint  q_mk    = (b == 0u) ? 0x0F0F0F0Fu : 0xF0F0F0F0u;                                                     \
        const uint w_lo     = (fn2 & 1u) << 2u;                                                                          \
        vec2 loadd;                                                                                                      \
        uvec3 scales;                                                                                                    \
        if (USE_U) {                                                                                                     \
            loadd  = vec2(u_q4_k.data[ib].dm);                                                                           \
            scales = uvec3(u_q4_k_p32.data[ib].scales[0], u_q4_k_p32.data[ib].scales[1], u_q4_k_p32.data[ib].scales[2]); \
        } else {                                                                                                         \
            loadd  = vec2(a_q4_k.data[ib].dm);                                                                           \
            scales = uvec3(a_q4_k_p32.data[ib].scales[0], a_q4_k_p32.data[ib].scales[1], a_q4_k_p32.data[ib].scales[2]); \
        }                                                                                                                \
        const float dx = loadd.x * d_hi;                                                                                 \
        LOOP_ATTR for (uint s_kp = 0u; s_kp < K_PAIRS; ++s_kp) {                                                         \
            FENCE_MACRO();                                                                                               \
            const uint sub         = sub_base + s_kp;                                                                    \
            const uint is          = (sub << 1u) | b;                                                                    \
            const uint scalesoffs  = (is & 3u) * 8u;                                                                     \
            const uint scidxshift1 = (is < 4u) ? scalesoffs : (scalesoffs + 2u);                                         \
            const uint mbidxshift0 = (is < 4u) ? scalesoffs : (scalesoffs + 4u);                                         \
            const uint sc_word     = (is < 4u) ? scales.x : scales.z;                                                    \
            const uint mb_word     = (is < 4u) ? scales.y : scales.z;                                                    \
            const uint sc          = ((sc_word >> scalesoffs) & 0xFu) | ((scales.x >> scidxshift1) & 0x30u);             \
            const uint mbyte       = ((mb_word >> mbidxshift0) & 0xFu) | ((scales.y >> scidxshift1) & 0x30u);            \
            const f16vec4 d        = f16vec4(dx * float(sc));                                                            \
            const f16vec4 m        = f16vec4(-loadd.y * float(mbyte));                                                   \
            const uint w_idx       = (sub << 3u) + w_lo;                                                                 \
            uint q0, q1, q2, q3;                                                                                         \
            if (USE_U) {                                                                                                 \
                q0 = u_q4_k_p32.data[ib].qs[w_idx + 0u]; q1 = u_q4_k_p32.data[ib].qs[w_idx + 1u];                        \
                q2 = u_q4_k_p32.data[ib].qs[w_idx + 2u]; q3 = u_q4_k_p32.data[ib].qs[w_idx + 3u];                        \
            } else {                                                                                                     \
                q0 = a_q4_k_p32.data[ib].qs[w_idx + 0u]; q1 = a_q4_k_p32.data[ib].qs[w_idx + 1u];                        \
                q2 = a_q4_k_p32.data[ib].qs[w_idx + 2u]; q3 = a_q4_k_p32.data[ib].qs[w_idx + 3u];                        \
            }                                                                                                            \
            const f16vec4 w0 = fma(d, f16vec4(unpack8(q0 & q_mk)), m);                                                   \
            const f16vec4 w1 = fma(d, f16vec4(unpack8(q1 & q_mk)), m);                                                   \
            const f16vec4 w2 = fma(d, f16vec4(unpack8(q2 & q_mk)), m);                                                   \
            const f16vec4 w3 = fma(d, f16vec4(unpack8(q3 & q_mk)), m);                                                   \
            FENCE_MACRO();                                                                                               \
            TARGET_MACRO(TARGET_ARR, (s_kp << 4u), w0, w1, w2, w3);                                                      \
        }                                                                                                                \
    } while (false)
#elif defined(DATA_A_Q5_K)
#define MMA_ACCUM_KPAIRS_GEN(LOOP_ATTR, FENCE_MACRO, TARGET_MACRO, TARGET_ARR, USE_U, ROW_BASE)                          \
    do {                                                                                                                 \
        FENCE_MACRO();                                                                                                   \
        const uint ib       = (ROW_BASE) + ((g * K_PAIRS) >> 2u);                                                        \
