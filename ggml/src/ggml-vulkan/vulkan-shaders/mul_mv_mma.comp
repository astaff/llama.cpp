#undef MMA_ACCUM_KPAIRS_FENCED
#undef MMA_ACCUM_KPAIRS_UNROLLED
#undef MMA_ACCUM_KPAIRS
#undef MMA_ACCUM_KPAIRS_GEN
#undef MMA_NO_FENCE
#undef MMA_SG_FENCE
#undef MMA_ACCUM_SHB
#undef MMA_ACCUM_SHB_1D
