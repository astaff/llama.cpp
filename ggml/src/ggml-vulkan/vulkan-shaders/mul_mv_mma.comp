    MMA_ACCUM_KPAIRS_GEN([[unroll]], MMA_NO_FENCE, MMA_ACCUM_SHB_1D, ACC_VEC, USE_U, ROW_BASE)
#define MMA_ACCUM_KPAIRS_FENCED(MC_ARR, USE_U, ROW_BASE) \
    MMA_ACCUM_KPAIRS_GEN([[unroll]], MMA_SG_FENCE, MMA_ACCUM_SHB, MC_ARR, USE_U, ROW_BASE)

        const uint K4_PER_COL = 16u * K_PAIRS;
        const uint K_CHUNK    = 64u * K_PAIRS;
        const uint nch        = p.K / K_CHUNK;
        const uint B_ELEMS    = K4_PER_COL * 8u * RT;
        const uint B_LOADS    = (B_ELEMS + WG_THREADS - 1u) / WG_THREADS;

        const bool stage_tmp_b = (USE_SH_B == 1u) ? true : ((USE_SH_B == 5u) ? true : (USE_SH_B == 8u));
        const bool use_sg_fence = (USE_SH_B == 5u) ? true : (USE_SH_B == 6u);
        const bool load_mb_once = (USE_SH_B == 7u) ? true : (USE_SH_B == 8u);

        for (uint g = 0u; g < nch; ++g) {
            if (stage_tmp_b) {
                MMA_FVEC4 tmp_b[B_LOADS];
                [[unroll]] for (uint li = 0u; li < B_LOADS; ++li) {
                    tmp_b[li] = MMA_FVEC4(0.0f);
                }
                [[unroll]] for (uint li = 0u; li < B_LOADS; ++li) {
                    const uint col_min = (li * WG_THREADS) / K4_PER_COL;
                    if (li == 0u || col_min < n_valid) {
                        const uint idx = li * WG_THREADS + tid;
                        const uint col_in_tile = idx / K4_PER_COL;
                        const uint k4 = idx % K4_PER_COL;
                        if (idx < B_ELEMS && col_in_tile < n_valid) {
#ifdef MUL_MAT_ID
                            const uint b_base = sh_b_base[col_in_tile];
#else
                            const uint b_base = b_batch_base + (wg_n0 + col_in_tile) * p.stride_b;
#endif
                            tmp_b[li] = MMA_FVEC4(load_b_vec4_aligned_or_scalar(b_base + g * K_CHUNK + (k4 << 2u), v4_ok));
                        }
                    }
                }

                if (g > 0u) {
                    barrier();
                }

                [[unroll]] for (uint li = 0u; li < B_LOADS; ++li) {
                    const uint col_min = (li * WG_THREADS) / K4_PER_COL;
                    if (li == 0u || col_min < n_valid) {
                        const uint idx = li * WG_THREADS + tid;
                        if (idx < B_ELEMS) {
                            sh_b[idx / K4_PER_COL][idx % K4_PER_COL] = tmp_b[li];
                        }
                    }
                }
                barrier();
            } else {
                if (g > 0u) {
                    barrier();
                }
                [[unroll]] for (uint li = 0u; li < B_LOADS; ++li) {
                    const uint col_min = (li * WG_THREADS) / K4_PER_COL;
                    if (li == 0u || col_min < n_valid) {
                        const uint idx = li * WG_THREADS + tid;
                        if (idx < B_ELEMS) {
                            const uint col_in_tile = idx / K4_PER_COL;
                            const uint k4 = idx % K4_PER_COL;
                            MMA_FVEC4 bv = MMA_FVEC4(0.0f);
                            if (col_in_tile < n_valid) {
#ifdef MUL_MAT_ID
                                const uint b_base = sh_b_base[col_in_tile];
#else
                                const uint b_base = b_batch_base + (wg_n0 + col_in_tile) * p.stride_b;
#endif
                                bv = MMA_FVEC4(load_b_vec4_aligned_or_scalar(b_base + g * K_CHUNK + (k4 << 2u), v4_ok));
