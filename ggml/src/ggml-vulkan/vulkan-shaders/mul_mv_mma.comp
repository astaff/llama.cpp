#define MMA_FTYPE float
#define MMA_FVEC4 vec4
#define MMA_FVEC2 vec2
#define MMA_ELEM_SHIFT 0u
#elif defined(DATA_A_F16)
#define MMA_FTYPE float16_t
#define MMA_FVEC4 f16vec4
#define MMA_FVEC2 f16vec2
#define MMA_ELEM_SHIFT 0u
#elif defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K) || defined(DATA_A_Q6_K) || defined(DATA_A_IQ4_XS)
#define MMA_FTYPE float16_t
#define MMA_FVEC4 f16vec4
#define MMA_FVEC2 f16vec2
#define MMA_ELEM_SHIFT 8u
#else
#define MMA_FTYPE float16_t
#define MMA_FVEC4 f16vec4
#define MMA_FVEC2 f16vec2
#define MMA_ELEM_SHIFT 5u
#endif

