                    const uint sub_off = (s_kp << 4u) + k4_lane_base;
                    coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb0[RT][4];
                    coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb1[RT][4];
                    [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
                        if (rt == 0u || (8u * rt < n_valid)) {
