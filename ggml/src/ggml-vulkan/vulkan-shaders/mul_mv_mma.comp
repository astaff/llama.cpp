                            ma[0] = MMA_FTYPE(v0_u.x); ma[1] = MMA_FTYPE(v0_u.z); mb[0] = b0[rt][0].x; mb[1] = b0[rt][1].x; mpu = coopMatMulAdd(ma, mb, mpu);
                            ma[0] = MMA_FTYPE(v0_u.y); ma[1] = MMA_FTYPE(v0_u.w); mb[0] = b0[rt][0].y; mb[1] = b0[rt][1].y; mpu = coopMatMulAdd(ma, mb, mpu);
                            ma[0] = MMA_FTYPE(v1_u.x); ma[1] = MMA_FTYPE(v1_u.z); mb[0] = b1[rt][0].x; mb[1] = b1[rt][1].x; mpu = coopMatMulAdd(ma, mb, mpu);
                            ma[0] = MMA_FTYPE(v1_u.y); ma[1] = MMA_FTYPE(v1_u.w); mb[0] = b1[rt][0].y; mb[1] = b1[rt][1].y; mpu = coopMatMulAdd(ma, mb, mpu);
