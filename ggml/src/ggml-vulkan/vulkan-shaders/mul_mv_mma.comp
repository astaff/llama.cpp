                            const uint c1 = 8u * rt + fn + 1u;
                            const MMA_FVEC4 ba0 = sh_b[c0][sub_off + 0u];
                            const MMA_FVEC4 ba1 = sh_b[c0][sub_off + 1u];
                            const MMA_FVEC4 bb0 = sh_b[c1][sub_off + 0u];
