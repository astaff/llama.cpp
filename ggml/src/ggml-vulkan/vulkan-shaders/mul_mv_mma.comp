                                        uma1[0] = uw1[s]; uma1[1] = uw3[s];
                                        mc_u[rt][t] = coopMatMulAdd(uma0, mb0[rt][s], mc_u[rt][t]);
                                        mc_u[rt][t] = coopMatMulAdd(uma1, mb1[rt][s], mc_u[rt][t]);
