// Zero-spill register-direct 8x8x8 cooperative-matrix few-column matmul / MoE matmul_id for Apple AGX (G17P).
// Subgroup layout (AGX3B 8x8 coopmat):
//   lane l in [0..31] owns:
//     fm = ((l >> 1) & 3) | ((l >> 2) & 4)   in [0..7]
//     fn = ((l & 1) << 1) | ((l >> 1) & 4)   in {0, 2, 4, 6}  (elements e=0,1 -> fn, fn+1)

layout(local_size_x = 32, local_size_y_id = 0, local_size_z = 1) in;

layout(constant_id = 0) const uint WG_SG     = 1; // total subgroups per workgroup = NSG * MSG
layout(constant_id = 1) const uint NT        = 2; // 8*NT M-rows per subgroup
layout(constant_id = 2) const uint RT        = 1; // 8*RT N-cols per workgroup (1, 2, 4)
layout(constant_id = 3) const uint NSG       = 1; // K-split subgroups (MSG = WG_SG / NSG)
// 0 = plain, 1 = single-op epilogue, 2 = PAIR_MM (dense only), 3 = PAIR_GLU, 4 = fast epilogue
layout(constant_id = 4) const uint FUSE_MODE = 0;
layout(constant_id = 5) const uint USE_SH_B  = 1;
layout(constant_id = 6) const uint K_PAIRS   = 1;

const uint MSG        = WG_SG / NSG;
const uint WG_THREADS = 32u * WG_SG;

