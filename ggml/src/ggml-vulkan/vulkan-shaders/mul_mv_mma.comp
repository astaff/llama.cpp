                            MMA_SG_FENCE();
                            MMA_FVEC4 uw0, uw1, uw2, uw3;
                            dequant16(true, a_row_base[t], ci_kp, uw0, uw1, uw2, uw3);
                            MMA_SG_FENCE();
                            [[unroll]] for (uint rt = 0u; rt < RT; ++rt) {
                                if (rt == 0u || (8u * rt < n_valid)) {
                                    [[unroll]] for (uint s = 0u; s < 4u; ++s) {
                                        coopmat<MMA_FTYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> uma0, uma1;
