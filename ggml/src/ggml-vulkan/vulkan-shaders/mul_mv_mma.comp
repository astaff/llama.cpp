                    const i8vec4 v0_u = unpack8(int32_t((uint(int(u_q8_0.data[blk_idx].qs[q_off + 0u])) & 0xFFFFu) | (uint(int(u_q8_0.data[blk_idx].qs[q_off + 1u])) << 16u)));
                    const i8vec4 v1_u = unpack8(int32_t((uint(int(u_q8_0.data[blk_idx].qs[q_off + 2u])) & 0xFFFFu) | (uint(int(u_q8_0.data[blk_idx].qs[q_off + 3u])) << 16u)));
