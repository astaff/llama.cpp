#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#if defined(BFLOAT16)
#extension GL_EXT_bfloat16 : enable
#endif

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable

#include "types.glsl"
#include "flash_attn_base.glsl"
#if !defined(BFLOAT16) && !defined(COOPMAT_8X8)
#include "flash_attn_dequant.glsl"
#endif

// These need to be supported N,M values for a MatBc x MatBr x 16 coopmatmuladd
const uint32_t MatBr = 16;
const uint32_t MatBc = 16;
const uint32_t q_tiles = Br / MatBr;

const uint32_t rows_per_thread = Br / row_split;
const uint32_t cols_per_iter = gl_WorkGroupSize.x / row_split;
const uint32_t cols_per_thread = Bc / cols_per_iter;


layout (binding = 0) readonly buffer Q {float data_q[];};
layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer K {FLOAT_TYPE data_k[];};
layout (binding = 1) readonly buffer KV4 {FLOAT_TYPEV4 data_kv4[];};
layout (binding = 2) readonly buffer V {FLOAT_TYPE data_v[];};
layout (binding = 2) readonly buffer VV4 {FLOAT_TYPEV4 data_vv4[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};

#if defined(COOPMAT_8X8) && !defined(BFLOAT16)
// Series 13: 15,776-byte <= 16 KB COOPMAT_8X8 layout for 2-WG/core occupancy on Apple AGX G17P
// Supports both WG=128 (4 subgroups -> 256 threads/core) and WG=256 (8 subgroups -> 512 threads/core,
// halving per-thread OfMat/SfMat GPRs from 80 -> 40 half-GPRs for zero register spills!):
// - 8x8 block-packed transposed Qf_T (RowMajor f16vec2 loads, 0 bank conflicts)
// - RowMajor [Br][Bc+8] Psh_s (f16vec2 loads, 36-dword stride -> 0 bank conflicts)
// - Direct OfMat[num_hsv_tiles][2][2] register accumulation (eliminates pvsh + 9 barriers/iter)
// - Compact 1 KB kvsh[128] used only on partial tail blocks
const uint32_t num_sg         = WorkGroupSize / SubGroupSize;
const uint32_t k_tiles_per_sg = Bc / (num_sg * 8u);
const uint32_t sm_rows_per_th = Br / 4u;
const uint32_t sm_cols_per_th = Bc / 32u;

shared float tmpsh[num_sg];
shared float sh_eMf[Br];
shared ACC_TYPE slope[Br];
shared FLOAT_TYPE Qf_T[HSK_pad * Br];
const uint32_t psh_s_stride = Bc + 8u;
shared FLOAT_TYPE Psh_s[Br * psh_s_stride];
const uint32_t sfshstride = (HSK <= 128u) ? (Br / 4u + 1u) : (Br / 4u);
const uint32_t osh_stride = 16u;
const uint32_t sfsh_elems = (Bc * sfshstride >= Br * osh_stride) ? (Bc * sfshstride) : (Br * osh_stride);
shared ACC_TYPEV4 sfsh[sfsh_elems];
shared FLOAT_TYPEV4 kvsh[128];

void main() {
    init_indices();

    const uint32_t tid     = gl_LocalInvocationIndex;
    const uint32_t row_tid = tid / 32u;
    const uint32_t col_tid = tid & 31u;

#define tile_row(r) (row_tid * sm_rows_per_th + (r))

    const uint32_t q_offset = gqa_iq1 * p.nb01 + (iq2 * p.nb02 + iq3 * p.nb03) / 4u;

    [[unroll]] for (uint32_t idx = 0u; idx < Br * HSK_pad / 4u; idx += WorkGroupSize) {
        const uint32_t idx0 = idx + tid;
        if (idx0 < Br * HSK_pad / 4u) {
            const uint32_t d4 = idx0 % (HSK_pad / 4u);
            const uint32_t r  = idx0 / (HSK_pad / 4u);
            vec4 qv = vec4(0.0);
            if (i * Br + r < N && d4 * 4u < HSK) {
                const uint32_t q_elem = q_offset + (i * Br + r) * q_stride + d4 * 4u;
                if (!KV_bounds_check || (q_elem & 3u) == 0u) {
                    qv = data_qv4[q_elem >> 2u] * p.scale;
                } else {
                    qv = vec4(data_q[q_elem + 0u], data_q[q_elem + 1u],
                              data_q[q_elem + 2u], data_q[q_elem + 3u]) * p.scale;
                }
            }
            const uint32_t d8     = d4 >> 1u;
            const uint32_t k_base = (d4 & 1u) * 4u;
            const uint32_t n_blk  = r >> 3u;
            const uint32_t c_in   = r & 7u;
            const uint32_t blk    = d8 * (Br / 8u) + n_blk;
            [[unroll]] for (uint32_t t = 0u; t < 4u; ++t) {
                Qf_T[((blk * 8u) + k_base + t) * 8u + c_in] = FLOAT_TYPE(qv[t]);
            }
        }
    }

    if (tid < Br) {
        slope[tid] = (p.max_bias > 0.0f) ? perElemOpComputeSlope(tid, col_tid, ACC_TYPE(0), iq2) : ACC_TYPE(1.0);
    }
    barrier();

    const uint32_t num_hsv_tiles = (HSV + MatBc * num_sg - 1u) / (MatBc * num_sg);
    coopmat<O_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> OfMat[num_hsv_tiles][2][2];
    [[unroll]] for (uint32_t ht = 0u; ht < num_hsv_tiles; ++ht) {
        [[unroll]] for (uint32_t m = 0u; m < 2u; ++m) {
            [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                OfMat[ht][m][n] = coopmat<O_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
            }
        }
    }

    float Lf[sm_rows_per_th], Mf[sm_rows_per_th];
    [[unroll]] for (uint32_t r = 0u; r < sm_rows_per_th; ++r) {
        Lf[r] = 0.0f;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    const uint32_t mo_stride = CEIL_DIV(KV, 16u * Bc);
    uint32_t mo_offset = mo_stride * i;
    const uint32_t k_offset = (ik2 * p.nb12 + ik3 * p.nb13) / FaBlockBytesK;
    const uint32_t v_offset = (iv2 * p.nb22 + iv3 * p.nb23) / FaBlockBytesV;
    uint32_t m_offset = gqa_iq1 * KV;
    if (p.nem2 != 1u || p.nem3 != 1u) {
        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
        mo_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * CEIL_DIV(p.nem1, Br) * mo_stride;
    }

    uint32_t mask_opt = 0u;
    uint32_t mask_opt_idx = ~0u;

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {
        uint32_t mask_opt_bits = 0u;
        if (MASK_ENABLE) {
            if (USE_MASK_OPT) {
                if (mask_opt_idx != j / 16u) {
                    mask_opt_idx = j / 16u;
                    mask_opt = data_mask_opt[mo_offset + mask_opt_idx];
                }
                const uint32_t rem_shift = (j & 15u) * 2u;
                const uint32_t chunk_end = min(end_j, (j & ~15u) + 16u);
                const uint32_t n_rem     = chunk_end - j;
                const uint32_t rem_mask  = (n_rem >= 16u) ? 0xFFFFFFFFu : ((1u << (2u * n_rem)) - 1u);
                if (((mask_opt >> rem_shift) & rem_mask) == (0x55555555u & rem_mask)) {
                    j = chunk_end - 1u;
                    continue;
                }
                mask_opt_bits = (mask_opt >> rem_shift) & 0x3u;
                if (mask_opt_bits == MASK_OPT_ALL_NEG_INF) {
                    continue;
                }
            } else {
                const bool nem1_bounds_check = !(p.gqa_ratio > 1u) && (p.nem1 % Br) != 0u;
                float max_mask = NEG_FLT_MAX_OVER_2;
                [[unroll]] for (uint32_t idx = 0u; idx < Bc * Br / 4u; idx += WorkGroupSize) {
                    const uint32_t idx0 = idx + tid;
                    if (idx0 < Bc * Br / 4u) {
                        const uint32_t c = idx0 / (Br / 4u);
                        const uint32_t r = idx0 % (Br / 4u);
                        uint32_t kcol;
                        if (fa_kv_index(j * Bc + c, kcol)) {
                            if (USE_SPARSE) {
                                max_mask = max(max_mask, float(data_m[m_offset + kcol]));
                            } else {
                                [[unroll]] for (uint32_t rr = 0u; rr < 4u; ++rr) {
                                    if (!nem1_bounds_check || i * Br + r * 4u + rr < p.nem1) {
                                        max_mask = max(max_mask, float(data_m[m_offset + (i * Br + r * 4u + rr) * m_stride + kcol]));
                                    }
                                }
                            }
                        }
                    }
                }
                const bool all_less = subgroupAll(max_mask <= NEG_FLT_MAX_OVER_2);
                barrier();
                if (gl_SubgroupInvocationID == 0u) {
                    tmpsh[gl_SubgroupID] = all_less ? NEG_FLT_MAX_OVER_2 : 0.0f;
                }
                barrier();
                [[unroll]] for (uint32_t s = 0u; s < num_sg; ++s) {
                    max_mask = max(max_mask, tmpsh[s]);
                }
                if (max_mask <= NEG_FLT_MAX_OVER_2) {
                    continue;
                }
            }
        }

        coopmat<ACC_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> SfMat[k_tiles_per_sg][2];
        [[unroll]] for (uint32_t m = 0u; m < k_tiles_per_sg; ++m) {
            [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                SfMat[m][n] = coopmat<ACC_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
            }
        }
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> KMatK[k_tiles_per_sg];
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> KMatP[2];
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> QMat[2];

        const bool stage_k_block = (SHMEM_STAGING != 0u) || USE_SPARSE ||
                                   (KV_bounds_check && (j * Bc + Bc > KV || ((k_offset | k_stride) & 3u) != 0u));

        [[unroll]] for (uint32_t d = 0u; d < HSK_pad / 16u; ++d) {
            [[unroll]] for (uint32_t dk = 0u; dk < 2u; ++dk) {
                const bool stage_k_now = stage_k_block || (d * 16u + dk * 8u + 8u > HSK);
                if (stage_k_now) {
                    barrier();
                    if (tid < 128u) {
                        const uint32_t row = tid >> 1u;
                        const uint32_t col_vec = tid & 1u;
                        FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0.0);
                        uint32_t kcol;
                        if (fa_kv_index(j * Bc + row, kcol) && (d * 16u + dk * 8u + col_vec * 4u < HSK)) {
                            const uint32_t elem_idx = k_offset + kcol * k_stride + d * 16u + dk * 8u + col_vec * 4u;
                            if ((elem_idx & 3u) == 0u) {
                                K_Tf = data_kv4[elem_idx >> 2u];
                            } else {
                                K_Tf = FLOAT_TYPEV4(data_k[elem_idx + 0u], data_k[elem_idx + 1u],
                                                    data_k[elem_idx + 2u], data_k[elem_idx + 3u]);
                            }
                        }
                        kvsh[tid] = K_Tf;
                    }
                    barrier();
                }
                [[unroll]] for (uint32_t m = 0u; m < k_tiles_per_sg; ++m) {
                    const uint32_t kv_local_row = (gl_SubgroupID * k_tiles_per_sg + m) * 8u;
                    if (!stage_k_now) {
                        const uint32_t coord = k_offset / 4u + (j * Bc + kv_local_row) * (k_stride / 4u) + d * 4u + dk * 2u;
                        coopMatLoad(KMatK[m], data_kv4, coord, k_stride / 4u, gl_CooperativeMatrixLayoutRowMajor);
                    } else {
                        const uint32_t coord = kv_local_row * 2u;
                        coopMatLoad(KMatK[m], kvsh, coord, 2u, gl_CooperativeMatrixLayoutRowMajor);
                    }
                }
                [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                    const uint32_t q_coord = ((d * 2u + dk) * (Br / 8u) + n) * 64u;
                    coopMatLoad(QMat[n], Qf_T, q_coord, 8u, gl_CooperativeMatrixLayoutRowMajor);
                }
                [[unroll]] for (uint32_t m = 0u; m < k_tiles_per_sg; ++m) {
                    [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                        SfMat[m][n] = coopMatMulAdd(KMatK[m], QMat[n], SfMat[m][n]);
                    }
                }
            }
        }

        [[unroll]] for (uint32_t m = 0u; m < k_tiles_per_sg; ++m) {
            const uint32_t kv_local_row = (gl_SubgroupID * k_tiles_per_sg + m) * 8u;
            [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                const uint32_t coord = kv_local_row * sfshstride + n * 2u;
                coopMatStore(SfMat[m][n], sfsh, coord, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        barrier(); // Barrier #1: sfsh ready; prior j's Psh_s/sh_eMf reads finished

        if (LOGIT_SOFTCAP) {
            [[unroll]] for (uint32_t idx = 0u; idx < Bc * Br / 4u; idx += WorkGroupSize) {
                const uint32_t idx0 = idx + tid;
                if (idx0 < Bc * Br / 4u) {
                    const uint32_t c = idx0 / (Br / 4u);
                    const uint32_t r = idx0 % (Br / 4u);
                    sfsh[c * sfshstride + r] = ACC_TYPEV4(p.logit_softcap * tanh(sfsh[c * sfshstride + r]));
                }
            }
            barrier();
        }

        if (MASK_ENABLE && mask_opt_bits != MASK_OPT_ALL_ZERO) {
            const bool nem1_bounds_check = !(p.gqa_ratio > 1u) && (p.nem1 % Br) != 0u;
            [[unroll]] for (uint32_t idx = 0u; idx < Bc * Br / 4u; idx += WorkGroupSize) {
                const uint32_t idx0 = idx + tid;
                if (idx0 < Bc * Br / 4u) {
                    const uint32_t c = idx0 / (Br / 4u);
                    const uint32_t r = idx0 % (Br / 4u);
                    uint32_t kcol;
                    const bool kv_active = fa_kv_index(j * Bc + c, kcol);
                    if (!KV_bounds_check || j * Bc + c < KV) {
                        ACC_TYPEV4 masks = ACC_TYPEV4(0.0);
                        if (kv_active) {
                            if (USE_SPARSE) {
                                masks = ACC_TYPEV4(float(data_m[m_offset + kcol]));
                            } else {
                                [[unroll]] for (uint32_t rr = 0u; rr < 4u; ++rr) {
                                    if (!nem1_bounds_check || i * Br + r * 4u + rr < p.nem1) {
                                        masks[rr] = ACC_TYPE(data_m[m_offset + (i * Br + r * 4u + rr) * m_stride + kcol]);
                                    }
                                }
                            }
                        } else if (USE_SPARSE) {
                            masks = ACC_TYPEV4(NEG_FLT_MAX_OVER_2);
                        }
                        const ACC_TYPEV4 slopes = ACC_TYPEV4(slope[r * 4u], slope[r * 4u + 1u], slope[r * 4u + 2u], slope[r * 4u + 3u]);
                        sfsh[c * sfshstride + r] += slopes * masks;
                    }
                }
            }
            barrier();
        }

        // Single-pass sfsh read -> online softmax -> Psh_s & sh_eMf write (first 4 subgroups = 128 threads)
        if (gl_SubgroupID < 4u) {
            [[unroll]] for (uint32_t r4 = 0u; r4 < sm_rows_per_th; r4 += 4u) {
                const uint32_t r_vec = tile_row(r4) / 4u;
                vec4 sf_reg[sm_cols_per_th];
                vec4 rowmax4 = vec4(NEG_FLT_MAX_OVER_2);
                [[unroll]] for (uint32_t c = 0u; c < sm_cols_per_th; ++c) {
                    const uint32_t col = c * 32u + col_tid;
                    if (!KV_bounds_check || j * Bc + col < KV) {
                        sf_reg[c] = vec4(sfsh[col * sfshstride + r_vec]);
                        rowmax4 = max(rowmax4, sf_reg[c]);
                    } else {
                        sf_reg[c] = vec4(0.0);
                    }
                }
                rowmax4 += vec4(FATTN_KQ_MAX_OFFSET);
                [[unroll]] for (uint32_t v = 0u; v < 4u; ++v) {
                    const uint32_t r = r4 + v;
                    const float Moldf = Mf[r];
                    const float rmax  = subgroupMax(rowmax4[v]);
                    Mf[r] = max(rmax, Moldf);
                    const float eM = exp(Moldf - Mf[r]);
                    Lf[r] = eM * Lf[r];
                    if (col_tid == 0u) {
                        sh_eMf[tile_row(r)] = eM;
                    }
                }
                const vec4 mfvec = vec4(Mf[r4], Mf[r4 + 1u], Mf[r4 + 2u], Mf[r4 + 3u]);
                const uint32_t base_row = tile_row(r4);
                [[unroll]] for (uint32_t c = 0u; c < sm_cols_per_th; ++c) {
                    const uint32_t col = c * 32u + col_tid;
                    FLOAT_TYPEV4 Pf = FLOAT_TYPEV4(0.0);
                    if (!KV_bounds_check || j * Bc + col < KV) {
                        Pf = FLOAT_TYPEV4(exp(sf_reg[c] - mfvec));
                        [[unroll]] for (uint32_t v = 0u; v < 4u; ++v) {
                            Lf[r4 + v] += float(Pf[v]);
                        }
                    }
                    [[unroll]] for (uint32_t v = 0u; v < 4u; ++v) {
                        Psh_s[(base_row + v) * psh_s_stride + col] = Pf[v];
                    }
                }
            }
        }
        barrier(); // Barrier #2: Psh_s & sh_eMf ready; sfsh reads finished for next j

        // Rescale OfMat directly in registers (both elements in lane belong to row cm_r)
        const uint32_t lane = gl_SubgroupInvocationID;
        const uint32_t cm_r = ((lane >> 1u) & 3u) | ((lane >> 2u) & 4u);
        const float eM0 = sh_eMf[cm_r];
        const float eM1 = sh_eMf[8u + cm_r];
        [[unroll]] for (uint32_t ht = 0u; ht < num_hsv_tiles; ++ht) {
            [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                OfMat[ht][0][n][0] *= eM0;
                OfMat[ht][0][n][1] *= eM0;
                OfMat[ht][1][n][0] *= eM1;
                OfMat[ht][1][n][1] *= eM1;
            }
        }

        const bool stage_v_block = (SHMEM_STAGING != 0u) || USE_SPARSE ||
                                   (KV_bounds_check && (j * Bc + Bc > KV || ((v_offset | v_stride) & 3u) != 0u));
        const uint32_t n_sub_passes = (num_sg + 3u) / 4u;

        [[unroll]] for (uint32_t bc_chunk = 0u; bc_chunk < Bc / MatBc; ++bc_chunk) {
            [[unroll]] for (uint32_t dk = 0u; dk < 2u; ++dk) {
                [[unroll]] for (uint32_t m = 0u; m < 2u; ++m) {
                    coopMatLoad(KMatP[m], Psh_s, (m * 8u) * psh_s_stride + bc_chunk * MatBc + dk * 8u, psh_s_stride, gl_CooperativeMatrixLayoutRowMajor);
                }
                [[unroll]] for (uint32_t hsv_tile = 0u; hsv_tile < num_hsv_tiles; ++hsv_tile) {
                    const uint32_t hsv_offset = (hsv_tile * num_sg + gl_SubgroupID) * 16u;
                    const bool hsv_tile_partial = (hsv_tile * MatBc * num_sg + MatBc * num_sg) > HSV;
                    const bool stage_v_now = stage_v_block || hsv_tile_partial;
                    if (!stage_v_now) {
                        if (hsv_offset < HSV_pad) {
                            const uint32_t v_tile_row = j * Bc + bc_chunk * MatBc + dk * 8u;
                            [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                                const uint32_t v_tile_offset = v_offset / 4u + v_tile_row * (v_stride / 4u) + hsv_offset / 4u + n * 2u;
                                coopMatLoad(QMat[n], data_vv4, v_tile_offset, v_stride / 4u, gl_CooperativeMatrixLayoutRowMajor);
                            }
                            [[unroll]] for (uint32_t m = 0u; m < 2u; ++m) {
                                [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                                    OfMat[hsv_tile][m][n] = coopMatMulAdd(KMatP[m], QMat[n], OfMat[hsv_tile][m][n]);
                                }
                            }
                        }
                    } else {
                        [[unroll]] for (uint32_t sp = 0u; sp < n_sub_passes; ++sp) {
                            barrier();
                            if (tid < 128u) {
                                const uint32_t r8  = tid >> 4u;
                                const uint32_t c16 = tid & 15u;
                                const uint32_t v_col = (hsv_tile * num_sg + sp * 4u) * 16u + c16 * 4u;
                                FLOAT_TYPEV4 V_Tf = FLOAT_TYPEV4(0.0);
                                uint32_t v_row;
                                if (v_col < HSV && fa_kv_index(j * Bc + bc_chunk * MatBc + dk * 8u + r8, v_row)) {
                                    const uint32_t elem_idx = v_offset + v_row * v_stride + v_col;
                                    if ((elem_idx & 3u) == 0u) {
                                        V_Tf = data_vv4[elem_idx >> 2u];
                                    } else {
                                        V_Tf = FLOAT_TYPEV4(data_v[elem_idx + 0u], data_v[elem_idx + 1u],
                                                            data_v[elem_idx + 2u], data_v[elem_idx + 3u]);
                                    }
                                }
                                kvsh[tid] = V_Tf;
                            }
                            barrier();
                            if ((gl_SubgroupID / 4u) == sp && hsv_offset < HSV_pad) {
                                [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                                    const uint32_t v_tile_offset = (gl_SubgroupID & 3u) * 4u + n * 2u;
                                    coopMatLoad(QMat[n], kvsh, v_tile_offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
                                }
                                [[unroll]] for (uint32_t m = 0u; m < 2u; ++m) {
                                    [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                                        OfMat[hsv_tile][m][n] = coopMatMulAdd(KMatP[m], QMat[n], OfMat[hsv_tile][m][n]);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (gl_SubgroupID < 4u) {
        [[unroll]] for (uint32_t r = 0u; r < sm_rows_per_th; ++r) {
            Lf[r] = subgroupAdd(Lf[r]);
        }

        if (p.k_num > 1u) {
            if (col_tid == 0u) {
                [[unroll]] for (uint32_t r = 0u; r < sm_rows_per_th; ++r) {
                    sh_eMf[tile_row(r)] = 1.0f;
                }
            }
            if (p.gqa_ratio > 1u) {
                const uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2u * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3));
                [[unroll]] for (uint32_t r = 0u; r < sm_rows_per_th; ++r) {
                    if (tile_row(r) < N) {
                        perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Lf[r]), lm_offset, iq2, N);
                        perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Mf[r]), lm_offset + p.ne1, iq2, N);
                    }
                }
            } else {
                [[unroll]] for (uint32_t r = 0u; r < sm_rows_per_th; ++r) {
                    const uint32_t global_row = i * Br + tile_row(r);
                    if (global_row < N && col_tid == 0u) {
                        const uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2u * (split_k_index + p.k_num * (global_row + p.ne2 * iq3));
                        data_o[lm_offset + iq2] = D_TYPE(Lf[r]);
                        data_o[lm_offset + p.ne1 + iq2] = D_TYPE(Mf[r]);
                    }
                }
            }
        } else {
            [[unroll]] for (uint32_t r = 0u; r < sm_rows_per_th; ++r) {
                float ms = 1.0f;
                if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0u) {
                    const float sink = perElemOpGetSink(tile_row(r), 0u, ACC_TYPE(0), iq2);
                    float vs = 1.0f;
                    if (sink > Mf[r]) {
                        ms = exp(Mf[r] - sink);
                    } else {
                        vs = exp(sink - Mf[r]);
                    }
                    Lf[r] = Lf[r] * ms + vs;
                }
                if (col_tid == 0u) {
                    sh_eMf[tile_row(r)] = (Lf[r] == 0.0f) ? 0.0f : (ms / Lf[r]);
                }
            }
        }
    }

    const uint32_t o_base_dense  = (gqa_iq1 * p.ne1 * HSV + iq3 * p.ne2 * p.ne1 * HSV) / 4u;
    const uint32_t o_base_sk_gqa = HSV * p.ne1 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3)) / 4u;
    const uint32_t n_sub_passes  = (num_sg + 3u) / 4u;

    [[unroll]] for (uint32_t hsv_tile = 0u; hsv_tile < num_hsv_tiles; ++hsv_tile) {
        const uint32_t hsv_offset = (hsv_tile * num_sg + gl_SubgroupID) * 16u;
        [[unroll]] for (uint32_t sp = 0u; sp < n_sub_passes; ++sp) {
            barrier();
            if ((gl_SubgroupID / 4u) == sp && hsv_offset < HSV_pad) {
                const uint32_t o_offset_sh = (gl_SubgroupID & 3u) * 4u;
                [[unroll]] for (uint32_t m = 0u; m < 2u; ++m) {
                    [[unroll]] for (uint32_t n = 0u; n < 2u; ++n) {
                        coopMatStore(OfMat[hsv_tile][m][n], sfsh, o_offset_sh + m * 8u * osh_stride + n * 2u, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                }
            }
            barrier();
            if (gl_SubgroupID < 4u && col_tid < 16u) {
                const uint32_t d = (hsv_tile * num_sg + sp * 4u) * 4u + col_tid;
                if (d < HSV / 4u) {
                    [[unroll]] for (uint32_t r = 0u; r < sm_rows_per_th; ++r) {
                        const uint32_t row = tile_row(r);
                        O_TYPEV4 out_v = sfsh[row * osh_stride + col_tid] * O_TYPE(sh_eMf[row]);
#if defined(FLOAT_TYPE_MAX)
                        if (p.k_num <= 1u) {
                            out_v = clamp(out_v, -O_TYPE(FLOAT_TYPE_MAX), O_TYPE(FLOAT_TYPE_MAX));
                        }
#endif
                        if (p.k_num > 1u) {
                            if (p.gqa_ratio > 1u) {
                                if (row < N) {
                                    gqaStore(row, d, out_v, o_base_sk_gqa, iq2, N);
                                }
                            } else {
                                const uint32_t global_row = i * Br + row;
                                if (global_row < N) {
                                    const uint32_t o_off = HSV * p.ne1 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3)) / 4u;
                                    data_ov4[o_off + iq2 * (HSV / 4u) + d] = D_TYPEV4(out_v);
                                }
                            }
                        } else if (p.gqa_ratio > 1u) {
                            if (row < N) {
                                gqaStore(row, d, out_v, o_base_dense, iq2, N);
                            }
                        } else {
                            const uint32_t global_row = i * Br + row;
                            if (global_row < N) {
                                data_ov4[o_base_dense + (iq2 * HSV + global_row * p.ne1 * HSV) / 4u + d] = D_TYPEV4(out_v);
                            }
                        }
                    }
                }
            }
        }
    }
}

#else // !(defined(COOPMAT_8X8) && !defined(BFLOAT16))

shared float tmpsh[row_split];

const uint32_t qstride = HSK_pad / 4 + 2;
shared FLOAT_TYPEV4 Qf[Q_IN_REGS ? 1 : (Br * qstride)];

const uint psh_stride = Br / 4 + 2;
const uint32_t qchunk_dtiles = 4;
const uint32_t qchunk_stride = qchunk_dtiles * 16 / 4 + 2;
const uint32_t psh_size = Bc * psh_stride;
const uint32_t qchunk_size = Q_IN_REGS ? Br * qchunk_stride : 0;
shared FLOAT_TYPEV4 Psh[psh_size >= qchunk_size ? psh_size : qchunk_size];

// Avoid padding for hsk==256 to make it fit in 48KB shmem.
const uint32_t sfshstride = (HSK <= 128) ? (Br / 4 + 2) : Br / 4;
shared ACC_TYPEV4 sfsh[Bc * sfshstride];

const uint32_t D_pad = HSK_pad > HSV_pad ? HSK_pad : HSV_pad;
const uint32_t kvsh_stride = (SHMEM_STAGING != 0 ? D_pad : MatBr) / 4 + 2;
const uint v_cols = MatBc / 4 * row_split; // total cols, 4 vec4s per MatBc * number of subgroups
const uint vsh_stride = v_cols;
shared FLOAT_TYPEV4 kvsh[(kvsh_stride >= vsh_stride) ? (Bc * kvsh_stride) : (Bc * vsh_stride)];

shared ACC_TYPE slope[Br];

// row-tiled builds stage the PV result through sfsh
const uint32_t osh_stride = row_split * MatBr / 4;
shared O_TYPEV4 pvsh[q_tiles > 1 ? 2 : Br * osh_stride];

shared vec4 occupancy_limiter[LIMIT_OCCUPANCY_SHMEM > 0 ? LIMIT_OCCUPANCY_SHMEM : 1];
#if defined(FLOAT16) && !defined(ACC_TYPE_MAX)
const uint32_t pv_per_acc = 2;
O_TYPEV4 pvsh_load(const uint32_t i) {
    if (q_tiles == 1) {
        return pvsh[i];
    }
    const uvec2 u = floatBitsToUint(vec2(sfsh[i / 2][(i % 2) * 2], sfsh[i / 2][(i % 2) * 2 + 1]));
    return O_TYPEV4(unpackFloat2x16(u.x), unpackFloat2x16(u.y));
}
#else
const uint32_t pv_per_acc = 1;
O_TYPEV4 pvsh_load(const uint32_t i) {
    if (q_tiles == 1) {
        return pvsh[i];
    }
    return O_TYPEV4(sfsh[i]);
}
#endif

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    if (fa_type_needs_shmem(FaTypeK) || fa_type_needs_shmem(FaTypeV)) {
        init_iq_shmem(gl_WorkGroupSize);
    }
#endif

    init_indices();

    const uint32_t tid = gl_LocalInvocationIndex;

    const uint32_t threads_per_rowgroup = gl_WorkGroupSize.x / row_split;
    const uint32_t d_per_thread = (HSV/4 + threads_per_rowgroup - 1) / threads_per_rowgroup;
    const uint32_t row_tid = gl_LocalInvocationIndex / threads_per_rowgroup;
    const uint32_t col_tid = gl_LocalInvocationIndex % threads_per_rowgroup;

    if (LIMIT_OCCUPANCY_SHMEM > 0) {
        // Runtime-dependent index, otherwise RADV forwards the store and drops the array
        const uint32_t li = (gl_WorkGroupID.x * gl_WorkGroupSize.x + tid) % LIMIT_OCCUPANCY_SHMEM;
        occupancy_limiter[li] = vec4(tid);
        barrier();
        const uint32_t lr = (li + 1) % LIMIT_OCCUPANCY_SHMEM;
        if (occupancy_limiter[lr] == vec4(99999.0)) {
            data_ov4[0] = D_TYPEV4(occupancy_limiter[lr]);
        }
    }

#define tile_row(r) (row_tid * rows_per_thread + (r))

    const uint32_t d_tiles = HSK_pad / 16;

    uint32_t q_offset = gqa_iq1*p.nb01 + (iq2*p.nb02+iq3*p.nb03) / 4;

    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBr, gl_MatrixUseB> Qreg[Q_IN_REGS ? (d_tiles * q_tiles) : 1];

    if (Q_IN_REGS) {
        [[unroll]] for (uint32_t dbase = 0; dbase < d_tiles; dbase += qchunk_dtiles) {
            [[unroll]] for (uint32_t idx = 0; idx < Br * qchunk_dtiles * 16 / 4; idx += gl_WorkGroupSize.x) {
                uint32_t dvec = (idx + tid) % (qchunk_dtiles * 16 / 4);
                uint32_t r = (idx + tid) / (qchunk_dtiles * 16 / 4);
                if (r < Br) {
                    uint32_t d = dbase * 4 + dvec;
                    FLOAT_TYPEV4 val = FLOAT_TYPEV4(0);
                    if (d < HSK / 4 && i * Br + r < N) {
                        val = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d] * p.scale);
                    }
                    Psh[r * qchunk_stride + dvec] = val;
                }
            }
            barrier();
            [[unroll]] for (uint32_t dd = 0; dd < qchunk_dtiles && dbase + dd < d_tiles; ++dd) {
                [[unroll]] for (uint32_t q = 0; q < q_tiles; ++q) {
                    coopMatLoad(Qreg[(dbase + dd) * q_tiles + q], Psh, dd * 16 / 4 + q * MatBr * qchunk_stride, qchunk_stride, gl_CooperativeMatrixLayoutColumnMajor);
                }
            }
            barrier();
        }
    } else {
        // Zero-initialize Qf when HSK is not a multiple of 16 (HSK_pad > HSK) or N is partial.
        if ((HSK % 16) != 0 || i * Br + Br > N) {
            [[unroll]] for (uint ii = 0; ii < Br * qstride; ii += gl_WorkGroupSize.x) {
                if (ii + tid < Br * qstride) {
                    Qf[ii + tid] = FLOAT_TYPEV4(0);
                }
            }
            barrier();
        }

        [[unroll]] for (uint32_t idx = 0; idx < Br * HSK / 4; idx += gl_WorkGroupSize.x) {
            uint32_t d = (idx + tid) % (HSK / 4);
            uint32_t r = (idx + tid) / (HSK / 4);
            if (r < Br && d < HSK / 4 &&
                i * Br + r < N) {
                Qf[r * qstride + d] = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d] * p.scale);
            }
        }
        barrier();
    }

    O_TYPEV4 Of[rows_per_thread][d_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        [[unroll]] for (uint32_t d = 0; d < d_per_thread; ++d) {
            Of[r][d] = O_TYPEV4(0.0);
        }
    }

    float Lf[rows_per_thread], Mf[rows_per_thread];


    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = 0;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    // ALiBi
    if (p.max_bias > 0.0f) {
        if (tid < Br) {
            uint r = tid;
            slope[r] = perElemOpComputeSlope(r, col_tid, ACC_TYPE(0), iq2);
        }
    } else {
        if (tid < Br) {
            uint r = tid;
            slope[r] = ACC_TYPE(1.0);
        }
    }

    const uint32_t mo_stride = CEIL_DIV(KV, 16 * Bc);
    // mo_offset will point to the tile starting at row i*Br and col 0
    uint32_t mo_offset = mo_stride * i;

    // FaBlockBytesK/V == 2 for f16 (sizeof f16) and == 16 for f32 (vec4) and == ggml block size for quants.
    uint32_t k_offset = (ik2*p.nb12 + ik3*p.nb13) / FaBlockBytesK;
    uint32_t v_offset = (iv2*p.nb22 + iv3*p.nb23) / FaBlockBytesV;
    uint32_t m_offset = gqa_iq1*KV;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
        mo_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * CEIL_DIV(p.nem1, Br) * mo_stride;
    }

    uint32_t mask_opt = 0;
    uint32_t mask_opt_idx = ~0;
    uint32_t mask_opt_bits = 0;
    f16vec4 mask_cache[Bc * Br / 4 / WorkGroupSize];

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {

        [[unroll]] for (uint32_t idx = 0; idx < mask_cache.length(); ++idx) {
            mask_cache[idx] = f16vec4(0);
        }

        if (MASK_ENABLE) {
            if (USE_MASK_OPT && mask_opt_idx != j / 16) {
                mask_opt_idx = j / 16;
                mask_opt = data_mask_opt[mo_offset + mask_opt_idx];
            }
            mask_opt_bits = (mask_opt >> ((j % 16) * 2)) & 0x3;
            if (mask_opt_bits == MASK_OPT_ALL_NEG_INF) {
                // skip this block
                continue;
            }
            // Only load if the block is not all zeros
            if (mask_opt_bits != MASK_OPT_ALL_ZERO) {
                bool nem1_bounds_check = !(p.gqa_ratio > 1) && (p.nem1 % Br) != 0;

                float max_mask = NEG_FLT_MAX_OVER_2;
                [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t c = (idx + tid) / (Br / 4);
                    uint32_t r = (idx + tid) % (Br / 4);
                    if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                        uint32_t kcol;
                        bool kv_active = fa_kv_index(j * Bc + c, kcol);
                        if (kv_active) {
                            f16vec4 m;
                            if (USE_SPARSE) {
                                // sparse is gqa-gated (m_stride == 0): all four rows share the value
                                FLOAT_TYPE mv = FLOAT_TYPE(data_m[m_offset + kcol]);
                                m = f16vec4(mv);
                                max_mask = max(max_mask, float(mv));
                            } else if (!nem1_bounds_check || i * Br + r * 4 + 3 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 2) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 3) * m_stride + (j * Bc + c)]);
                                max_mask = max(max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2])), float(m[3]));
                            } else if (i * Br + r * 4 + 2 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 2) * m_stride + (j * Bc + c)],
                                            0.0);
                                max_mask = max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2]));
                            } else if (i * Br + r * 4 + 1 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            0.0,
                                            0.0);
                                max_mask = max(max(max_mask, float(m[0])), float(m[1]));
                            } else if (i * Br + r * 4 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            0.0,
                                            0.0,
                                            0.0);
                                max_mask = max(max_mask, float(m[0]));
                            } else {
                                m = f16vec4(0.0);
                            }
                            mask_cache[idx / WorkGroupSize] = m;
                        } else if (USE_SPARSE) {
                            mask_cache[idx / WorkGroupSize] = f16vec4(NEG_FLT16_MAX);
                        }
                    }
                }
                // skip the block if the mask is entirely -inf
                bool all_less = subgroupAll(max_mask <= NEG_FLT_MAX_OVER_2);
                barrier();
                if (gl_SubgroupInvocationID == 0) {
                    tmpsh[gl_SubgroupID] = all_less ? NEG_FLT_MAX_OVER_2 : 0.0f;
                }
                barrier();
                [[unroll]] for (uint s = 0; s < gl_NumSubgroups; ++s) {
                    max_mask = max(max_mask, tmpsh[s]);
                }
                if (max_mask <= NEG_FLT_MAX_OVER_2) {
                    continue;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSK_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSK_pad / 4);
                uint32_t c = (idx + tid) / (HSK_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSK_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                    uint32_t kcol;
                    bool kv_active = fa_kv_index(j * Bc + c, kcol);
                    if (kv_active && (HSK == HSK_pad || d < HSK / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_K) {
                            uint coord = kcol * k_stride * BLOCK_SIZE_K + 4 * d;
                            uint ib = coord / BLOCK_SIZE_K;
                            uint iqs = (coord % BLOCK_SIZE_K);
                            K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                        } else
#endif
                        {
                            K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + kcol * k_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = K_Tf;
                }
            }
            barrier();
        }

        // K * Q^T -> S^T: Bc x HSK_pad * HSK_pad x Br -> Bc x Br
        // Bc split across workgroup (four subgroups), loop over HSK in chunks of 16: 16 x 16 * 16 x 16 -> 16 x 16
        // This is written transposed in order to allow for N being 8 if implementations need it
#ifdef COOPMAT_8X8
        coopmat<ACC_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> SfMat[2][2];
        [[unroll]] for (uint32_t m = 0; m < 2; ++m) {
            [[unroll]] for (uint32_t n = 0; n < 2; ++n) {
                SfMat[m][n] = coopmat<ACC_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
            }
        }
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> KMat[2];
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> QMat[2];
#else
        // No coopmat arrays: AMD's Windows compiler crashes on loop-indexed ones. q_tiles <= 2.
        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat0 = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat1 = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> KMat;
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBr, gl_MatrixUseB> QMat;
#endif

        [[unroll]] for (uint32_t d = 0; d < d_tiles; ++d) {
            // If SHMEM_STAGING is set, a Bc * HSK_pad size tile of K is loaded to shmem
            // If not, K is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatBr size staging buffer.
            // If K is a quant type, then it is always staged for dequantization.
            const bool stage_k = USE_DECODE_K || KV_bounds_check || USE_SPARSE || d * 16 + 16 > HSK;
            if (SHMEM_STAGING == 0) {
            // For quants we always need to dequant into kvsh; for f16/bf16 we can load
            // directly from global memory when alignment / bounds allow it.
            if (stage_k) {
                barrier();
                [[unroll]] for (uint32_t idx = 0; idx < Bc * MatBr / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t col_vec = (idx + tid) % (MatBr / 4);
                    uint32_t row = (idx + tid) / (MatBr / 4);
                    if (idx + tid < Bc * MatBr / 4) {
                        FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                        uint32_t kcol;
                        bool kv_active = fa_kv_index(j * Bc + row, kcol);
                        if (kv_active && (HSK == HSK_pad || d * 16 + col_vec * 4 < HSK)) {
#if !defined(BFLOAT16)
                            if (USE_DECODE_K) {
                                uint coord = kcol * k_stride * BLOCK_SIZE_K + d * 16 + col_vec * 4;
                                uint ib = coord / BLOCK_SIZE_K;
                                uint iqs = (coord % BLOCK_SIZE_K);
                                K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                            } else
#endif
                            {
                                K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + kcol * k_stride / 4 + d * 16 / 4 + col_vec]);
                            }
                        }

                        kvsh[row * kvsh_stride + col_vec] = K_Tf;
                    }
                }
                barrier();
            }
#ifdef COOPMAT_8X8
            }
            [[unroll]] for (uint32_t dk = 0; dk < 2; ++dk) {
                [[unroll]] for (uint32_t m = 0; m < 2; ++m) {
                    if (SHMEM_STAGING == 0) {
                        if (stage_k) {
                            uint coord = (gl_SubgroupID * MatBc + m * 8) * kvsh_stride + dk * 2;
                            coopMatLoad(KMat[m], kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                        } else {
                            const uint coord = k_offset / 4 + (j * Bc + gl_SubgroupID * MatBc + m * 8) * (k_stride / 4) + d * 4 + dk * 2;
                            coopMatLoad(KMat[m], data_kv4, coord, k_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                        }
                    } else {
                        uint coord = (gl_SubgroupID * MatBc + m * 8) * kvsh_stride + d * 4 + dk * 2;
                        coopMatLoad(KMat[m], kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                }
                [[unroll]] for (uint32_t n = 0; n < 2; ++n) {
                    coopMatLoad(QMat[n], Qf, d * 4 + n * 8 * qstride + dk * 2, qstride, gl_CooperativeMatrixLayoutColumnMajor);
                }
                [[unroll]] for (uint32_t m = 0; m < 2; ++m) {
                    [[unroll]] for (uint32_t n = 0; n < 2; ++n) {
                        SfMat[m][n] = coopMatMulAdd(KMat[m], QMat[n], SfMat[m][n]);
                    }
                }
            }
#else
            if (stage_k) {
                uint coord = (gl_SubgroupID * MatBc) * kvsh_stride;
                coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                const uint coord = k_offset / 4 + (j * Bc + gl_SubgroupID * MatBc) * k_stride / 4 + d * 16 / 4;
                coopMatLoad(KMat, data_kv4, coord, k_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
            }
            } else {
                uint coord = (gl_SubgroupID * MatBc) * kvsh_stride + d * 16 / 4;
                coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
            }

            if (Q_IN_REGS) {
                SfMat0 = coopMatMulAdd(KMat, Qreg[d * q_tiles], SfMat0);
                if (q_tiles > 1) {
                    SfMat1 = coopMatMulAdd(KMat, Qreg[d * q_tiles + 1], SfMat1);
                }
            } else {
                coopMatLoad(QMat, Qf, d * 16 / 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
                SfMat0 = coopMatMulAdd(KMat, QMat, SfMat0);
                if (q_tiles > 1) {
                    coopMatLoad(QMat, Qf, d * 16 / 4 + MatBr * qstride, qstride, gl_CooperativeMatrixLayoutColumnMajor);
                    SfMat1 = coopMatMulAdd(KMat, QMat, SfMat1);
                }
            }
#endif
        }

#ifdef COOPMAT_8X8
        [[unroll]] for (uint32_t m = 0; m < 2; ++m) {
            [[unroll]] for (uint32_t n = 0; n < 2; ++n) {
                uint coord = (gl_SubgroupID * MatBc + m * 8) * sfshstride + n * 2;
                coopMatStore(SfMat[m][n], sfsh, coord, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
#else
        coopMatStore(SfMat0, sfsh, gl_SubgroupID * MatBc * sfshstride, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
        if (q_tiles > 1) {
            coopMatStore(SfMat1, sfsh, gl_SubgroupID * MatBc * sfshstride + MatBr / 4, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
        }
#endif
        barrier();

        if (LOGIT_SOFTCAP) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    sfsh[c * sfshstride + r] = ACC_TYPEV4(p.logit_softcap * tanh(sfsh[c * sfshstride + r]));
                }
            }
            barrier();
        }

        if (MASK_ENABLE && mask_opt_bits != MASK_OPT_ALL_ZERO) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    if (!KV_bounds_check || j * Bc + c < KV) {
                        // Mask nem1 bounds check is handled when loading masks
                        ACC_TYPEV4 masks = ACC_TYPEV4(mask_cache[idx / WorkGroupSize]);
                        ACC_TYPEV4 slopes = ACC_TYPEV4(slope[r * 4], slope[r * 4 + 1], slope[r * 4 + 2], slope[r * 4 + 3]);
                        sfsh[c * sfshstride + r] += slopes * masks;
                    }
                }
            }
            barrier();
        }

        float eMf[rows_per_thread];
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint r_vec  = tile_row(r) / 4;
            const uint r_comp = tile_row(r) % 4;

            float rowmaxf = NEG_FLT_MAX_OVER_2;
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                if (KV_bounds_check && j * Bc + c * cols_per_iter + col_tid >= KV) {
                    continue;
                }
                rowmaxf = max(rowmaxf, float(sfsh[r_vec + (c * cols_per_iter + col_tid) * sfshstride][r_comp]));
            }
            rowmaxf += FATTN_KQ_MAX_OFFSET;
            float Moldf = Mf[r];

            // Compute max across the row
            rowmaxf = subgroupMax(rowmaxf);

            // M = max(rowmax, Mold)
            // P = e^(S - M)
            // eM = e^(Mold - M)
            Mf[r] = max(rowmaxf, Moldf);
            eMf[r] = exp(Moldf - Mf[r]);

            Lf[r] = eMf[r]*Lf[r];
        }

        [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
            const uint d_local = d0 / threads_per_rowgroup;
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                Of[r][d_local] = O_TYPE(eMf[r]) * Of[r][d_local];
            }
        }

        // Calculate and store Pf in Psh
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            const uint col = c * cols_per_iter + col_tid;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; r += 4) {
                const uint row = tile_row(r);
                if (KV_bounds_check && j * Bc + col >= KV) {
                    Psh[col * psh_stride + row / 4] = FLOAT_TYPEV4(0.0f);
                } else {
                    const vec4 mfvec = vec4(Mf[r], Mf[r + 1], Mf[r + 2], Mf[r + 3]);
                    const FLOAT_TYPEV4 Pf = FLOAT_TYPEV4(exp(vec4(sfsh[row / 4 + col * sfshstride]) - mfvec));
                    [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                        Lf[r + vec_idx] += Pf[vec_idx];
                    }
                    Psh[col * psh_stride + row / 4] = Pf;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSV_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSV_pad / 4);
                uint32_t c = (idx + tid) / (HSV_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSV_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 V_Tf = FLOAT_TYPEV4(0);
                    uint32_t v_row;
                    bool kv_active = fa_kv_index(j * Bc + c, v_row);
                    if (kv_active && (HSV == HSV_pad || d < HSV / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            uint coord = v_row * v_stride * BLOCK_SIZE_V + 4 * d;
                            uint ib = coord / BLOCK_SIZE_V;
                            uint iqs = (coord % BLOCK_SIZE_V);
                            V_Tf = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            V_Tf = FLOAT_TYPEV4(data_vv4[v_offset / 4 + v_row * v_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = V_Tf;
                }
            }
        }
        barrier();

        const uint num_hsv_tiles = (HSV + MatBc * row_split - 1) / (MatBc * row_split); // round up

        // Each subgroup handles HSV/4 columns
        [[unroll]] for (uint32_t hsv_tile = 0; hsv_tile < num_hsv_tiles; ++hsv_tile) {
            const uint hsv_offset = (hsv_tile * row_split + gl_SubgroupID) * 16;

#ifdef COOPMAT_8X8
            coopmat<O_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> PVMat[2][2];
            [[unroll]] for (uint32_t m = 0; m < 2; ++m) {
                [[unroll]] for (uint32_t n = 0; n < 2; ++n) {
                    PVMat[m][n] = coopmat<O_TYPE, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
                }
            }
#else
            coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVMat0 = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
            coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVMat1 = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
#endif

            // Preload V tiles for [Bc, 16 * num subgroups]
            const uint v_rows = Bc;
            const uint v_total = v_rows * v_cols;
            const uint v_loads_per_thread = v_total / gl_WorkGroupSize.x;

            // If SHMEM_STAGING is set, a Bc * HSV_pad size tile of V is loaded to shmem.
            // If not, V is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatBr size staging buffer.
            // If V is a quant type, then it is always staged for dequantization.
            const bool hsv_partial = (hsv_tile * MatBc * row_split + MatBc * row_split) > HSV;
            if (SHMEM_STAGING == 0) {
            // For quants we always preload via kvsh. For f16/bf16 we only preload when
            // alignment / bounds force it (otherwise we coopMatLoad direct from data_vv4).
            const bool stage_v = USE_DECODE_V || KV_bounds_check || USE_SPARSE || hsv_partial;
            if (stage_v) {
                [[unroll]] for (uint32_t i = 0; i < v_loads_per_thread; ++i) {
                    const uint idx = i * gl_WorkGroupSize.x + tid;
                    const uint row = idx / v_cols;
                    const uint col = idx % v_cols;

                    uint32_t v_row;
                    bool kv_active = fa_kv_index(j * Bc + row, v_row);
                    const uint v_col = hsv_tile * MatBc * row_split + col * 4;

                    const uint coord = v_row * v_stride * BLOCK_SIZE_V + v_col;
                    const uint ib = coord / BLOCK_SIZE_V;
                    const uint iqs = coord % BLOCK_SIZE_V;

                    if (USE_SPARSE ? (kv_active && v_col < HSV) : (v_col < HSV && (!KV_bounds_check || v_row < KV))) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            kvsh[row * vsh_stride + col] = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            kvsh[row * vsh_stride + col] = data_vv4[(v_offset + v_row * v_stride + v_col) / 4];
                        }
                    } else {
                        kvsh[row * vsh_stride + col] = FLOAT_TYPEV4(0.0f);
                    }
                }
            }
            }
            barrier();

            const uint o_offset = gl_SubgroupID * MatBr / 4;

            if (hsv_offset < HSV_pad) {
#ifdef COOPMAT_8X8
                [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                    [[unroll]] for (uint32_t dk = 0; dk < 2; ++dk) {
                        [[unroll]] for (uint32_t m = 0; m < 2; ++m) {
                            coopMatLoad(KMat[m], Psh, (bc_chunk * MatBc + dk * 8) * psh_stride + m * 2, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                        }
                        [[unroll]] for (uint32_t n = 0; n < 2; ++n) {
                            if (SHMEM_STAGING == 0) {
                                if (!USE_DECODE_V && !KV_bounds_check && !USE_SPARSE && !hsv_partial) {
                                    const uint v_tile_row = j * Bc + bc_chunk * MatBc + dk * 8;
                                    const uint v_tile_offset = v_offset / 4 + v_tile_row * (v_stride / 4) + hsv_offset / 4 + n * 2;
                                    coopMatLoad(QMat[n], data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                                } else {
                                    const uint v_tile_offset = (bc_chunk * MatBr + dk * 8) * v_cols + gl_SubgroupID * (MatBc / 4) + n * 2;
                                    coopMatLoad(QMat[n], kvsh, v_tile_offset, vsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                                }
                            } else {
                                const uint v_tile_offset = (bc_chunk * MatBc + dk * 8) * kvsh_stride + (hsv_tile * row_split + gl_SubgroupID) * (MatBc / 4) + n * 2;
                                coopMatLoad(QMat[n], kvsh, v_tile_offset, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                            }
                        }
                        [[unroll]] for (uint32_t m = 0; m < 2; ++m) {
                            [[unroll]] for (uint32_t n = 0; n < 2; ++n) {
                                PVMat[m][n] = coopMatMulAdd(KMat[m], QMat[n], PVMat[m][n]);
                            }
                        }
                    }
                }
                [[unroll]] for (uint32_t m = 0; m < 2; ++m) {
                    [[unroll]] for (uint32_t n = 0; n < 2; ++n) {
                        coopMatStore(PVMat[m][n], pvsh, o_offset + m * 8 * osh_stride + n * 2, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                }
#else
                [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                    if (SHMEM_STAGING == 0) {
                    if (!USE_DECODE_V && !KV_bounds_check && !USE_SPARSE && !hsv_partial) {
                        // F16/BF16 values can be loaded directly from global memory
                        const uint v_tile_row = j * Bc + bc_chunk * MatBc;
                        const uint v_tile_offset = v_offset / 4 + v_tile_row * v_stride / 4 + hsv_offset / 4;
                        coopMatLoad(QMat, data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                    } else {
                        const uint v_tile_offset = bc_chunk * MatBr * v_cols + gl_SubgroupID * (MatBc / 4);
                        coopMatLoad(QMat, kvsh, v_tile_offset, vsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                    } else {
                        const uint v_tile_offset = bc_chunk * MatBc * kvsh_stride + (hsv_tile * row_split + gl_SubgroupID) * (MatBc / 4);
                        coopMatLoad(QMat, kvsh, v_tile_offset, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }

                    coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                    PVMat0 = coopMatMulAdd(KMat, QMat, PVMat0);
                    if (q_tiles > 1) {
                        coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride + MatBc / 4, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                        PVMat1 = coopMatMulAdd(KMat, QMat, PVMat1);
                    }
                }

                if (q_tiles > 1) {
                    coopMatStore(PVMat0, sfsh, o_offset / pv_per_acc, osh_stride / pv_per_acc, gl_CooperativeMatrixLayoutRowMajor);
                    coopMatStore(PVMat1, sfsh, (o_offset + MatBc * osh_stride) / pv_per_acc, osh_stride / pv_per_acc, gl_CooperativeMatrixLayoutRowMajor);
                } else {
                    coopMatStore(PVMat0, pvsh, o_offset, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                }
#endif
            }

            barrier();

            const uint hsv_per_tile = row_split * MatBc;
            const uint hsv_base = hsv_tile * hsv_per_tile;
            const uint d_values_per_tile = hsv_per_tile / 4;

            const uint d_start = hsv_tile * d_values_per_tile;
            const uint d_end = min(d_start + d_values_per_tile, HSV / 4);

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);

                [[unroll]] for (uint32_t d_local = 0; d_local < d_per_thread; ++d_local) {
                    const uint d = d_local * threads_per_rowgroup + col_tid;
                    const uint hsv_col = 4 * d;

                    if (hsv_col >= hsv_base && hsv_col < hsv_base + hsv_per_tile && hsv_col < HSV) {
                        const uint local_hsv = (hsv_col - hsv_base) / 4;
                        Of[r][d_local] += pvsh_load(row * osh_stride + local_hsv);
                    }
                }
            }
        }

        barrier();
    }

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = subgroupAdd(Lf[r]);
    }

    // If there is split_k, then the split_k resolve shader does the final
    // division by L. Store the intermediate O value and per-row m and L values.
    if (p.k_num > 1) {
        if (p.gqa_ratio > 1) {
            // note: O and Q have swapped coord 1,2.
            uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3)) / 4;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                if (tile_row(r) < N) {
                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        const uint d_local = d0 / threads_per_rowgroup;
                        gqaStore(tile_row(r), d, Of[r][d_local], o_offset, iq2, N);
                    }
                }
            }

            o_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3));
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                if (tile_row(r) < N) {
                    perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Lf[r]), o_offset, iq2, N);
                    perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Mf[r]), o_offset + p.ne1, iq2, N);
                }
            }
        } else {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);
                const uint global_row = i * Br + row;

                if (global_row < N) {
                    uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3)) / 4;

                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        data_ov4[o_offset + iq2 * HSV/4 + d] = D_TYPEV4(Of[r][d/threads_per_rowgroup]);
                    }
                }

                if (global_row < N && col_tid == 0) {
                    uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3));
                    data_o[lm_offset + iq2] = D_TYPE(Lf[r]);
                    data_o[lm_offset + p.ne1 + iq2] = D_TYPE(Mf[r]);
                }
            }
        }

        return;
    }

    if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            float sink = perElemOpGetSink(tile_row(r), 0u, ACC_TYPE(0), iq2);

            float ms = 1.0f;
            float vs = 1.0f;

            if (sink > Mf[r]) {
                ms = exp(Mf[r] - sink);

                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d_local = d0 / threads_per_rowgroup;
                    Of[r][d_local] *= O_TYPE(ms);
                }
            } else {
                vs = exp(sink - Mf[r]);
            }

            Lf[r] = Lf[r]*ms + vs;
        }
    }

    float Lfrcp[rows_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lfrcp[r] = (Lf[r] == 0.0) ? 0.0 : (1.0 / Lf[r]);
    }

    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
        const uint d_local = d0 / threads_per_rowgroup;
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            Of[r][d_local] *= O_TYPE(Lfrcp[r]);
#if defined(FLOAT_TYPE_MAX)
            Of[r][d_local] = clamp(Of[r][d_local], -O_TYPE(FLOAT_TYPE_MAX), O_TYPE(FLOAT_TYPE_MAX));
#endif
        }
    }

    uint32_t o_offset = (gqa_iq1*p.ne1*HSV + iq3*p.ne2*p.ne1*HSV) / 4;

    if (p.gqa_ratio > 1) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (tile_row(r) < N) {
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    gqaStore(tile_row(r), d, Of[r][d_local], o_offset, iq2, N);
                }
            }
        }
    } else {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (i * Br + tile_row(r) < N) {
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    data_ov4[o_offset + (iq2 * HSV + (i * Br + tile_row(r)) * p.ne1 * HSV) / 4 + d] = D_TYPEV4(Of[r][d_local]);
                }
            }
        }
    }
}
#endif // defined(COOPMAT_8X8) && !defined(BFLOAT16)
