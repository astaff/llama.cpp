#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : enable
#if USE_SUBGROUP_CLUSTERED
#extension GL_KHR_shader_subgroup_clustered : enable
#endif
#if USE_SUBGROUP_ADD
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

// Caller guarantees valid spec constants: S_V % COLS_PER_WG == 0 and S_V % LANES_PER_COLUMN == 0,
// so no bounds checking is needed.
layout(constant_id = 0) const uint S_V = 128;
layout(constant_id = 1) const uint KDA = 0;
layout(constant_id = 2) const uint SUBGROUP_SIZE = 32;
layout(constant_id = 3) const uint LANES_PER_COLUMN = 32;
layout(constant_id = 4) const bool PACKED_ROWS = false;
layout(constant_id = 5) const uint REPLAY = 0;
layout(constant_id = 6) const uint COLS_PER_SUB = 1;
layout(constant_id = 7) const uint SUBGROUPS_PER_WG = 1;
layout(constant_id = 8) const uint CONTIG_VEC4 = 0;

const uint COLS_PER_SUB_STEP = SUBGROUP_SIZE / LANES_PER_COLUMN;
const uint COLS_PER_WG = COLS_PER_SUB_STEP * SUBGROUPS_PER_WG;
const uint ROWS_PER_LANE = S_V / LANES_PER_COLUMN;

uint row_index(uint r, uint lane) {
    // Keep four adjacent rows together in each lane.
    if (PACKED_ROWS) {
        return (r / 4u * LANES_PER_COLUMN + lane) * 4u + r % 4u;
    }
    return r * LANES_PER_COLUMN + lane;
}

layout(local_size_x_id = 2, local_size_y_id = 7, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint H;
    uint n_tokens;
    uint n_seqs;
    uint s_off;
    uint sq1, sq2, sq3;
    uint sk1, sk2, sk3;
    uint sv1, sv2, sv3;
    uint sb1, sb2, sb3;
    uint neq1, rq3;
    float scale;
    uint K;
    uint n_pend, keep;
    uint spk1, spk2, spk3;
    uint spv1, spv2, spv3;
    uint spg1, spg2, spg3;
    uint sout_nb2;
};

layout(binding = 0) readonly  buffer QBuf     { FLOAT_TYPE data_q[];     };
layout(binding = 0) readonly  buffer QBufV4   { vec4       data_q_v4[];  };
layout(binding = 1) readonly  buffer KBuf     { FLOAT_TYPE data_k[];     };
layout(binding = 1) readonly  buffer KBufV4   { vec4       data_k_v4[];  };
layout(binding = 2) readonly  buffer VBuf     { FLOAT_TYPE data_v[];     };
layout(binding = 2) readonly  buffer VBufV4   { vec4       data_v_v4[];  };
layout(binding = 3) readonly  restrict buffer GBuf     { FLOAT_TYPE data_g[];     };
layout(binding = 4) readonly  restrict buffer BetaBuf  { FLOAT_TYPE data_beta[];  };
layout(binding = 5) readonly  buffer StateBuf   { FLOAT_TYPE data_state[];    };
layout(binding = 5) readonly  buffer StateBufV4 { vec4       data_state_v4[]; };
layout(binding = 6) writeonly buffer DstBuf     { FLOAT_TYPE data_dst[];      };
layout(binding = 6) writeonly buffer DstBufV4   { vec4       data_dst_v4[];   };
// replay: pending tokens to run before the new ones (see ggml_gated_delta_net_ext)
layout(binding = 7)  readonly buffer PKBuf    { FLOAT_TYPE data_pk[];    };
layout(binding = 8)  readonly buffer PVBuf    { FLOAT_TYPE data_pv[];    };
layout(binding = 9)  readonly buffer PGBBuf   { FLOAT_TYPE data_pgb[];   };
layout(binding = 10) readonly buffer NRepBuf  { int        data_n_rep[]; };
#if STATE_OUT
// gen: the final state goes straight to its destination (the recurrent cache row), not into dst
layout(binding = 11)          buffer StateOutBuf   { FLOAT_TYPE data_state_out[];    };
layout(binding = 11)          buffer StateOutBufV4 { vec4       data_state_out_v4[]; };
#endif

#if !USE_SUBGROUP_ADD && !USE_SUBGROUP_CLUSTERED
shared FLOAT_TYPE temp[SUBGROUP_SIZE];

// This does a reduction across groups of LANES_PER_COLUMN
FLOAT_TYPE reduce_add_shmem(FLOAT_TYPE partial) {
    const uint lane = gl_SubgroupInvocationID;
    temp[lane] = partial;
    barrier();
    [[unroll]] for (uint s = LANES_PER_COLUMN / 2u; s > 0; s >>= 1u) {
        FLOAT_TYPE other = temp[lane ^ s];
        barrier();
        temp[lane] += other;
        barrier();
    }
    const FLOAT_TYPE result = temp[lane];
    barrier();
    return result;
}
#endif

// clusterSize for subgroupClusteredAdd must be a compile-time constant; branch on spec constant
FLOAT_TYPE reduce_partial(FLOAT_TYPE partial) {
    switch (LANES_PER_COLUMN) {
        case 1u:
            return partial;
#if USE_SUBGROUP_CLUSTERED
        // Workaround for GLSL requiring a literal constant for the cluster size.
        // The branches should all fold away.
        case 2u:
            return subgroupClusteredAdd(partial, 2u);
        case 4u:
            return subgroupClusteredAdd(partial, 4u);
        case 8u:
            return subgroupClusteredAdd(partial, 8u);
        case 16u:
            return subgroupClusteredAdd(partial, 16u);
        case 32u:
            return subgroupClusteredAdd(partial, 32u);
        case 64u:
            return subgroupClusteredAdd(partial, 64u);
#endif
        default:
#if USE_SUBGROUP_ADD
            return subgroupAdd(partial);
#else
            return reduce_add_shmem(partial);
#endif
    }
}

void main() {
    const uint head_id = gl_WorkGroupID.x;
    const uint seq_id = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID % LANES_PER_COLUMN;
    const uint col_base = (gl_WorkGroupID.z * COLS_PER_SUB) * COLS_PER_WG + gl_LocalInvocationID.y * COLS_PER_SUB_STEP + (gl_SubgroupInvocationID / LANES_PER_COLUMN);

    const uint iq1 = head_id % neq1;
    const uint iq3 = seq_id / rq3;

    const uint state_size = S_V * S_V;
    // input state holds s0 only [S_v, S_v, H, n_seqs]: per-seq stride is H*D.
    const uint state_in_base       = (seq_id * H + head_id) * state_size;
    // output state layout per slot: same per-(seq,head) offset as the single-slot case.
    const uint state_out_base      = (seq_id * H + head_id) * state_size;
    const uint state_size_per_snap = state_size * H * n_seqs;
    const bool zero_state          = (K & 0x80000000u) != 0u;
    const uint eff_K               = K & 0x7FFFFFFFu;

#if USE_SUBGROUP_ADD
    if (REPLAY == 0u && CONTIG_VEC4 != 0u && KDA == 0u && ROWS_PER_LANE == 4u && LANES_PER_COLUMN == 32u && (COLS_PER_SUB == 4u || COLS_PER_SUB == 2u) &&
        sq1 == sk1 && sq2 == sk2 && sq3 == sk3) {
        const bool qk_v4_ok = ((sq1 & 3u) == 0u) && ((sq2 & 3u) == 0u) && ((sq3 & 3u) == 0u);
        const bool v_v4_ok  = (COLS_PER_SUB == 4u) && (COLS_PER_WG == 1u) && ((sv1 & 3u) == 0u) && ((sv2 & 3u) == 0u) && ((sv3 & 3u) == 0u) && ((col_base & 3u) == 0u);
        const bool st_v4_ok = ((sout_nb2 & 3u) == 0u) && ((s_off & 3u) == 0u);
        vec4 s0 = vec4(0.0f), s1 = vec4(0.0f), s2 = vec4(0.0f), s3 = vec4(0.0f);
        if (!zero_state) {
            s0 = data_state_v4[((state_in_base + (col_base + 0u * COLS_PER_WG) * S_V) >> 2u) + lane];
            s1 = data_state_v4[((state_in_base + (col_base + 1u * COLS_PER_WG) * S_V) >> 2u) + lane];
            if (COLS_PER_SUB == 4u) {
                s2 = data_state_v4[((state_in_base + (col_base + 2u * COLS_PER_WG) * S_V) >> 2u) + lane];
                s3 = data_state_v4[((state_in_base + (col_base + 3u * COLS_PER_WG) * S_V) >> 2u) + lane];
            }
        }

        uint attn_off = (seq_id * n_tokens * H + head_id) * S_V;
        uint q_off    = iq3 * sq3 + iq1 * sq1;
        uint v_off    = seq_id * sv3 + head_id * sv1;
        uint gb_off   = seq_id * sb3 + head_id * sb1;
        for (uint t = 0u; t < n_tokens; ++t) {
            const float beta_val = data_beta[gb_off];
            const float g_val    = exp(data_g[gb_off]);

            const vec4 k_vec = qk_v4_ok
                ? data_k_v4[(q_off >> 2u) + lane]
                : vec4(data_k[q_off + 4u * lane + 0u], data_k[q_off + 4u * lane + 1u], data_k[q_off + 4u * lane + 2u], data_k[q_off + 4u * lane + 3u]);
            const vec4 q_vec = qk_v4_ok
                ? data_q_v4[(q_off >> 2u) + lane]
                : vec4(data_q[q_off + 4u * lane + 0u], data_q[q_off + 4u * lane + 1u], data_q[q_off + 4u * lane + 2u], data_q[q_off + 4u * lane + 3u]);

            if (COLS_PER_SUB == 4u) {
                vec4 attn_cols;
                if (CONTIG_VEC4 >= 2u) {
                    const vec4 kv_sh = vec4(
                        dot(s0, k_vec),
                        dot(s1, k_vec),
                        dot(s2, k_vec),
                        dot(s3, k_vec)
                    ) * g_val;
                    const vec4 sq_sh = vec4(
                        dot(s0, q_vec),
                        dot(s1, q_vec),
                        dot(s2, q_vec),
                        dot(s3, q_vec)
                    );
                    const float kq_sh   = dot(k_vec, q_vec);
                    const vec4  kv_cols = subgroupAdd(kv_sh);
                    const vec4  sq_cols = subgroupAdd(sq_sh);
                    const float kq_dot  = subgroupAdd(kq_sh);
                    const vec4  v_cols  = v_v4_ok
                        ? data_v_v4[(v_off + col_base) >> 2u]
                        : vec4(data_v[v_off + col_base], data_v[v_off + col_base + COLS_PER_WG], data_v[v_off + col_base + 2u * COLS_PER_WG], data_v[v_off + col_base + 3u * COLS_PER_WG]);
                    const vec4 delta = (v_cols - kv_cols) * beta_val;
                    attn_cols = fma(vec4(g_val), sq_cols, delta * kq_dot) * scale;
                    s0 = fma(vec4(g_val), s0, k_vec * delta.x);
                    s1 = fma(vec4(g_val), s1, k_vec * delta.y);
                    s2 = fma(vec4(g_val), s2, k_vec * delta.z);
                    s3 = fma(vec4(g_val), s3, k_vec * delta.w);
                } else {
                    vec4 kv_sh = vec4(
                        dot(s0, k_vec),
                        dot(s1, k_vec),
                        dot(s2, k_vec),
                        dot(s3, k_vec)
                    ) * g_val;
                    const vec4 kv_cols = subgroupAdd(kv_sh);
                    const vec4 v_cols  = v_v4_ok
                        ? data_v_v4[(v_off + col_base) >> 2u]
                        : vec4(data_v[v_off + col_base], data_v[v_off + col_base + COLS_PER_WG], data_v[v_off + col_base + 2u * COLS_PER_WG], data_v[v_off + col_base + 3u * COLS_PER_WG]);
                    const vec4 delta = (v_cols - kv_cols) * beta_val;
                    s0 = fma(vec4(g_val), s0, k_vec * delta.x);
                    s1 = fma(vec4(g_val), s1, k_vec * delta.y);
                    s2 = fma(vec4(g_val), s2, k_vec * delta.z);
                    s3 = fma(vec4(g_val), s3, k_vec * delta.w);

                    attn_cols = subgroupAdd(vec4(
                        dot(s0, q_vec),
                        dot(s1, q_vec),
                        dot(s2, q_vec),
                        dot(s3, q_vec)
                    )) * scale;
                }
                if (COLS_PER_WG == 1u && ((col_base & 3u) == 0u)) {
                    if (lane == 0u) {
                        data_dst_v4[(attn_off + col_base) >> 2u] = attn_cols;
                    }
                } else if (lane < 4u) {
                    data_dst[attn_off + col_base + lane * COLS_PER_WG] = attn_cols[lane];
                }
            } else {
                vec2 attn_cols;
                if (CONTIG_VEC4 >= 2u) {
                    const vec2  kv_sh   = vec2(dot(s0, k_vec), dot(s1, k_vec)) * g_val;
                    const vec2  sq_sh   = vec2(dot(s0, q_vec), dot(s1, q_vec));
                    const float kq_sh   = dot(k_vec, q_vec);
                    const vec2  kv_cols = subgroupAdd(kv_sh);
                    const vec2  sq_cols = subgroupAdd(sq_sh);
                    const float kq_dot  = subgroupAdd(kq_sh);
                    const vec2  v_cols  = vec2(data_v[v_off + col_base], data_v[v_off + col_base + COLS_PER_WG]);
                    const vec2  delta   = (v_cols - kv_cols) * beta_val;
                    attn_cols = fma(vec2(g_val), sq_cols, delta * kq_dot) * scale;
                    s0 = fma(vec4(g_val), s0, k_vec * delta.x);
                    s1 = fma(vec4(g_val), s1, k_vec * delta.y);
                } else {
                    vec2 kv_sh = vec2(dot(s0, k_vec), dot(s1, k_vec)) * g_val;
                    const vec2 kv_cols = subgroupAdd(kv_sh);
                    const vec2 v_cols  = vec2(data_v[v_off + col_base], data_v[v_off + col_base + COLS_PER_WG]);
                    const vec2 delta   = (v_cols - kv_cols) * beta_val;
                    s0 = fma(vec4(g_val), s0, k_vec * delta.x);
                    s1 = fma(vec4(g_val), s1, k_vec * delta.y);

                    attn_cols = subgroupAdd(vec2(dot(s0, q_vec), dot(s1, q_vec))) * scale;
                }
                if (lane < 2u) {
                    data_dst[attn_off + col_base + lane * COLS_PER_WG] = attn_cols[lane];
                }
            }

            attn_off += S_V * H;
            q_off    += sq2;
            v_off    += sv2;
            gb_off   += sb2;

            if (eff_K > 1u) {
                const int target_slot = int(n_tokens) - 1 - int(t);
                if (target_slot >= 0 && target_slot < int(eff_K)) {
                    for (uint c = 0u; c < COLS_PER_SUB; ++c) {
                        const vec4 sv = (c == 0u) ? s0 : ((c == 1u) ? s1 : ((c == 2u) ? s2 : s3));
                        const uint col = col_base + c * COLS_PER_WG;
#if STATE_OUT
                        const uint slot_base = uint(target_slot) * sout_nb2 + state_out_base;
                        if (st_v4_ok) {
                            data_state_out_v4[((slot_base + col * S_V) >> 2u) + lane] = sv;
                        } else {
                            const uint b = slot_base + col * S_V + 4u * lane;
                            data_state_out[b + 0u] = sv.x; data_state_out[b + 1u] = sv.y;
                            data_state_out[b + 2u] = sv.z; data_state_out[b + 3u] = sv.w;
                        }
#else
                        const uint slot_base = s_off + uint(target_slot) * state_size_per_snap + state_out_base;
                        if (st_v4_ok) {
                            data_dst_v4[((slot_base + col * S_V) >> 2u) + lane] = sv;
                        } else {
                            const uint b = slot_base + col * S_V + 4u * lane;
                            data_dst[b + 0u] = sv.x; data_dst[b + 1u] = sv.y;
                            data_dst[b + 2u] = sv.z; data_dst[b + 3u] = sv.w;
                        }
#endif
                    }
                }
            }
        }

        if (eff_K == 1u) {
            for (uint c = 0u; c < COLS_PER_SUB; ++c) {
                const vec4 sv = (c == 0u) ? s0 : ((c == 1u) ? s1 : ((c == 2u) ? s2 : s3));
                const uint col = col_base + c * COLS_PER_WG;
#if STATE_OUT
                data_state_out_v4[((state_out_base + col * S_V) >> 2u) + lane] = sv;
#else
                if (st_v4_ok) {
                    data_dst_v4[((s_off + state_out_base + col * S_V) >> 2u) + lane] = sv;
                } else {
                    const uint b = s_off + state_out_base + col * S_V + 4u * lane;
                    data_dst[b + 0u] = sv.x; data_dst[b + 1u] = sv.y;
                    data_dst[b + 2u] = sv.z; data_dst[b + 3u] = sv.w;
                }
#endif
            }
        }
        return;
    }
#endif

    FLOAT_TYPE s_shard[COLS_PER_SUB * ROWS_PER_LANE];
    if (zero_state) {
        [[unroll]] for (uint idx_s = 0; idx_s < COLS_PER_SUB * ROWS_PER_LANE; idx_s++) {
            s_shard[idx_s] = FLOAT_TYPE(0.0);
        }
    } else {
        [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
            const uint col = col_base + c * COLS_PER_WG;
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                s_shard[c * ROWS_PER_LANE + r] = FLOAT_TYPE(data_state[state_in_base + col * S_V + row_index(r, lane)]);
            }
        }
    }

    if (REPLAY != 0) {
        const uint n_r = uint(clamp(data_n_rep[seq_id], 0, int(n_pend)));

        for (uint t = 0; t < n_r; t++) {
            const uint k_off = seq_id * spk3 + t * spk2 + iq1 * spk1;
            const uint v_off = seq_id * spv3 + t * spv2 + head_id * spv1;
            const uint g_off = seq_id * spg3 + t * spg2 + head_id * spg1;
            const FLOAT_TYPE beta_val = FLOAT_TYPE(data_pgb[g_off + n_pend * spg2]);

            FLOAT_TYPE k_reg[ROWS_PER_LANE];
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                k_reg[r] = FLOAT_TYPE(data_pk[k_off + row_index(r, lane)]);
            }

            FLOAT_TYPE g_exp[ROWS_PER_LANE];
            if (KDA == 0) {
                const FLOAT_TYPE g_val = exp(FLOAT_TYPE(data_pgb[g_off]));
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    g_exp[r] = g_val;
                }
            } else {
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    g_exp[r] = exp(FLOAT_TYPE(data_pgb[g_off + row_index(r, lane)]));
                }
            }

            [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                const uint col = col_base + c * COLS_PER_WG;
                const uint sb = c * ROWS_PER_LANE;
                const FLOAT_TYPE v_val = FLOAT_TYPE(data_pv[v_off + col]);

                // same update as below, without the attention output
                FLOAT_TYPE kv_shard = 0.0;
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    kv_shard += g_exp[r] * s_shard[sb + r] * k_reg[r];
                }
                FLOAT_TYPE kv_col = reduce_partial(kv_shard);

                FLOAT_TYPE delta_col = (v_val - kv_col) * beta_val;

                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    s_shard[sb + r] = g_exp[r] * s_shard[sb + r] + k_reg[r] * delta_col;
                }
            }
        }

        if (keep != 0) {
            [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                const uint col = col_base + c * COLS_PER_WG;
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    data_dst[s_off + state_out_base + col * S_V + row_index(r, lane)] = s_shard[c * ROWS_PER_LANE + r];
                }
            }
        }
    }

    // snapshot slot mapping: slot 0 = most recent state, slot s = s tokens back.
    // When n_tokens < K, only slots 0..n_tokens-1 are written; older slots are caller-owned.

    uint attn_off = (seq_id * n_tokens * H + head_id) * S_V;

    for (uint t = 0; t < n_tokens; t++) {
        const uint q_off = iq3 * sq3 + t * sq2 + iq1 * sq1;
        const uint k_off = iq3 * sk3 + t * sk2 + iq1 * sk1;
        const uint v_off = seq_id * sv3 + t * sv2 + head_id * sv1;
        const uint gb_off = seq_id * sb3 + t * sb2 + head_id * sb1;
        const FLOAT_TYPE beta_val = FLOAT_TYPE(data_beta[gb_off]);

        FLOAT_TYPE k_reg[ROWS_PER_LANE];
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            const uint i = row_index(r, lane);
            k_reg[r] = FLOAT_TYPE(data_k[k_off + i]);
        }

        if (KDA == 0) {
            const FLOAT_TYPE g_val = exp(FLOAT_TYPE(data_g[gb_off]));
            FLOAT_TYPE kv_shards[COLS_PER_SUB];
            [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                const uint sb = c * ROWS_PER_LANE;
                FLOAT_TYPE kv_shard = 0.0;
                if (COLS_PER_SUB == 1u) {
                    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                        kv_shard += g_val * s_shard[sb + r] * k_reg[r];
                    }
                    kv_shards[c] = kv_shard;
                } else {
                    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                        kv_shard += s_shard[sb + r] * k_reg[r];
                    }
                    kv_shards[c] = kv_shard * g_val;
                }
            }
            FLOAT_TYPE kv_cols[COLS_PER_SUB];
            [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                kv_cols[c] = reduce_partial(kv_shards[c]);
            }
            [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                const uint col = col_base + c * COLS_PER_WG;
                const uint sb = c * ROWS_PER_LANE;
                const FLOAT_TYPE delta_col = (FLOAT_TYPE(data_v[v_off + col]) - kv_cols[c]) * beta_val;
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    s_shard[sb + r] = g_val * s_shard[sb + r] + k_reg[r] * delta_col;
                }
            }
        } else {
            FLOAT_TYPE g_exp[ROWS_PER_LANE];
            const uint g_base = gb_off * S_V;
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                const uint i = row_index(r, lane);
                g_exp[r] = exp(FLOAT_TYPE(data_g[g_base + i]));
            }
            [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                const uint col = col_base + c * COLS_PER_WG;
                const uint sb = c * ROWS_PER_LANE;
                const FLOAT_TYPE v_val = FLOAT_TYPE(data_v[v_off + col]);

                FLOAT_TYPE kv_shard = 0.0;
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    kv_shard += g_exp[r] * s_shard[sb + r] * k_reg[r];
                }
                FLOAT_TYPE kv_col = reduce_partial(kv_shard);
                FLOAT_TYPE delta_col = (v_val - kv_col) * beta_val;

                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    s_shard[sb + r] = g_exp[r] * s_shard[sb + r] + k_reg[r] * delta_col;
                }
            }
        }

        if (COLS_PER_SUB == 1u) {
            FLOAT_TYPE attn_partial = 0.0;
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                const uint i = row_index(r, lane);
                attn_partial += s_shard[r] * FLOAT_TYPE(data_q[q_off + i]);
            }
            FLOAT_TYPE attn_col = reduce_partial(attn_partial);

            if (lane == 0) {
                data_dst[attn_off + col_base] = attn_col * scale;
            }
        } else {
            FLOAT_TYPE q_reg[ROWS_PER_LANE];
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                const uint i = row_index(r, lane);
                q_reg[r] = FLOAT_TYPE(data_q[q_off + i]);
            }

            FLOAT_TYPE attn_partials[COLS_PER_SUB];
            [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                const uint sb = c * ROWS_PER_LANE;
                FLOAT_TYPE attn_partial = 0.0;
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    attn_partial += s_shard[sb + r] * q_reg[r];
                }
                attn_partials[c] = attn_partial;
            }
            [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                const FLOAT_TYPE attn_col = reduce_partial(attn_partials[c]);
                if (lane == 0) {
                    const uint col = col_base + c * COLS_PER_WG;
                    data_dst[attn_off + col] = attn_col * scale;
                }
            }
        }

        attn_off += S_V * H;

        if (eff_K > 1u) {
            const int target_slot = int(n_tokens) - 1 - int(t);
            if (target_slot >= 0 && target_slot < int(eff_K)) {
#if STATE_OUT
                const uint slot_base = uint(target_slot) * sout_nb2 + state_out_base;
                [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                    const uint col = col_base + c * COLS_PER_WG;
                    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                        data_state_out[slot_base + col * S_V + row_index(r, lane)] = s_shard[c * ROWS_PER_LANE + r];
                    }
                }
#else
                const uint slot_base = s_off + uint(target_slot) * state_size_per_snap + state_out_base;
                [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
                    const uint col = col_base + c * COLS_PER_WG;
                    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                        data_dst[slot_base + col * S_V + row_index(r, lane)] = s_shard[c * ROWS_PER_LANE + r];
                    }
                }
#endif
            }
        }
    }

    // replay with keep: the state output is the state after the replay
    if (eff_K == 1u && !(REPLAY != 0 && keep != 0)) {
        [[unroll]] for (uint c = 0; c < COLS_PER_SUB; c++) {
            const uint col = col_base + c * COLS_PER_WG;
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
#if STATE_OUT
                data_state_out[state_out_base + col * S_V + row_index(r, lane)] = s_shard[c * ROWS_PER_LANE + r];
#else
                data_dst[s_off + state_out_base + col * S_V + row_index(r, lane)] = s_shard[c * ROWS_PER_LANE + r];
#endif
            }
        }
    }
}
