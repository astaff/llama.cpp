#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

struct block_q8_0_u16 {
    float16_t d;
    uint16_t  qs16[16];
};

layout(binding = 0) readonly  buffer BufA   { float          data_a[];    };
layout(binding = 0) readonly  buffer BufAV4 { vec4           data_a_v4[]; };
layout(binding = 1) readonly  buffer BufB   { float          data_b[];    };
layout(binding = 2) writeonly buffer BufDQ8 { block_q8_0_u16 data_d_q8[]; };
layout(binding = 3) readonly  buffer BufIdx { uvec2          data_i[];    };

layout(push_constant) uniform PushConstants {
    uint  ne;
    uint  ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
    uint  ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
    uint  ne20; uint ne21; uint ne22; uint ne23; uint nb20; uint nb21; uint nb22; uint nb23;
    uint  misalign_offsets;
    float param1;
    float param2;
    int   param3;
} p;

void main() {
    const uint ncols     = p.ne00;
    const uint nchannels = p.ne02;
    const uint nsamples  = p.ne03;
    const uint row       = gl_WorkGroupID.x;
    const uint tid       = gl_LocalInvocationID.x;

    const uint a_misalign = p.misalign_offsets >> 16u;
    const uint p3         = uint(p.param3);
    const uint i_misalign = p3 >> 16u;
    const bool v4_ok      = (p3 & 0x8000u) != 0u;
    const uint d_blk_off  = p3 & 0x7FFFu;
    const uint n_blks     = ncols >> 5u;

    for (uint samp = gl_WorkGroupID.z; samp < nsamples; samp += gl_NumWorkGroups.z) {
        for (uint channel = gl_WorkGroupID.y; channel < nchannels; channel += gl_NumWorkGroups.y) {
            const uint a_offset = samp * p.nb03 + channel * p.nb02 + row * p.nb01 + a_misalign;
            float sum_sq = 0.0f;
            if (v4_ok && ncols == 128u) {
                const vec4 xv = data_a_v4[(a_offset >> 2u) + tid];
                sum_sq = subgroupAdd(dot(xv, xv));
            } else {
                for (uint col = tid; col < ncols; col += 32u) {
                    const float x = data_a[a_offset + col];
                    sum_sq += x * x;
                }
                sum_sq = subgroupAdd(sum_sq);
            }
            const float scale = inversesqrt(sum_sq / float(ncols) + p.param1);
            const uint dst_blk_base = data_i[i_misalign + channel].x * p.nb21 + row * n_blks + d_blk_off;

            for (uint b = 0u; b < n_blks; ++b) {
                const float out_v = scale * data_a[a_offset + (b << 5u) + tid];
                const float amax  = subgroupMax(abs(out_v));
                const float d     = amax / 127.0f;
                const float id    = (d != 0.0f) ? (1.0f / d) : 0.0f;
                const uint  qlo   = uint(int(round(out_v * id))) & 0xFFu;
                const uint  qhi   = subgroupShuffleXor(qlo, 1u);
                const uint  bi    = dst_blk_base + b;
                if (tid == 0u) {
                    data_d_q8[bi].d = float16_t(d);
                }
                if ((tid & 1u) == 0u) {
                    data_d_q8[bi].qs16[tid >> 1u] = uint16_t(qlo | (qhi << 8u));
                }
            }
        }
    }
}
