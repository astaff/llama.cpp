#ifdef MULMAT_QUANT
uint mm_load_vec_a() {
    if (AGX_DIRECT_STORE == 1u) {
        switch (MmTypeA) {
        case GGML_TYPE_Q1_0:
        case GGML_TYPE_Q4_0:
        case GGML_TYPE_Q4_1:
        case GGML_TYPE_Q5_1:
            return 8u;
        case GGML_TYPE_Q2_0:
        case GGML_TYPE_Q5_0:
        case GGML_TYPE_Q8_0:
        case GGML_TYPE_Q2_K:
        case GGML_TYPE_Q4_K:
        case GGML_TYPE_Q5_K:
            return 4u;
        default:
            return 2u;
        }
    }
    switch (MmTypeA) {
    case GGML_TYPE_Q8_0:
    case GGML_TYPE_Q4_K:
    case GGML_TYPE_Q5_K:
    case GGML_TYPE_Q6_K:
        return 16u;
    case GGML_TYPE_Q1_0:
    case GGML_TYPE_Q4_0:
    case GGML_TYPE_Q4_1:
    case GGML_TYPE_Q5_1:
        return 8u;
    case GGML_TYPE_Q2_0:
    case GGML_TYPE_Q5_0:
    case GGML_TYPE_Q2_K:
        return 4u;
    default:
        return 2u;
    }
}
#endif

