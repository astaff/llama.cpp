void main() {
#ifdef MUL_MAT_ID
    const uint tile_idx = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    if (tile_idx >= data_row_map[0]) {
        return;
    }
    const uint expert_idx = data_row_map[1 + 2 * tile_idx];
    const uint row_begin = tile_idx * BN;
    _ne1 = data_row_map[2 + 2 * tile_idx];
    const uint ic = 0;
#else
    const uint group_idx = gl_WorkGroupID.x;
#ifndef MM_FUSED
    uint stream_k_work_unit;
    uint stream_k_work_unit_end;

    if (stream_k) {
        stream_k_work_unit = group_idx * p.work_units_per_group + min(group_idx, p.groups_with_extra_unit);
        stream_k_work_unit_end = stream_k_work_unit + p.work_units_per_group + uint(group_idx < p.groups_with_extra_unit);
    }
#endif
#endif
#if defined(NEEDS_INIT_IQ_SHMEM) || defined(MULMAT_QUANT)
    init_iq_shmem(gl_WorkGroupSize);
#endif

    const uint BM_EFF = (MM_FUSE_MODE == 2u) ? (BM / 2u) : BM;
    const uint WM_EFF = (MM_FUSE_MODE == 2u) ? (WM / 2u) : WM;

#ifdef MUL_MAT_ID
    const uint blocks_m = (p.M + BM_EFF - 1) / BM_EFF;
    const uint ir = gl_WorkGroupID.x % blocks_m;
    const uint ik = gl_WorkGroupID.x / blocks_m;
    const bool pair_use_u = false;
    const uint ir_mem     = ir;
    const uint m_lim      = p.M;
#endif

#ifdef COOPMAT
    const uint warp_i = gl_SubgroupID;

    const uint tiw = gl_SubgroupInvocationID;

    const uint cms_per_row = WM / TM;
    const uint cms_per_col = WN / TN;

    const uint storestride = WARP / TM;
    const uint store_r = tiw % TM;
    const uint store_c = tiw / TM;
#else
    const uint WNITER = (WM * WN) / (WARP * TM * TN * WMITER);
    const uint WSUBM = WM / WMITER;
    const uint WSUBN = WN / WNITER;

    const uint warp_i = gl_LocalInvocationID.x / WARP;

    const uint tiw = gl_LocalInvocationID.x % WARP;

    const uint tiwr = tiw % (WSUBM / TM);
    const uint tiwc = tiw / (WSUBM / TM);
#endif

    const uint warp_r = warp_i % (BM / WM);
    const uint warp_c = warp_i / (BM / WM);

#if defined(DATA_A_F32) || defined(DATA_A_F16) || defined(DATA_A_BF16)
    const uint LOAD_VEC_A_EFF = (ALIGNED != 0) ? LOAD_VEC_A : 1;
    const uint LOAD_VEC_BATCH_A = (ALIGNED != 0) ? 1 : 2;
#elif !defined(MULMAT_QUANT)
    const uint LOAD_VEC_A_EFF = LOAD_VEC_A;
    const uint LOAD_VEC_BATCH_A = 1;
#else
    const uint LOAD_VEC_A_EFF = mm_load_vec_a();
    const uint LOAD_VEC_BATCH_A = 1;
#endif
    const uint LOAD_VEC_B_EFF = (ALIGNED != 0) ? LOAD_VEC_B : 1;
    const uint LOAD_VEC_BATCH_B = (ALIGNED != 0) ? 1 : 2;

    const uint loadr_a = gl_LocalInvocationID.x % (BK / LOAD_VEC_A_EFF / LOAD_VEC_BATCH_A);
    const uint loadc_a = gl_LocalInvocationID.x / (BK / LOAD_VEC_A_EFF / LOAD_VEC_BATCH_A);
    const uint loadr_b = gl_LocalInvocationID.x % (BK / LOAD_VEC_B_EFF / LOAD_VEC_BATCH_B);
    const uint loadc_b = gl_LocalInvocationID.x / (BK / LOAD_VEC_B_EFF / LOAD_VEC_BATCH_B);

    const uint loadstride_a = BLOCK_SIZE * LOAD_VEC_A_EFF * LOAD_VEC_BATCH_A / BK;
    const uint loadstride_b = BLOCK_SIZE * LOAD_VEC_B_EFF * LOAD_VEC_BATCH_B / BK;

#ifndef MUL_MAT_ID
#ifdef MM_FUSED
    const uint blocks_m = (p.M + BM_EFF - 1) / BM_EFF;
    const uint ic = gl_WorkGroupID.y;
    const uint batch_idx = gl_WorkGroupID.z + p.base_work_group_z;
    const uint ir = group_idx % blocks_m;
    const uint ik = group_idx / blocks_m;

    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;
    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;
    const uint batch_idx_a = i03 * p.ne02 + i02;

    const bool pair_use_u = (MM_FUSE_MODE == 3u) && (ir * BM_EFF >= p.pair_m0);
    const uint ir_mem     = pair_use_u ? (ir - (p.pair_m0 / BM_EFF)) : ir;
    const uint m_lim      = (MM_FUSE_MODE == 3u) ? (pair_use_u ? (p.M - p.pair_m0) : p.pair_m0) : p.M;
#else
    do {
    uint stream_k_tile_k_unit;
    uint stream_k_tile_k_units;
    uint ir;
    uint ic;
    uint batch_idx;
    uint ik;

    if (stream_k) {
        const uint tile_idx = fastdiv(stream_k_work_unit, p.k_units_mp, fastdiv_L(p.div_Ls0, 0));
        stream_k_tile_k_unit = stream_k_work_unit - tile_idx * p.k_units_per_tile;
        stream_k_tile_k_units = min(stream_k_work_unit_end - stream_k_work_unit, p.k_units_per_tile - stream_k_tile_k_unit);

        const uint blocks_m = p.M / BM;
        const uint blocks_n = p.N / BN;
        const uint outer_tile = fastdiv(tile_idx, p.blocks_m_mp, fastdiv_L(p.div_Ls0, 1));
        ir = tile_idx - outer_tile * blocks_m;
        batch_idx = fastdiv(outer_tile, p.blocks_n_mp, fastdiv_L(p.div_Ls0, 2));
        ic = outer_tile - batch_idx * blocks_n;
    } else {
        const uint blocks_m = (p.M + BM - 1) / BM;
        ic = gl_WorkGroupID.y;
        batch_idx = gl_WorkGroupID.z + p.base_work_group_z;
        ir = group_idx % blocks_m;
        ik = group_idx / blocks_m;
    }

    const uint i13 = fastdiv(batch_idx, p.ne12_mp, fastdiv_L(p.div_Ls1, 0));
    const uint i12 = batch_idx - i13 * p.ne12;
    const uint i03 = fastdiv(i13, p.broadcast3_mp, fastdiv_L(p.div_Ls1, 2));
    const uint i02 = fastdiv(i12, p.broadcast2_mp, fastdiv_L(p.div_Ls1, 1));
    const uint batch_idx_a = i03 * p.ne02 + i02;

    const bool pair_use_u = false;
    const uint ir_mem     = ir;
    const uint m_lim      = p.M;
#endif
#endif

#ifdef MUL_MAT_ID
    load_row_ids(row_begin);
    uint required_warp_c = (_ne1 + WN - 1) / WN;
#endif

#ifdef MUL_MAT_ID
    const uint start_k = 0;
    const uint end_k = p.K;
#elif defined(MM_FUSED)
    const uint start_k = ik * p.k_split;
    const uint end_k = min(p.K, (ik + 1) * p.k_split);
#else
    uint start_k;
    uint end_k;
    if (stream_k) {
        start_k = stream_k_tile_k_unit * 256;
        end_k = (stream_k_tile_k_unit + stream_k_tile_k_units) * 256;
    } else {
        start_k = ik * p.k_split;
        end_k = min(p.K, (ik + 1) * p.k_split);
    }
#endif

    uint pos_a =
#ifdef MUL_MAT_ID
        expert_idx * (p.batch_stride_a / LOAD_VEC_A_EFF) +
#else
        batch_idx_a * (p.batch_stride_a / LOAD_VEC_A_EFF) +
#endif
        (ir_mem * BM_EFF * p.stride_a + start_k) / LOAD_VEC_A_EFF;
#ifdef MUL_MAT_ID
    uint pos_b = 0;
#else
    uint pos_b = (batch_idx * p.batch_stride_b + ic * BN * p.stride_b + start_k) / LOAD_VEC_B_EFF;
#endif

#ifdef COOPMAT
    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cache_a;
    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> cache_b_arr[cms_per_col];
    coopmat<ACC_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> sums[cms_per_row * cms_per_col];

    [[unroll]] for (uint i = 0; i < cms_per_row * cms_per_col; i++) {
        sums[i] = coopmat<ACC_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0f);
    }
#else
    ACC_TYPEV2 sums[WMITER * TM * WNITER * TN/2];
#if defined(DATA_A_F32) || defined(DATA_A_F16)
    FLOAT_TYPEV4 cache_a[WMITER * TM];
    FLOAT_TYPEV4 cache_b;
#else
    FLOAT_TYPEV2 cache_a[WMITER * TM];
    FLOAT_TYPEV2 cache_b;
#endif

    [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN/2; i++) {
        sums[i] = ACC_TYPEV2(0.0f, 0.0f);
    }
#endif

#ifdef COOPMAT
    bool use_sw_pipe = false;
#if (defined(DATA_A_F32) || defined(DATA_A_F16)) && LOAD_VEC_A == 4
    const uint MAX_STAGE_A = 4u;
#else
    const uint MAX_STAGE_A = 2u;
#endif
    if (AGX_DIRECT_STORE != 1u) {
        if (ALIGNED != 0) {
            if (mm_can_stage_a()) {
                if (LOAD_VEC_B == 8 || LOAD_VEC_B == 4) {
                    if (BM <= MAX_STAGE_A * loadstride_a && BN <= 2u * loadstride_b) {
                        use_sw_pipe = true;
                    }
                }
            }
        }
    }
    if (use_sw_pipe) {
#ifdef MUL_MAT_ID
        const uint active_cols_b = min(BN, ((required_warp_c * WN) + 7u) & ~7u);
#endif
        for (uint block = start_k; block < end_k; block += BK) {
            FLOAT_TYPEV2 reg_a0[8];
            FLOAT_TYPEV2 reg_a1[8];
#if (defined(DATA_A_F32) || defined(DATA_A_F16)) && LOAD_VEC_A == 4
            FLOAT_TYPEV2 reg_a2[8];
            FLOAT_TYPEV2 reg_a3[8];
#endif
            FLOAT_TYPEV2 reg_b0[4];
            FLOAT_TYPEV2 reg_b1[4];
#ifdef MUL_MAT_ID
            [[unroll]] for (uint bi = 0u; bi < 4u; ++bi) {
                reg_b0[bi] = FLOAT_TYPEV2(0.0f);
                reg_b1[bi] = FLOAT_TYPEV2(0.0f);
            }
#endif

            if (loadstride_a <= BM || loadc_a < BM) {
                const uint c_sh0 = loadc_a;
#ifdef MM_FUSED
                if (MM_FUSE_MODE == 2u && c_sh0 >= BM_EFF) {
                    const uint c_mem0 = c_sh0 - BM_EFF;
                    stage_u_to_reg(pos_a, loadr_a, c_sh0, c_mem0, ir * BM_EFF + c_mem0, block, end_k, reg_a0);
                } else if (pair_use_u) {
                    stage_u_to_reg(pos_a, loadr_a, c_sh0, c_sh0, ir * BM_EFF + c_sh0, block, end_k, reg_a0);
                } else
#endif
                {
                    stage_a_to_reg(pos_a, loadr_a, c_sh0, c_sh0, ir * BM_EFF + c_sh0, block, end_k, reg_a0);
                }
            }
            if (loadstride_a < BM && loadc_a + loadstride_a < BM) {
                const uint c_sh1 = loadc_a + loadstride_a;
#ifdef MM_FUSED
                if (MM_FUSE_MODE == 2u && c_sh1 >= BM_EFF) {
                    const uint c_mem1 = c_sh1 - BM_EFF;
                    stage_u_to_reg(pos_a, loadr_a, c_sh1, c_mem1, ir * BM_EFF + c_mem1, block, end_k, reg_a1);
                } else if (pair_use_u) {
                    stage_u_to_reg(pos_a, loadr_a, c_sh1, c_sh1, ir * BM_EFF + c_sh1, block, end_k, reg_a1);
                } else
#endif
                {
                    stage_a_to_reg(pos_a, loadr_a, c_sh1, c_sh1, ir * BM_EFF + c_sh1, block, end_k, reg_a1);
                }
            }
#if (defined(DATA_A_F32) || defined(DATA_A_F16)) && LOAD_VEC_A == 4
            if (2u * loadstride_a < BM && loadc_a + 2u * loadstride_a < BM) {
                const uint c_sh2 = loadc_a + 2u * loadstride_a;
#ifdef MM_FUSED
                if (MM_FUSE_MODE == 2u && c_sh2 >= BM_EFF) {
                    const uint c_mem2 = c_sh2 - BM_EFF;
                    stage_u_to_reg(pos_a, loadr_a, c_sh2, c_mem2, ir * BM_EFF + c_mem2, block, end_k, reg_a2);
                } else if (pair_use_u) {
                    stage_u_to_reg(pos_a, loadr_a, c_sh2, c_sh2, ir * BM_EFF + c_sh2, block, end_k, reg_a2);
                } else
#endif
                {
                    stage_a_to_reg(pos_a, loadr_a, c_sh2, c_sh2, ir * BM_EFF + c_sh2, block, end_k, reg_a2);
                }
            }
            if (3u * loadstride_a < BM && loadc_a + 3u * loadstride_a < BM) {
                const uint c_sh3 = loadc_a + 3u * loadstride_a;
#ifdef MM_FUSED
                if (MM_FUSE_MODE == 2u && c_sh3 >= BM_EFF) {
                    const uint c_mem3 = c_sh3 - BM_EFF;
                    stage_u_to_reg(pos_a, loadr_a, c_sh3, c_mem3, ir * BM_EFF + c_mem3, block, end_k, reg_a3);
                } else if (pair_use_u) {
                    stage_u_to_reg(pos_a, loadr_a, c_sh3, c_sh3, ir * BM_EFF + c_sh3, block, end_k, reg_a3);
                } else
#endif
                {
                    stage_a_to_reg(pos_a, loadr_a, c_sh3, c_sh3, ir * BM_EFF + c_sh3, block, end_k, reg_a3);
                }
            }
#endif

#ifdef MUL_MAT_ID
            if (loadc_b < active_cols_b) {
                stage_b_to_reg(pos_b, loadr_b, loadc_b, 0u, reg_b0);
            }
            if (loadstride_b < BN && loadc_b + loadstride_b < active_cols_b) {
                stage_b_to_reg(pos_b, loadr_b, loadc_b + loadstride_b, 0u, reg_b1);
            }
#else
            if (loadstride_b <= BN || loadc_b < BN) {
                stage_b_to_reg(pos_b, loadr_b, loadc_b, ic * BN + loadc_b, reg_b0);
            }
            if (loadstride_b < BN && loadc_b + loadstride_b < BN) {
                const uint c_b1 = loadc_b + loadstride_b;
                stage_b_to_reg(pos_b, loadr_b, c_b1, ic * BN + c_b1, reg_b1);
            }
#endif

            if (block > start_k) {
                barrier();
            }

            if (loadstride_a <= BM || loadc_a < BM) {
                commit_stage_a(loadc_a, loadr_a, reg_a0);
            }
            if (loadstride_a < BM && loadc_a + loadstride_a < BM) {
                commit_stage_a(loadc_a + loadstride_a, loadr_a, reg_a1);
            }
#if (defined(DATA_A_F32) || defined(DATA_A_F16)) && LOAD_VEC_A == 4
            if (2u * loadstride_a < BM && loadc_a + 2u * loadstride_a < BM) {
                commit_stage_a(loadc_a + 2u * loadstride_a, loadr_a, reg_a2);
            }
            if (3u * loadstride_a < BM && loadc_a + 3u * loadstride_a < BM) {
                commit_stage_a(loadc_a + 3u * loadstride_a, loadr_a, reg_a3);
            }
#endif
#ifdef MUL_MAT_ID
            if (loadc_b < active_cols_b) {
                commit_stage_b(loadc_b, loadr_b, reg_b0);
            }
            if (loadstride_b < BN && loadc_b + loadstride_b < active_cols_b) {
                commit_stage_b(loadc_b + loadstride_b, loadr_b, reg_b1);
            }
#else
            if (loadstride_b <= BN || loadc_b < BN) {
                commit_stage_b(loadc_b, loadr_b, reg_b0);
            }
            if (loadstride_b < BN && loadc_b + loadstride_b < BN) {
                commit_stage_b(loadc_b + loadstride_b, loadr_b, reg_b1);
            }
#endif

            barrier();

            pos_a += BK / LOAD_VEC_A_EFF;
            pos_b += BK / LOAD_VEC_B_EFF;

#ifdef MUL_MAT_ID
            if (warp_c < required_warp_c)
#endif
            {
#define MM_COMPUTE_KTILE(K_OFF)                                                                                                                       \
    do {                                                                                                                                              \
        const uint _i = (K_OFF);                                                                                                                      \
        [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {                                                                            \
            MM_LOAD_CACHE_B(_i, cm_col);                                                                                                              \
        }                                                                                                                                             \
        [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {                                                                            \
            const uint sh_row_a = (MM_FUSE_MODE == 2u)                                                                                                \
                ? ((cm_row < cms_per_row / 2u)                                                                                                        \
                    ? (warp_r * WM_EFF + cm_row * TM)                                                                                                 \
                    : (BM_EFF + warp_r * WM_EFF + (cm_row - cms_per_row / 2u) * TM))                                                                  \
                : (warp_r * WM + cm_row * TM);                                                                                                        \
            coopMatLoad(cache_a, buf_a, a_shmem_index(sh_row_a, _i / 2), a_shmem_stride(), gl_CooperativeMatrixLayoutRowMajor);                       \
            [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {                                                                        \
                sums[cm_col * cms_per_row + cm_row] = coopMatMulAdd(cache_a, cache_b_arr[cm_col], sums[cm_col * cms_per_row + cm_row]);               \
            }                                                                                                                                         \
        }                                                                                                                                             \
    } while (false)

#if !defined(MUL_MAT_ID)
#define MM_LOAD_CACHE_B_COLMAJ(K_I, CM_COL) \
    coopMatLoad(cache_b_arr[CM_COL], buf_b, b_shmem_index(warp_c * WN + (CM_COL) * TN, (K_I) / 2), b_shmem_stride(), gl_CooperativeMatrixLayoutColumnMajor)
#else
#define MM_LOAD_CACHE_B_COLMAJ(K_I, CM_COL) \
    coopMatLoad(cache_b_arr[CM_COL], buf_b, (warp_c * WN + (CM_COL) * TN) * SHMEM_STRIDE + (K_I) / 2, SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor)
#endif

#if defined(FLOAT16) && !defined(DATA_A_BF16) && LOAD_VEC_B == 8
#define MM_LOAD_CACHE_B(K_I, CM_COL)                                                                                                                  \
    do {                                                                                                                                              \
        if (AGX_DIRECT_STORE != 0) {                                                                                                                  \
            if (APPLY_SLM_A_RESHAPE) {                                                                                                                \
                if (BK == 32) {                                                                                                                       \
                    const uint b_off = ((K_I) >> 3u) * ((BN << 2u) + 8u) + (((warp_c * WN + (CM_COL) * 8u) >> 3u) << 5u);                             \
                    coopMatLoad(cache_b_arr[CM_COL], buf_b, b_off, 4u, gl_CooperativeMatrixLayoutRowMajor);                                           \
                } else {                                                                                                                              \
                    MM_LOAD_CACHE_B_COLMAJ(K_I, CM_COL);                                                                                              \
                }                                                                                                                                     \
            } else {                                                                                                                                  \
                MM_LOAD_CACHE_B_COLMAJ(K_I, CM_COL);                                                                                                  \
            }                                                                                                                                         \
        } else {                                                                                                                                      \
            MM_LOAD_CACHE_B_COLMAJ(K_I, CM_COL);                                                                                                      \
        }                                                                                                                                             \
    } while (false)
#else
#define MM_LOAD_CACHE_B(K_I, CM_COL) MM_LOAD_CACHE_B_COLMAJ(K_I, CM_COL)
#endif

                if (AGX_DIRECT_STORE == 2u) {
                    [[dont_unroll]] for (uint i = 0; i < BK; i += 2u * TK) {
                        MM_COMPUTE_KTILE(i);
                        MM_COMPUTE_KTILE(i + TK);
                    }
                } else if (AGX_DIRECT_STORE == 3u) {
                    [[dont_unroll]] for (uint i = 0; i < BK; i += TK) {
                        MM_COMPUTE_KTILE(i);
                    }
                } else if (AGX_DIRECT_STORE == 4u) {
                    [[unroll]] for (uint i = 0; i < BK; i += TK) {
                        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                        MM_COMPUTE_KTILE(i);
                    }
                } else if (AGX_DIRECT_STORE == 5u) {
                    [[unroll]] for (uint i = 0; i < BK; i += TK) {
                        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cache_a_arr[cms_per_row];
                        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                        [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {
                            const uint sh_row_a = (MM_FUSE_MODE == 2u)
                                ? ((cm_row < cms_per_row / 2u)
                                    ? (warp_r * WM_EFF + cm_row * TM)
                                    : (BM_EFF + warp_r * WM_EFF + (cm_row - cms_per_row / 2u) * TM))
                                : (warp_r * WM + cm_row * TM);
                            coopMatLoad(cache_a_arr[cm_row], buf_a, a_shmem_index(sh_row_a, i / 2), a_shmem_stride(), gl_CooperativeMatrixLayoutRowMajor);
                        }
                        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                        [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                            MM_LOAD_CACHE_B(i, cm_col);
                        }
                        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                        [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {
                            [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                                sums[cm_col * cms_per_row + cm_row] = coopMatMulAdd(cache_a_arr[cm_row], cache_b_arr[cm_col], sums[cm_col * cms_per_row + cm_row]);
                            }
                        }
                    }
                } else {
                    [[unroll]] for (uint i = 0; i < BK; i += TK) {
                        MM_COMPUTE_KTILE(i);
                    }
                }

#undef MM_LOAD_CACHE_B
#undef MM_LOAD_CACHE_B_COLMAJ
#undef MM_COMPUTE_KTILE
            }
        }
    } else
#endif
    for (uint block = start_k; block < end_k; block += BK) {
        [[unroll]] for (uint l = 0; l < BM; l += loadstride_a) {
            if (loadstride_a <= BM || loadc_a + l < BM) {
                const uint c_sh = loadc_a + l;
#ifdef MM_FUSED
                if (MM_FUSE_MODE == 2u && c_sh >= BM_EFF) {
                    const uint c_mem = c_sh - BM_EFF;
                    const uint idx_m = ir * BM_EFF + c_mem;
                    if (idx_m < p.M) {
                        load_u_to_shmem(pos_a, loadr_a, c_sh, c_mem, idx_m, block, end_k);
                    } else {
                        const uint kp_cnt = (LOAD_VEC_A_EFF * LOAD_VEC_BATCH_A) / 2u;
                        const uint kp_base = loadr_a * kp_cnt;
                        [[unroll]] for (uint kp = 0; kp < kp_cnt; ++kp) {
                            store_a(c_sh, kp_base + kp, FLOAT_TYPEV2(0.0f));
                        }
                    }
                } else if (pair_use_u) {
                    const uint idx_m = ir * BM_EFF + c_sh;
                    if (idx_m < p.M) {
                        load_u_to_shmem(pos_a, loadr_a, c_sh, c_sh, idx_m, block, end_k);
                    } else {
                        const uint kp_cnt = (LOAD_VEC_A_EFF * LOAD_VEC_BATCH_A) / 2u;
                        const uint kp_base = loadr_a * kp_cnt;
                        [[unroll]] for (uint kp = 0; kp < kp_cnt; ++kp) {
                            store_a(c_sh, kp_base + kp, FLOAT_TYPEV2(0.0f));
                        }
                    }
                } else
#endif
                {
                    const uint idx_m = ir * BM_EFF + c_sh;
                    if (idx_m < m_lim) {
                        load_a_to_shmem(pos_a, loadr_a, c_sh, c_sh, idx_m, block, end_k);
                    } else {
                        const uint kp_cnt = (LOAD_VEC_A_EFF * LOAD_VEC_BATCH_A) / 2u;
                        const uint kp_base = loadr_a * kp_cnt;
                        [[unroll]] for (uint kp = 0; kp < kp_cnt; ++kp) {
                            store_a(c_sh, kp_base + kp, FLOAT_TYPEV2(0.0f));
                        }
                    }
                }
            }
        }
        #ifdef MUL_MAT_ID
        const uint active_cols_b = min(BN, required_warp_c * WN);
        [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) {
            const uint col_b = loadc_b + l;
            if (col_b < _ne1) {
                load_b_to_shmem(pos_b, loadr_b, col_b, ic, _ne1, block, end_k);
            } else if (col_b < active_cols_b) {
                const uint kp_cnt = (LOAD_VEC_B_EFF * LOAD_VEC_BATCH_B) / 2u;
                const uint buf_idx = col_b * SHMEM_STRIDE + loadr_b * kp_cnt;
                [[unroll]] for (uint kp = 0; kp < kp_cnt; ++kp) {
                    buf_b[buf_idx + kp] = FLOAT_TYPEV2(0.0f);
                }
            }
        }
        #else
        [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) {
            if (loadstride_b <= BN || loadc_b + l < BN) {
                load_b_to_shmem(pos_b, loadr_b, loadc_b + l, ic * BN + loadc_b + l, block, end_k);
            }
        }
        #endif

        barrier();

        pos_a += BK / LOAD_VEC_A_EFF;
        pos_b += BK / LOAD_VEC_B_EFF;

#ifdef COOPMAT
#ifdef MUL_MAT_ID
        if (warp_c < required_warp_c) {
#endif
        [[unroll]] for (uint i = 0; i < BK; i += TK) {
            [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
#if !defined(MUL_MAT_ID)
                coopMatLoad(cache_b_arr[cm_col], buf_b, b_shmem_index(warp_c * WN + cm_col * TN, i / 2), b_shmem_stride(), gl_CooperativeMatrixLayoutColumnMajor);
#else
                coopMatLoad(cache_b_arr[cm_col], buf_b, (warp_c * WN + cm_col * TN) * SHMEM_STRIDE + i / 2, SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
#endif
            }
            [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {
                const uint sh_row_a = (MM_FUSE_MODE == 2u)
                    ? ((cm_row < cms_per_row / 2u)
                        ? (warp_r * WM_EFF + cm_row * TM)
                        : (BM_EFF + warp_r * WM_EFF + (cm_row - cms_per_row / 2u) * TM))
                    : (warp_r * WM + cm_row * TM);
                // Load from shared into cache
                coopMatLoad(cache_a, buf_a, a_shmem_index(sh_row_a, i / 2), a_shmem_stride(), gl_CooperativeMatrixLayoutRowMajor);

                [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                    sums[cm_col * cms_per_row + cm_row] = coopMatMulAdd(cache_a, cache_b_arr[cm_col], sums[cm_col * cms_per_row + cm_row]);
                }
            }
        }
#ifdef MUL_MAT_ID
        }
#endif
#else
        [[unroll]] for (uint i = 0; i < BK / BK_STEP; i++) {
            // Load from shared into cache
            [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                [[unroll]] for (uint j = 0; j < TM; j++) {
                #if defined(DATA_A_F32) || defined(DATA_A_F16)
                    cache_a[wsir * TM + j].xy = buf_a[(warp_r * WM + wsir * WSUBM + tiwr * TM + j) * SHMEM_STRIDE + 2 * i    ];
                    cache_a[wsir * TM + j].zw = buf_a[(warp_r * WM + wsir * WSUBM + tiwr * TM + j) * SHMEM_STRIDE + 2 * i + 1];
                #else
                    cache_a[wsir * TM + j] = buf_a[(warp_r * WM + wsir * WSUBM + tiwr * TM + j) * SHMEM_STRIDE + i];
                #endif
                }
            }

            [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
                [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                #if defined(DATA_A_F32) || defined(DATA_A_F16)
                    cache_b.xy = buf_b[(warp_c * WN + wsic * WSUBN + tiwc * TN + cc) * SHMEM_STRIDE + 2 * i    ];
                    cache_b.zw = buf_b[(warp_c * WN + wsic * WSUBN + tiwc * TN + cc) * SHMEM_STRIDE + 2 * i + 1];
                #else
                    cache_b = buf_b[(warp_c * WN + wsic * WSUBN + tiwc * TN + cc) * SHMEM_STRIDE + i];
                #endif

                    [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                        [[unroll]] for (uint cr = 0; cr < TM / 2; cr++) {
                            // [WNITER][TN][WMITER][TM / 2] -> [wsic][cc][wsir][cr]
                            const uint sums_idx = (wsic * TN + cc) * WMITER * (TM / 2) + wsir * (TM / 2) + cr;
                            sums[sums_idx] = dot_product_v2(cache_a[wsir * TM + 2 * cr], cache_a[wsir * TM + 2 * cr + 1], cache_b, sums[sums_idx]);
                        }
                    }
                }
            }

        }
#endif

        barrier();
    }

#if defined(ACC_TYPE_MAX)
#ifdef COOPMAT
    [[unroll]] for (uint j = 0; j < cms_per_row * cms_per_col; j++) {
        [[unroll]] for (uint i = 0; i < sums[j].length(); ++i) {
            sums[j][i] = clamp(sums[j][i], -ACC_TYPE_MAX, ACC_TYPE_MAX);
        }
    }
#else
    [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN/2; i++) {
        sums[i].x = clamp(sums[i].x, -ACC_TYPE_MAX, ACC_TYPE_MAX);
        sums[i].y = clamp(sums[i].y, -ACC_TYPE_MAX, ACC_TYPE_MAX);
    }
#endif
#endif

    const uint dr = ir_mem * BM_EFF + warp_r * WM_EFF;
    const uint dc = ic * BN + warp_c * WN;

#ifndef MUL_MAT_ID
    uint offsets = batch_idx * p.batch_stride_d;
    if (!stream_k) {
        offsets += ik * p.batch_stride_d * p.num_batches;
    }
#endif

#if !defined(MUL_MAT_ID) && !defined(MM_FUSED)
    bool stream_k_store_scratch;
    if (stream_k) {
        stream_k_store_scratch = stream_k_tile_k_unit + stream_k_tile_k_units != p.k_units_per_tile;
    }
#endif

#ifdef COOPMAT
    const uint cms_out_rows = (MM_FUSE_MODE == 2u) ? (cms_per_row / 2u) : cms_per_row;
    const uint cms_up_off   = cms_per_row / 2u;
#ifdef MUL_MAT_ID
    if (AGX_DIRECT_STORE != 0 && TM == 8 && TN == 8 && WARP == 32) {
        const uint agx_m_local = ((tiw >> 1u) & 3u) | ((tiw >> 2u) & 4u);
        const uint agx_n_base  = ((tiw & 1u) << 1u) | ((tiw >> 1u) & 4u);
        [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
            [[unroll]] for (uint elem = 0; elem < 2; elem++) {
                const uint row_i = dc + cm_col * TN + (agx_n_base | elem);
                if (row_i < _ne1) {
                    const u16vec2 row_idx = row_ids[row_i - ic * BN];
                    const uint d_col_base = row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d;
                    float row_scale = 1.0f;
#ifdef MM_FUSED
                    if (MM_FUSE_MODE == 4u) {
                        const uint s0_idx = uint(row_idx.x) + ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE0_TOK) != 0u ? uint(row_idx.y) * p.nei0 : 0u);
                        row_scale = data_aux0[s0_idx];
                    }
#endif
                    [[unroll]] for (uint cm_row = 0; cm_row < cms_out_rows; cm_row++) {
                        const uint d_row = dr + cm_row * TM + agx_m_local;
                        if (d_row < p.M) {
                            const uint d_idx = d_col_base + d_row;
                            float val = float(sums[cm_col * cms_per_row + cm_row][elem]);
#ifdef MM_FUSED
                            if (MM_FUSE_MODE == 2u) {
                                const float u = float(sums[cm_col * cms_per_row + cms_up_off + cm_row][elem]);
                                val = (val / (1.0f + exp(-val))) * u;
                            } else if (MM_FUSE_MODE == 4u) {
                                val *= row_scale;
                            } else if (p.fusion_flags != 0u) {
                                val = mm_apply_id_epilogue(val, expert_idx, row_idx, d_row, d_idx);
                            }
#endif
                            data_d[d_idx] = D_TYPE(val);
                        }
                    }
                }
            }
        }
    } else {
        [[unroll]] for (uint cm_row = 0; cm_row < cms_out_rows; cm_row++) {
            [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                coopmat<ACC_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> out_cm = sums[cm_col * cms_per_row + cm_row];
#ifdef MM_FUSED
                if (MM_FUSE_MODE == 2u) {
                    [[unroll]] for (uint e = 0; e < out_cm.length(); ++e) {
                        const float g = float(out_cm[e]);
                        const float u = float(sums[cm_col * cms_per_row + cms_up_off + cm_row][e]);
                        out_cm[e] = ACC_TYPE((g / (1.0f + exp(-g))) * u);
                    }
                }
#endif
                coopMatStore(out_cm, coopmat_stage, warp_i * TM * TN, TM, gl_CooperativeMatrixLayoutColumnMajor);

                controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                [[unroll]] for (uint col = 0; col < TN; col += storestride) {
                    const uint row_i = dc + cm_col * TN + col + store_c;
                    if (row_i >= _ne1) break;

                    const u16vec2 row_idx = row_ids[row_i - ic * BN];
                    const uint d_row = dr + cm_col * 0u + cm_row * TM + store_r;

                    if (d_row < p.M) {
                        const uint d_idx = row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + d_row;
                        float val = float(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]);
#ifdef MM_FUSED
                        if (MM_FUSE_MODE != 2u && p.fusion_flags != 0u) {
                            val = mm_apply_id_epilogue(val, expert_idx, row_idx, d_row, d_idx);
                        }
#endif
                        data_d[d_idx] = D_TYPE(val);
                    }
                }
                controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
            }
        }
    }
#else
    if (!stream_k && AGX_DIRECT_STORE != 0 && TM == 8 && TN == 8 && WARP == 32) {
        const uint agx_m_local = ((tiw >> 1u) & 3u) | ((tiw >> 2u) & 4u);
        const uint agx_n_base  = ((tiw & 1u) << 1u) | ((tiw >> 1u) & 4u);
#ifdef MM_FUSED
        float fast_row_scale[cms_per_col][2];
        if (MM_FUSE_MODE == 4u && (p.fusion_flags & MAT_VEC_FUSION_FLAGS_ROW_SCALE0) != 0u) {
            [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                [[unroll]] for (uint elem = 0; elem < 2; elem++) {
                    const uint d_col = dc + cm_col * TN + (agx_n_base | elem);
                    fast_row_scale[cm_col][elem] = (d_col < p.N) ? data_aux0[d_col] : 1.0f;
                }
            }
        }
#endif
        [[unroll]] for (uint cm_row = 0; cm_row < cms_out_rows; cm_row++) {
            const uint d_row = dr + cm_row * TM + agx_m_local;
            if (d_row < m_lim) {
                [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                    [[unroll]] for (uint elem = 0; elem < 2; elem++) {
                        const uint d_col = dc + cm_col * TN + (agx_n_base | elem);
                        if (d_col < p.N) {
                            float val = float(sums[cm_col * cms_per_row + cm_row][elem]);
#ifdef MM_FUSED
                            if (MM_FUSE_MODE == 3u && pair_use_u) {
                                if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_PAIR_MM_SIGMOID1) != 0u) {
                                    val = 1.0f / (1.0f + exp(-val));
                                }
                                data_d2[batch_idx * p.batch_stride_d2 + d_col * p.stride_d2 + d_row] = D_TYPE(val);
                            } else
#endif
                            {
                                const uint d_idx = offsets + d_col * p.stride_d + d_row;
#ifdef MM_FUSED
                                if (MM_FUSE_MODE == 2u) {
                                    const float u = float(sums[cm_col * cms_per_row + cms_up_off + cm_row][elem]);
                                    val = (val / (1.0f + exp(-val))) * u;
                                } else if (MM_FUSE_MODE == 4u) {
                                    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0u) {
                                        val += data_aux0[d_idx];
                                    }
                                    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS1) != 0u) {
                                        val += data_aux1[d_idx];
                                    }
                                    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_ROW_SCALE0) != 0u) {
                                        val *= fast_row_scale[cm_col][elem];
                                    }
                                } else if (MM_FUSE_MODE == 1u) {
                                    val = mm_apply_dense_epilogue(val, d_row, d_col, d_idx);
                                }
#endif
                                data_d[d_idx] = D_TYPE(val);
                            }
                        }
                    }
                }
            }
        }
    } else {
#ifndef MM_FUSED
        [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {
            [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                coopmat<D_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> cm_dtype = coopmat<D_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(sums[cm_col * cms_per_row + cm_row]);
                if (stream_k) {
                    if (stream_k_store_scratch) {
                        const uint scratch_offset = group_idx * BM * BN + (warp_c * WN + cm_col * TN) * BM + warp_r * WM + cm_row * TM;
                        coopMatStore(cm_dtype, data_s, scratch_offset, BM, gl_CooperativeMatrixLayoutColumnMajor);
                    } else {
                        coopMatStore(cm_dtype, data_d, offsets + (dc + cm_col * TN) * p.stride_d + dr + cm_row * TM, p.stride_d, gl_CooperativeMatrixLayoutColumnMajor);
                    }
                } else {
                    const bool is_aligned = p.stride_d % 4 == 0;  // Assumption: D_TYPE == float
                    const bool is_in_bounds = dr + (cm_row + 1) * TM <= p.M && dc + (cm_col + 1) * TN <= p.N;

                    if (is_aligned && is_in_bounds) {
                        // Full coopMat is within bounds and stride_d is aligned with 16B
                        coopMatStore(cm_dtype, data_d, offsets + (dc + cm_col * TN) * p.stride_d + dr + cm_row * TM, p.stride_d, gl_CooperativeMatrixLayoutColumnMajor);
                    } else if (is_in_bounds) {
                        // Full coopMat is within bounds, but stride_d is not aligned
                        coopMatStore(sums[cm_col * cms_per_row + cm_row], coopmat_stage, warp_i * TM * TN, TM, gl_CooperativeMatrixLayoutColumnMajor);

                        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                        [[unroll]] for (uint col = 0; col < TN; col += storestride) {
                            data_d[offsets + (dc + cm_col * TN + col + store_c) * p.stride_d + dr + cm_row * TM + store_r] = D_TYPE(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]);
                        }
                        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                    } else if (dr + cm_row * TM < p.M && dc + cm_col * TN < p.N) {
                        // Partial coopMat is within bounds
                        coopMatStore(sums[cm_col * cms_per_row + cm_row], coopmat_stage, warp_i * TM * TN, TM, gl_CooperativeMatrixLayoutColumnMajor);

                        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                        [[unroll]] for (uint col = 0; col < TN; col += storestride) {
                            if (dr + cm_row * TM + store_r < p.M && dc + cm_col * TN + col + store_c < p.N) {
                                data_d[offsets + (dc + cm_col * TN + col + store_c) * p.stride_d + dr + cm_row * TM + store_r] = D_TYPE(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]);
                            }
                        }
                        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                    }
                }
            }
        }
#else
        [[unroll]] for (uint cm_row = 0; cm_row < cms_out_rows; cm_row++) {
            [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                const bool is_in_bounds = dr + (cm_row + 1) * TM <= m_lim && dc + (cm_col + 1) * TN <= p.N;

                if (dr + cm_row * TM < m_lim && dc + cm_col * TN < p.N) {
                    coopmat<ACC_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> out_cm = sums[cm_col * cms_per_row + cm_row];
                    if (MM_FUSE_MODE == 2u) {
                        [[unroll]] for (uint e = 0; e < out_cm.length(); ++e) {
                            const float g = float(out_cm[e]);
                            const float u = float(sums[cm_col * cms_per_row + cms_up_off + cm_row][e]);
                            out_cm[e] = ACC_TYPE((g / (1.0f + exp(-g))) * u);
                        }
                    }
                    coopMatStore(out_cm, coopmat_stage, warp_i * TM * TN, TM, gl_CooperativeMatrixLayoutColumnMajor);

                    controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                    [[unroll]] for (uint col = 0; col < TN; col += storestride) {
                        const uint d_row = dr + cm_row * TM + store_r;
                        const uint d_col = dc + cm_col * TN + col + store_c;
                        if (is_in_bounds || (d_row < m_lim && d_col < p.N)) {
                            float val = float(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]);
                            if (pair_use_u) {
                                if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_PAIR_MM_SIGMOID1) != 0u) {
                                    val = 1.0f / (1.0f + exp(-val));
                                }
                                data_d2[batch_idx * p.batch_stride_d2 + d_col * p.stride_d2 + d_row] = D_TYPE(val);
                            } else {
                                const uint d_idx = offsets + d_col * p.stride_d + d_row;
                                if (MM_FUSE_MODE == 4u) {
                                    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0u) {
                                        val += data_aux0[d_idx];
                                    }
                                    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS1) != 0u) {
                                        val += data_aux1[d_idx];
                                    }
                                    if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_ROW_SCALE0) != 0u) {
                                        val *= data_aux0[d_col];
                                    }
                                } else if (MM_FUSE_MODE == 1u) {
                                    val = mm_apply_dense_epilogue(val, d_row, d_col, d_idx);
                                }
                                data_d[d_idx] = D_TYPE(val);
                            }
                        }
                    }
                    controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                }
            }
        }
#endif
    }
#endif // MUL_MAT_ID
#else
    [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
        [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {

            const uint dr_warp = dr + wsir * WSUBM + tiwr * TM;
            const uint dc_warp = dc + wsic * WSUBN + tiwc * TN;
            [[unroll]] for (uint cc = 0; cc < TN; cc++) {
#ifdef MUL_MAT_ID
                const uint row_i = dc_warp + cc;
                if (row_i >= _ne1) break;

                const u16vec2 row_idx = row_ids[row_i - ic * BN];
#endif // MUL_MAT_ID
                [[unroll]] for (uint cr = 0; cr < TM / 2; cr++) {
                    const uint sums_idx = (wsic * TN + cc) * WMITER * (TM / 2) + wsir * (TM / 2) + cr;
#ifdef MUL_MAT_ID
                    if (dr_warp + 2 * cr < p.M) {
                        data_d[row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr_warp + 2 * cr] = D_TYPE(sums[sums_idx].x);
                    }
                    if (dr_warp + 2 * cr + 1 < p.M) {
                        data_d[row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr_warp + 2 * cr + 1] = D_TYPE(sums[sums_idx].y);
                    }
#else
#ifndef MM_FUSED
                    if (stream_k) {
                        const uint scratch_offset = group_idx * BM * BN + (dc_warp + cc - ic * BN) * BM + dr_warp + 2 * cr - ir * BM;
                        if (stream_k_store_scratch) {
                            data_s[scratch_offset] = D_TYPE(sums[sums_idx].x);
                            data_s[scratch_offset + 1] = D_TYPE(sums[sums_idx].y);
                        } else {
                            data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp + 2 * cr] = D_TYPE(sums[sums_idx].x);
                            data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp + 2 * cr + 1] = D_TYPE(sums[sums_idx].y);
                        }
                    } else
#endif
                    {
                        if (dr_warp + 2 * cr < p.M && dc_warp + cc < p.N) {
                            data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp + 2 * cr] = D_TYPE(sums[sums_idx].x);
                        }
                        if (dr_warp + 2 * cr + 1 < p.M && dc_warp + cc < p.N) {
                            data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp + 2 * cr + 1] = D_TYPE(sums[sums_idx].y);
                        }
                    }
#endif // MUL_MAT_ID
                }
            }
        }
    }
#endif // COOPMAT
#if !defined(MUL_MAT_ID) && !defined(MM_FUSED)
    if (stream_k) {
        stream_k_work_unit += stream_k_tile_k_units;
    }
    } while (stream_k && stream_k_work_unit < stream_k_work_unit_end);
#endif
}
