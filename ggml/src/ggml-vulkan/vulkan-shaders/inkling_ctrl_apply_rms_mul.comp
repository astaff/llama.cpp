#version 450
// S19_WAVE3 (mode = 11): Batched [gain; forget] ctrl_apply + 0-ULP Borealis 512-tree RMS_NORM_MUL
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer BufCur { float data_cur[]; };
layout(binding = 1) readonly  buffer BufMsg { float data_msg[]; };
layout(binding = 2) readonly  buffer BufUp  { float data_up[];  };
layout(binding = 3) readonly  buffer BufW   { float data_w[];   };
layout(binding = 4) writeonly buffer BufDst { float data_dst[]; };

layout(push_constant) uniform PushConstants {
    uint  n_embd;
    uint  n_tokens;
    uint  C;
    uint  off_cur;
    uint  off_msg;
    uint  off_up;
    uint  off_w;
    uint  off_dst;
    uint  cur_s2;
    uint  w_s1;
    float eps;
} p;

shared float sh_mix[2304];
shared float sh_rms[16];

void main() {
    const uint tok = gl_WorkGroupID.x + gl_WorkGroupID.y * 65535u;
    const uint sl  = gl_WorkGroupID.z;
    if (tok >= p.n_tokens || sl >= p.C) {
        return;
    }
    const uint tid = gl_LocalInvocationID.x;
    const uint cb  = p.off_cur + sl * p.cur_s2 + tok * p.n_embd;
    const uint mb  = p.off_msg + (sl * p.n_tokens + tok) * p.n_embd;
    const uint ub  = p.off_up  + (sl * p.n_tokens + tok) * (2u * p.n_embd);
    const uint wb  = p.off_w   + sl * p.w_s1;
    const uint db  = p.off_dst + (sl * p.n_tokens + tok) * p.n_embd;

    for (uint col = tid; col < p.n_embd; col += 512u) {
        const float c  = data_cur[cb + col];
        const float m  = data_msg[mb + col];
        const float gn = tanh(data_up[ub + col]);
        const float fg = tanh(data_up[ub + p.n_embd + col]);
        sh_mix[col] = (c - fg * c) + gn * m;
    }
    barrier();

    const uint num_blocks = (p.n_embd + 511u) >> 9u;
    float sum = 0.0f;
    [[dont_unroll]] for (uint col = tid, idx = 0u; idx < num_blocks; col += 512u, ++idx) {
        float xi = 0.0f;
        if (col < p.n_embd) {
            xi = sh_mix[col];
        }
        sum += xi * xi;
    }
    sum = subgroupAdd(sum);
    if (gl_SubgroupInvocationID == 0u) {
        sh_rms[gl_SubgroupID] = sum;
    }
    barrier();

    float total = (gl_SubgroupInvocationID < 16u) ? sh_rms[gl_SubgroupInvocationID] : 0.0f;
    total = subgroupAdd(total);
    const float mean  = total / float(p.n_embd);
    const float scale = inversesqrt(mean + p.eps);

    for (uint col = tid; col < p.n_embd; col += 512u) {
        data_dst[db + col] = scale * sh_mix[col] * data_w[wb + col];
    }
}
