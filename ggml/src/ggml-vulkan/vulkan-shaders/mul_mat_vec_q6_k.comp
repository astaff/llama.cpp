                        const FLOAT_TYPE sc0 = FLOAT_TYPE(bitfieldExtract(int(sw_a), int(sel * 8u),       8));
                        const FLOAT_TYPE sc1 = FLOAT_TYPE(bitfieldExtract(int(sw_a), int((sel + 2u) * 8u), 8));
                        const FLOAT_TYPE sc2 = FLOAT_TYPE(bitfieldExtract(int(sw_b), int(sel * 8u),       8));
                        const FLOAT_TYPE sc3 = FLOAT_TYPE(bitfieldExtract(int(sw_b), int((sel + 2u) * 8u), 8));
                        const uint ql0  = data_a2_u32[ql_base + 0u];
                        const uint ql32 = data_a2_u32[ql_base + 1u];
                        const uint qh   = data_a2_u32[sb_u32 + REPACK_Q6_K_QH_OFF_U32 + itid8 * 2u + h];
                        const vec4 q0 = repack_magic_q6((ql0  & 0x000F000Fu) | ((qh & 0x00030003u) << 4u), ((ql0  >> 8u) & 0x000F000Fu) | ((qh & 0x03000300u) >> 4u));
                        const vec4 q1 = repack_magic_q6((ql32 & 0x000F000Fu) | ((qh & 0x000C000Cu) << 2u), ((ql32 >> 8u) & 0x000F000Fu) | ((qh & 0x0C000C00u) >> 6u));
                        const vec4 q2 = repack_magic_q6(((ql0 >> 4u) & 0x000F000Fu) | (qh & 0x00300030u),  ((ql0  >> 12u) & 0x000F000Fu) | ((qh & 0x30003000u) >> 8u));
                        const vec4 q3 = repack_magic_q6(((ql32>> 4u) & 0x000F000Fu) | ((qh & 0x00C000C0u) >> 2u), ((ql32 >> 12u) & 0x000F000Fu) | ((qh & 0xC000C000u) >> 10u));
                        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                            const uint b4 = (j * p.batch_stride_b + b_offset + y_idx) >> 2u;
                            const vec4 by0 = vec4(data_b_v4[b4      ]), by1 = vec4(data_b_v4[b4 +  8u]);
                            const vec4 by2 = vec4(data_b_v4[b4 + 16u]), by3 = vec4(data_b_v4[b4 + 24u]);
                            FLOAT_TYPE sum[4] = {0, 0, 0, 0};
                            [[unroll]] for (uint l = 0; l < 4; ++l) {
                                sum[0] = fma(FLOAT_TYPE(by0[l]), q0[l], sum[0]);
                                sum[1] = fma(FLOAT_TYPE(by1[l]), q1[l], sum[1]);
                                sum[2] = fma(FLOAT_TYPE(by2[l]), q2[l], sum[2]);
                                sum[3] = fma(FLOAT_TYPE(by3[l]), q3[l], sum[3]);
                            }
                            temp2[j][n] = fma(fma(sum[0], sc0, fma(sum[1], sc1, fma(sum[2], sc2, sum[3] * sc3))), d, temp2[j][n]);
                        }
                    }
                }
            }
        }
    }
#else
    if (GEN_FAST_KQ >= 2) {
        const uint it_size8 = gl_WorkGroupSize.x / 8;
        const uint itid8 = tid & 7;
        const uint ix8 = tid >> 3;
        if (GEN_GLU == 2 && use_a2) {
            for (uint i = ix8; i < num_blocks_per_row; i += it_size8) {
                calc_superblock_8_a2(temp, a_offset, b_offset, itid8, i, num_blocks_per_row, row_base, eff_rows);
            }
        } else {
            for (uint i = ix8; i < num_blocks_per_row; i += it_size8) {
                calc_superblock_8_a(temp, temp2, a_offset, b_offset, itid8, i, num_blocks_per_row, row_base, eff_rows);
            }
        }
    } else {
        // 16 threads are used to process each block
        const uint it_size = gl_WorkGroupSize.x/16;
        const uint itid = tid%16;  // 0...15
        const uint ix = tid/16;

        const uint v_im = itid/8;                               // 0 or 1. 0 computes 0..., 1 computes 128...
        const uint v_in = itid - 8*v_im;                        // 0...7

        const uint l0 = 4 * v_in;                               // 0, 4, 8, ..., 28
        const uint is = v_in / 4;

        const uint ql_offset = 64*v_im + l0;
        const uint qh_offset = 32*v_im + l0;
        const uint s_offset  =  8*v_im + is;
        const uint y_offset = 128*v_im + l0;

        if (GEN_GLU == 2 && use_a2) {
            for (uint i = ix; i < num_blocks_per_row; i += it_size) {
                calc_superblock_a2(temp, a_offset, b_offset, ql_offset, qh_offset, s_offset, y_offset, i, num_blocks_per_row, row_base, eff_rows);
            }
        } else {
            for (uint i = ix; i < num_blocks_per_row; i += it_size) {
                calc_superblock_a(temp, temp2, a_offset, b_offset, ql_offset, qh_offset, s_offset, y_offset, i, num_blocks_per_row, row_base, eff_rows);
            }
        }
    }
#endif

    if (GEN_GLU == 3) {
        reduce_pair_glu(temp, temp2, d_offset, first_row, eff_rows, tid);
    }
#ifndef MUL_MAT_ID
    else if (GEN_GLU == 2 && use_a2) {
        reduce_result_d2(temp, row_base, eff_rows, tid);
    }
#endif
    else {
        reduce_result(temp, d_offset, first_row, eff_rows, tid);
    }
}

void main() {
#ifdef USE_SUBGROUP_ADD_NO_SHMEM
    const uint first_row = NUM_ROWS * (NUM_SUBGROUPS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z) + gl_SubgroupID);
#else
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
#endif

    if (first_row >= p.stride_d) {
        return;
    }
    compute_outputs(first_row, min(NUM_ROWS, p.stride_d - first_row));
}
