#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer BufTable   { float     data_table[];    };
layout(binding = 1) readonly  buffer BufSinks   { float     data_sinks[];    };
layout(binding = 2) readonly  buffer BufRelPos  { int       data_rel_pos[];  };
layout(binding = 3) readonly  buffer BufMaskF16 { float16_t data_mask_f16[]; };
layout(binding = 4) writeonly buffer BufDstF32  { float     data_dst[];      };
layout(binding = 4) writeonly buffer BufDstF16  { float16_t data_dst_f16[];  };

layout(push_constant) uniform PushConstants {
    uint n_kv;
    uint nr;
    uint n_head;
    uint n_stream;
    uint n_seq_tokens;
    uint r0;
    uint table_len;
    uint extent;
    uint off_table;
    uint off_sinks;
    uint off_rel;
    uint off_dst;
    uint flags;     // bit 0: out_f16, bit 1: has_mask
    uint off_mask;  // in f16 elements
    uint mask_r0;
    uint mask_ne1;
    uint mask_ne2;
    uint mask_ne3;
} p;

void main() {
    const uint idx   = gl_GlobalInvocationID.x + gl_WorkGroupID.y * (65535u * 256u);
    const uint total = p.n_kv * p.nr * p.n_head * p.n_stream;
    if (idx >= total) {
        return;
    }
    const uint kv_i  = idx % p.n_kv;
    const uint t1    = idx / p.n_kv;
    const uint tok_r = t1 % p.nr;
    const uint t2    = t1 / p.nr;
    const uint h     = t2 % p.n_head;
    const uint s     = t2 / p.n_head;

    const uint tok_seq    = p.r0 + tok_r;
    const uint tok_global = s * p.n_seq_tokens + tok_seq;
    const int  r          = data_rel_pos[p.off_rel + tok_global * p.n_kv + kv_i];
    const float tval      = (r >= 0 && uint(r) < p.extent && uint(r) < p.table_len)
        ? data_table[p.off_table + (tok_global * p.n_head + h) * p.table_len + uint(r)]
        : 0.0f;
    const float sval      = data_sinks[p.off_sinks + tok_global * p.n_head + h];
    precise float b       = tval - sval;

    if ((p.flags & 2u) != 0u) {
        const uint m2   = (p.mask_ne2 > 1u) ? (h % p.mask_ne2) : 0u;
        const uint m3   = (p.mask_ne3 > 1u) ? (s % p.mask_ne3) : 0u;
        const uint midx = p.off_mask + (((m3 * p.mask_ne2 + m2) * p.mask_ne1 + (p.mask_r0 + tok_r)) * p.n_kv + kv_i);
        precise float mv  = float(data_mask_f16[midx]);
        precise float sum = b + mv;
        b = sum;
    }

    if ((p.flags & 1u) != 0u) {
        data_dst_f16[p.off_dst + idx] = float16_t(b);
    } else {
        data_dst[p.off_dst + idx] = b;
    }
}
