#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer BufS0 { float s0[]; };
layout(binding = 1) readonly  buffer BufS1 { float s1[]; };
layout(binding = 2) readonly  buffer BufS2 { float s2[]; };
layout(binding = 3) readonly  buffer BufS3 { float s3[]; };
layout(binding = 4) readonly  buffer BufS4 { float s4[]; };
layout(binding = 5) readonly  buffer BufS5 { float s5[]; };
layout(binding = 6) readonly  buffer BufQ  { float data_q[];   };
layout(binding = 7) writeonly buffer BufD  { float data_dst[]; };

layout(push_constant) uniform PushConstants {
    uint  n_embd;
    uint  n_tokens;
    uint  K;
    uint  Q;
    uint  off_s[6];
    uint  off_q;
    uint  off_dst;
    float eps;
    float sm_scale;
} p;

shared float sh_red[4];

float reduce_sum_128(float v) {
    const float sg = subgroupAdd(v);
    if (gl_SubgroupInvocationID == 0u) {
        sh_red[gl_SubgroupID] = sg;
    }
    barrier();
    const float res = sh_red[0] + sh_red[1] + sh_red[2] + sh_red[3];
    barrier();
    return res;
}

float load_state(uint b, uint idx) {
    switch (b) {
        case 0u: return s0[p.off_s[0] + idx];
        case 1u: return s1[p.off_s[1] + idx];
        case 2u: return s2[p.off_s[2] + idx];
        case 3u: return s3[p.off_s[3] + idx];
        case 4u: return s4[p.off_s[4] + idx];
        default: return s5[p.off_s[5] + idx];
    }
}

void main() {
    const uint tok = gl_WorkGroupID.x + gl_WorkGroupID.y * 65535u;
    if (tok >= p.n_tokens) {
        return;
    }
    const uint tid      = gl_LocalInvocationID.x;
    const uint tok_base = tok * p.n_embd;
    const float inv_d   = 1.0f / float(p.n_embd);

    // Fast in-register path for n_embd == 1280, K <= 6 (Inkling 2 Mini): 10 floats/thread!
    if (p.n_embd == 1280u && p.K <= 6u) {
        float v[6][10];
        for (uint b = 0u; b < p.K; ++b) {
            float ss = 0.0f;
            [[unroll]] for (uint m = 0u; m < 10u; ++m) {
                const float x = load_state(b, tok_base + tid + m * 128u);
                v[b][m] = x;
                ss += x * x;
            }
            const float rms_inv = 1.0f / sqrt(reduce_sum_128(ss) * inv_d + p.eps);
            [[unroll]] for (uint m = 0u; m < 10u; ++m) {
                v[b][m] *= rms_inv;
            }
        }

        for (uint q = 0u; q < p.Q; ++q) {
            const uint qb = p.off_q + q * 1280u;
            float qv[10];
            [[unroll]] for (uint m = 0u; m < 10u; ++m) {
                qv[m] = data_q[qb + tid + m * 128u];
            }
            float scores[6];
            float mx = -3.402823466e+38f;
            for (uint b = 0u; b < p.K; ++b) {
                float dp = 0.0f;
                [[unroll]] for (uint m = 0u; m < 10u; ++m) {
                    dp += v[b][m] * qv[m];
                }
                const float sc = reduce_sum_128(dp) * p.sm_scale;
                scores[b] = sc;
                mx = max(mx, sc);
            }
            float ex_sum = 0.0f;
            for (uint b = 0u; b < p.K; ++b) {
                scores[b] = exp(scores[b] - mx);
                ex_sum += scores[b];
            }
            const float inv_ex = 1.0f / ex_sum;
            for (uint b = 0u; b < p.K; ++b) {
                scores[b] *= inv_ex;
            }
            const uint db = p.off_dst + (q * p.n_tokens + tok) * 1280u;
            [[unroll]] for (uint m = 0u; m < 10u; ++m) {
                float acc = 0.0f;
                for (uint b = 0u; b < p.K; ++b) {
                    acc += v[b][m] * scores[b];
                }
                data_dst[db + tid + m * 128u] = acc;
            }
        }
        return;
    }

    // Generic fallback for arbitrary n_embd, K <= 6
    float rms_inv[6];
    for (uint b = 0u; b < p.K; ++b) {
        float ss = 0.0f;
        for (uint c = tid; c < p.n_embd; c += 128u) {
            const float x = load_state(b, tok_base + c);
            ss += x * x;
        }
        rms_inv[b] = 1.0f / sqrt(reduce_sum_128(ss) * inv_d + p.eps);
    }
    for (uint q = 0u; q < p.Q; ++q) {
        const uint qb = p.off_q + q * p.n_embd;
        float scores[6];
        float mx = -3.402823466e+38f;
        for (uint b = 0u; b < p.K; ++b) {
            float dp = 0.0f;
            for (uint c = tid; c < p.n_embd; c += 128u) {
                dp += (load_state(b, tok_base + c) * rms_inv[b]) * data_q[qb + c];
            }
            const float sc = reduce_sum_128(dp) * p.sm_scale;
            scores[b] = sc;
            mx = max(mx, sc);
        }
        float ex_sum = 0.0f;
        for (uint b = 0u; b < p.K; ++b) {
            scores[b] = exp(scores[b] - mx);
            ex_sum += scores[b];
        }
        const float inv_ex = 1.0f / ex_sum;
        for (uint b = 0u; b < p.K; ++b) {
            scores[b] *= inv_ex;
        }
        const uint db = p.off_dst + (q * p.n_tokens + tok) * p.n_embd;
        for (uint c = tid; c < p.n_embd; c += 128u) {
            float acc = 0.0f;
            for (uint b = 0u; b < p.K; ++b) {
                acc += (load_state(b, tok_base + c) * rms_inv[b]) * scores[b];
            }
            data_dst[db + c] = acc;
        }
    }
}
