#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"

#ifdef USE_SUBGROUP_ADD_NO_SHMEM
layout(local_size_x_id = 0, local_size_y_id = 4, local_size_z = 1) in;
#else
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
#endif

#define LOAD_Q5_K_0ULP(PFX, ARR_A, ARR_P16) \
    const FLOAT_TYPEV2 PFX##_dm = FLOAT_TYPEV2(ARR_A[ib0 + i].dm); \
    const uint32_t PFX##_scale0_u32 = ARR_P16[ib0 + i].scales[v_im    ]; \
    const uint32_t PFX##_scale4_u32 = ARR_P16[ib0 + i].scales[v_im + 2]; \
    const uint32_t PFX##_scale8_u32 = ARR_P16[ib0 + i].scales[v_im + 4]; \
    const uint32_t PFX##_scale_0_4_l = (PFX##_scale4_u32 << 16) | PFX##_scale0_u32; \
    const uint32_t PFX##_scale_0_4_h = (PFX##_scale_0_4_l & 0xC0C0C0C0u) >> 2; \
    const vec4 PFX##_sc03 = vec4(unpack8(PFX##_scale_0_4_l & 0x3F3F3F3Fu)); \
    const vec4 PFX##_sc47 = vec4(unpack8((((PFX##_scale8_u32 << 12) | PFX##_scale8_u32) & 0x0F0F0F0Fu) | PFX##_scale_0_4_h)); \
    const uint32_t PFX##_qs0_16_u32  = uint32_t(ARR_P16[ib0 + i].qs[q_offset / 2])      | (uint32_t(ARR_P16[ib0 + i].qs[q_offset / 2 +  8]) << 16); \
    const uint32_t PFX##_qs64_80_u32 = uint32_t(ARR_P16[ib0 + i].qs[q_offset / 2 + 32]) | (uint32_t(ARR_P16[ib0 + i].qs[q_offset / 2 + 40]) << 16); \
    const uint32_t PFX##_qh = pack32(u16vec2(ARR_P16[ib0 + i].qh[l0 / 2], ARR_P16[ib0 + i].qh[l0 / 2 + 8])); \
    const vec4 PFX##_qs0_16_lo4  = vec4(unpack8((PFX##_qs0_16_u32  & 0x0F0F0F0Fu) + (((PFX##_qh >> (2*v_im)) & 0x01010101u) << 4))); \
    const vec4 PFX##_qs0_16_hi4  = vec4(unpack8(((PFX##_qs0_16_u32  >> 4) & 0x0F0F0F0Fu) + (((PFX##_qh >> (2*v_im)) & 0x02020202u) << 3))); \
    const vec4 PFX##_qs64_80_lo4 = vec4(unpack8((PFX##_qs64_80_u32 & 0x0F0F0F0Fu) + ((PFX##_qh >> (2*v_im)) & 0x10101010u))); \
    const vec4 PFX##_qs64_80_hi4 = vec4(unpack8(((PFX##_qs64_80_u32 >> 4) & 0x0F0F0F0Fu) + (((PFX##_qh >> (2*v_im)) & 0x20202020u) >> 1)))

#define DOT_Q5_K_0ULP_WITH_BY(PFX, DST_TEMP, BY10, BY116, BY132, BY148, BY20, BY216, BY232, BY248, SY0, SY1, SY2, SY3) do { \
    const FLOAT_TYPE sx = fma(FLOAT_TYPE((BY10).x),  PFX##_qs0_16_lo4.x,  fma(FLOAT_TYPE((BY10).y),  PFX##_qs0_16_lo4.y,  fma(FLOAT_TYPE((BY116).x), PFX##_qs0_16_lo4.z,  FLOAT_TYPE((BY116).y) * PFX##_qs0_16_lo4.w))); \
    const FLOAT_TYPE sy = fma(FLOAT_TYPE((BY132).x), PFX##_qs0_16_hi4.x,  fma(FLOAT_TYPE((BY132).y), PFX##_qs0_16_hi4.y,  fma(FLOAT_TYPE((BY148).x), PFX##_qs0_16_hi4.z,  FLOAT_TYPE((BY148).y) * PFX##_qs0_16_hi4.w))); \
    const FLOAT_TYPE sz = fma(FLOAT_TYPE((BY20).x),  PFX##_qs64_80_lo4.x, fma(FLOAT_TYPE((BY20).y),  PFX##_qs64_80_lo4.y, fma(FLOAT_TYPE((BY216).x), PFX##_qs64_80_lo4.z, FLOAT_TYPE((BY216).y) * PFX##_qs64_80_lo4.w))); \
    const FLOAT_TYPE sw = fma(FLOAT_TYPE((BY232).x), PFX##_qs64_80_hi4.x, fma(FLOAT_TYPE((BY232).y), PFX##_qs64_80_hi4.y, fma(FLOAT_TYPE((BY248).x), PFX##_qs64_80_hi4.z, FLOAT_TYPE((BY248).y) * PFX##_qs64_80_hi4.w))); \
    const FLOAT_TYPE smin = fma(SY0, PFX##_sc03.z, fma(SY1, PFX##_sc03.w, fma(SY2, PFX##_sc47.z, (SY3) * PFX##_sc47.w))); \
    DST_TEMP[j][n] = fma(PFX##_dm.x, fma(sx, PFX##_sc03.x, fma(sy, PFX##_sc03.y, fma(sz, PFX##_sc47.x, sw * PFX##_sc47.y))), fma(-PFX##_dm.y, smin, DST_TEMP[j][n])); \
} while (false)

void calc_superblock_a(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], inout FLOAT_TYPE temp2[NUM_COLS][NUM_ROWS], const uint a_offset, const uint b_offset, const uint v_im, const uint l0, const uint q_offset, const uint y_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y1_idx = i * QUANT_K + y_offset;
    const uint y2_idx = y1_idx + 128;

    if (NUM_COLS <= 4) {
        vec2 by10_a[4], by116_a[4], by132_a[4], by148_a[4];
        vec2 by20_a[4], by216_a[4], by232_a[4], by248_a[4];
        FLOAT_TYPE sy0_a[4], sy1_a[4], sy2_a[4], sy3_a[4];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b2_1 = (j * p.batch_stride_b + b_offset + y1_idx) / 2;
            const uint b2_2 = (j * p.batch_stride_b + b_offset + y2_idx) / 2;
            by10_a[j]  = vec2(data_b_v2[b2_1     ]); by116_a[j] = vec2(data_b_v2[b2_1 +  8]);
            by132_a[j] = vec2(data_b_v2[b2_1 + 16]); by148_a[j] = vec2(data_b_v2[b2_1 + 24]);
            by20_a[j]  = vec2(data_b_v2[b2_2     ]); by216_a[j] = vec2(data_b_v2[b2_2 +  8]);
            by232_a[j] = vec2(data_b_v2[b2_2 + 16]); by248_a[j] = vec2(data_b_v2[b2_2 + 24]);
            sy0_a[j] = FLOAT_TYPE(by10_a[j].x)  + FLOAT_TYPE(by10_a[j].y)  + FLOAT_TYPE(by116_a[j].x) + FLOAT_TYPE(by116_a[j].y);
            sy1_a[j] = FLOAT_TYPE(by132_a[j].x) + FLOAT_TYPE(by132_a[j].y) + FLOAT_TYPE(by148_a[j].x) + FLOAT_TYPE(by148_a[j].y);
            sy2_a[j] = FLOAT_TYPE(by20_a[j].x)  + FLOAT_TYPE(by20_a[j].y)  + FLOAT_TYPE(by216_a[j].x) + FLOAT_TYPE(by216_a[j].y);
            sy3_a[j] = FLOAT_TYPE(by232_a[j].x) + FLOAT_TYPE(by232_a[j].y) + FLOAT_TYPE(by248_a[j].x) + FLOAT_TYPE(by248_a[j].y);
        }
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib0 = a_offset + (first_row + rn) * num_blocks_per_row;
            LOAD_Q5_K_0ULP(a1, data_a, data_a_packed16);
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                DOT_Q5_K_0ULP_WITH_BY(a1, temp, by10_a[j], by116_a[j], by132_a[j], by148_a[j], by20_a[j], by216_a[j], by232_a[j], by248_a[j], sy0_a[j], sy1_a[j], sy2_a[j], sy3_a[j]);
            }
            if (GEN_GLU == 3) {
                LOAD_Q5_K_0ULP(a2, data_a2, data_a2_packed16);
                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    DOT_Q5_K_0ULP_WITH_BY(a2, temp2, by10_a[j], by116_a[j], by132_a[j], by148_a[j], by20_a[j], by216_a[j], by232_a[j], by248_a[j], sy0_a[j], sy1_a[j], sy2_a[j], sy3_a[j]);
                }
            }
        }
    } else {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib0 = a_offset + (first_row + rn) * num_blocks_per_row;
            LOAD_Q5_K_0ULP(a1, data_a, data_a_packed16);
            if (GEN_GLU == 3) {
                LOAD_Q5_K_0ULP(a2, data_a2, data_a2_packed16);
                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    const uint b2_1 = (j * p.batch_stride_b + b_offset + y1_idx) / 2;
                    const uint b2_2 = (j * p.batch_stride_b + b_offset + y2_idx) / 2;
                    const vec2 by10  = vec2(data_b_v2[b2_1     ]), by116 = vec2(data_b_v2[b2_1 +  8]);
                    const vec2 by132 = vec2(data_b_v2[b2_1 + 16]), by148 = vec2(data_b_v2[b2_1 + 24]);
                    const vec2 by20  = vec2(data_b_v2[b2_2     ]), by216 = vec2(data_b_v2[b2_2 +  8]);
                    const vec2 by232 = vec2(data_b_v2[b2_2 + 16]), by248 = vec2(data_b_v2[b2_2 + 24]);
                    const FLOAT_TYPE sumy0 = FLOAT_TYPE(by10.x)  + FLOAT_TYPE(by10.y)  + FLOAT_TYPE(by116.x) + FLOAT_TYPE(by116.y);
                    const FLOAT_TYPE sumy1 = FLOAT_TYPE(by132.x) + FLOAT_TYPE(by132.y) + FLOAT_TYPE(by148.x) + FLOAT_TYPE(by148.y);
                    const FLOAT_TYPE sumy2 = FLOAT_TYPE(by20.x)  + FLOAT_TYPE(by20.y)  + FLOAT_TYPE(by216.x) + FLOAT_TYPE(by216.y);
                    const FLOAT_TYPE sumy3 = FLOAT_TYPE(by232.x) + FLOAT_TYPE(by232.y) + FLOAT_TYPE(by248.x) + FLOAT_TYPE(by248.y);
                    DOT_Q5_K_0ULP_WITH_BY(a1, temp,  by10, by116, by132, by148, by20, by216, by232, by248, sumy0, sumy1, sumy2, sumy3);
                    DOT_Q5_K_0ULP_WITH_BY(a2, temp2, by10, by116, by132, by148, by20, by216, by232, by248, sumy0, sumy1, sumy2, sumy3);
                }
            } else {
                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    const uint b2_1 = (j * p.batch_stride_b + b_offset + y1_idx) / 2;
                    const uint b2_2 = (j * p.batch_stride_b + b_offset + y2_idx) / 2;
                    const vec2 by10  = vec2(data_b_v2[b2_1     ]), by116 = vec2(data_b_v2[b2_1 +  8]);
                    const vec2 by132 = vec2(data_b_v2[b2_1 + 16]), by148 = vec2(data_b_v2[b2_1 + 24]);
                    const vec2 by20  = vec2(data_b_v2[b2_2     ]), by216 = vec2(data_b_v2[b2_2 +  8]);
                    const vec2 by232 = vec2(data_b_v2[b2_2 + 16]), by248 = vec2(data_b_v2[b2_2 + 24]);
                    const FLOAT_TYPE sumy0 = FLOAT_TYPE(by10.x)  + FLOAT_TYPE(by10.y)  + FLOAT_TYPE(by116.x) + FLOAT_TYPE(by116.y);
                    const FLOAT_TYPE sumy1 = FLOAT_TYPE(by132.x) + FLOAT_TYPE(by132.y) + FLOAT_TYPE(by148.x) + FLOAT_TYPE(by148.y);
                    const FLOAT_TYPE sumy2 = FLOAT_TYPE(by20.x)  + FLOAT_TYPE(by20.y)  + FLOAT_TYPE(by216.x) + FLOAT_TYPE(by216.y);
                    const FLOAT_TYPE sumy3 = FLOAT_TYPE(by232.x) + FLOAT_TYPE(by232.y) + FLOAT_TYPE(by248.x) + FLOAT_TYPE(by248.y);
                    DOT_Q5_K_0ULP_WITH_BY(a1, temp, by10, by116, by132, by148, by20, by216, by232, by248, sumy0, sumy1, sumy2, sumy3);
                }
            }
        }
    }
}

void calc_superblock_a2(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint a_offset, const uint b_offset, const uint v_im, const uint l0, const uint q_offset, const uint y_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y1_idx = i * QUANT_K + y_offset;
    const uint y2_idx = y1_idx + 128;

    if (NUM_COLS <= 4) {
        vec2 by10_a[4], by116_a[4], by132_a[4], by148_a[4];
        vec2 by20_a[4], by216_a[4], by232_a[4], by248_a[4];
        FLOAT_TYPE sy0_a[4], sy1_a[4], sy2_a[4], sy3_a[4];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b2_1 = (j * p.batch_stride_b + b_offset + y1_idx) / 2;
            const uint b2_2 = (j * p.batch_stride_b + b_offset + y2_idx) / 2;
            by10_a[j]  = vec2(data_b_v2[b2_1     ]); by116_a[j] = vec2(data_b_v2[b2_1 +  8]);
            by132_a[j] = vec2(data_b_v2[b2_1 + 16]); by148_a[j] = vec2(data_b_v2[b2_1 + 24]);
            by20_a[j]  = vec2(data_b_v2[b2_2     ]); by216_a[j] = vec2(data_b_v2[b2_2 +  8]);
            by232_a[j] = vec2(data_b_v2[b2_2 + 16]); by248_a[j] = vec2(data_b_v2[b2_2 + 24]);
            sy0_a[j] = FLOAT_TYPE(by10_a[j].x)  + FLOAT_TYPE(by10_a[j].y)  + FLOAT_TYPE(by116_a[j].x) + FLOAT_TYPE(by116_a[j].y);
            sy1_a[j] = FLOAT_TYPE(by132_a[j].x) + FLOAT_TYPE(by132_a[j].y) + FLOAT_TYPE(by148_a[j].x) + FLOAT_TYPE(by148_a[j].y);
            sy2_a[j] = FLOAT_TYPE(by20_a[j].x)  + FLOAT_TYPE(by20_a[j].y)  + FLOAT_TYPE(by216_a[j].x) + FLOAT_TYPE(by216_a[j].y);
            sy3_a[j] = FLOAT_TYPE(by232_a[j].x) + FLOAT_TYPE(by232_a[j].y) + FLOAT_TYPE(by248_a[j].x) + FLOAT_TYPE(by248_a[j].y);
        }
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib0 = a_offset + (first_row + rn) * num_blocks_per_row;
            LOAD_Q5_K_0ULP(a2, data_a2, data_a2_packed16);
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                DOT_Q5_K_0ULP_WITH_BY(a2, temp, by10_a[j], by116_a[j], by132_a[j], by148_a[j], by20_a[j], by216_a[j], by232_a[j], by248_a[j], sy0_a[j], sy1_a[j], sy2_a[j], sy3_a[j]);
            }
        }
    } else {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib0 = a_offset + (first_row + rn) * num_blocks_per_row;
            LOAD_Q5_K_0ULP(a2, data_a2, data_a2_packed16);
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint b2_1 = (j * p.batch_stride_b + b_offset + y1_idx) / 2;
                const uint b2_2 = (j * p.batch_stride_b + b_offset + y2_idx) / 2;
                const vec2 by10  = vec2(data_b_v2[b2_1     ]), by116 = vec2(data_b_v2[b2_1 +  8]);
                const vec2 by132 = vec2(data_b_v2[b2_1 + 16]), by148 = vec2(data_b_v2[b2_1 + 24]);
                const vec2 by20  = vec2(data_b_v2[b2_2     ]), by216 = vec2(data_b_v2[b2_2 +  8]);
                const vec2 by232 = vec2(data_b_v2[b2_2 + 16]), by248 = vec2(data_b_v2[b2_2 + 24]);
                const FLOAT_TYPE sumy0 = FLOAT_TYPE(by10.x)  + FLOAT_TYPE(by10.y)  + FLOAT_TYPE(by116.x) + FLOAT_TYPE(by116.y);
                const FLOAT_TYPE sumy1 = FLOAT_TYPE(by132.x) + FLOAT_TYPE(by132.y) + FLOAT_TYPE(by148.x) + FLOAT_TYPE(by148.y);
                const FLOAT_TYPE sumy2 = FLOAT_TYPE(by20.x)  + FLOAT_TYPE(by20.y)  + FLOAT_TYPE(by216.x) + FLOAT_TYPE(by216.y);
                const FLOAT_TYPE sumy3 = FLOAT_TYPE(by232.x) + FLOAT_TYPE(by232.y) + FLOAT_TYPE(by248.x) + FLOAT_TYPE(by248.y);
                DOT_Q5_K_0ULP_WITH_BY(a2, temp, by10, by116, by132, by148, by20, by216, by232, by248, sumy0, sumy1, sumy2, sumy3);
            }
        }
    }
}

#define LOAD_Q5_K_16_VEC4(PFX, ARR_A, ARR_P16, ARR_P32) \
    const FLOAT_TYPEV2 PFX##_dm = FLOAT_TYPEV2(ARR_A[ib0 + i].dm); \
    const uint32_t PFX##_scale0_u32 = ARR_P16[ib0 + i].scales[v_im    ]; \
    const uint32_t PFX##_scale4_u32 = ARR_P16[ib0 + i].scales[v_im + 2]; \
    const uint32_t PFX##_scale8_u32 = ARR_P16[ib0 + i].scales[v_im + 4]; \
    const uint32_t PFX##_scale_0_4_l = (PFX##_scale4_u32 << 16) | PFX##_scale0_u32; \
    const uint32_t PFX##_scale_0_4_h = (PFX##_scale_0_4_l & 0xC0C0C0C0u) >> 2; \
    const vec4 PFX##_sc03 = vec4(unpack8(PFX##_scale_0_4_l & 0x3F3F3F3Fu)); \
    const vec4 PFX##_sc47 = vec4(unpack8((((PFX##_scale8_u32 << 12) | PFX##_scale8_u32) & 0x0F0F0F0Fu) | PFX##_scale_0_4_h)); \
    const uint32_t PFX##_qs0_u32  = ARR_P32[ib0 + i].qs[q_offset / 4]; \
    const uint32_t PFX##_qs64_u32 = ARR_P32[ib0 + i].qs[q_offset / 4 + 16]; \
    const uint32_t PFX##_qh_s = ARR_P32[ib0 + i].qh[l0 / 4] >> (2 * v_im); \
    const vec4 PFX##_q0_lo = vec4(unpack8((PFX##_qs0_u32  & 0x0F0F0F0Fu) | ((PFX##_qh_s & 0x01010101u) << 4))); \
    const vec4 PFX##_q0_hi = vec4(unpack8(((PFX##_qs0_u32  >> 4) & 0x0F0F0F0Fu) | ((PFX##_qh_s & 0x02020202u) << 3))); \
    const vec4 PFX##_q2_lo = vec4(unpack8((PFX##_qs64_u32 & 0x0F0F0F0Fu) | (PFX##_qh_s & 0x10101010u))); \
    const vec4 PFX##_q2_hi = vec4(unpack8(((PFX##_qs64_u32 >> 4) & 0x0F0F0F0Fu) | ((PFX##_qh_s & 0x20202020u) >> 1)))

#define DOT_Q5_K_16_VEC4(PFX, DST_TEMP) do { \
    const uint b4_1 = (j * p.batch_stride_b + b_offset + y1_idx) / 4; \
    const uint b4_2 = (j * p.batch_stride_b + b_offset + y2_idx) / 4; \
    const vec4 by10  = vec4(data_b_v4[b4_1    ]), by132 = vec4(data_b_v4[b4_1 + 8]); \
    const vec4 by20  = vec4(data_b_v4[b4_2    ]), by232 = vec4(data_b_v4[b4_2 + 8]); \
    const FLOAT_TYPE sumy10  = (FLOAT_TYPE(by10.x)  + FLOAT_TYPE(by10.y))  + (FLOAT_TYPE(by10.z)  + FLOAT_TYPE(by10.w)); \
    const FLOAT_TYPE sumy132 = (FLOAT_TYPE(by132.x) + FLOAT_TYPE(by132.y)) + (FLOAT_TYPE(by132.z) + FLOAT_TYPE(by132.w)); \
    const FLOAT_TYPE sumy20  = (FLOAT_TYPE(by20.x)  + FLOAT_TYPE(by20.y))  + (FLOAT_TYPE(by20.z)  + FLOAT_TYPE(by20.w)); \
    const FLOAT_TYPE sumy232 = (FLOAT_TYPE(by232.x) + FLOAT_TYPE(by232.y)) + (FLOAT_TYPE(by232.z) + FLOAT_TYPE(by232.w)); \
    const FLOAT_TYPE sx = dot(by10,  PFX##_q0_lo); \
    const FLOAT_TYPE sy = dot(by132, PFX##_q0_hi); \
    const FLOAT_TYPE sz = dot(by20,  PFX##_q2_lo); \
    const FLOAT_TYPE sw = dot(by232, PFX##_q2_hi); \
    const FLOAT_TYPE smin = fma(sumy10, PFX##_sc03.z, fma(sumy132, PFX##_sc03.w, fma(sumy20, PFX##_sc47.z, sumy232 * PFX##_sc47.w))); \
    DST_TEMP[j][n] = fma(PFX##_dm.x, fma(sx, PFX##_sc03.x, fma(sy, PFX##_sc03.y, fma(sz, PFX##_sc47.x, sw * PFX##_sc47.y))), fma(-PFX##_dm.y, smin, DST_TEMP[j][n])); \
} while (false)

#define DOT_Q5_K_16_VEC4_BY(PFX, DST_TEMP, BY10, BY132, BY20, BY232, SY10, SY132, SY20, SY232) do { \
    const FLOAT_TYPE sx = dot(BY10,  PFX##_q0_lo); \
    const FLOAT_TYPE sy = dot(BY132, PFX##_q0_hi); \
    const FLOAT_TYPE sz = dot(BY20,  PFX##_q2_lo); \
    const FLOAT_TYPE sw = dot(BY232, PFX##_q2_hi); \
    const FLOAT_TYPE smin = fma(SY10, PFX##_sc03.z, fma(SY132, PFX##_sc03.w, fma(SY20, PFX##_sc47.z, (SY232) * PFX##_sc47.w))); \
    DST_TEMP[j][n] = fma(PFX##_dm.x, fma(sx, PFX##_sc03.x, fma(sy, PFX##_sc03.y, fma(sz, PFX##_sc47.x, sw * PFX##_sc47.y))), fma(-PFX##_dm.y, smin, DST_TEMP[j][n])); \
} while (false)

void calc_superblock_vec4_a(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], inout FLOAT_TYPE temp2[NUM_COLS][NUM_ROWS], const uint a_offset, const uint b_offset, const uint v_im, const uint l0, const uint q_offset, const uint y_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y1_idx = i * QUANT_K + y_offset;
    const uint y2_idx = y1_idx + 128;

    if (GEN_FAST_KQ > 0) {
        if (NUM_COLS <= 4) {
            vec4 by10_a[NUM_COLS], by132_a[NUM_COLS], by20_a[NUM_COLS], by232_a[NUM_COLS];
            FLOAT_TYPE sy10_a[NUM_COLS], sy132_a[NUM_COLS], sy20_a[NUM_COLS], sy232_a[NUM_COLS];
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint b4_1 = (j * p.batch_stride_b + b_offset + y1_idx) / 4;
                const uint b4_2 = (j * p.batch_stride_b + b_offset + y2_idx) / 4;
                by10_a[j]  = vec4(data_b_v4[b4_1    ]); by132_a[j] = vec4(data_b_v4[b4_1 + 8]);
                by20_a[j]  = vec4(data_b_v4[b4_2    ]); by232_a[j] = vec4(data_b_v4[b4_2 + 8]);
                sy10_a[j]  = (FLOAT_TYPE(by10_a[j].x)  + FLOAT_TYPE(by10_a[j].y))  + (FLOAT_TYPE(by10_a[j].z)  + FLOAT_TYPE(by10_a[j].w));
                sy132_a[j] = (FLOAT_TYPE(by132_a[j].x) + FLOAT_TYPE(by132_a[j].y)) + (FLOAT_TYPE(by132_a[j].z) + FLOAT_TYPE(by132_a[j].w));
                sy20_a[j]  = (FLOAT_TYPE(by20_a[j].x)  + FLOAT_TYPE(by20_a[j].y))  + (FLOAT_TYPE(by20_a[j].z)  + FLOAT_TYPE(by20_a[j].w));
                sy232_a[j] = (FLOAT_TYPE(by232_a[j].x) + FLOAT_TYPE(by232_a[j].y)) + (FLOAT_TYPE(by232_a[j].z) + FLOAT_TYPE(by232_a[j].w));
            }
            [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                const uint rn = (n == 0 || n < num_rows) ? n : 0;
                const uint ib0 = a_offset + (first_row + rn) * num_blocks_per_row;
                LOAD_Q5_K_16_VEC4(a1, data_a, data_a_packed16, data_a_packed32);
                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    DOT_Q5_K_16_VEC4_BY(a1, temp, by10_a[j], by132_a[j], by20_a[j], by232_a[j], sy10_a[j], sy132_a[j], sy20_a[j], sy232_a[j]);
                }
                if (GEN_GLU == 3) {
                    LOAD_Q5_K_16_VEC4(a2, data_a2, data_a2_packed16, data_a2_packed32);
                    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                        DOT_Q5_K_16_VEC4_BY(a2, temp2, by10_a[j], by132_a[j], by20_a[j], by232_a[j], sy10_a[j], sy132_a[j], sy20_a[j], sy232_a[j]);
                    }
                }
            }
            return;
        }
    }
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        const uint rn = (n == 0 || n < num_rows) ? n : 0;
        const uint ib0 = a_offset + (first_row + rn) * num_blocks_per_row;
        LOAD_Q5_K_16_VEC4(a1, data_a, data_a_packed16, data_a_packed32);
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            DOT_Q5_K_16_VEC4(a1, temp);
        }
        if (GEN_GLU == 3) {
            LOAD_Q5_K_16_VEC4(a2, data_a2, data_a2_packed16, data_a2_packed32);
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                DOT_Q5_K_16_VEC4(a2, temp2);
            }
        }
    }
}

