#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#if defined(DATA_A_Q8_0) || defined(DATA_A_NVFP4)
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

#include "mul_mat_vec_base.glsl"
#include "dequant_funcs.glsl"

#if defined(USE_SUBGROUP_ADD_NO_SHMEM) && !defined(NEEDS_INIT_IQ_SHMEM)
layout(local_size_x_id = 0, local_size_y_id = 4, local_size_z = 1) in;
#else
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
#endif

#if !defined(DATA_A_F32) && !defined(DATA_A_F16) && !defined(DATA_A_BF16)
#define K_PER_ITER 8
#else
#define K_PER_ITER 4
#endif


uint a_offset, b_offset, d_offset, y_offset;

vec4 load_b(const uint j, const uint iybs, const uint iqs, const bool lastiter, out bool OOB_y, out bool OOB_z, out bool OOB_w) {
    // Check if the latter elements are OOB, and don't fetch B or accumulate it.
    OOB_y = lastiter && (iybs + iqs + y_offset >= p.ncols);
    OOB_z = lastiter && (iybs + iqs + y_offset*2 >= p.ncols);
    OOB_w = lastiter && (iybs + iqs + y_offset*3 >= p.ncols);

    if (!OOB_w) {
        return vec4(FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset*2]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset*3]));
    } else if (!OOB_z) {
        return vec4(FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset*2]),
                 0);
    } else if (!OOB_y) {
        return vec4(FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs]),
                 FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs + y_offset]),
                 0, 0);
    } else if (!lastiter || iybs + iqs < p.ncols) {
        return vec4(FLOAT_TYPE(data_b[j*p.batch_stride_b + b_offset + iybs + iqs]),
                 0, 0, 0);
    } else {
        return vec4(0);
    }
}

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i, bool lastiter)
{
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
        const uint iqs = (col%QUANT_K)/QUANT_R; // quant index
        const uint iybs = col - col%QUANT_K; // y block start index

#if K_PER_ITER == 8
#if QUANT_R == 2
        // Note that we end up fetching bogus elements here, but its fine as they'll be
        // within an accessible block.
        const vec4 bv02 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
        const vec4 bv13 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs + y_offset) / 4]);
        const vec4 bv0 = vec4(bv02.x, bv13.x, bv02.y, bv13.y);
        const vec4 bv1 = vec4(bv02.z, bv13.z, bv02.w, bv13.w);
#else
        const vec4 bv0 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4]);
        const vec4 bv1 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + iybs + iqs) / 4 + 1]);
#endif
#else
        bool OOB_y;
        bool OOB_z;
        bool OOB_w;

        const vec4 b = load_b(j, iybs, iqs, lastiter, OOB_y, OOB_z, OOB_w);
#endif
        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib = (ibi + rn*p.ncols + col)/QUANT_K; // block index

#if K_PER_ITER == 8
            vec4 v = dequantize4(ib, iqs, a_offset);
            vec4 v2 = dequantize4(ib, iqs+(4/QUANT_R), a_offset);

#if defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1)
            const vec2 dm = get_dm(ib, a_offset);
            if (dm.y != 0) { // quant has min component
                v = v * dm.x + dm.y;
                v2 = v2 * dm.x + dm.y;
            }

            // matrix multiplication
            FLOAT_TYPE rowtmp = dot(bv0, v);
            rowtmp += dot(bv1, v2);

            if (dm.y == 0)
                rowtmp *= dm.x;
#elif defined(DATA_A_NVFP4)
            FLOAT_TYPE rowtmp = dot(bv0, v);
            rowtmp += dot(bv1, v2);
#else
            FLOAT_TYPE rowtmp = dot(bv0, v);
            rowtmp += dot(bv1, v2);
            rowtmp *= get_dm(ib, a_offset).x;
#endif

            temp[j][n] += rowtmp;
#else
            if (!OOB_w) {
                const vec4 v = dequantize4(ib, iqs, a_offset);
                temp[j][n] += dot(v, b);
            } else if (!OOB_z) {
                const vec2 v0 = dequantize(ib, iqs, a_offset);
                const FLOAT_TYPE v1 = dequantize1(ib + 2/QUANT_R, iqs, a_offset);
                const vec3 v = vec3(v0.x, v0.y, v1);
                const vec3 b0 = vec3(b.x, b.y, b.z);
                temp[j][n] += dot(v, b0);
            } else if (!OOB_y) {
                const vec2 v0 = dequantize(ib, iqs, a_offset);
                const vec2 b0 = vec2(b.x, b.y);
                temp[j][n] += dot(v0, b0);
            } else {
                const FLOAT_TYPE v = dequantize1(ib, iqs, a_offset);
                temp[j][n] = fma(v, b.x, temp[j][n]);
            }
#endif
        }
    }
}

#if defined(DATA_A_F32) || defined(DATA_A_F16) || defined(DATA_A_BF16)
vec4 dequantize4_2aligned_a2(uint ib, uint a_offset) {
#if defined(DATA_A_F32)
    const vec2 a = data_a2_packed64[(a_offset + ib)/2];
    const vec2 b = data_a2_packed64[(a_offset + ib)/2 + 1];
    return vec4(a, b);
#elif defined(DATA_A_F16)
    const vec2 a = data_a2_packed32[(a_offset + ib)/2];
    const vec2 b = data_a2_packed32[(a_offset + ib)/2 + 1];
    return vec4(a, b);
#else
    const uint a = data_a2_packed32[(a_offset + ib)/2];
    const uint b = data_a2_packed32[(a_offset + ib)/2 + 1];
    return vec4(uintBitsToFloat((a & 0x0000ffff) << 16),
                uintBitsToFloat( a & 0xffff0000),
                uintBitsToFloat((b & 0x0000ffff) << 16),
                uintBitsToFloat( b & 0xffff0000));
#endif
}

void iter_aligned_nonquant_a(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], inout FLOAT_TYPE temp2[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i)
{
    const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
    uint ibi = first_row*p.ncols;
    if (NUM_COLS <= 8) {
        vec4 b_arr[8];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_arr[j] = data_b_v4[(j*p.batch_stride_b + b_offset + col) / 4];
        }
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib = (ibi + rn*p.ncols + col)/QUANT_K;
            const vec4 v = dequantize4_2aligned(ib, 0, a_offset);
            vec4 u = vec4(0.0);
            if (GEN_GLU == 3) {
                u = dequantize4_2aligned_a2(ib, a_offset);
            }
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                temp[j][n] += dot(v, b_arr[j]);
                if (GEN_GLU == 3) {
                    temp2[j][n] += dot(u, b_arr[j]);
                }
            }
        }
    } else {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib = (ibi + rn*p.ncols + col)/QUANT_K;
            const vec4 v = dequantize4_2aligned(ib, 0, a_offset);
            vec4 u = vec4(0.0);
            if (GEN_GLU == 3) {
                u = dequantize4_2aligned_a2(ib, a_offset);
            }
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const vec4 b = data_b_v4[(j*p.batch_stride_b + b_offset + col) / 4];
                temp[j][n] += dot(v, b);
                if (GEN_GLU == 3) {
                    temp2[j][n] += dot(u, b);
                }
            }
        }
    }
}

void iter_aligned_nonquant_a2(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i)
{
    const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
    uint ibi = first_row*p.ncols;
    if (NUM_COLS <= 4) {
        vec4 b_arr[4];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            b_arr[j] = data_b_v4[(j*p.batch_stride_b + b_offset + col) / 4];
        }
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib = (ibi + rn*p.ncols + col)/QUANT_K;
            const vec4 v = dequantize4_2aligned_a2(ib, a_offset);
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                temp[j][n] += dot(v, b_arr[j]);
            }
        }
    } else {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib = (ibi + rn*p.ncols + col)/QUANT_K;
            const vec4 v = dequantize4_2aligned_a2(ib, a_offset);
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const vec4 b = data_b_v4[(j*p.batch_stride_b + b_offset + col) / 4];
                temp[j][n] += dot(v, b);
            }
        }
    }
}
#endif

#if defined(DATA_A_NVFP4) && !defined(USE_OCP_FP4)
vec4 nvfp4_decode_nibs(const uint qs_shifted) {
    const f16vec2 ev = unpackFloat2x16(nvfp4_e2m1_pair_fp16_bits(qs_shifted));
    const f16vec2 od = unpackFloat2x16(nvfp4_e2m1_pair_fp16_bits(qs_shifted >> 8u));
    return vec4(ev.x, od.x, ev.y, od.y);
}

float nvfp4_decode_scale(const uint d_u32, const uint sub) {
    const uint du = (d_u32 >> (sub * 8u)) & 0xFFu;
    return ue4m3_to_fp32_build(du);
}

#ifdef REPACK_PLANAR
void nvfp4_load_planar_a(const uint b_in_slice, const uint sub, const uint shift, out float da, out vec4 v0, out vec4 v1) {
#ifdef MUL_MAT_ID
    const uint s_blks = p.batch_stride_a >> 6u;
#else
    const uint s_blks = (p.ncols >> 6u) * ((GEN_GLU == 2u) ? p.pair_m0 : p.stride_d);
#endif
    const uint slice_u32 = a_offset * 9u;
    const uint slice_u2  = slice_u32 >> 1u;
    da = nvfp4_decode_scale(data_a_repack_u32[slice_u32 + s_blks * 8u + b_in_slice], sub);
    const uvec2 q01 = data_a_repack_u2[slice_u2 + b_in_slice * 4u + sub];
    v0 = nvfp4_decode_nibs(q01.x >> shift);
    v1 = nvfp4_decode_nibs(q01.y >> shift);
}

void nvfp4_load_planar_a2(const uint b_in_slice, const uint sub, const uint shift, out float da, out vec4 v0, out vec4 v1) {
#ifdef MUL_MAT_ID
    const uint s_blks = p.batch_stride_a >> 6u;
#else
    const uint s_blks = (p.ncols >> 6u) * ((GEN_GLU == 2u) ? p.stride_d2 : p.stride_d);
#endif
    const uint slice_u32 = a_offset * 9u;
    const uint slice_u2  = slice_u32 >> 1u;
    da = nvfp4_decode_scale(data_a2_repack_u32[slice_u32 + s_blks * 8u + b_in_slice], sub);
    const uvec2 q01 = data_a2_repack_u2[slice_u2 + b_in_slice * 4u + sub];
    v0 = nvfp4_decode_nibs(q01.x >> shift);
    v1 = nvfp4_decode_nibs(q01.y >> shift);
}
#endif

void iter_aligned_nvfp4_a(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], inout FLOAT_TYPE temp2[NUM_COLS][NUM_ROWS], const uint row_base, const uint num_rows, const uint tid, const uint iter_idx) {
    const uint b_col4 = iter_idx * (2u * BLOCK_SIZE) + 2u * tid;
    const uint lane8  = tid & 7u;
    const uint sub    = lane8 >> 1u;
    const uint shift  = (lane8 & 1u) * 4u;
    const uint ib_col = iter_idx * (BLOCK_SIZE >> 3u) + (tid >> 3u);
    const uint blocks_per_row = p.ncols >> 6u;

    if (NUM_COLS <= 4) {
        vec4 bv0_arr[NUM_COLS];
        vec4 bv1_arr[NUM_COLS];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b4 = (j * p.batch_stride_b + b_offset) >> 2u;
            bv0_arr[j] = vec4(data_b_v4[b4 + b_col4]);
            bv1_arr[j] = vec4(data_b_v4[b4 + b_col4 + 1u]);
        }
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0u || n < num_rows) ? n : 0u;
#ifdef REPACK_PLANAR
            const uint b_in_slice = (row_base + rn) * blocks_per_row + ib_col;
            float da; vec4 v0, v1;
            nvfp4_load_planar_a(b_in_slice, sub, shift, da, v0, v1);
#else
            const uint ib = a_offset + (row_base + rn) * blocks_per_row + ib_col;
            const float da = nvfp4_decode_scale(data_a_packed32[ib].d[0], sub);
            const vec4  v0 = nvfp4_decode_nibs(data_a_packed32[ib].qs[2u * sub + 0u] >> shift);
            const vec4  v1 = nvfp4_decode_nibs(data_a_packed32[ib].qs[2u * sub + 1u] >> shift);
#endif
            vec4 u0 = vec4(0.0), u1 = vec4(0.0);
            float da2 = 0.0f;
            if (GEN_GLU == 3) {
#ifdef MUL_MAT_ID
                if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SITU_MERGED) != 0u) {
#ifdef REPACK_PLANAR
                    nvfp4_load_planar_a(b_in_slice + p.stride_d * blocks_per_row, sub, shift, da2, u0, u1);
#else
                    const uint ib_u = ib + p.stride_d * blocks_per_row;
                    da2 = nvfp4_decode_scale(data_a_packed32[ib_u].d[0], sub);
                    u0  = nvfp4_decode_nibs(data_a_packed32[ib_u].qs[2u * sub + 0u] >> shift);
                    u1  = nvfp4_decode_nibs(data_a_packed32[ib_u].qs[2u * sub + 1u] >> shift);
#endif
                } else
#endif
                {
#ifdef REPACK_PLANAR
                    nvfp4_load_planar_a2(b_in_slice, sub, shift, da2, u0, u1);
#else
                    da2 = nvfp4_decode_scale(data_a2_packed32[ib].d[0], sub);
                    u0  = nvfp4_decode_nibs(data_a2_packed32[ib].qs[2u * sub + 0u] >> shift);
                    u1  = nvfp4_decode_nibs(data_a2_packed32[ib].qs[2u * sub + 1u] >> shift);
#endif
                }
            }
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                temp[j][n] += FLOAT_TYPE((dot(bv0_arr[j], v0) + dot(bv1_arr[j], v1)) * da);
                if (GEN_GLU == 3) {
                    temp2[j][n] += FLOAT_TYPE((dot(bv0_arr[j], u0) + dot(bv1_arr[j], u1)) * da2);
                }
            }
        }
    } else {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0u || n < num_rows) ? n : 0u;
#ifdef REPACK_PLANAR
            const uint b_in_slice = (row_base + rn) * blocks_per_row + ib_col;
            float da; vec4 v0, v1;
            nvfp4_load_planar_a(b_in_slice, sub, shift, da, v0, v1);
#else
            const uint ib = a_offset + (row_base + rn) * blocks_per_row + ib_col;
            const float da = nvfp4_decode_scale(data_a_packed32[ib].d[0], sub);
            const vec4  v0 = nvfp4_decode_nibs(data_a_packed32[ib].qs[2u * sub + 0u] >> shift);
            const vec4  v1 = nvfp4_decode_nibs(data_a_packed32[ib].qs[2u * sub + 1u] >> shift);
#endif
            vec4 u0 = vec4(0.0), u1 = vec4(0.0);
            float da2 = 0.0f;
            if (GEN_GLU == 3) {
#ifdef MUL_MAT_ID
                if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SITU_MERGED) != 0u) {
#ifdef REPACK_PLANAR
                    nvfp4_load_planar_a(b_in_slice + p.stride_d * blocks_per_row, sub, shift, da2, u0, u1);
#else
                    const uint ib_u = ib + p.stride_d * blocks_per_row;
                    da2 = nvfp4_decode_scale(data_a_packed32[ib_u].d[0], sub);
                    u0  = nvfp4_decode_nibs(data_a_packed32[ib_u].qs[2u * sub + 0u] >> shift);
                    u1  = nvfp4_decode_nibs(data_a_packed32[ib_u].qs[2u * sub + 1u] >> shift);
#endif
                } else
#endif
                {
#ifdef REPACK_PLANAR
                    nvfp4_load_planar_a2(b_in_slice, sub, shift, da2, u0, u1);
#else
                    da2 = nvfp4_decode_scale(data_a2_packed32[ib].d[0], sub);
                    u0  = nvfp4_decode_nibs(data_a2_packed32[ib].qs[2u * sub + 0u] >> shift);
                    u1  = nvfp4_decode_nibs(data_a2_packed32[ib].qs[2u * sub + 1u] >> shift);
#endif
                }
            }
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const uint b4 = (j * p.batch_stride_b + b_offset) >> 2u;
                const vec4 bv0 = vec4(data_b_v4[b4 + b_col4]);
                const vec4 bv1 = vec4(data_b_v4[b4 + b_col4 + 1u]);
                temp[j][n] += FLOAT_TYPE((dot(bv0, v0) + dot(bv1, v1)) * da);
                if (GEN_GLU == 3) {
                    temp2[j][n] += FLOAT_TYPE((dot(bv0, u0) + dot(bv1, u1)) * da2);
                }
            }
        }
    }
}

void iter_aligned_nvfp4_a2(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint row_base, const uint num_rows, const uint tid, const uint iter_idx) {
    const uint b_col4 = iter_idx * (2u * BLOCK_SIZE) + 2u * tid;
    const uint lane8  = tid & 7u;
    const uint sub    = lane8 >> 1u;
    const uint shift  = (lane8 & 1u) * 4u;
    const uint ib_col = iter_idx * (BLOCK_SIZE >> 3u) + (tid >> 3u);
    const uint blocks_per_row = p.ncols >> 6u;
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        const uint rn = (n == 0u || n < num_rows) ? n : 0u;
#ifdef REPACK_PLANAR
        const uint b_in_slice = (row_base + rn) * blocks_per_row + ib_col;
        float da; vec4 v0, v1;
        nvfp4_load_planar_a2(b_in_slice, sub, shift, da, v0, v1);
#else
        const uint ib = a_offset + (row_base + rn) * blocks_per_row + ib_col;
        const float da = nvfp4_decode_scale(data_a2_packed32[ib].d[0], sub);
        const vec4  v0 = nvfp4_decode_nibs(data_a2_packed32[ib].qs[2u * sub + 0u] >> shift);
        const vec4  v1 = nvfp4_decode_nibs(data_a2_packed32[ib].qs[2u * sub + 1u] >> shift);
#endif
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b4 = (j * p.batch_stride_b + b_offset) >> 2u;
            const vec4 bv0 = vec4(data_b_v4[b4 + b_col4]);
            const vec4 bv1 = vec4(data_b_v4[b4 + b_col4 + 1u]);
            temp[j][n] += FLOAT_TYPE((dot(bv0, v0) + dot(bv1, v1)) * da);
        }
    }
}
#endif

#if defined(DATA_A_Q8_0)
vec4 q8_0_decode_magic(const i16vec2 qh)
{
    const uint biased = pack32(qh) ^ 0x80808080u;
    const f16vec2 ev = unpackFloat2x16((biased & 0x00FF00FFu) | 0x64006400u) - f16vec2(1152.0);
    const f16vec2 od = unpackFloat2x16(((biased >> 8u) & 0x00FF00FFu) | 0x64006400u) - f16vec2(1152.0);
    return vec4(ev.x, od.x, ev.y, od.y);
}

void iter_aligned_q8_0_a(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], inout FLOAT_TYPE temp2[NUM_COLS][NUM_ROWS], const uint row_base, const uint num_rows, const uint tid, const uint iter_idx)
{
    const uint b_col4 = iter_idx * (2 * BLOCK_SIZE) + 2 * tid;
    const uint iqs_h = 4 * (tid & 3);
    const uint ib_col = iter_idx * (BLOCK_SIZE >> 2) + (tid >> 2);
    const uint blocks_per_row = p.ncols >> 5;

    if (NUM_COLS <= 4) {
        vec4 bv0_arr[NUM_COLS];
        vec4 bv1_arr[NUM_COLS];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b4 = (j * p.batch_stride_b + b_offset) >> 2;
            bv0_arr[j] = vec4(data_b_v4[b4 + b_col4]);
            bv1_arr[j] = vec4(data_b_v4[b4 + b_col4 + 1]);
        }
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            const uint rn = (n == 0 || n < num_rows) ? n : 0;
            const uint ib = a_offset + (row_base + rn) * blocks_per_row + ib_col;
            const vec4 v  = q8_0_decode_magic(i16vec2(data_a_packed16[ib].qs[iqs_h    ], data_a_packed16[ib].qs[iqs_h + 1]));
