    } else {
        iter_aligned_q8_0_a2(temp, row_base, num_rows, tid, iter_idx);
        iter_aligned_q8_0_a2(temp, row_base, num_rows, tid, iter_idx + 1);
    }
}
#endif

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
#if defined(USE_SUBGROUP_ADD_NO_SHMEM) && !defined(NEEDS_INIT_IQ_SHMEM)
    const uint tid = gl_SubgroupInvocationID;
#else
    const uint tid = gl_LocalInvocationID.x;
#endif

    get_offsets(a_offset, b_offset, d_offset);
#ifndef MUL_MAT_ID
    const bool use_a2   = (GEN_GLU == 2) && (first_row >= p.pair_m0);
    const uint row_base = use_a2 ? (first_row - p.pair_m0) : first_row;
    const uint eff_rows = (!use_a2 && GEN_GLU == 2) ? min(num_rows, p.pair_m0 - first_row) : num_rows;
#else
    const bool use_a2   = false;
    const uint row_base = first_row;
    const uint eff_rows = num_rows;
#endif

    const bool is_aligned_nonquant =
        p.batch_stride_b % 4 == 0 && p.ncols % 4 == 0 &&
        a_offset % 4 == 0 && b_offset % 4 == 0 &&
        BLOCK_SIZE % 4 == 0 && K_PER_ITER == 4;

    y_offset = QUANT_R == 1 ? 1 : QUANT_K/2;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
    FLOAT_TYPE temp2[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
            if (GEN_GLU == 3) {
                temp2[j][i] = FLOAT_TYPE(0);
            }
        }
    }

#if defined(DATA_A_NVFP4) && !defined(USE_OCP_FP4)
    if ((p.ncols & 63u) == 0u && (p.batch_stride_b & 3u) == 0u && (b_offset & 3u) == 0u && (BLOCK_SIZE & 7u) == 0u) {
        if (eff_rows == 0u) {
            return;
        }
        const uint full_iters = p.ncols / (8u * BLOCK_SIZE);
        const bool has_tail   = (full_iters * (8u * BLOCK_SIZE) + 8u * tid < p.ncols);
        if (GEN_GLU == 2 && use_a2) {
            for (uint it = 0u; it < full_iters; ++it) {
                iter_aligned_nvfp4_a2(temp, row_base, eff_rows, tid, it);
            }
            if (has_tail) {
                iter_aligned_nvfp4_a2(temp, row_base, eff_rows, tid, full_iters);
            }
        } else {
            for (uint it = 0u; it < full_iters; ++it) {
                iter_aligned_nvfp4_a(temp, temp2, row_base, eff_rows, tid, it);
            }
            if (has_tail) {
                iter_aligned_nvfp4_a(temp, temp2, row_base, eff_rows, tid, full_iters);
            }
        }
        if (GEN_GLU == 3) {
            reduce_pair_glu(temp, temp2, d_offset, first_row, eff_rows, tid);
        }
#ifndef MUL_MAT_ID
        else if (GEN_GLU == 2 && use_a2) {
            reduce_result_d2(temp, row_base, eff_rows, tid);
        }
#endif
        else {
            reduce_result(temp, d_offset, first_row, eff_rows, tid);
        }
        return;
    }
#endif

#if defined(DATA_A_Q8_0)
    if ((p.ncols & 31) == 0 && (p.batch_stride_b & 3) == 0 && (b_offset & 3) == 0 && (BLOCK_SIZE & 3) == 0) {
        if (eff_rows == 0) {
            return;
        }
        const uint full_iters = p.ncols / (8 * BLOCK_SIZE);
        const bool has_tail = (full_iters * (8 * BLOCK_SIZE) + 8 * tid < p.ncols);
        uint it = 0;
        if (GEN_GLU == 2 && use_a2) {
            if (NUM_ROWS == 1 && NUM_COLS <= 4) {
                for (; it + 1 < full_iters; it += 2) {
                    iter2_aligned_q8_0_a2(temp, row_base, eff_rows, tid, it);
                }
            }
            for (; it < full_iters; ++it) {
                iter_aligned_q8_0_a2(temp, row_base, eff_rows, tid, it);
            }
            if (has_tail) {
                iter_aligned_q8_0_a2(temp, row_base, eff_rows, tid, full_iters);
            }
        } else {
            if (NUM_ROWS == 1 && NUM_COLS <= 4) {
                for (; it + 1 < full_iters; it += 2) {
                    iter2_aligned_q8_0_a(temp, temp2, row_base, eff_rows, tid, it);
                }
            }
            for (; it < full_iters; ++it) {
                iter_aligned_q8_0_a(temp, temp2, row_base, eff_rows, tid, it);
            }
            if (has_tail) {
                iter_aligned_q8_0_a(temp, temp2, row_base, eff_rows, tid, full_iters);
            }
        }
        if (GEN_GLU == 3) {
            reduce_pair_glu(temp, temp2, d_offset, first_row, eff_rows, tid);
        }
#ifndef MUL_MAT_ID
        else if (GEN_GLU == 2 && use_a2) {
            reduce_result_d2(temp, row_base, eff_rows, tid);
        }
#endif
        else {
            reduce_result(temp, d_offset, first_row, eff_rows, tid);
        }
        return;
    }
#endif

    if (eff_rows == 0) {
        return;
    }

    uint num_iters = p.ncols / (K_PER_ITER * BLOCK_SIZE);
    if (num_iters * K_PER_ITER * BLOCK_SIZE + K_PER_ITER*tid < p.ncols) {
        num_iters++;
    }

#if K_PER_ITER == 4 && (defined(DATA_A_F32) || defined(DATA_A_F16) || defined(DATA_A_BF16))
    if (is_aligned_nonquant) {
        if (GEN_GLU == 2 && use_a2) {
            for (uint it = 0; it < num_iters; ++it) {
                iter_aligned_nonquant_a2(temp, row_base, eff_rows, tid, it*K_PER_ITER);
            }
        } else {
            for (uint it = 0; it < num_iters; ++it) {
                iter_aligned_nonquant_a(temp, temp2, row_base, eff_rows, tid, it*K_PER_ITER);
            }
        }
        if (GEN_GLU == 3) {
            reduce_pair_glu(temp, temp2, d_offset, first_row, eff_rows, tid);
        }
#ifndef MUL_MAT_ID
        else if (GEN_GLU == 2 && use_a2) {
            reduce_result_d2(temp, row_base, eff_rows, tid);
        }
#endif
        else {
            reduce_result(temp, d_offset, first_row, eff_rows, tid);
        }
        return;
    }
#endif

    uint unrolled_iters = num_iters;
#if K_PER_ITER == 4
    if ((p.ncols & 3) != 0 && unrolled_iters > 0) {
        unrolled_iters--;
    }
#endif
    uint i = 0;
    while (i < unrolled_iters) {
        iter(temp, row_base, eff_rows, tid, i*K_PER_ITER, false);
        i++;
    }
    while (i < num_iters) {
        iter(temp, row_base, eff_rows, tid, i*K_PER_ITER, true);
        i++;
    }

    if (GEN_GLU == 3) {
        reduce_pair_glu(temp, temp2, d_offset, first_row, eff_rows, tid);
    }
#ifndef MUL_MAT_ID
    else if (GEN_GLU == 2 && use_a2) {
        reduce_result_d2(temp, row_base, eff_rows, tid);
    }
#endif
    else {
        reduce_result(temp, d_offset, first_row, eff_rows, tid);
    }
}

void main() {
#if defined(USE_SUBGROUP_ADD_NO_SHMEM) && !defined(NEEDS_INIT_IQ_SHMEM)
    const uint first_row = NUM_ROWS * (NUM_SUBGROUPS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z) + gl_SubgroupID);
#else
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
#endif

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    if (first_row >= p.stride_d) {
        return;
    }
    compute_outputs(first_row, min(NUM_ROWS, p.stride_d - first_row));
}
