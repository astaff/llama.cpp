//   - 1-row software prefetch + Exact Top-2 Pigeonhole across 32 disjoint streams!
// ============================================================================
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define DSPARK_F_HAS_W2_BIAS (1u << 2)
#define DSPARK_F_EMIT_TOP64  (1u << 3)

layout(push_constant) uniform PushArgs {
    uint64_t markov_va;
    uint64_t w2_va;
    uint64_t w2_bias_va;
    uint64_t base_va;
    uint64_t out_logits_va;
