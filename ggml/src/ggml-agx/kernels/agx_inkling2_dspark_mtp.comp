    uint64_t cand_idx_va;
    uint     rank;
    uint     n_vocab;
    uint     n_blocks;
    uint     block_drafts;
    uint     draft_pos;
    uint     n_splits;
    uint     w2_wtype;
    uint     w2_row_bytes;
    uint     flags;
    float    w2_scale;
    float    softcap;
    float    inv_softcap;
    uint     base_stride_f32;
    uint     pad0;
} pc;

shared f16vec2 s_mk_pair[128]; //   512 B (pre-packed (m[k], m[k+4]) matching Q4_32 nibbles!)
shared float   s_logits[1280]; // 5,120 B (up to V=204,800 @ 160 splits -> 0 global re-reads!)
shared float   s_val[256];     // 1,024 B
shared int     s_idx[256];     // 1,024 B
shared float   s_t2[8];        //    32 B (Top-2 Pigeonhole threshold reduction across 8 SGs)
shared uint    s_cnt;          //     4 B -> TOTAL 7,716 B <= 8,192 B (4 WGs/core = 32 SGs/core!)

void bitonic_sort_desc13(uint n, uint tid) {
    const uint half_n = n >> 1u;
    for (uint k = 2u; k <= n; k <<= 1u) {
        for (uint j = k >> 1u; j > 0u; j >>= 1u) {
            if (tid < half_n) {
                uint low_mask = j - 1u;
                uint lo = ((tid & ~low_mask) << 1u) | (tid & low_mask);
                uint hi = lo | j;
                bool asc_dir = ((lo & k) == 0u);
                float va = s_val[lo]; int ia = s_idx[lo];
                float vb = s_val[hi]; int ib = s_idx[hi];
                bool a_before = comes_before_desc(va, ia, vb, ib);
                if (asc_dir ? (!a_before) : a_before) {
                    s_val[lo] = vb; s_idx[lo] = ib;
                    s_val[hi] = va; s_idx[hi] = ia;
                }
            }
            barrier();
        }
    }
}

void main() {
    const uint split = gl_WorkGroupID.x;
    const uint blk   = gl_WorkGroupID.y;
    if (split >= pc.n_splits || blk >= pc.n_blocks) return;

    const uint tid     = gl_LocalInvocationID.x; // 0..255
    const uint sg      = tid >> 5u;              // 0..7
    const uint ln      = tid & 31u;              // 0..31
    const uint row_in8 = sg * 4u + (ln >> 3u);   // 0..31 (32 disjoint row-streams!)
    const uint l8      = ln & 7u;                // 0..7  (32 weights/lane)

    // Pre-pack R=256 markov vector into f16vec2(m[k0+j], m[k0+4+j]) ONCE per WG!
    if (tid < 128u) {
        const uint64_t mk_va = pc.markov_va + uint64_t(blk) * 256ul * 4ul;
        ConstBufF32 mb = ConstBufF32(mk_va);
        const uint base_k = (tid >> 2u) * 8u;
        const uint j      = tid & 3u;
        s_mk_pair[tid] = f16vec2(float16_t(mb.v[base_k + j]), float16_t(mb.v[base_k + j + 4u]));
    }
    barrier();

    const uint V        = pc.n_vocab;
    const uint base_str = (pc.base_stride_f32 > 0u) ? pc.base_stride_f32 : V;
    const uint chunk    = (V + pc.n_splits - 1u) / pc.n_splits;
    const uint beg      = split * chunk;
    const uint end      = min(beg + chunk, V);
    const uint n_local  = (end > beg) ? (end - beg) : 0u;
    const uint slot_idx = blk * pc.block_drafts + pc.draft_pos;
    const uint out_off  = slot_idx * V;
    const uint base_off = slot_idx * base_str;

    const bool has_bias  = (pc.flags & DSPARK_F_HAS_W2_BIAS) != 0u && pc.w2_bias_va != 0ul;
    const bool do_cap    = (pc.softcap > 0.0);
    const bool emit_top  = (pc.flags & DSPARK_F_EMIT_TOP64) != 0u;
    const float neg_inf  = uintBitsToFloat(0xFF800000u);
    const float pos_inf  = uintBitsToFloat(0x7F800000u);
    const f16vec2 kBias  = f16vec2(float16_t(1032.0));
    const uint p_base    = l8 * 16u;

    ConstBufF32 bb = ConstBufF32(pc.base_va);
    BufF32      ob = BufF32(pc.out_logits_va);

    float b0 = neg_inf;
    float b1 = neg_inf;

    uint  v  = beg + row_in8;
    float d  = 0.0;
    uvec4 qp = uvec4(0u);
    if (v < end) {
        const uint64_t rva = pc.w2_va + uint64_t(v) * 144ul;
        d  = float(ConstBufF16(rva).v[l8]);
        qp = ConstBufUvec4(rva + 16ul).v[l8];
    }

    while (v < end) {
        const uint v_next = v + 32u;
        float d_n  = 0.0;
        uvec4 qp_n = uvec4(0u);
        if (v_next < end) {
            const uint64_t rva_n = pc.w2_va + uint64_t(v_next) * 144ul;
            d_n  = float(ConstBufF16(rva_n).v[l8]);
            qp_n = ConstBufUvec4(rva_n + 16ul).v[l8];
        }

        f16vec2 dp2 = f16vec2(float16_t(0.0));
        [[unroll]] for (uint w_i = 0u; w_i < 4u; ++w_i) {
            const uint pw = (w_i == 0u) ? qp.x : ((w_i == 1u) ? qp.y : ((w_i == 2u) ? qp.z : qp.w));
            const uint pi = p_base + w_i * 4u;
            dp2 = fma(unpackFloat2x16(( pw         & 0x000F000Fu) | 0x64006400u) - kBias, s_mk_pair[pi + 0u], dp2);
            dp2 = fma(unpackFloat2x16(((pw >>  4u) & 0x000F000Fu) | 0x64006400u) - kBias, s_mk_pair[pi + 1u], dp2);
            dp2 = fma(unpackFloat2x16(((pw >>  8u) & 0x000F000Fu) | 0x64006400u) - kBias, s_mk_pair[pi + 2u], dp2);
            dp2 = fma(unpackFloat2x16(((pw >> 12u) & 0x000F000Fu) | 0x64006400u) - kBias, s_mk_pair[pi + 3u], dp2);
        }
        float acc = float(dp2.x + dp2.y) * d;
        acc += subgroupShuffleXor(acc, 1u);
        acc += subgroupShuffleXor(acc, 2u);
        acc += subgroupShuffleXor(acc, 4u);
        if (l8 == 0u) {
            float bias = acc * pc.w2_scale;
            if (has_bias) bias += ConstBufF32(pc.w2_bias_va).v[v];
            float logit = bb.v[base_off + v] + bias;
            if (do_cap) logit = pc.softcap * tanh(logit * pc.inv_softcap);
            ob.v[out_off + v] = logit;
            if (emit_top) {
                s_logits[v - beg] = logit;
                if (logit >= b0) {
                    b1 = b0;
                    b0 = logit;
                } else if (logit > b1) {
                    b1 = logit;
                }
            }
        }
        v  = v_next;
        d  = d_n;
        qp = qp_n;
    }

    if (!emit_top) return;

    // Exact Top-2 Pigeonhole across 32 disjoint streams: 32 * 2 = 64 distinct elements >= thresh!
    float sg_min = subgroupMin((l8 == 0u) ? b1 : pos_inf);
    if (ln == 0u) s_t2[sg] = sg_min;
    if (tid == 0u) s_cnt = 0u;
    barrier();

    float thresh = min(min(min(s_t2[0], s_t2[1]), min(s_t2[2], s_t2[3])),
                       min(min(s_t2[4], s_t2[5]), min(s_t2[6], s_t2[7])));
    if (n_local <= 64u) thresh = neg_inf;

    // Pass 2: scan TG-SRAM s_logits[] directly (0 global memory reads, 0 memoryBarrierBuffer!)
    for (uint i = tid; i < n_local; i += 256u) {
        float lv = s_logits[i];
        if (lv >= thresh) {
            uint pos = atomicAdd(s_cnt, 1u);
            if (pos < 256u) {
                s_val[pos] = lv;
                s_idx[pos] = int(beg + i);
            }
        }
    }
    barrier();

    const uint tot = s_cnt;
    const uint cand_base = (blk * pc.n_splits + split) * 64u;
    if (tot <= 256u) {
        const uint n_sort = (tot <= 64u) ? 64u : ((tot <= 128u) ? 128u : 256u);
        if (tid < n_sort && tid >= tot) {
            s_val[tid] = neg_inf;
            s_idx[tid] = 0x7FFFFFFF;
        }
        barrier();
        bitonic_sort_desc13(n_sort, tid);
        if (tid < 64u) {
            BufF32(pc.cand_val_va).v[cand_base + tid] = s_val[tid];
            BufI32(pc.cand_idx_va).v[cand_base + tid] = s_idx[tid];
        }
    } else {
        // Exact 64-pass SRAM fallback if >256 tied elements >= thresh
        float last_v = pos_inf;
        int   last_i = -1;
        for (uint k = 0u; k < 64u; ++k) {
            float bv = neg_inf;
            int   bi = 0x7FFFFFFF;
            for (uint i = tid; i < n_local; i += 256u) {
                float lv = s_logits[i];
                int   vi = int(beg + i);
                if (k > 0u && (lv > last_v || (lv == last_v && vi <= last_i))) continue;
                if (comes_before_desc(lv, vi, bv, bi)) { bv = lv; bi = vi; }
            }
            for (uint off = 16u; off > 0u; off >>= 1u) {
                float ov = subgroupShuffleXor(bv, off);
                int   oi = subgroupShuffleXor(bi, off);
                if (comes_before_desc(ov, oi, bv, bi)) { bv = ov; bi = oi; }
            }
            if (ln == 0u) { s_val[sg] = bv; s_idx[sg] = bi; }
            barrier();
            if (sg == 0u) {
                float rv = (ln < 8u) ? s_val[ln] : neg_inf;
                int   ri = (ln < 8u) ? s_idx[ln] : 0x7FFFFFFF;
                for (uint off = 16u; off > 0u; off >>= 1u) {
                    float ov = subgroupShuffleXor(rv, off);
                    int   oi = subgroupShuffleXor(ri, off);
                    if (comes_before_desc(ov, oi, rv, ri)) { rv = ov; ri = oi; }
                }
                if (ln == 0u) { s_val[128u + k] = rv; s_idx[128u + k] = ri; }
            }
            barrier();
            last_v = s_val[128u + k];
            last_i = s_idx[128u + k];
        }
        if (tid < 64u) {
            BufF32(pc.cand_val_va).v[cand_base + tid] = s_val[128u + tid];
            BufI32(pc.cand_idx_va).v[cand_base + tid] = s_idx[128u + tid];
        }
    }
}

#elif DSPARK_FUSED_MODE == 14
// ============================================================================
// Mode 14 (Wave 11): Single-Read All-Slots Fused Target-Feature Gather + ctx_mix + RMSNorm*w
//   - Grid: (n_tokens, 1, 1), Local: (512, 1, 1) [16 SGs/WG]
//   - Reads feat_src_va ONCE across all n_slots <= 4 (4x less DRAM read BW than Mode 10!)
//   - Supports D <= 3072 (D4 <= 768), n_target <= 16, n_slots <= 4; <= 40 GPR32, 0:0 spills
// ============================================================================
layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushArgs {
    uint64_t feat_src_va;
    uint64_t embd_rows_va;
    uint64_t mix_w_va[4];
    uint64_t norm_w_va[4];
    uint64_t out_va[4];
    uint     n_embd;
    uint     n_target;
    uint     n_tokens;
    uint     n_slots;
    uint     feat_row_f32;
    uint     mix_wtypes;
    float    rms_eps;
    uint     pad0;
} pc;

shared vec4  s_tail[4][256];
shared float s_mw[4][16];
shared float s_red[4][16];

void main() {
    const uint tok = gl_WorkGroupID.x;
    if (tok >= pc.n_tokens) return;

    const uint tid     = gl_LocalInvocationID.x;
    const uint sg      = tid >> 5u;
    const uint ln      = tid & 31u;
    const uint D       = pc.n_embd;
    const uint D4      = D >> 2u;
    const uint T       = pc.n_target;
    const uint n_slots = min(pc.n_slots, 4u);

    if (tid < n_slots * 16u) {
        const uint s   = tid >> 4u;
        const uint tap = tid & 15u;
        float mw = 0.0;
        if (tap < T && pc.mix_w_va[s] != 0ul) {
            const uint wt = (pc.mix_wtypes >> (s * 2u)) & 3u;
            mw = load_w_scalar(pc.mix_w_va[s], wt, tap);
        }
        s_mw[s][tap] = mw;
    }
    barrier();

    const int src_row = (pc.embd_rows_va != 0ul) ? max(ConstBufI32(pc.embd_rows_va).v[tok], 0) : int(tok);
    const uint64_t row_va = pc.feat_src_va + uint64_t(src_row) * uint64_t(pc.feat_row_f32) * 4ul;
    ConstBufVec4 fb = ConstBufVec4(row_va);

    vec4 a0 = vec4(0.0), a1 = vec4(0.0), a2 = vec4(0.0), a3 = vec4(0.0);
    float ss0 = 0.0, ss1 = 0.0, ss2 = 0.0, ss3 = 0.0;
    if (tid < D4) {
        for (uint tap = 0u; tap < T; ++tap) {
            vec4 fv = fb.v[tap * D4 + tid];
            if (n_slots > 0u) a0 = fma(fv, vec4(s_mw[0][tap]), a0);
            if (n_slots > 1u) a1 = fma(fv, vec4(s_mw[1][tap]), a1);
            if (n_slots > 2u) a2 = fma(fv, vec4(s_mw[2][tap]), a2);
            if (n_slots > 3u) a3 = fma(fv, vec4(s_mw[3][tap]), a3);
        }
        if (n_slots > 0u) ss0 = dot(a0, a0);
        if (n_slots > 1u) ss1 = dot(a1, a1);
        if (n_slots > 2u) ss2 = dot(a2, a2);
        if (n_slots > 3u) ss3 = dot(a3, a3);
    }

    const uint i4_1 = tid + 512u;
    if (i4_1 < D4 && tid < 256u) {
        s_tail[0][tid] = vec4(0.0);
        s_tail[1][tid] = vec4(0.0);
        s_tail[2][tid] = vec4(0.0);
        s_tail[3][tid] = vec4(0.0);
        for (uint tap = 0u; tap < T; ++tap) {
            vec4 fv = fb.v[tap * D4 + i4_1];
            if (n_slots > 0u) s_tail[0][tid] = fma(fv, vec4(s_mw[0][tap]), s_tail[0][tid]);
            if (n_slots > 1u) s_tail[1][tid] = fma(fv, vec4(s_mw[1][tap]), s_tail[1][tid]);
            if (n_slots > 2u) s_tail[2][tid] = fma(fv, vec4(s_mw[2][tap]), s_tail[2][tid]);
            if (n_slots > 3u) s_tail[3][tid] = fma(fv, vec4(s_mw[3][tap]), s_tail[3][tid]);
        }
        if (n_slots > 0u) { vec4 t = s_tail[0][tid]; ss0 += dot(t, t); }
        if (n_slots > 1u) { vec4 t = s_tail[1][tid]; ss1 += dot(t, t); }
        if (n_slots > 2u) { vec4 t = s_tail[2][tid]; ss2 += dot(t, t); }
        if (n_slots > 3u) { vec4 t = s_tail[3][tid]; ss3 += dot(t, t); }
    }

    float r0 = subgroupAdd(ss0);
    float r1 = subgroupAdd(ss1);
    float r2 = subgroupAdd(ss2);
    float r3 = subgroupAdd(ss3);
    if (ln == 0u) {
        s_red[0][sg] = r0;
        s_red[1][sg] = r1;
        s_red[2][sg] = r2;
        s_red[3][sg] = r3;
    }
    barrier();
    if (sg == 0u) {
        float t0 = subgroupAdd((ln < 16u) ? s_red[0][ln] : 0.0);
        float t1 = subgroupAdd((ln < 16u) ? s_red[1][ln] : 0.0);
        float t2 = subgroupAdd((ln < 16u) ? s_red[2][ln] : 0.0);
        float t3 = subgroupAdd((ln < 16u) ? s_red[3][ln] : 0.0);
        if (ln == 0u) {
            s_red[0][0] = inversesqrt(t0 / float(D) + pc.rms_eps);
            s_red[1][0] = inversesqrt(t1 / float(D) + pc.rms_eps);
            s_red[2][0] = inversesqrt(t2 / float(D) + pc.rms_eps);
            s_red[3][0] = inversesqrt(t3 / float(D) + pc.rms_eps);
        }
    }
    barrier();

    const uint64_t tok_off_B = uint64_t(tok) * uint64_t(D) * 4ul;
    if (n_slots > 0u && pc.out_va[0] != 0ul) {
        const float ir = s_red[0][0];
        ConstBufVec4 nw = ConstBufVec4(pc.norm_w_va[0]);
        BufVec4      ob = BufVec4(pc.out_va[0] + tok_off_B);
        if (tid < D4)                 ob.v[tid]  = (a0 * ir) * nw.v[tid];
        if (i4_1 < D4 && tid < 256u)  ob.v[i4_1] = (s_tail[0][tid] * ir) * nw.v[i4_1];
    }
    if (n_slots > 1u && pc.out_va[1] != 0ul) {
        const float ir = s_red[1][0];
        ConstBufVec4 nw = ConstBufVec4(pc.norm_w_va[1]);
        BufVec4      ob = BufVec4(pc.out_va[1] + tok_off_B);
        if (tid < D4)                 ob.v[tid]  = (a1 * ir) * nw.v[tid];
        if (i4_1 < D4 && tid < 256u)  ob.v[i4_1] = (s_tail[1][tid] * ir) * nw.v[i4_1];
    }
    if (n_slots > 2u && pc.out_va[2] != 0ul) {
        const float ir = s_red[2][0];
        ConstBufVec4 nw = ConstBufVec4(pc.norm_w_va[2]);
        BufVec4      ob = BufVec4(pc.out_va[2] + tok_off_B);
        if (tid < D4)                 ob.v[tid]  = (a2 * ir) * nw.v[tid];
        if (i4_1 < D4 && tid < 256u)  ob.v[i4_1] = (s_tail[2][tid] * ir) * nw.v[i4_1];
    }
    if (n_slots > 3u && pc.out_va[3] != 0ul) {
        const float ir = s_red[3][0];
        ConstBufVec4 nw = ConstBufVec4(pc.norm_w_va[3]);
        BufVec4      ob = BufVec4(pc.out_va[3] + tok_off_B);
        if (tid < D4)                 ob.v[tid]  = (a3 * ir) * nw.v[tid];
        if (i4_1 < D4 && tid < 256u)  ob.v[i4_1] = (s_tail[3][tid] * ir) * nw.v[i4_1];
    }
}
#endif
