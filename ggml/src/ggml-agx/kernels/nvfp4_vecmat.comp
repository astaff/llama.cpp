#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "dequant_supertile.glsl"

// ============================================================================
// Pillar 2: Predicated Remainder-Free NVFP4 B=1..5 Simdgroup Vec-Mat Kernel
// ============================================================================
// Compile-time specializations (all <= 56 GPR32, 0:0 spills):
//   - REPACKED (1 = AGX_NVFP4_32x16 128B super-tile; 0 = raw GGML block_nvfp4)
//   - BATCH_M  (1..5)
//   - K_SGS    (1 = high-N DRAM roofline path: for M=1 each simdgroup fuses BOTH
//                   half-tiles s=0 & s=1 (32 rows/sg = 128 rows/WG, 2x X reuse,
//                   100% 128B-aligned 1024B weight bursts, ~36 GPR32!);
//               4 = medium-N WG K-split: 4 sgs split K over 16 rows + 256B SRAM)
//
// Uses direct-to-FP32 branchless FTZ-safe normal-exponent E2M1 + UE4M3 decode
// (0 denormals, 0 LUT, 0 f16->f32 conversions, streaming 4 weights at a time
// to minimize live GPR footprint for maximum dynamic-caching occupancy).

#ifndef REPACKED
#define REPACKED 1
#endif

#ifndef BATCH_M
#define BATCH_M 1
#endif

#ifndef K_SGS
#define K_SGS 4
#endif

#ifndef PREC_F32
#define PREC_F32 0
#endif

#if K_SGS == 1
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
#else
layout(local_size_x = 32 * K_SGS, local_size_y = 1, local_size_z = 1) in;
#endif

layout(push_constant, scalar) uniform PushArgs {
    uint64_t w_va;
    uint64_t x_va;
    uint64_t y_va;
    uint     M;
    uint     N;
    uint     K;
    uint     x_stride;
    uint     y_stride;
    uint     w_slice_bytes;
    uint     x_slice_elems;
    uint     y_slice_elems;
    uint     w_bcast_div;
    uint     _pad;
} pc;

#if K_SGS > 1
shared float sh_reduce[K_SGS][BATCH_M][16];
#endif

// Stream-dot 8 sequential E2M1 nibbles packed in `w32` against two vec4 activations
float dot_e2m1_u32_x2(uint w32, vec4 x0, vec4 x1) {
    float s = dot(agx_e2m1_u16_to_vec4(w32 & 0xFFFFu), x0);
    s += dot(agx_e2m1_u16_to_vec4(w32 >> 16), x1);
    return s;
}

#if PREC_F32 == 0
// SWAR2 + 2x-rate AGX3B FP16 FMA dot of 8 sequential E2M1 weights in `w32`
// against two pre-cast f16vec4 activations (zero compares, zero multiplies, zero LUT!)
float dot_e2m1_u32_f16x2(uint w32, f16vec4 hx0, f16vec4 hx1) {
    f16vec2 v04 = agx_e2m1_swar2_to_f16vec2( w32        & 0x000F000Fu);
    f16vec2 v15 = agx_e2m1_swar2_to_f16vec2((w32 >> 4)  & 0x000F000Fu);
    f16vec2 v26 = agx_e2m1_swar2_to_f16vec2((w32 >> 8)  & 0x000F000Fu);
    f16vec2 v37 = agx_e2m1_swar2_to_f16vec2((w32 >> 12) & 0x000F000Fu);
    float16_t s = dot(f16vec4(v04.x, v15.x, v26.x, v37.x), hx0);
    s += dot(f16vec4(v04.y, v15.y, v26.y, v37.y), hx1);
    return float(s);
}
#endif

void main() {
    const uint lane  = gl_SubgroupInvocationID; // 0..31
    const uint sg_id = gl_SubgroupID;           // 0..3 (or 0..K_SGS-1)
    const uint slice = gl_WorkGroupID.z;

    const uint w_slice = slice / max(1u, pc.w_bcast_div);
    const uint64_t w_base = pc.w_va + uint64_t(w_slice) * uint64_t(pc.w_slice_bytes);
    const uint64_t x_base = pc.x_va + uint64_t(slice)   * uint64_t(pc.x_slice_elems) * 4ul;
    const uint64_t y_base = pc.y_va + uint64_t(slice)   * uint64_t(pc.y_slice_elems) * 4ul;

    AgxBufVec4R x_buf4 = AgxBufVec4R(x_base);
    AgxBufF32RW y_buf  = AgxBufF32RW(y_base);

    const uint nb_k     = pc.K >> 6; // K / 64
    const uint row_in_h = lane >> 1; // 0..15
    const uint kh       = lane & 1u; // 0 or 1

#if REPACKED == 1 && K_SGS == 1 && BATCH_M == 1
    // ------------------------------------------------------------------------
    // Peak-roofline B=1 fused 32-row/simdgroup path (128 rows/WG, 0 shared mem):
    // Each simdgroup owns an ENTIRE 1152B (9 x 128B cache-line) AGX_NVFP4_32x16
    // super-tile (both half-tiles s=0 & s=1), loading X ONCE and reusing it
    // across 2 output rows per lane-pair -> 2x fewer X loads + ~36 GPR32!
    // ------------------------------------------------------------------------
    const uint tn   = gl_WorkGroupID.x * 4u + sg_id;
    const uint row0 = tn * 32u + row_in_h;
    const uint row1 = row0 + 16u;

    float acc0 = 0.0;
    float acc1 = 0.0;

    if (tn * 32u < pc.N) {
        AgxBufNvfp4ST st_buf = AgxBufNvfp4ST(w_base);
        const uint st_row_base = tn * nb_k;

        for (uint tk = 0u; tk < nb_k; ++tk) {
            const uint st_idx = st_row_base + tk;
            const uint16_t d_pair0 = st_buf.st[st_idx].d[lane];
            const uint16_t d_pair1 = st_buf.st[st_idx].d[32u + lane];
            const uvec4    qs0     = st_buf.st[st_idx].qs[lane];
            const uvec4    qs1     = st_buf.st[st_idx].qs[32u + lane];

            const vec2 sc0 = agx_ue4m3_pair_to_vec2(d_pair0);
            const vec2 sc1 = agx_ue4m3_pair_to_vec2(d_pair1);

            const uint col4 = (tk * 64u + kh * 32u) >> 2;

            // Sub-block 0 (weights 0..15): stream 8 floats of X at a time for both s=0 & s=1
            // When PREC_F32==0, cast X to f16vec4 ONCE and use 2x-rate AGX3B ffma16!
#if PREC_F32 == 0
            f16vec4 hx0 = f16vec4(x_buf4.v[col4 + 0u]);
            f16vec4 hx1 = f16vec4(x_buf4.v[col4 + 1u]);
            float d0_a = dot_e2m1_u32_f16x2(qs0.x, hx0, hx1);
            float d1_a = dot_e2m1_u32_f16x2(qs1.x, hx0, hx1);

            hx0 = f16vec4(x_buf4.v[col4 + 2u]);
            hx1 = f16vec4(x_buf4.v[col4 + 3u]);
            d0_a += dot_e2m1_u32_f16x2(qs0.y, hx0, hx1);
            d1_a += dot_e2m1_u32_f16x2(qs1.y, hx0, hx1);

            acc0 = fma(d0_a, sc0.x, acc0);
            acc1 = fma(d1_a, sc1.x, acc1);

            // Sub-block 1 (weights 16..31)
            hx0 = f16vec4(x_buf4.v[col4 + 4u]);
            hx1 = f16vec4(x_buf4.v[col4 + 5u]);
            float d0_b = dot_e2m1_u32_f16x2(qs0.z, hx0, hx1);
            float d1_b = dot_e2m1_u32_f16x2(qs1.z, hx0, hx1);

            hx0 = f16vec4(x_buf4.v[col4 + 6u]);
            hx1 = f16vec4(x_buf4.v[col4 + 7u]);
            d0_b += dot_e2m1_u32_f16x2(qs0.w, hx0, hx1);
            d1_b += dot_e2m1_u32_f16x2(qs1.w, hx0, hx1);
#else
            vec4 x0 = x_buf4.v[col4 + 0u];
            vec4 x1 = x_buf4.v[col4 + 1u];
            float d0_a = dot_e2m1_u32_x2(qs0.x, x0, x1);
            float d1_a = dot_e2m1_u32_x2(qs1.x, x0, x1);

            x0 = x_buf4.v[col4 + 2u];
            x1 = x_buf4.v[col4 + 3u];
            d0_a += dot_e2m1_u32_x2(qs0.y, x0, x1);
            d1_a += dot_e2m1_u32_x2(qs1.y, x0, x1);

            acc0 = fma(d0_a, sc0.x, acc0);
            acc1 = fma(d1_a, sc1.x, acc1);

            // Sub-block 1 (weights 16..31)
            x0 = x_buf4.v[col4 + 4u];
            x1 = x_buf4.v[col4 + 5u];
            float d0_b = dot_e2m1_u32_x2(qs0.z, x0, x1);
            float d1_b = dot_e2m1_u32_x2(qs1.z, x0, x1);

            x0 = x_buf4.v[col4 + 6u];
            x1 = x_buf4.v[col4 + 7u];
            d0_b += dot_e2m1_u32_x2(qs0.w, x0, x1);
            d1_b += dot_e2m1_u32_x2(qs1.w, x0, x1);
#endif

            acc0 = fma(d0_b, sc0.y, acc0);
            acc1 = fma(d1_b, sc1.y, acc1);
        }
    }

    acc0 += subgroupShuffleXor(acc0, 1u);
    acc1 += subgroupShuffleXor(acc1, 1u);

    if (kh == 0u) {
        if (row0 < pc.N) y_buf.v[row0] = acc0;
        if (row1 < pc.N) y_buf.v[row1] = acc1;
    }
#else

#if K_SGS == 1
    // Each simdgroup independently owns one 16-row half-tile
    const uint half_idx = gl_WorkGroupID.x * 4u + sg_id;
    const uint tn       = half_idx >> 1;
    const uint sub_s    = half_idx & 1u;
    const uint row      = half_idx * 16u + row_in_h;
    const uint tk_start = 0u;
    const uint tk_step  = 1u;
#else
    // All K_SGS simdgroups in this workgroup collaborate on the SAME 16-row half-tile
    const uint half_idx = gl_WorkGroupID.x;
    const uint tn       = half_idx >> 1;
    const uint sub_s    = half_idx & 1u;
    const uint row      = half_idx * 16u + row_in_h;
    const uint tk_start = sg_id;
    const uint tk_step  = uint(K_SGS);
#endif

    // Predicated guard for out-of-range half-tiles (no divergent remainder kernel!)
    const bool tile_valid = (half_idx * 16u < pc.N);

    float acc[BATCH_M];
    for (uint m = 0u; m < uint(BATCH_M); ++m) {
        acc[m] = 0.0;
    }

#if REPACKED == 1
    if (tile_valid) {
        AgxBufNvfp4ST st_buf = AgxBufNvfp4ST(w_base);
        const uint st_row_base = tn * nb_k;
        const uint l_idx       = sub_s * 32u + lane;
        const uint x_stride4   = pc.x_stride >> 2;

        for (uint tk = tk_start; tk < nb_k; tk += tk_step) {
            const uint st_idx = st_row_base + tk;
            const uint16_t d_pair = st_buf.st[st_idx].d[l_idx];
            const uvec4    qs     = st_buf.st[st_idx].qs[l_idx];

            const vec2 scales = agx_ue4m3_pair_to_vec2(d_pair);
            const uint col4_base = (tk * 64u + kh * 32u) >> 2;

            // Stream 8 weights at a time (SWAR2 + ffma16 when PREC_F32==0!)
#if PREC_F32 == 0 && BATCH_M == 1
            f16vec4 hx0 = f16vec4(x_buf4.v[col4_base + 0u]);
            f16vec4 hx1 = f16vec4(x_buf4.v[col4_base + 1u]);
            float d0 = dot_e2m1_u32_f16x2(qs.x, hx0, hx1);
            hx0 = f16vec4(x_buf4.v[col4_base + 2u]);
            hx1 = f16vec4(x_buf4.v[col4_base + 3u]);
            d0 += dot_e2m1_u32_f16x2(qs.y, hx0, hx1);
            acc[0] = fma(d0, scales.x, acc[0]);

            hx0 = f16vec4(x_buf4.v[col4_base + 4u]);
            hx1 = f16vec4(x_buf4.v[col4_base + 5u]);
            float d1 = dot_e2m1_u32_f16x2(qs.z, hx0, hx1);
            hx0 = f16vec4(x_buf4.v[col4_base + 6u]);
            hx1 = f16vec4(x_buf4.v[col4_base + 7u]);
            d1 += dot_e2m1_u32_f16x2(qs.w, hx0, hx1);
            acc[0] = fma(d1, scales.y, acc[0]);
#else
            vec4 w0 = agx_e2m1_u16_to_vec4(qs.x & 0xFFFFu);
            vec4 w1 = agx_e2m1_u16_to_vec4(qs.x >> 16);
            float sub0[BATCH_M];
            for (uint m = 0u; m < uint(BATCH_M); ++m) {
                if (m < pc.M) {
                    const uint x_off4 = m * x_stride4 + col4_base;
                    sub0[m] = dot(w0, x_buf4.v[x_off4 + 0u])
                            + dot(w1, x_buf4.v[x_off4 + 1u]);
                } else {
                    sub0[m] = 0.0;
                }
            }
            w0 = agx_e2m1_u16_to_vec4(qs.y & 0xFFFFu);
            w1 = agx_e2m1_u16_to_vec4(qs.y >> 16);
            for (uint m = 0u; m < uint(BATCH_M); ++m) {
                if (m < pc.M) {
                    const uint x_off4 = m * x_stride4 + col4_base;
                    sub0[m] += dot(w0, x_buf4.v[x_off4 + 2u])
                             + dot(w1, x_buf4.v[x_off4 + 3u]);
                    acc[m] = fma(sub0[m], scales.x, acc[m]);
                }
            }

            w0 = agx_e2m1_u16_to_vec4(qs.z & 0xFFFFu);
            w1 = agx_e2m1_u16_to_vec4(qs.z >> 16);
            for (uint m = 0u; m < uint(BATCH_M); ++m) {
                if (m < pc.M) {
                    const uint x_off4 = m * x_stride4 + col4_base + 4u;
                    sub0[m] = dot(w0, x_buf4.v[x_off4 + 0u])
                            + dot(w1, x_buf4.v[x_off4 + 1u]);
                }
            }
            w0 = agx_e2m1_u16_to_vec4(qs.w & 0xFFFFu);
            w1 = agx_e2m1_u16_to_vec4(qs.w >> 16);
            for (uint m = 0u; m < uint(BATCH_M); ++m) {
                if (m < pc.M) {
                    const uint x_off4 = m * x_stride4 + col4_base + 4u;
                    sub0[m] += dot(w0, x_buf4.v[x_off4 + 2u])
                             + dot(w1, x_buf4.v[x_off4 + 3u]);
                    acc[m] = fma(sub0[m], scales.y, acc[m]);
                }
            }
#endif
        }
    }
#else
    // Raw GGML block_nvfp4 fallback (still uses branchless FTZ-safe E2M1/UE4M3 decode!)
    if (tile_valid && row < pc.N) {
        AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
        const uint row_blk_base = row * nb_k;
        const uint x_stride4    = pc.x_stride >> 2;

        for (uint tk = tk_start; tk < nb_k; tk += tk_step) {
            const uint blk_idx = row_blk_base + tk;
            for (uint s = 0u; s < 2u; ++s) {
                const uint sub = kh * 2u + s;
                const float sc = agx_ue4m3_to_f32(uint(raw_buf.blk[blk_idx].d[sub]));
                uint b0 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + 0u]);
                uint b1 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + 1u]);
                uint b2 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + 2u]);
                uint b3 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + 3u]);
                uint b4 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + 4u]);
                uint b5 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + 5u]);
                uint b6 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + 6u]);
                uint b7 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + 7u]);

                vec4 w0 = vec4(agx_e2m1_to_f32(b0 & 0xFu), agx_e2m1_to_f32(b1 & 0xFu),
                               agx_e2m1_to_f32(b2 & 0xFu), agx_e2m1_to_f32(b3 & 0xFu));
                vec4 w1 = vec4(agx_e2m1_to_f32(b4 & 0xFu), agx_e2m1_to_f32(b5 & 0xFu),
                               agx_e2m1_to_f32(b6 & 0xFu), agx_e2m1_to_f32(b7 & 0xFu));
                vec4 w2 = vec4(agx_e2m1_to_f32(b0 >> 4), agx_e2m1_to_f32(b1 >> 4),
                               agx_e2m1_to_f32(b2 >> 4), agx_e2m1_to_f32(b3 >> 4));
                vec4 w3 = vec4(agx_e2m1_to_f32(b4 >> 4), agx_e2m1_to_f32(b5 >> 4),
                               agx_e2m1_to_f32(b6 >> 4), agx_e2m1_to_f32(b7 >> 4));

                const uint col4 = (tk * 64u + sub * 16u) >> 2;
                for (uint m = 0u; m < uint(BATCH_M); ++m) {
                    if (m < pc.M) {
                        const uint x_off4 = m * x_stride4 + col4;
                        float d_sub = dot(w0, x_buf4.v[x_off4 + 0u])
                                    + dot(w1, x_buf4.v[x_off4 + 1u])
                                    + dot(w2, x_buf4.v[x_off4 + 2u])
                                    + dot(w3, x_buf4.v[x_off4 + 3u]);
                        acc[m] = fma(d_sub, sc, acc[m]);
                    }
                }
            }
        }
    }
#endif

    // 1-cycle simdgroup reduction across K-halves (lane ^ 1)
    for (uint m = 0u; m < uint(BATCH_M); ++m) {
        acc[m] += subgroupShuffleXor(acc[m], 1u);
    }

#if K_SGS == 1
    if (kh == 0u && row < pc.N) {
        for (uint m = 0u; m < uint(BATCH_M); ++m) {
            if (m < pc.M) {
                y_buf.v[m * pc.y_stride + row] = acc[m];
            }
        }
    }
#else
    if (kh == 0u) {
        for (uint m = 0u; m < uint(BATCH_M); ++m) {
            sh_reduce[sg_id][m][row_in_h] = acc[m];
        }
    }
    barrier();

    if (sg_id == 0u && lane < 16u) {
        const uint out_row = half_idx * 16u + lane;
        if (out_row < pc.N) {
            for (uint m = 0u; m < uint(BATCH_M); ++m) {
                if (m < pc.M) {
                    float total = 0.0;
                    for (uint s = 0u; s < uint(K_SGS); ++s) {
                        total += sh_reduce[s][m][lane];
                    }
                    y_buf.v[m * pc.y_stride + out_row] = total;
                }
            }
        }
    }
#endif
#endif
}
