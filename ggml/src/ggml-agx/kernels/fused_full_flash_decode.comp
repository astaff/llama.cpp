                int kp = BufI32(pc.rel_pos_pack_va).d[pc.rel_cp_off + batch * pc.n_kv + kv];
                int bd = b_pos_q - kp;
                if (bd >= 0 && uint(bd) < pc.n_rel_extent && uint(bd) < pc.rel_table_len) {
                    const uint64_t b_rt_va = pc.rel_table_va + uint64_t(tok_global * pc.n_head_q + h_q) * uint64_t(pc.rel_table_len) * 4ul;
                    score += BufF32(b_rt_va).d[uint(bd)];
                }
            }
        }

        float m_new = max(m_i, score);
        float alpha = exp(m_i - m_new);
        float p_w   = exp(score - m_new);
        o_i = o_i * alpha + v_reg * p_w;
        l_i = l_i * alpha + p_w;
        m_i = m_new;
    }

    if (lane == 0u) {
        sh_m[sg] = m_i;
        sh_l[sg] = l_i;
    }
    sh_o[sg][lane] = o_i;
    barrier();

    if (sg == 0u) {
        float m_wg = -3.402823466e+38f * 0.5f;
        for (uint s = 0u; s < N_SG; ++s) {
            if (sh_l[s] > 0.0f) {
                m_wg = max(m_wg, sh_m[s]);
            }
        }

        float l_wg = 0.0f;
        VEC_T o_wg = VEC_T(0.0f);
        for (uint s = 0u; s < N_SG; ++s) {
            if (sh_l[s] > 0.0f) {
                float w = exp(sh_m[s] - m_wg);
                l_wg += sh_l[s] * w;
                o_wg += sh_o[s][lane] * w;
            }
        }

        if (pc.n_splits == 1u) {
            bool  has_sink;
            float eff_sink;
            get_sink_info(tok_global, h_q, has_sink, eff_sink);
            if (has_sink) {
                float m_fin = (l_wg > 0.0f) ? max(m_wg, eff_sink) : eff_sink;
                float w_o   = (l_wg > 0.0f) ? exp(m_wg - m_fin) : 0.0f;
                float w_s   = exp(eff_sink - m_fin);
                o_wg = o_wg * w_o;
                l_wg = l_wg * w_o + w_s;
            }
            VEC_T out_v = (l_wg > 0.0f) ? (o_wg / l_wg) : VEC_T(0.0f);
            const uint ep_b = (n_batches > 1u) ? (tok_global / pc.n_tokens) : 0u;
            const uint ep_t = (n_batches > 1u) ? (tok_global - ep_b * pc.n_tokens) : tok_global;
            apply_epilogue_and_store(out_v, ep_b, ep_t, h_q, lane);
        } else {
            const uint base = ((tok_global * pc.n_head_q + h_q) * pc.n_splits + split) * PARTIAL_STRIDE;
            BufF32W pb = BufF32W(pc.partial_va);
            pb.d[base + lane * ELEMS_PER_LANE + 0u] = o_wg.x;
            pb.d[base + lane * ELEMS_PER_LANE + 1u] = o_wg.y;
#if HEAD_DIM != 64
            pb.d[base + lane * ELEMS_PER_LANE + 2u] = o_wg.z;
            pb.d[base + lane * ELEMS_PER_LANE + 3u] = o_wg.w;
#endif
            if (lane == 0u) {
                pb.d[base + uint(HEAD_DIM) + 0u] = m_wg;
                pb.d[base + uint(HEAD_DIM) + 1u] = l_wg;
            }
        }
    }
}
#endif // GQA_GRP == 3 vs 1

#elif PASS_MODE == 3 || PASS_MODE == 4

// ============================================================================
// Shared FP16 E4M3FN Helpers for 8x8 Coopmat Prefill & GQA-Grouped Verify (Mode 3 & Mode 4)
// ============================================================================
float16_t pf_e4m3_to_f16(uint b) {
    uint s    = (b & 0x80u) << 8u;
    uint absb = b & 0x7Fu;
    uint h    = s | ((absb + 0x40u) << 7u);
    float16_t v_norm = unpackFloat2x16(h).x;
    float16_t v_sub  = float16_t(absb) * ((b >= 128u) ? float16_t(-1.0 / 512.0) : float16_t(1.0 / 512.0));
    return (absb < 8u) ? v_sub : v_norm;
}

f16vec2 pf_e4m3_pair_to_f16x2(uint16_t b2) {
    uint u = uint(b2);
    return f16vec2(pf_e4m3_to_f16(u & 0xFFu), pf_e4m3_to_f16(u >> 8u));
}

#if PASS_MODE == 3

// ============================================================================
// Phase 3: Wave 9/10 Lean 8-SG Zero-K/V-SRAM Coopmat Prefill (D=128, Bc=64)
//   - PF_BR=16 (default, 16 <= M < 256): 10,500 B SRAM -> 3 WGs/core = 24 SGs/core!
//   - PF_BR=32 (Wave 10 32k PP Killer, M >= 256):
//       * 2.0x fewer KV DRAM reads & 2.0x higher MMA/load intensity (16 MMAs / 4 loads!)
//       * Exact 16,384 B SRAM = sh_q[128 * 16] packed u32 XOR-swizzled (8,192 B, 0 conflicts!)
//         + sh_buf[32 * 64] unified XOR-swizzled (8,192 B, 0 conflicts!)
//         -> 2 WGs/core = 16 ActSGs/core, <= 72 GPR32, 0:0 spills across ALL KV dtypes!
//   - Native O(n_kv) banded rel-bias + tile64_minmax skip + 2D sinks + FWHT64 + QGate!
// ============================================================================
#ifndef PF_BR
#define PF_BR       16
#endif
#define PF_BC       64u

#if PF_BR == 32

#define PF_Q_TILES  4u
#define PF_SM_ROWS  4u

// Exact 16,384 B TG-SRAM -> 2 WGs/core = 16 active simdgroups/core on AGX3B!
shared uint sh_q[HEAD_DIM * 16u]; // 8,192 B: packed f16vec2(Q[2*qp, d], Q[2*qp+1, d]), col_sw = qp ^ ((d&6)<<1)
shared uint sh_buf[32u * 64u];    // 8,192 B: unified S (FP32) / P (f16x2 in 0..31) + eM (32+rl) / FWHT64 epilogue

void main() {
    const uint h_q    = gl_WorkGroupID.x;
    const uint n_qt   = (pc.n_tokens + 31u) >> 5u;
    const uint q_tile = (n_qt - 1u) - gl_WorkGroupID.y;
    const uint q0     = q_tile * 32u;
    if (h_q >= pc.n_head_q || q0 >= pc.n_tokens) {
        return;
    }

    const uint sg   = gl_LocalInvocationID.y;  // 0..7
    const uint lane = gl_LocalInvocationID.x;  // 0..31
    const uint tid  = sg * 32u + lane;         // 0..255

    const uint gqa  = max(1u, pc.n_head_q / pc.n_head_kv);
    const uint h_kv = h_q / gqa;

    const uint cm_r = agx_cmat8_row(lane);     // 0..7
    const uint cm_c = agx_cmat8_col0(lane);    // 0, 2, 4, 6
    const uint q_sw = (cm_r & 6u) << 1u;       // 0, 4, 8, 12 (32/32 bank bijection!)

    // 1. Load Q[q0..q0+31, h_q, 0..127] * kq_scale -> packed XOR-swizzled sh_q[d * 16 + col_sw]
    //    Each iter loads coalesced vec4 for (ql_even, ql_odd) and packs 4 f16vec2 uints (exact 2 iters/thread!)
    const bool q_is_f16 = (pc.flags & FLAG_Q_F16) != 0u;
    const float q_sc = pc.kq_scale;
    [[dont_unroll]] for (uint idx = tid; idx < 16u * 32u; idx += 256u) {
        const uint qp  = idx >> 5u;            // 0..15 (pair of Q rows)
        const uint ql0 = qp * 2u;
        const uint ql1 = ql0 + 1u;
        const uint d4  = (idx & 31u) << 2u;    // 0, 4, ..., 124
        f16vec4 qv0 = f16vec4(float16_t(0.0));
        f16vec4 qv1 = f16vec4(float16_t(0.0));
        if (q0 + ql0 < pc.n_tokens) {
            uint64_t qva = pc.q_va + uint64_t(q0 + ql0) * uint64_t(pc.q_nb1) + uint64_t(h_q) * uint64_t(pc.q_nb2);
            vec4 qf;
            if (q_is_f16) {
                qf = vec4(BufF16V4(qva).d[d4 >> 2u]) * q_sc;
            } else if ((qva & 15ul) == 0ul) {
                qf = BufVec4R(qva).d[d4 >> 2u] * q_sc;
            } else {
                BufF32 qb = BufF32(qva);
                qf = vec4(qb.d[d4 + 0u], qb.d[d4 + 1u], qb.d[d4 + 2u], qb.d[d4 + 3u]) * q_sc;
            }
            qv0 = f16vec4(clamp(qf, vec4(-65504.0f), vec4(65504.0f)));
        }
        if (q0 + ql1 < pc.n_tokens) {
            uint64_t qva = pc.q_va + uint64_t(q0 + ql1) * uint64_t(pc.q_nb1) + uint64_t(h_q) * uint64_t(pc.q_nb2);
            vec4 qf;
            if (q_is_f16) {
                qf = vec4(BufF16V4(qva).d[d4 >> 2u]) * q_sc;
            } else if ((qva & 15ul) == 0ul) {
                qf = BufVec4R(qva).d[d4 >> 2u] * q_sc;
            } else {
                BufF32 qb = BufF32(qva);
                qf = vec4(qb.d[d4 + 0u], qb.d[d4 + 1u], qb.d[d4 + 2u], qb.d[d4 + 3u]) * q_sc;
            }
            qv1 = f16vec4(clamp(qf, vec4(-65504.0f), vec4(65504.0f)));
        }
        const uint sw_a = qp ^ ((d4 & 4u) << 1u); // (d4+0, d4+1): bit 1 of d is 0
        const uint sw_b = sw_a ^ 4u;              // (d4+2, d4+3): bit 1 of d is 1
        sh_q[(d4 + 0u) * 16u + sw_a] = packFloat2x16(f16vec2(qv0.x, qv1.x));
        sh_q[(d4 + 1u) * 16u + sw_a] = packFloat2x16(f16vec2(qv0.y, qv1.y));
        sh_q[(d4 + 2u) * 16u + sw_b] = packFloat2x16(f16vec2(qv0.z, qv1.z));
        sh_q[(d4 + 3u) * 16u + sw_b] = packFloat2x16(f16vec2(qv0.w, qv1.w));
    }

    const bool has_banded = (pc.flags & FLAG_BANDED_REL_BIAS) != 0u &&
                            (pc.rel_table_va != 0ul) && (pc.rel_pos_pack_va != 0ul);
    if (has_banded && sg == 0u) {
        const bool tok_ok = (q0 + lane < pc.n_tokens);
        const int p = tok_ok ? BufI32(pc.rel_pos_pack_va).d[pc.rel_qp_off + q0 + lane] : -1073741824;
        const int pmin = subgroupMin(tok_ok ? p : 1073741824);
        const int pmax = subgroupMax(p);
        if (lane == 0u) {
            sh_buf[0] = uint(pmin);
            sh_buf[1] = uint(pmax);
        }
    }

    uint kv_beg = 0u;
    uint kv_end = pc.n_kv;
    bool span_no_holes = false;
    if ((pc.flags & FLAG_KV_BOUNDS) != 0u && pc.partial_va != 0ul) {
        uvec2 b = BufUvec2(pc.partial_va).d[q_tile];
        kv_beg = b.x & ~63u;
        span_no_holes = (b.y & 0x80000000u) != 0u;
        kv_end = min(pc.n_kv, b.y & 0x7FFFFFFFu);
    }

    barrier();

    const int q_pmin = has_banded ? int(sh_buf[0]) : 1073741824;
    const int q_pmax = has_banded ? int(sh_buf[1]) : -1073741824;
    if (has_banded) {
        barrier(); // release sh_buf[0..1] before kv0 loop
    }

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> OfMat[PF_Q_TILES][2];
    [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
        OfMat[m][0] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        OfMat[m][1] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    }

    float Mf[PF_SM_ROWS];
    float Lf[PF_SM_ROWS];
    [[unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
        Mf[r] = -3.402823466e+38f;
        Lf[r] = 0.0f;
    }

    const bool has_mask_f16 = (pc.flags & FLAG_HAS_MASK_F16) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask_f32 = (pc.flags & FLAG_HAS_MASK_F32) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask     = has_mask_f16 || has_mask_f32;
    const bool has_softcap  = (pc.flags & FLAG_SOFTCAP) != 0u && (pc.logit_softcap != 0.0f);
    const float slope_v     = compute_alibi_slope(h_q);
    const uint mask_h       = (pc.ext_mask_ne2 > 1u) ? (h_q % pc.ext_mask_ne2) : 0u;
    const uint kv_last      = (pc.n_kv > 0u) ? (pc.n_kv - 1u) : 0u;
    const uint d_sg_base    = sg * 16u;
    const uint q_c0         = (cm_c >> 1u) ^ q_sw;       // q_c(m) == q_c0 ^ (m * 4u)
    const uint p_sw         = cm_r << 2u;                // (rl & 7u) << 2u for rl = m*8 + cm_r
    const uint s_sw0        = ((cm_c + 0u) & 6u) << 2u;  // Phase 1 S store swizzle (32/32 banks!)
    bool prev_sh_live       = false;

    for (uint kv0 = kv_beg; kv0 < kv_end; kv0 += PF_BC) {
        if (has_mask && !span_no_holes) {
            if (prev_sh_live) {
                barrier();
                prev_sh_live = false;
            }
            if (tid == 0u) {
                sh_buf[0] = 1u;
            }
            barrier();
            bool any_ok = false;
            const uint64_t mask_h_va = pc.kq_mask_va + uint64_t(mask_h) * uint64_t(pc.ext_mask_nb2);
            [[dont_unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
                const uint q_row = q0 + sg * PF_SM_ROWS + r;
                if (q_row < pc.n_tokens) {
                    const uint64_t mva = mask_h_va + uint64_t(q_row) * uint64_t(pc.ext_mask_nb1);
                    const uint c0 = kv0 + lane;
                    const uint c1 = kv0 + lane + 32u;
                    if (c0 < pc.n_kv) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c0]) : BufF32(mva).d[c0];
                        if (mv > -1.0e30f) any_ok = true;
                    }
                    if (c1 < pc.n_kv) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c1]) : BufF32(mva).d[c1];
                        if (mv > -1.0e30f) any_ok = true;
                    }
                }
            }
            if (subgroupAny(any_ok) && lane == 0u) {
                sh_buf[0] = 0u;
            }
            barrier();
            const bool do_skip = (sh_buf[0] != 0u);
            prev_sh_live = true; // protect sh_buf[0] read before next write
            if (do_skip) {
                continue;
            }
        }

        // Phase 1: S^T = K * Q^T (Zero K SRAM! 16 MMAs per 4 global K loads -> 2x AI vs Br=16!)
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> SfMat[PF_Q_TILES];
        [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
            SfMat[m] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        }

        const uint k_row = min(kv0 + sg * 8u + cm_r, kv_last);
        const uint64_t k_rva = pc.k_or_pt_va
            + uint64_t(h_kv) * uint64_t(pc.ext_k_nb2)
            + uint64_t(k_row) * uint64_t(pc.ext_k_nb1);

        [[dont_unroll]] for (uint blk = 0u; blk < HEAD_DIM / 32u; ++blk) {
            const uint d32 = blk * 32u;
#if KV_DTYPE_K == 2
            const uint cidx = (d32 + cm_c) >> 1u;
            uint pk0 = BufU32(k_rva).d[cidx +  0u];
            uint pk1 = BufU32(k_rva).d[cidx +  4u];
            uint pk2 = BufU32(k_rva).d[cidx +  8u];
            uint pk3 = BufU32(k_rva).d[cidx + 12u];
            f16vec2 k0 = unpackFloat2x16(pk0);
            f16vec2 k1 = unpackFloat2x16(pk1);
            f16vec2 k2 = unpackFloat2x16(pk2);
            f16vec2 k3 = unpackFloat2x16(pk3);
#elif KV_DTYPE_K == 4
            const uint64_t bva = k_rva + uint64_t(blk) * 34ul;
            const float16_t sc = BufF16(bva).d[0];
            const uint qidx = cm_c >> 1u;
            i8vec2 q0v = BufI8V2(bva + 2ul).d[qidx +  0u];
            i8vec2 q1v = BufI8V2(bva + 2ul).d[qidx +  4u];
            i8vec2 q2v = BufI8V2(bva + 2ul).d[qidx +  8u];
            i8vec2 q3v = BufI8V2(bva + 2ul).d[qidx + 12u];
            f16vec2 k0 = f16vec2(q0v) * sc;
            f16vec2 k1 = f16vec2(q1v) * sc;
            f16vec2 k2 = f16vec2(q2v) * sc;
            f16vec2 k3 = f16vec2(q3v) * sc;
#else
            const uint cidx = (d32 + cm_c) >> 1u;
            uint16_t b0 = BufU16(k_rva).d[cidx +  0u];
            uint16_t b1 = BufU16(k_rva).d[cidx +  4u];
            uint16_t b2 = BufU16(k_rva).d[cidx +  8u];
            uint16_t b3 = BufU16(k_rva).d[cidx + 12u];
            f16vec2 k0 = pf_e4m3_pair_to_f16x2(b0);
            f16vec2 k1 = pf_e4m3_pair_to_f16x2(b1);
            f16vec2 k2 = pf_e4m3_pair_to_f16x2(b2);
            f16vec2 k3 = pf_e4m3_pair_to_f16x2(b3);
#endif
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> Km0, Km1, Km2, Km3;
            Km0[0] = k0.x; Km0[1] = k0.y;
            Km1[0] = k1.x; Km1[1] = k1.y;
            Km2[0] = k2.x; Km2[1] = k2.y;
            Km3[0] = k3.x; Km3[1] = k3.y;

            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> Qm;
            const uint qr0 = (d32 +  0u + cm_r) * 16u;
            [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
                f16vec2 qp = unpackFloat2x16(sh_q[qr0 + (q_c0 ^ (m * 4u))]);
                Qm[0] = qp.x; Qm[1] = qp.y;
                SfMat[m] = coopMatMulAdd(Km0, Qm, SfMat[m]);
            }

            const uint qr1 = (d32 +  8u + cm_r) * 16u;
            [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
                f16vec2 qp = unpackFloat2x16(sh_q[qr1 + (q_c0 ^ (m * 4u))]);
                Qm[0] = qp.x; Qm[1] = qp.y;
                SfMat[m] = coopMatMulAdd(Km1, Qm, SfMat[m]);
            }

            const uint qr2 = (d32 + 16u + cm_r) * 16u;
            [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
                f16vec2 qp = unpackFloat2x16(sh_q[qr2 + (q_c0 ^ (m * 4u))]);
                Qm[0] = qp.x; Qm[1] = qp.y;
                SfMat[m] = coopMatMulAdd(Km2, Qm, SfMat[m]);
            }

            const uint qr3 = (d32 + 24u + cm_r) * 16u;
            [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
                f16vec2 qp = unpackFloat2x16(sh_q[qr3 + (q_c0 ^ (m * 4u))]);
                Qm[0] = qp.x; Qm[1] = qp.y;
                SfMat[m] = coopMatMulAdd(Km3, Qm, SfMat[m]);
            }
        }

        // Wait for prior iter's Phase 3 (or skip flag) reads of sh_buf AFTER Phase 1 K-loads & MMAs!
        if (prev_sh_live) {
            barrier();
        }

        const uint kv_loc_sw = (sg * 8u + cm_r) ^ s_sw0; // 32/32 distinct banks (0 conflicts!)
        [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
            sh_buf[(m * 8u + cm_c + 0u) * 64u + kv_loc_sw] = floatBitsToUint(SfMat[m][0]);
            sh_buf[(m * 8u + cm_c + 1u) * 64u + kv_loc_sw] = floatBitsToUint(SfMat[m][1]);
        }

        barrier(); // Phase 1 -> Phase 2: sh_buf scores ready!

        // Phase 2: Fused Softcap + Mask + Banded Rel-Bias + Online Softmax -> sh_buf (P in 0..31, eM in 32+rl)
        bool tile_has_rel = false;
        int kp0 = -1073741824;
        int kp1 = -1073741824;
        if (has_banded) {
            const uint b64 = kv0 >> 6u;
            const int tmin = BufI32(pc.rel_pos_pack_va).d[pc.rel_tm_off + b64 * 2u + 0u];
            const int tmax = BufI32(pc.rel_pos_pack_va).d[pc.rel_tm_off + b64 * 2u + 1u];
            tile_has_rel = (q_pmax >= tmin) && (q_pmin < tmax + int(pc.n_rel_extent));
            if (tile_has_rel) {
                if (kv0 + lane < pc.n_kv)       kp0 = BufI32(pc.rel_pos_pack_va).d[pc.rel_cp_off + kv0 + lane];
                if (kv0 + lane + 32u < pc.n_kv) kp1 = BufI32(pc.rel_pos_pack_va).d[pc.rel_cp_off + kv0 + lane + 32u];
            }
        }

        const uint c0 = kv0 + lane;
        const uint c1 = kv0 + lane + 32u;
        const bool ok0 = c0 < pc.n_kv;
        const bool ok1 = c1 < pc.n_kv;
        const uint64_t mask_h_va = pc.kq_mask_va + uint64_t(mask_h) * uint64_t(pc.ext_mask_nb2);

        [[dont_unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
            const uint rl    = sg * PF_SM_ROWS + r;
            const uint q_row = q0 + rl;
            const uint sw_s  = (rl & 6u) << 2u;
            float s0 = ok0 ? uintBitsToFloat(sh_buf[rl * 64u + (lane ^ sw_s)])         : -3.402823466e+38f;
            float s1 = ok1 ? uintBitsToFloat(sh_buf[rl * 64u + ((lane + 32u) ^ sw_s)]) : -3.402823466e+38f;

            if (has_softcap) {
                if (ok0) s0 = pc.logit_softcap * tanh(s0);
                if (ok1) s1 = pc.logit_softcap * tanh(s1);
            }

            if (q_row < pc.n_tokens) {
                if (has_mask) {
                    const uint64_t mva = mask_h_va + uint64_t(q_row) * uint64_t(pc.ext_mask_nb1);
                    if (ok0) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c0]) : BufF32(mva).d[c0];
                        s0 += slope_v * mv;
                    }
                    if (ok1) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c1]) : BufF32(mva).d[c1];
                        s1 += slope_v * mv;
                    }
                }
                if (tile_has_rel) {
                    const int qp = BufI32(pc.rel_pos_pack_va).d[pc.rel_qp_off + q_row];
                    const uint64_t rt_base = pc.rel_table_va
                        + uint64_t(q_row * pc.n_head_q + h_q) * uint64_t(pc.rel_table_len) * 4ul;
                    const int d0 = qp - kp0;
                    const int d1 = qp - kp1;
                    if (ok0 && d0 >= 0 && uint(d0) < pc.n_rel_extent && uint(d0) < pc.rel_table_len) {
                        s0 += BufF32(rt_base).d[uint(d0)];
                    }
                    if (ok1 && d1 >= 0 && uint(d1) < pc.n_rel_extent && uint(d1) < pc.rel_table_len) {
                        s1 += BufF32(rt_base).d[uint(d1)];
                    }
                }
            } else {
                s0 = -3.402823466e+38f;
                s1 = -3.402823466e+38f;
            }

            const float rmax  = subgroupMax(max(s0, s1));
            const float m_old = Mf[r];
            const float m_new = max(m_old, rmax);
            const float eM    = (m_old > -1.0e30f) ? exp(m_old - m_new) : 0.0f;
            const float p0    = (ok0 && s0 > -1.0e30f) ? exp(s0 - m_new) : 0.0f;
            const float p1    = (ok1 && s1 > -1.0e30f) ? exp(s1 - m_new) : 0.0f;

            Mf[r] = m_new;
            Lf[r] = Lf[r] * eM + subgroupAdd(p0 + p1);

            const float p0_nb = subgroupShuffleXor(p0, 1u);
            const float p1_nb = subgroupShuffleXor(p1, 1u);
            // Each SG owns disjoint rows rl; subgroup shared-only barrier guarantees s0/s1 reads finish
            // before in-place overwrite without emitting any global/device memory fence!
            controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
            if (lane == 0u) {
                sh_buf[rl * 64u + 32u + rl] = floatBitsToUint(eM);
            }
            if ((lane & 1u) == 0u) {
                const uint sw_p = (rl & 7u) << 2u;
                const uint c_p0 = lane >> 1u;
                sh_buf[rl * 64u + (c_p0 ^ sw_p)]         = packFloat2x16(f16vec2(float16_t(p0), float16_t(p0_nb)));
                sh_buf[rl * 64u + ((16u + c_p0) ^ sw_p)] = packFloat2x16(f16vec2(float16_t(p1), float16_t(p1_nb)));
            }
        }

        barrier(); // Phase 2 -> Phase 3: sh_buf P & eM ready!
        prev_sh_live = true;

        // Phase 3: Rescale OfMat + P * V (Zero V SRAM! 16 MMAs per 4 global V loads -> 2x AI vs Br=16!)
        [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
            const uint rl = m * 8u + cm_r;
            const float eM = uintBitsToFloat(sh_buf[rl * 64u + 32u + rl]);
            OfMat[m][0][0] *= eM; OfMat[m][0][1] *= eM;
            OfMat[m][1][0] *= eM; OfMat[m][1][1] *= eM;
        }

        const uint64_t v_head_va = pc.v_va + uint64_t(h_kv) * uint64_t(pc.ext_v_nb2);
        [[dont_unroll]] for (uint k16 = 0u; k16 < PF_BC; k16 += 16u) {
            const uint vr0_raw = kv0 + k16 + 0u + cm_r;
            const uint vr1_raw = kv0 + k16 + 8u + cm_r;
            const uint64_t v_rva0 = v_head_va + uint64_t(min(vr0_raw, kv_last)) * uint64_t(pc.ext_v_nb1);
            const uint64_t v_rva1 = v_head_va + uint64_t(min(vr1_raw, kv_last)) * uint64_t(pc.ext_v_nb1);

#if KV_DTYPE_V == 2
            const uint vidx = (d_sg_base + cm_c) >> 1u;
            uint pv0 = BufU32(v_rva0).d[vidx + 0u];
            uint pv1 = BufU32(v_rva0).d[vidx + 4u];
            uint pv2 = BufU32(v_rva1).d[vidx + 0u];
            uint pv3 = BufU32(v_rva1).d[vidx + 4u];
            f16vec2 va0 = unpackFloat2x16(pv0);
            f16vec2 va1 = unpackFloat2x16(pv1);
            f16vec2 vb0 = unpackFloat2x16(pv2);
            f16vec2 vb1 = unpackFloat2x16(pv3);
#elif KV_DTYPE_V == 4
            const uint v_blk_off = (d_sg_base >> 5u) * 34u;
            const uint v_qidx    = ((d_sg_base & 31u) + cm_c) >> 1u;
            const uint64_t vb0a  = v_rva0 + uint64_t(v_blk_off);
            const uint64_t vb1a  = v_rva1 + uint64_t(v_blk_off);
            const float16_t sc0  = BufF16(vb0a).d[0];
            const float16_t sc1  = BufF16(vb1a).d[0];
            i8vec2 q0a = BufI8V2(vb0a + 2ul).d[v_qidx + 0u];
            i8vec2 q1a = BufI8V2(vb0a + 2ul).d[v_qidx + 4u];
            i8vec2 q0b = BufI8V2(vb1a + 2ul).d[v_qidx + 0u];
            i8vec2 q1b = BufI8V2(vb1a + 2ul).d[v_qidx + 4u];
            f16vec2 va0 = f16vec2(q0a) * sc0;
            f16vec2 va1 = f16vec2(q1a) * sc0;
            f16vec2 vb0 = f16vec2(q0b) * sc1;
            f16vec2 vb1 = f16vec2(q1b) * sc1;
#else
            const uint vidx = (d_sg_base + cm_c) >> 1u;
            uint16_t bv0 = BufU16(v_rva0).d[vidx + 0u];
            uint16_t bv1 = BufU16(v_rva0).d[vidx + 4u];
            uint16_t bv2 = BufU16(v_rva1).d[vidx + 0u];
            uint16_t bv3 = BufU16(v_rva1).d[vidx + 4u];
            f16vec2 va0 = pf_e4m3_pair_to_f16x2(bv0);
            f16vec2 va1 = pf_e4m3_pair_to_f16x2(bv1);
            f16vec2 vb0 = pf_e4m3_pair_to_f16x2(bv2);
            f16vec2 vb1 = pf_e4m3_pair_to_f16x2(bv3);
#endif
            if (vr0_raw >= pc.n_kv) { va0 = f16vec2(float16_t(0.0)); va1 = f16vec2(float16_t(0.0)); }
            if (vr1_raw >= pc.n_kv) { vb0 = f16vec2(float16_t(0.0)); vb1 = f16vec2(float16_t(0.0)); }

            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> Vm0, Vm1, Vm2, Vm3;
            Vm0[0] = va0.x; Vm0[1] = va0.y;
            Vm1[0] = va1.x; Vm1[1] = va1.y;
            Vm2[0] = vb0.x; Vm2[1] = vb0.y;
            Vm3[0] = vb1.x; Vm3[1] = vb1.y;

            const uint p_idx0 = ((k16 + cm_c) >> 1u) ^ p_sw;
            const uint p_idx1 = p_idx0 ^ 4u;
            [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
                const uint p_row = (m * 8u + cm_r) * 64u;
                f16vec2 p0 = unpackFloat2x16(sh_buf[p_row + p_idx0]);
                f16vec2 p1 = unpackFloat2x16(sh_buf[p_row + p_idx1]);
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> Pm0, Pm1;
                Pm0[0] = p0.x; Pm0[1] = p0.y;
                Pm1[0] = p1.x; Pm1[1] = p1.y;
                OfMat[m][0] = coopMatMulAdd(Pm0, Vm0, OfMat[m][0]);
                OfMat[m][1] = coopMatMulAdd(Pm0, Vm1, OfMat[m][1]);
                OfMat[m][0] = coopMatMulAdd(Pm1, Vm2, OfMat[m][0]);
                OfMat[m][1] = coopMatMulAdd(Pm1, Vm3, OfMat[m][1]);
            }
        }
    }

    // Epilogue: Sink + InvL Normalization + Optional FWHT64 + Optional QGate + Store
    if (prev_sh_live) {
        barrier(); // ensure Phase 3 finished reading sh_buf before writing invL
    }
    [[dont_unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
        const uint rl    = sg * PF_SM_ROWS + r;
        const uint q_row = q0 + rl;
        float ms = 1.0f;
        float L  = Lf[r];
        float M  = Mf[r];
        if (q_row < pc.n_tokens) {
            bool  has_sink;
            float eff_sink;
            get_sink_info(q_row, h_q, has_sink, eff_sink);
            if (has_sink) {
                float vs = 1.0f;
                if (eff_sink > M) { ms = (M > -1.0e30f) ? exp(M - eff_sink) : 0.0f; }
                else              { vs = exp(eff_sink - M); }
                L = L * ms + vs;
            }
        }
        if (lane == 0u) {
            sh_buf[rl * 64u + 32u + rl] = floatBitsToUint((L > 0.0f) ? (ms / L) : 0.0f);
        }
    }
    barrier();

    [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
        const uint rl = m * 8u + cm_r;
        const float invL = uintBitsToFloat(sh_buf[rl * 64u + 32u + rl]);
        OfMat[m][0][0] *= invL; OfMat[m][0][1] *= invL;
        OfMat[m][1][0] *= invL; OfMat[m][1][1] *= invL;
    }

    const bool do_fwht  = (pc.flags & FLAG_FWHT64) != 0u;
    const bool do_qg32  = (pc.flags & FLAG_QGATE_F32) != 0u && (pc.q_gate_va != 0ul);
    const bool do_qg16  = (pc.flags & FLAG_QGATE_F16) != 0u && (pc.q_gate_va != 0ul);
    const bool out_f16  = (pc.flags & FLAG_OUT_F16) != 0u;

    if (!do_fwht) {
        [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
            const uint q_row = q0 + m * 8u + cm_r;
            if (q_row < pc.n_tokens) {
                const uint base_elem = (q_row * pc.n_head_q + h_q) * HEAD_DIM + d_sg_base + cm_c;
                vec2 v0 = vec2(OfMat[m][0][0], OfMat[m][0][1]);
                vec2 v1 = vec2(OfMat[m][1][0], OfMat[m][1][1]);
                if (do_qg32) {
                    v0 /= (vec2(1.0f) + exp(-vec2(BufF32(pc.q_gate_va).d[base_elem],      BufF32(pc.q_gate_va).d[base_elem + 1u])));
                    v1 /= (vec2(1.0f) + exp(-vec2(BufF32(pc.q_gate_va).d[base_elem + 8u], BufF32(pc.q_gate_va).d[base_elem + 9u])));
                } else if (do_qg16) {
                    vec2 g0 = vec2(unpackFloat2x16(BufU32(pc.q_gate_va).d[base_elem >> 1u]));
                    vec2 g1 = vec2(unpackFloat2x16(BufU32(pc.q_gate_va).d[(base_elem + 8u) >> 1u]));
                    v0 /= (vec2(1.0f) + exp(-g0));
                    v1 /= (vec2(1.0f) + exp(-g1));
                }
                if (out_f16) {
                    BufF16W(pc.out_va).d[base_elem + 0u] = float16_t(v0.x);
                    BufF16W(pc.out_va).d[base_elem + 1u] = float16_t(v0.y);
                    BufF16W(pc.out_va).d[base_elem + 8u] = float16_t(v1.x);
                    BufF16W(pc.out_va).d[base_elem + 9u] = float16_t(v1.y);
                } else {
                    BufF32W(pc.out_va).d[base_elem + 0u] = v0.x;
                    BufF32W(pc.out_va).d[base_elem + 1u] = v0.y;
                    BufF32W(pc.out_va).d[base_elem + 8u] = v1.x;
                    BufF32W(pc.out_va).d[base_elem + 9u] = v1.y;
                }
            }
        }
    } else {
        [[dont_unroll]] for (uint half_i = 0u; half_i < 2u; ++half_i) {
            barrier();
            if ((sg >> 2u) == half_i) {
                const uint col_off = (sg & 3u) * 16u + cm_c;
                const uint sw_e    = (cm_r & 3u) << 3u;
                [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
                    const uint row_off = (m * 8u + cm_r) * 64u;
                    sh_buf[row_off + ((col_off + 0u) ^ sw_e)] = floatBitsToUint(OfMat[m][0][0]);
                    sh_buf[row_off + ((col_off + 1u) ^ sw_e)] = floatBitsToUint(OfMat[m][0][1]);
                    sh_buf[row_off + ((col_off + 8u) ^ sw_e)] = floatBitsToUint(OfMat[m][1][0]);
                    sh_buf[row_off + ((col_off + 9u) ^ sw_e)] = floatBitsToUint(OfMat[m][1][1]);
                }
            }
            barrier();
            [[dont_unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
                const uint rl    = sg * PF_SM_ROWS + r;
                const uint q_row = q0 + rl;
                if (q_row < pc.n_tokens) {
                    const uint sw_e = (rl & 3u) << 3u;
                    float a = uintBitsToFloat(sh_buf[rl * 64u + (lane ^ sw_e)]);
                    float b = uintBitsToFloat(sh_buf[rl * 64u + ((lane + 32u) ^ sw_e)]);
                    float t0 = a + b; float t1 = a - b;
                    a = t0; b = t1;
                    [[unroll]] for (uint step = 1u; step < 32u; step <<= 1u) {
                        float sa = subgroupShuffleXor(a, step);
                        float sb = subgroupShuffleXor(b, step);
                        bool hi = (lane & step) != 0u;
                        a = hi ? (sa - a) : (a + sa);
                        b = hi ? (sb - b) : (b + sb);
                    }
                    a *= 0.125f; b *= 0.125f;
                    const uint base = (q_row * pc.n_head_q + h_q) * HEAD_DIM + half_i * 64u;
                    if (do_qg32) {
                        a /= (1.0f + exp(-BufF32(pc.q_gate_va).d[base + lane]));
                        b /= (1.0f + exp(-BufF32(pc.q_gate_va).d[base + lane + 32u]));
                    } else if (do_qg16) {
                        a /= (1.0f + exp(-float(BufF16(pc.q_gate_va).d[base + lane])));
                        b /= (1.0f + exp(-float(BufF16(pc.q_gate_va).d[base + lane + 32u])));
                    }
                    if (out_f16) {
                        BufF16W(pc.out_va).d[base + lane]       = float16_t(a);
                        BufF16W(pc.out_va).d[base + lane + 32u] = float16_t(b);
                    } else {
                        BufF32W(pc.out_va).d[base + lane]       = a;
                        BufF32W(pc.out_va).d[base + lane + 32u] = b;
                    }
                }
            }
        }
    }
}

#else // PF_BR == 16

#undef PF_BR
#define PF_BR       16u
#define PF_Q_TILES  2u
#define PF_SM_ROWS  2u
#define PF_SF_STR   65u  // 64+1 f32 = 260 B (4 B mod 128 B -> 0 bank conflicts!)
#define PF_PF_STR   33u  // 32+1 u32 = 132 B (4 B mod 128 B -> 0 bank conflicts!)

shared float16_t sh_q[HEAD_DIM * PF_BR];   // 4,096 B (XOR-swizzled by (d & 4) << 1)
shared float     sh_sf[PF_BR * PF_SF_STR]; // 4,160 B (FP32 scores + FWHT64 epilogue scratch)
shared uint      sh_pf[PF_BR * PF_PF_STR]; // 2,112 B (packed FP16x2 probabilities)
shared float     sh_eM[PF_BR];             //    64 B (online rescale / final invL)
shared int       sh_q_pos[PF_BR];          //    64 B (query positions for banded rel-bias)
shared uint      sh_tile_skip;             //     4 B (all-masked 64-KV tile skip)

void main() {
    // Reverse Q-tile order + GQA head-grouped launch (x=h_q, y=q_tile_rev):
    // heaviest late-sequence causal tiles launch first and all GQA Q heads of the same h_kv
    // share L2/SLC K/V lines simultaneously!
    const uint h_q    = gl_WorkGroupID.x;
    const uint n_qt   = (pc.n_tokens + PF_BR - 1u) / PF_BR;
    const uint q_tile = (n_qt - 1u) - gl_WorkGroupID.y;
    const uint q0     = q_tile * PF_BR;
    if (h_q >= pc.n_head_q || q0 >= pc.n_tokens) {
        return;
    }

    const uint sg   = gl_LocalInvocationID.y;  // 0..7
    const uint lane = gl_LocalInvocationID.x;  // 0..31
    const uint tid  = sg * 32u + lane;         // 0..255

    const uint gqa  = max(1u, pc.n_head_q / pc.n_head_kv);
    const uint h_kv = h_q / gqa;

    const uint cm_r = agx_cmat8_row(lane);     // 0..7
    const uint cm_c = agx_cmat8_col0(lane);    // 0, 2, 4, 6
    const uint q_sw = (cm_r & 4u) << 1u;       // 0 for cm_r 0..3, 8 for cm_r 4..7

    // 1. Load Q[q0..q0+15, h_q, 0..127] * kq_scale -> XOR-swizzled sh_q[d * 16 + (ql ^ ((d&4)<<1))]
    const bool q_is_f16 = (pc.flags & FLAG_Q_F16) != 0u;
    const float q_sc = pc.kq_scale;
    for (uint idx = tid; idx < PF_BR * 32u; idx += 256u) {
        const uint ql = idx >> 5u;
        const uint d4 = (idx & 31u) << 2u;
        f16vec4 qv = f16vec4(float16_t(0.0));
        if (q0 + ql < pc.n_tokens) {
            uint64_t qva = pc.q_va + uint64_t(q0 + ql) * uint64_t(pc.q_nb1) + uint64_t(h_q) * uint64_t(pc.q_nb2);
            vec4 qf;
            if (q_is_f16) {
                qf = vec4(BufF16V4(qva).d[d4 >> 2u]) * q_sc;
            } else if ((qva & 15ul) == 0ul) {
                qf = BufVec4R(qva).d[d4 >> 2u] * q_sc;
            } else {
                BufF32 qb = BufF32(qva);
                qf = vec4(qb.d[d4 + 0u], qb.d[d4 + 1u], qb.d[d4 + 2u], qb.d[d4 + 3u]) * q_sc;
            }
            qv = f16vec4(clamp(qf, vec4(-65504.0f), vec4(65504.0f)));
        }
        const uint ql_sw = ql ^ ((d4 & 4u) << 1u);
        sh_q[(d4 + 0u) * PF_BR + ql_sw] = qv.x;
        sh_q[(d4 + 1u) * PF_BR + ql_sw] = qv.y;
        sh_q[(d4 + 2u) * PF_BR + ql_sw] = qv.z;
        sh_q[(d4 + 3u) * PF_BR + ql_sw] = qv.w;
    }

    const bool has_banded = (pc.flags & FLAG_BANDED_REL_BIAS) != 0u &&
                            (pc.rel_table_va != 0ul) && (pc.rel_pos_pack_va != 0ul);
    if (has_banded && tid < PF_BR) {
        sh_q_pos[tid] = (q0 + tid < pc.n_tokens)
            ? BufI32(pc.rel_pos_pack_va).d[pc.rel_qp_off + q0 + tid]
            : -1073741824;
    }

    uint kv_beg = 0u;
    uint kv_end = pc.n_kv;
    bool span_no_holes = false;
    if ((pc.flags & FLAG_KV_BOUNDS) != 0u && pc.partial_va != 0ul) {
        uvec2 b = BufUvec2(pc.partial_va).d[q_tile];
        kv_beg = b.x & ~63u;
        span_no_holes = (b.y & 0x80000000u) != 0u;
        kv_end = min(pc.n_kv, b.y & 0x7FFFFFFFu);
    }

    barrier();

    int q_pmin = 1073741824;
    int q_pmax = -1073741824;
    if (has_banded) {
        for (uint r = 0u; r < PF_BR; ++r) {
            if (q0 + r < pc.n_tokens) {
                int p = sh_q_pos[r];
                q_pmin = min(q_pmin, p);
                q_pmax = max(q_pmax, p);
            }
        }
    }

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> OfMat[PF_Q_TILES][2];
    [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
        OfMat[m][0] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        OfMat[m][1] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    }

    float Mf[PF_SM_ROWS];
    float Lf[PF_SM_ROWS];
    [[unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
        Mf[r] = -3.402823466e+38f;
        Lf[r] = 0.0f;
    }

    const bool has_mask_f16 = (pc.flags & FLAG_HAS_MASK_F16) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask_f32 = (pc.flags & FLAG_HAS_MASK_F32) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask     = has_mask_f16 || has_mask_f32;
    const bool has_softcap  = (pc.flags & FLAG_SOFTCAP) != 0u && (pc.logit_softcap != 0.0f);
    const float slope_v     = compute_alibi_slope(h_q);
    const uint mask_h       = (pc.ext_mask_ne2 > 1u) ? (h_q % pc.ext_mask_ne2) : 0u;
    const uint kv_last      = (pc.n_kv > 0u) ? (pc.n_kv - 1u) : 0u;
    const uint d_sg_base    = sg * 16u;
    const uint q_c0         = (0u + cm_c) ^ q_sw;
    const uint q_c1         = (8u + cm_c) ^ q_sw;

    for (uint kv0 = kv_beg; kv0 < kv_end; kv0 += PF_BC) {
        if (has_mask && !span_no_holes) {
            if (tid == 0u) {
                sh_tile_skip = 1u;
            }
            barrier();
            bool any_ok = false;
            const uint64_t mask_h_va = pc.kq_mask_va + uint64_t(mask_h) * uint64_t(pc.ext_mask_nb2);
            [[dont_unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
                const uint q_row = q0 + sg * PF_SM_ROWS + r;
                if (q_row < pc.n_tokens) {
                    const uint64_t mva = mask_h_va + uint64_t(q_row) * uint64_t(pc.ext_mask_nb1);
                    const uint c0 = kv0 + lane;
                    const uint c1 = kv0 + lane + 32u;
                    if (c0 < pc.n_kv) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c0]) : BufF32(mva).d[c0];
                        if (mv > -1.0e30f) any_ok = true;
                    }
                    if (c1 < pc.n_kv) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c1]) : BufF32(mva).d[c1];
                        if (mv > -1.0e30f) any_ok = true;
                    }
                }
            }
            if (subgroupAny(any_ok) && lane == 0u) {
                sh_tile_skip = 0u;
            }
            barrier();
            if (sh_tile_skip != 0u) {
                continue;
            }
        }

        // Phase 1: S^T = K * Q^T (Zero K SRAM! 4 branchless global K loads/iter -> MMA ILP + load batch!)
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> SfMat0 =
            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> SfMat1 =
            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);

        const uint k_row = min(kv0 + sg * 8u + cm_r, kv_last);
        const uint64_t k_rva = pc.k_or_pt_va
            + uint64_t(h_kv) * uint64_t(pc.ext_k_nb2)
            + uint64_t(k_row) * uint64_t(pc.ext_k_nb1);

        [[dont_unroll]] for (uint blk = 0u; blk < HEAD_DIM / 32u; ++blk) {
            const uint d32 = blk * 32u;
#if KV_DTYPE_K == 2
            const uint cidx = (d32 + cm_c) >> 1u;
            uint pk0 = BufU32(k_rva).d[cidx +  0u];
            uint pk1 = BufU32(k_rva).d[cidx +  4u];
            uint pk2 = BufU32(k_rva).d[cidx +  8u];
            uint pk3 = BufU32(k_rva).d[cidx + 12u];
            f16vec2 k0 = unpackFloat2x16(pk0);
            f16vec2 k1 = unpackFloat2x16(pk1);
            f16vec2 k2 = unpackFloat2x16(pk2);
            f16vec2 k3 = unpackFloat2x16(pk3);
#elif KV_DTYPE_K == 4
            const uint64_t bva = k_rva + uint64_t(blk) * 34ul;
            const float16_t sc = BufF16(bva).d[0];
            const uint qidx = cm_c >> 1u;
            i8vec2 q0v = BufI8V2(bva + 2ul).d[qidx +  0u];
            i8vec2 q1v = BufI8V2(bva + 2ul).d[qidx +  4u];
            i8vec2 q2v = BufI8V2(bva + 2ul).d[qidx +  8u];
            i8vec2 q3v = BufI8V2(bva + 2ul).d[qidx + 12u];
            f16vec2 k0 = f16vec2(q0v) * sc;
            f16vec2 k1 = f16vec2(q1v) * sc;
            f16vec2 k2 = f16vec2(q2v) * sc;
            f16vec2 k3 = f16vec2(q3v) * sc;
#else
            const uint cidx = (d32 + cm_c) >> 1u;
            uint16_t b0 = BufU16(k_rva).d[cidx +  0u];
            uint16_t b1 = BufU16(k_rva).d[cidx +  4u];
            uint16_t b2 = BufU16(k_rva).d[cidx +  8u];
            uint16_t b3 = BufU16(k_rva).d[cidx + 12u];
            f16vec2 k0 = pf_e4m3_pair_to_f16x2(b0);
            f16vec2 k1 = pf_e4m3_pair_to_f16x2(b1);
            f16vec2 k2 = pf_e4m3_pair_to_f16x2(b2);
            f16vec2 k3 = pf_e4m3_pair_to_f16x2(b3);
#endif
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> Km0, Km1, Km2, Km3;
            Km0[0] = k0.x; Km0[1] = k0.y;
            Km1[0] = k1.x; Km1[1] = k1.y;
            Km2[0] = k2.x; Km2[1] = k2.y;
            Km3[0] = k3.x; Km3[1] = k3.y;

            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> Qm0, Qm1;
            const uint qr0 = (d32 +  0u + cm_r) * PF_BR;
            Qm0[0] = sh_q[qr0 + q_c0]; Qm0[1] = sh_q[qr0 + q_c0 + 1u];
            Qm1[0] = sh_q[qr0 + q_c1]; Qm1[1] = sh_q[qr0 + q_c1 + 1u];
            SfMat0 = coopMatMulAdd(Km0, Qm0, SfMat0);
            SfMat1 = coopMatMulAdd(Km0, Qm1, SfMat1);

            const uint qr1 = (d32 +  8u + cm_r) * PF_BR;
            Qm0[0] = sh_q[qr1 + q_c0]; Qm0[1] = sh_q[qr1 + q_c0 + 1u];
            Qm1[0] = sh_q[qr1 + q_c1]; Qm1[1] = sh_q[qr1 + q_c1 + 1u];
            SfMat0 = coopMatMulAdd(Km1, Qm0, SfMat0);
            SfMat1 = coopMatMulAdd(Km1, Qm1, SfMat1);

            const uint qr2 = (d32 + 16u + cm_r) * PF_BR;
            Qm0[0] = sh_q[qr2 + q_c0]; Qm0[1] = sh_q[qr2 + q_c0 + 1u];
            Qm1[0] = sh_q[qr2 + q_c1]; Qm1[1] = sh_q[qr2 + q_c1 + 1u];
            SfMat0 = coopMatMulAdd(Km2, Qm0, SfMat0);
            SfMat1 = coopMatMulAdd(Km2, Qm1, SfMat1);

            const uint qr3 = (d32 + 24u + cm_r) * PF_BR;
            Qm0[0] = sh_q[qr3 + q_c0]; Qm0[1] = sh_q[qr3 + q_c0 + 1u];
            Qm1[0] = sh_q[qr3 + q_c1]; Qm1[1] = sh_q[qr3 + q_c1 + 1u];
            SfMat0 = coopMatMulAdd(Km3, Qm0, SfMat0);
            SfMat1 = coopMatMulAdd(Km3, Qm1, SfMat1);
        }

        const uint kv_loc = sg * 8u + cm_r;
        sh_sf[(0u + cm_c + 0u) * PF_SF_STR + kv_loc] = SfMat0[0];
        sh_sf[(0u + cm_c + 1u) * PF_SF_STR + kv_loc] = SfMat0[1];
        sh_sf[(8u + cm_c + 0u) * PF_SF_STR + kv_loc] = SfMat1[0];
        sh_sf[(8u + cm_c + 1u) * PF_SF_STR + kv_loc] = SfMat1[1];

        barrier(); // Barrier #1: sh_sf ready & prior iter's sh_pf reads complete!

        // Phase 2: Fused Softcap + Mask + Banded Rel-Bias + Online Softmax -> sh_pf & sh_eM
        bool tile_has_rel = false;
        int kp0 = -1073741824;
        int kp1 = -1073741824;
        if (has_banded) {
            const uint b64 = kv0 >> 6u;
            const int tmin = BufI32(pc.rel_pos_pack_va).d[pc.rel_tm_off + b64 * 2u + 0u];
            const int tmax = BufI32(pc.rel_pos_pack_va).d[pc.rel_tm_off + b64 * 2u + 1u];
            tile_has_rel = (q_pmax >= tmin) && (q_pmin < tmax + int(pc.n_rel_extent));
            if (tile_has_rel) {
                if (kv0 + lane < pc.n_kv)       kp0 = BufI32(pc.rel_pos_pack_va).d[pc.rel_cp_off + kv0 + lane];
                if (kv0 + lane + 32u < pc.n_kv) kp1 = BufI32(pc.rel_pos_pack_va).d[pc.rel_cp_off + kv0 + lane + 32u];
            }
        }

        const uint c0 = kv0 + lane;
        const uint c1 = kv0 + lane + 32u;
        const bool ok0 = c0 < pc.n_kv;
        const bool ok1 = c1 < pc.n_kv;
        const uint64_t mask_h_va = pc.kq_mask_va + uint64_t(mask_h) * uint64_t(pc.ext_mask_nb2);

        [[dont_unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
            const uint rl    = sg * PF_SM_ROWS + r;
            const uint q_row = q0 + rl;
            float s0 = ok0 ? sh_sf[rl * PF_SF_STR + lane]       : -3.402823466e+38f;
            float s1 = ok1 ? sh_sf[rl * PF_SF_STR + lane + 32u] : -3.402823466e+38f;

            if (has_softcap) {
                if (ok0) s0 = pc.logit_softcap * tanh(s0);
                if (ok1) s1 = pc.logit_softcap * tanh(s1);
            }

            if (q_row < pc.n_tokens) {
                if (has_mask) {
                    const uint64_t mva = mask_h_va + uint64_t(q_row) * uint64_t(pc.ext_mask_nb1);
                    if (ok0) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c0]) : BufF32(mva).d[c0];
                        s0 += slope_v * mv;
                    }
                    if (ok1) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c1]) : BufF32(mva).d[c1];
                        s1 += slope_v * mv;
                    }
                }
                if (tile_has_rel) {
                    const int qp = sh_q_pos[rl];
                    const uint64_t rt_base = pc.rel_table_va
                        + uint64_t(q_row * pc.n_head_q + h_q) * uint64_t(pc.rel_table_len) * 4ul;
                    const int d0 = qp - kp0;
                    const int d1 = qp - kp1;
                    if (ok0 && d0 >= 0 && uint(d0) < pc.n_rel_extent && uint(d0) < pc.rel_table_len) {
                        s0 += BufF32(rt_base).d[uint(d0)];
                    }
                    if (ok1 && d1 >= 0 && uint(d1) < pc.n_rel_extent && uint(d1) < pc.rel_table_len) {
                        s1 += BufF32(rt_base).d[uint(d1)];
                    }
                }
            } else {
                s0 = -3.402823466e+38f;
                s1 = -3.402823466e+38f;
            }

            const float rmax  = subgroupMax(max(s0, s1));
            const float m_old = Mf[r];
            const float m_new = max(m_old, rmax);
            const float eM    = (m_old > -1.0e30f) ? exp(m_old - m_new) : 0.0f;
            const float p0    = (ok0 && s0 > -1.0e30f) ? exp(s0 - m_new) : 0.0f;
            const float p1    = (ok1 && s1 > -1.0e30f) ? exp(s1 - m_new) : 0.0f;

            Mf[r] = m_new;
            Lf[r] = Lf[r] * eM + subgroupAdd(p0 + p1);
            if (lane == 0u) {
                sh_eM[rl] = eM;
            }
            const float p0_nb = subgroupShuffleXor(p0, 1u);
            const float p1_nb = subgroupShuffleXor(p1, 1u);
            if ((lane & 1u) == 0u) {
                sh_pf[rl * PF_PF_STR + (lane >> 1u)]       = packFloat2x16(f16vec2(float16_t(p0), float16_t(p0_nb)));
                sh_pf[rl * PF_PF_STR + 16u + (lane >> 1u)] = packFloat2x16(f16vec2(float16_t(p1), float16_t(p1_nb)));
            }
        }

        barrier(); // Barrier #2: sh_pf & sh_eM ready & this iter's sh_sf reads complete!

        // Phase 3: Rescale OfMat + P * V (Zero V SRAM! 4 branchless global V loads/iter!)
        [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
            const float eM = sh_eM[m * 8u + cm_r];
            OfMat[m][0][0] *= eM; OfMat[m][0][1] *= eM;
            OfMat[m][1][0] *= eM; OfMat[m][1][1] *= eM;
        }

        const uint64_t v_head_va = pc.v_va + uint64_t(h_kv) * uint64_t(pc.ext_v_nb2);
        [[dont_unroll]] for (uint k16 = 0u; k16 < PF_BC; k16 += 16u) {
            const uint vr0_raw = kv0 + k16 + 0u + cm_r;
            const uint vr1_raw = kv0 + k16 + 8u + cm_r;
            const uint64_t v_rva0 = v_head_va + uint64_t(min(vr0_raw, kv_last)) * uint64_t(pc.ext_v_nb1);
            const uint64_t v_rva1 = v_head_va + uint64_t(min(vr1_raw, kv_last)) * uint64_t(pc.ext_v_nb1);

#if KV_DTYPE_V == 2
            const uint vidx = (d_sg_base + cm_c) >> 1u;
            uint pv0 = BufU32(v_rva0).d[vidx + 0u];
            uint pv1 = BufU32(v_rva0).d[vidx + 4u];
            uint pv2 = BufU32(v_rva1).d[vidx + 0u];
            uint pv3 = BufU32(v_rva1).d[vidx + 4u];
            f16vec2 va0 = unpackFloat2x16(pv0);
            f16vec2 va1 = unpackFloat2x16(pv1);
            f16vec2 vb0 = unpackFloat2x16(pv2);
            f16vec2 vb1 = unpackFloat2x16(pv3);
#elif KV_DTYPE_V == 4
            const uint v_blk_off = (d_sg_base >> 5u) * 34u;
            const uint v_qidx    = ((d_sg_base & 31u) + cm_c) >> 1u;
            const uint64_t vb0a  = v_rva0 + uint64_t(v_blk_off);
            const uint64_t vb1a  = v_rva1 + uint64_t(v_blk_off);
            const float16_t sc0  = BufF16(vb0a).d[0];
            const float16_t sc1  = BufF16(vb1a).d[0];
            i8vec2 q0a = BufI8V2(vb0a + 2ul).d[v_qidx + 0u];
            i8vec2 q1a = BufI8V2(vb0a + 2ul).d[v_qidx + 4u];
            i8vec2 q0b = BufI8V2(vb1a + 2ul).d[v_qidx + 0u];
            i8vec2 q1b = BufI8V2(vb1a + 2ul).d[v_qidx + 4u];
            f16vec2 va0 = f16vec2(q0a) * sc0;
            f16vec2 va1 = f16vec2(q1a) * sc0;
            f16vec2 vb0 = f16vec2(q0b) * sc1;
            f16vec2 vb1 = f16vec2(q1b) * sc1;
#else
            const uint vidx = (d_sg_base + cm_c) >> 1u;
            uint16_t bv0 = BufU16(v_rva0).d[vidx + 0u];
            uint16_t bv1 = BufU16(v_rva0).d[vidx + 4u];
            uint16_t bv2 = BufU16(v_rva1).d[vidx + 0u];
            uint16_t bv3 = BufU16(v_rva1).d[vidx + 4u];
            f16vec2 va0 = pf_e4m3_pair_to_f16x2(bv0);
            f16vec2 va1 = pf_e4m3_pair_to_f16x2(bv1);
            f16vec2 vb0 = pf_e4m3_pair_to_f16x2(bv2);
            f16vec2 vb1 = pf_e4m3_pair_to_f16x2(bv3);
#endif
            if (vr0_raw >= pc.n_kv) { va0 = f16vec2(float16_t(0.0)); va1 = f16vec2(float16_t(0.0)); }
            if (vr1_raw >= pc.n_kv) { vb0 = f16vec2(float16_t(0.0)); vb1 = f16vec2(float16_t(0.0)); }

            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> Vm0, Vm1, Vm2, Vm3;
            Vm0[0] = va0.x; Vm0[1] = va0.y;
            Vm1[0] = va1.x; Vm1[1] = va1.y;
            Vm2[0] = vb0.x; Vm2[1] = vb0.y;
            Vm3[0] = vb1.x; Vm3[1] = vb1.y;

            const uint p_col0 = (k16 + cm_c) >> 1u;
            [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
                const uint p_row = (m * 8u + cm_r) * PF_PF_STR;
                f16vec2 p0 = unpackFloat2x16(sh_pf[p_row + p_col0 + 0u]);
                f16vec2 p1 = unpackFloat2x16(sh_pf[p_row + p_col0 + 4u]);
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> Pm0, Pm1;
                Pm0[0] = p0.x; Pm0[1] = p0.y;
                Pm1[0] = p1.x; Pm1[1] = p1.y;
                OfMat[m][0] = coopMatMulAdd(Pm0, Vm0, OfMat[m][0]);
                OfMat[m][1] = coopMatMulAdd(Pm0, Vm1, OfMat[m][1]);
                OfMat[m][0] = coopMatMulAdd(Pm1, Vm2, OfMat[m][0]);
                OfMat[m][1] = coopMatMulAdd(Pm1, Vm3, OfMat[m][1]);
            }
        }
    }

    // Epilogue: Sink + InvL Normalization + Optional FWHT64 + Optional QGate + Store
    [[dont_unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
        const uint rl    = sg * PF_SM_ROWS + r;
        const uint q_row = q0 + rl;
        float ms = 1.0f;
        float L  = Lf[r];
        float M  = Mf[r];
        if (q_row < pc.n_tokens) {
            bool  has_sink;
            float eff_sink;
            get_sink_info(q_row, h_q, has_sink, eff_sink);
            if (has_sink) {
                float vs = 1.0f;
                if (eff_sink > M) { ms = (M > -1.0e30f) ? exp(M - eff_sink) : 0.0f; }
                else              { vs = exp(eff_sink - M); }
                L = L * ms + vs;
            }
        }
        if (lane == 0u) {
            sh_eM[rl] = (L > 0.0f) ? (ms / L) : 0.0f;
        }
    }
    barrier();

    [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
        const float invL = sh_eM[m * 8u + cm_r];
        OfMat[m][0][0] *= invL; OfMat[m][0][1] *= invL;
        OfMat[m][1][0] *= invL; OfMat[m][1][1] *= invL;
    }

    const bool do_fwht  = (pc.flags & FLAG_FWHT64) != 0u;
    const bool do_qg32  = (pc.flags & FLAG_QGATE_F32) != 0u && (pc.q_gate_va != 0ul);
    const bool do_qg16  = (pc.flags & FLAG_QGATE_F16) != 0u && (pc.q_gate_va != 0ul);
    const bool out_f16  = (pc.flags & FLAG_OUT_F16) != 0u;

    if (!do_fwht) {
        [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
            const uint q_row = q0 + m * 8u + cm_r;
            if (q_row < pc.n_tokens) {
                const uint base_elem = (q_row * pc.n_head_q + h_q) * HEAD_DIM + d_sg_base + cm_c;
                vec2 v0 = vec2(OfMat[m][0][0], OfMat[m][0][1]);
                vec2 v1 = vec2(OfMat[m][1][0], OfMat[m][1][1]);
                if (do_qg32) {
                    v0 /= (vec2(1.0f) + exp(-vec2(BufF32(pc.q_gate_va).d[base_elem],      BufF32(pc.q_gate_va).d[base_elem + 1u])));
                    v1 /= (vec2(1.0f) + exp(-vec2(BufF32(pc.q_gate_va).d[base_elem + 8u], BufF32(pc.q_gate_va).d[base_elem + 9u])));
                } else if (do_qg16) {
                    vec2 g0 = vec2(unpackFloat2x16(BufU32(pc.q_gate_va).d[base_elem >> 1u]));
                    vec2 g1 = vec2(unpackFloat2x16(BufU32(pc.q_gate_va).d[(base_elem + 8u) >> 1u]));
                    v0 /= (vec2(1.0f) + exp(-g0));
                    v1 /= (vec2(1.0f) + exp(-g1));
                }
                if (out_f16) {
                    BufF16W(pc.out_va).d[base_elem + 0u] = float16_t(v0.x);
                    BufF16W(pc.out_va).d[base_elem + 1u] = float16_t(v0.y);
                    BufF16W(pc.out_va).d[base_elem + 8u] = float16_t(v1.x);
                    BufF16W(pc.out_va).d[base_elem + 9u] = float16_t(v1.y);
                } else {
                    BufF32W(pc.out_va).d[base_elem + 0u] = v0.x;
                    BufF32W(pc.out_va).d[base_elem + 1u] = v0.y;
                    BufF32W(pc.out_va).d[base_elem + 8u] = v1.x;
                    BufF32W(pc.out_va).d[base_elem + 9u] = v1.y;
                }
            }
        }
    } else {
        [[dont_unroll]] for (uint half_i = 0u; half_i < 2u; ++half_i) {
            barrier();
            if ((sg >> 2u) == half_i) {
                const uint col_off = (sg & 3u) * 16u + cm_c;
                [[unroll]] for (uint m = 0u; m < PF_Q_TILES; ++m) {
                    const uint row_off = (m * 8u + cm_r) * PF_SF_STR;
                    sh_sf[row_off + col_off + 0u] = OfMat[m][0][0];
                    sh_sf[row_off + col_off + 1u] = OfMat[m][0][1];
                    sh_sf[row_off + col_off + 8u] = OfMat[m][1][0];
                    sh_sf[row_off + col_off + 9u] = OfMat[m][1][1];
                }
            }
            barrier();
            [[dont_unroll]] for (uint r = 0u; r < PF_SM_ROWS; ++r) {
                const uint rl    = sg * PF_SM_ROWS + r;
                const uint q_row = q0 + rl;
                if (q_row < pc.n_tokens) {
                    float a = sh_sf[rl * PF_SF_STR + lane];
                    float b = sh_sf[rl * PF_SF_STR + lane + 32u];
                    float t0 = a + b; float t1 = a - b;
                    a = t0; b = t1;
                    [[unroll]] for (uint step = 1u; step < 32u; step <<= 1u) {
                        float sa = subgroupShuffleXor(a, step);
                        float sb = subgroupShuffleXor(b, step);
                        bool hi = (lane & step) != 0u;
                        a = hi ? (sa - a) : (a + sa);
                        b = hi ? (sb - b) : (b + sb);
                    }
                    a *= 0.125f; b *= 0.125f;
                    const uint base = (q_row * pc.n_head_q + h_q) * HEAD_DIM + half_i * 64u;
                    if (do_qg32) {
                        a /= (1.0f + exp(-BufF32(pc.q_gate_va).d[base + lane]));
                        b /= (1.0f + exp(-BufF32(pc.q_gate_va).d[base + lane + 32u]));
                    } else if (do_qg16) {
                        a /= (1.0f + exp(-float(BufF16(pc.q_gate_va).d[base + lane])));
                        b /= (1.0f + exp(-float(BufF16(pc.q_gate_va).d[base + lane + 32u])));
                    }
                    if (out_f16) {
                        BufF16W(pc.out_va).d[base + lane]       = float16_t(a);
                        BufF16W(pc.out_va).d[base + lane + 32u] = float16_t(b);
                    } else {
                        BufF32W(pc.out_va).d[base + lane]       = a;
                        BufF32W(pc.out_va).d[base + lane + 32u] = b;
                    }
                }
            }
        }
    }
}

#endif // PF_BR == 32 vs 16

#else // PASS_MODE == 4

// ============================================================================
// Phase 4 (Wave 10 GQA-Grouped Zero-K/V-SRAM 8-SG Split-K Coopmat Verify, D=128):
//   - grid = (n_head_kv, ceil(M / floor(16/gqa)), n_splits): packs ALL gqa Q-heads
//     (e.g. M=4..5 x gqa=3 -> 12..15 Q rows <= 16!) into ONE WG sharing 1x K & V
//     DRAM read -> EXACT 3.0x KV DRAM reduction at 16k/32k/250K!
//   - ZERO K/V SRAM staging, 8 SGs (256T), 10,504 B SRAM -> 3 WGs/core = 24 ActSGs/core
//     (3.0x higher occupancy than old 2-SG PASS_MODE=4's 8 ActSGs/core!)
//   - BK = 64 KV/tile -> ONLY 2 WG barriers per 64 KV tokens (8.0x fewer barriers!),
//     64-key aligned Split-K, double-buffered zero-extra-barrier empty-tile V skip,
//     native tile64_minmax banded rel-bias, feeds PASS_MODE=1 when n_splits > 1!
// ============================================================================
#define PF4_BR       16u
#define PF4_BC       64u
#define PF4_Q_TILES  2u
#define PF4_SM_ROWS  2u
#define PF4_SF_STR   65u  // 64+1 f32 = 260 B (0 bank conflicts!)
#define PF4_PF_STR   33u  // 32+1 u32 = 132 B (0 bank conflicts!)

shared float16_t sh4_q[HEAD_DIM * PF4_BR];    // 4,096 B (XOR-swizzled by (d & 4) << 1)
shared float     sh4_sf[PF4_BR * PF4_SF_STR]; // 4,160 B (FP32 scores + FWHT64 epilogue scratch)
shared uint      sh4_pf[PF4_BR * PF4_PF_STR]; // 2,112 B (packed FP16x2 probabilities)
shared float     sh4_eM[PF4_BR];              //    64 B (online rescale / final invL)
shared int       sh4_q_pos[PF4_BR];           //    64 B (query positions for banded rel-bias)
shared uint      sh4_tile_ok[2];              //     8 B (double-buffered zero-barrier V-skip)
// Total SRAM = 10,504 B <= 10,922 B -> 3 WGs/core = 24 ActSGs/core on AGX3B!

void main() {
    const uint h_kv  = gl_WorkGroupID.x;
    const uint gqa   = max(1u, pc.n_head_q / pc.n_head_kv);
    const uint m_wg  = max(1u, PF4_BR / gqa); // gqa=3 -> 5 tokens/WG (15 Q rows/WG!)
    const uint wg_t0 = gl_WorkGroupID.y * m_wg;
    const uint split = gl_WorkGroupID.z;

    if (h_kv >= pc.n_head_kv || wg_t0 >= pc.n_tokens || split >= pc.n_splits) {
        return;
    }

    const uint m_act  = min(m_wg, pc.n_tokens - wg_t0);
    const uint n_q_wg = m_act * gqa; // <= 16 active (tok, h_q) rows sharing h_kv!

    const uint sg   = gl_LocalInvocationID.y; // 0..7
    const uint lane = gl_LocalInvocationID.x; // 0..31
    const uint tid  = sg * 32u + lane;        // 0..255

    const uint cm_r = agx_cmat8_row(lane);    // 0..7
    const uint cm_c = agx_cmat8_col0(lane);   // 0, 2, 4, 6
    const uint q_sw = (cm_r & 4u) << 1u;      // 0 for cm_r 0..3, 8 for cm_r 4..7

    // 1. Load Q[wg_t0..+m_act, h_kv*gqa..+gqa, 0..127] * kq_scale -> XOR-swizzled sh4_q
    const bool q_is_f16 = (pc.flags & FLAG_Q_F16) != 0u;
    const float q_sc    = pc.kq_scale;
    for (uint idx = tid; idx < PF4_BR * 32u; idx += 256u) {
        const uint ql = idx >> 5u;
        const uint d4 = (idx & 31u) << 2u;
        f16vec4 qv = f16vec4(float16_t(0.0));
        if (ql < n_q_wg) {
            const uint q_tok = wg_t0 + (ql / gqa);
            const uint h_q   = h_kv * gqa + (ql % gqa);
            uint64_t qva = pc.q_va + uint64_t(q_tok) * uint64_t(pc.q_nb1) + uint64_t(h_q) * uint64_t(pc.q_nb2);
            vec4 qf;
            if (q_is_f16) {
                qf = vec4(BufF16V4(qva).d[d4 >> 2u]) * q_sc;
            } else if ((qva & 15ul) == 0ul) {
                qf = BufVec4R(qva).d[d4 >> 2u] * q_sc;
            } else {
                BufF32 qb = BufF32(qva);
                qf = vec4(qb.d[d4 + 0u], qb.d[d4 + 1u], qb.d[d4 + 2u], qb.d[d4 + 3u]) * q_sc;
            }
            qv = f16vec4(clamp(qf, vec4(-65504.0f), vec4(65504.0f)));
        }
        const uint ql_sw = ql ^ ((d4 & 4u) << 1u);
        sh4_q[(d4 + 0u) * PF4_BR + ql_sw] = qv.x;
        sh4_q[(d4 + 1u) * PF4_BR + ql_sw] = qv.y;
        sh4_q[(d4 + 2u) * PF4_BR + ql_sw] = qv.z;
        sh4_q[(d4 + 3u) * PF4_BR + ql_sw] = qv.w;
    }

    const bool has_banded = (pc.flags & FLAG_BANDED_REL_BIAS) != 0u &&
                            (pc.rel_table_va != 0ul) && (pc.rel_pos_pack_va != 0ul);
    if (has_banded && tid < PF4_BR) {
        sh4_q_pos[tid] = (tid < n_q_wg)
            ? BufI32(pc.rel_pos_pack_va).d[pc.rel_qp_off + wg_t0 + (tid / gqa)]
            : -1073741824;
    }
    if (tid < 2u) {
        sh4_tile_ok[tid] = 0u;
    }
    barrier();

    int q_pmin = 1073741824;
    int q_pmax = -1073741824;
    if (has_banded) {
        for (uint r = 0u; r < n_q_wg; ++r) {
            int p = sh4_q_pos[r];
            q_pmin = min(q_pmin, p);
            q_pmax = max(q_pmax, p);
        }
    }

    // 64-key aligned split boundaries -> every 64-KV tile matches exact tile64_minmax[kv0 >> 6]!
    const uint n_blk64 = (pc.n_kv + 63u) >> 6u;
    const uint b_start = (pc.n_splits == 1u) ? 0u : uint((uint64_t(split)      * uint64_t(n_blk64)) / uint64_t(pc.n_splits));
    const uint b_end   = (pc.n_splits == 1u) ? n_blk64 : uint((uint64_t(split + 1u) * uint64_t(n_blk64)) / uint64_t(pc.n_splits));
    const uint k_start = min(b_start << 6u, pc.n_kv);
    const uint k_end   = min(b_end   << 6u, pc.n_kv);

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> OfMat[PF4_Q_TILES][2];
    [[unroll]] for (uint m = 0u; m < PF4_Q_TILES; ++m) {
        OfMat[m][0] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        OfMat[m][1] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    }

    float Mf[PF4_SM_ROWS];
    float Lf[PF4_SM_ROWS];
    [[unroll]] for (uint r = 0u; r < PF4_SM_ROWS; ++r) {
        Mf[r] = -3.402823466e+38f;
        Lf[r] = 0.0f;
    }

    const bool has_mask_f16 = (pc.flags & FLAG_HAS_MASK_F16) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask_f32 = (pc.flags & FLAG_HAS_MASK_F32) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask     = has_mask_f16 || has_mask_f32;
    const bool has_softcap  = (pc.flags & FLAG_SOFTCAP) != 0u && (pc.logit_softcap != 0.0f);
    const uint kv_last      = (pc.n_kv > 0u) ? (pc.n_kv - 1u) : 0u;
    const uint d_sg_base    = sg * 16u;
    const uint q_c0         = (0u + cm_c) ^ q_sw;
    const uint q_c1         = (8u + cm_c) ^ q_sw;

    for (uint kv0 = k_start; kv0 < k_end; kv0 += PF4_BC) {
        const uint ping = ((kv0 - k_start) >> 6u) & 1u;

        // Phase 1: S^T = K * Q^T (Zero K SRAM! 1x K load shared across all gqa * m_act Q rows!)
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> SfMat0 =
            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> SfMat1 =
            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);

        const uint k_row = min(kv0 + sg * 8u + cm_r, kv_last);
        const uint64_t k_rva = pc.k_or_pt_va
            + uint64_t(h_kv) * uint64_t(pc.ext_k_nb2)
            + uint64_t(k_row) * uint64_t(pc.ext_k_nb1);

        [[dont_unroll]] for (uint blk = 0u; blk < HEAD_DIM / 32u; ++blk) {
            const uint d32 = blk * 32u;
#if KV_DTYPE_K == 2
            const uint cidx = (d32 + cm_c) >> 1u;
            uint pk0 = BufU32(k_rva).d[cidx +  0u];
            uint pk1 = BufU32(k_rva).d[cidx +  4u];
            uint pk2 = BufU32(k_rva).d[cidx +  8u];
            uint pk3 = BufU32(k_rva).d[cidx + 12u];
            f16vec2 k0 = unpackFloat2x16(pk0);
            f16vec2 k1 = unpackFloat2x16(pk1);
            f16vec2 k2 = unpackFloat2x16(pk2);
            f16vec2 k3 = unpackFloat2x16(pk3);
#elif KV_DTYPE_K == 4
            const uint64_t bva = k_rva + uint64_t(blk) * 34ul;
            const float16_t sc = BufF16(bva).d[0];
            const uint qidx = cm_c >> 1u;
            i8vec2 q0v = BufI8V2(bva + 2ul).d[qidx +  0u];
            i8vec2 q1v = BufI8V2(bva + 2ul).d[qidx +  4u];
            i8vec2 q2v = BufI8V2(bva + 2ul).d[qidx +  8u];
            i8vec2 q3v = BufI8V2(bva + 2ul).d[qidx + 12u];
            f16vec2 k0 = f16vec2(q0v) * sc;
            f16vec2 k1 = f16vec2(q1v) * sc;
            f16vec2 k2 = f16vec2(q2v) * sc;
            f16vec2 k3 = f16vec2(q3v) * sc;
#else
            const uint cidx = (d32 + cm_c) >> 1u;
            uint16_t b0 = BufU16(k_rva).d[cidx +  0u];
            uint16_t b1 = BufU16(k_rva).d[cidx +  4u];
            uint16_t b2 = BufU16(k_rva).d[cidx +  8u];
            uint16_t b3 = BufU16(k_rva).d[cidx + 12u];
            f16vec2 k0 = pf_e4m3_pair_to_f16x2(b0);
            f16vec2 k1 = pf_e4m3_pair_to_f16x2(b1);
            f16vec2 k2 = pf_e4m3_pair_to_f16x2(b2);
            f16vec2 k3 = pf_e4m3_pair_to_f16x2(b3);
#endif
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> Km0, Km1, Km2, Km3;
            Km0[0] = k0.x; Km0[1] = k0.y;
            Km1[0] = k1.x; Km1[1] = k1.y;
            Km2[0] = k2.x; Km2[1] = k2.y;
            Km3[0] = k3.x; Km3[1] = k3.y;

            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> Qm0, Qm1;
            const uint qr0 = (d32 +  0u + cm_r) * PF4_BR;
            Qm0[0] = sh4_q[qr0 + q_c0]; Qm0[1] = sh4_q[qr0 + q_c0 + 1u];
            Qm1[0] = sh4_q[qr0 + q_c1]; Qm1[1] = sh4_q[qr0 + q_c1 + 1u];
            SfMat0 = coopMatMulAdd(Km0, Qm0, SfMat0);
            SfMat1 = coopMatMulAdd(Km0, Qm1, SfMat1);

            const uint qr1 = (d32 +  8u + cm_r) * PF4_BR;
            Qm0[0] = sh4_q[qr1 + q_c0]; Qm0[1] = sh4_q[qr1 + q_c0 + 1u];
            Qm1[0] = sh4_q[qr1 + q_c1]; Qm1[1] = sh4_q[qr1 + q_c1 + 1u];
            SfMat0 = coopMatMulAdd(Km1, Qm0, SfMat0);
            SfMat1 = coopMatMulAdd(Km1, Qm1, SfMat1);

            const uint qr2 = (d32 + 16u + cm_r) * PF4_BR;
            Qm0[0] = sh4_q[qr2 + q_c0]; Qm0[1] = sh4_q[qr2 + q_c0 + 1u];
            Qm1[0] = sh4_q[qr2 + q_c1]; Qm1[1] = sh4_q[qr2 + q_c1 + 1u];
            SfMat0 = coopMatMulAdd(Km2, Qm0, SfMat0);
            SfMat1 = coopMatMulAdd(Km2, Qm1, SfMat1);

            const uint qr3 = (d32 + 24u + cm_r) * PF4_BR;
            Qm0[0] = sh4_q[qr3 + q_c0]; Qm0[1] = sh4_q[qr3 + q_c0 + 1u];
            Qm1[0] = sh4_q[qr3 + q_c1]; Qm1[1] = sh4_q[qr3 + q_c1 + 1u];
            SfMat0 = coopMatMulAdd(Km3, Qm0, SfMat0);
            SfMat1 = coopMatMulAdd(Km3, Qm1, SfMat1);
        }

        const uint kv_loc = sg * 8u + cm_r;
        sh4_sf[(0u + cm_c + 0u) * PF4_SF_STR + kv_loc] = SfMat0[0];
        sh4_sf[(0u + cm_c + 1u) * PF4_SF_STR + kv_loc] = SfMat0[1];
        sh4_sf[(8u + cm_c + 0u) * PF4_SF_STR + kv_loc] = SfMat1[0];
        sh4_sf[(8u + cm_c + 1u) * PF4_SF_STR + kv_loc] = SfMat1[1];
        if (tid == 0u) {
            sh4_tile_ok[ping ^ 1u] = 0u;
        }

        barrier(); // Barrier #1: sh4_sf ready & prior iter's sh4_pf reads complete!

        // Phase 2: Fused Softcap + Mask + Banded Rel-Bias + Online Softmax -> sh4_pf & sh4_eM
        bool tile_has_rel = false;
        int kp0 = -1073741824;
        int kp1 = -1073741824;
        if (has_banded) {
            const uint b64 = kv0 >> 6u;
            const int tmin = BufI32(pc.rel_pos_pack_va).d[pc.rel_tm_off + b64 * 2u + 0u];
            const int tmax = BufI32(pc.rel_pos_pack_va).d[pc.rel_tm_off + b64 * 2u + 1u];
            tile_has_rel = (q_pmax >= tmin) && (q_pmin < tmax + int(pc.n_rel_extent));
            if (tile_has_rel) {
                if (kv0 + lane < pc.n_kv)       kp0 = BufI32(pc.rel_pos_pack_va).d[pc.rel_cp_off + kv0 + lane];
                if (kv0 + lane + 32u < pc.n_kv) kp1 = BufI32(pc.rel_pos_pack_va).d[pc.rel_cp_off + kv0 + lane + 32u];
            }
        }

        const uint c0  = kv0 + lane;
        const uint c1  = kv0 + lane + 32u;
        const bool ok0 = c0 < k_end;
        const bool ok1 = c1 < k_end;
        bool sg_any_ok = false;

        [[dont_unroll]] for (uint r = 0u; r < PF4_SM_ROWS; ++r) {
            const uint rl = sg * PF4_SM_ROWS + r;
            float s0 = ok0 ? sh4_sf[rl * PF4_SF_STR + lane]       : -3.402823466e+38f;
            float s1 = ok1 ? sh4_sf[rl * PF4_SF_STR + lane + 32u] : -3.402823466e+38f;

            if (has_softcap) {
                if (ok0) s0 = pc.logit_softcap * tanh(s0);
                if (ok1) s1 = pc.logit_softcap * tanh(s1);
            }

            if (rl < n_q_wg) {
                const uint q_tok = wg_t0 + (rl / gqa);
                const uint h_q   = h_kv * gqa + (rl % gqa);
                if (has_mask) {
                    const float slope_v = compute_alibi_slope(h_q);
                    const uint  mask_h  = (pc.ext_mask_ne2 > 1u) ? (h_q % pc.ext_mask_ne2) : 0u;
                    const uint64_t mva  = pc.kq_mask_va
                        + uint64_t(mask_h) * uint64_t(pc.ext_mask_nb2)
                        + uint64_t(q_tok)  * uint64_t(pc.ext_mask_nb1);
                    if (ok0) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c0]) : BufF32(mva).d[c0];
                        s0 += slope_v * mv;
                    }
                    if (ok1) {
                        float mv = has_mask_f16 ? float(BufF16(mva).d[c1]) : BufF32(mva).d[c1];
                        s1 += slope_v * mv;
                    }
                }
                if (tile_has_rel) {
                    const int qp = sh4_q_pos[rl];
                    const uint64_t rt_base = pc.rel_table_va
                        + uint64_t(q_tok * pc.n_head_q + h_q) * uint64_t(pc.rel_table_len) * 4ul;
                    const int d0 = qp - kp0;
                    const int d1 = qp - kp1;
                    if (ok0 && d0 >= 0 && uint(d0) < pc.n_rel_extent && uint(d0) < pc.rel_table_len) {
                        s0 += BufF32(rt_base).d[uint(d0)];
                    }
                    if (ok1 && d1 >= 0 && uint(d1) < pc.n_rel_extent && uint(d1) < pc.rel_table_len) {
                        s1 += BufF32(rt_base).d[uint(d1)];
                    }
                }
            } else {
                s0 = -3.402823466e+38f;
                s1 = -3.402823466e+38f;
            }

            const float rmax  = subgroupMax(max(s0, s1));
            if (rmax > -1.0e30f) {
                sg_any_ok = true;
            }
            const float m_old = Mf[r];
            const float m_new = max(m_old, rmax);
            const float eM    = (m_old > -1.0e30f) ? exp(m_old - m_new) : 0.0f;
            const float p0    = (ok0 && s0 > -1.0e30f) ? exp(s0 - m_new) : 0.0f;
            const float p1    = (ok1 && s1 > -1.0e30f) ? exp(s1 - m_new) : 0.0f;

            Mf[r] = m_new;
            Lf[r] = Lf[r] * eM + subgroupAdd(p0 + p1);
            if (lane == 0u) {
                sh4_eM[rl] = eM;
            }
            const float p0_nb = subgroupShuffleXor(p0, 1u);
            const float p1_nb = subgroupShuffleXor(p1, 1u);
            if ((lane & 1u) == 0u) {
                sh4_pf[rl * PF4_PF_STR + (lane >> 1u)]       = packFloat2x16(f16vec2(float16_t(p0), float16_t(p0_nb)));
                sh4_pf[rl * PF4_PF_STR + 16u + (lane >> 1u)] = packFloat2x16(f16vec2(float16_t(p1), float16_t(p1_nb)));
            }
        }
        if (sg_any_ok && lane == 0u) {
            sh4_tile_ok[ping] = 1u;
        }

        barrier(); // Barrier #2: sh4_pf, sh4_eM, sh4_tile_ok ready & sh4_sf reads complete!
        if (sh4_tile_ok[ping] == 0u) {
            continue; // Zero-barrier skip of V DRAM loads & P*V MMAs on all-masked 64-KV tiles!
        }

        // Phase 3: Rescale OfMat + P * V (Zero V SRAM! 1x V load shared across all gqa * m_act Q rows!)
        [[unroll]] for (uint m = 0u; m < PF4_Q_TILES; ++m) {
            const float eM = sh4_eM[m * 8u + cm_r];
            OfMat[m][0][0] *= eM; OfMat[m][0][1] *= eM;
            OfMat[m][1][0] *= eM; OfMat[m][1][1] *= eM;
        }

        const uint64_t v_head_va = pc.v_va + uint64_t(h_kv) * uint64_t(pc.ext_v_nb2);
        [[dont_unroll]] for (uint k16 = 0u; k16 < PF4_BC; k16 += 16u) {
            const uint vr0_raw = kv0 + k16 + 0u + cm_r;
            const uint vr1_raw = kv0 + k16 + 8u + cm_r;
            const uint64_t v_rva0 = v_head_va + uint64_t(min(vr0_raw, kv_last)) * uint64_t(pc.ext_v_nb1);
            const uint64_t v_rva1 = v_head_va + uint64_t(min(vr1_raw, kv_last)) * uint64_t(pc.ext_v_nb1);

#if KV_DTYPE_V == 2
            const uint vidx = (d_sg_base + cm_c) >> 1u;
            uint pv0 = BufU32(v_rva0).d[vidx + 0u];
            uint pv1 = BufU32(v_rva0).d[vidx + 4u];
            uint pv2 = BufU32(v_rva1).d[vidx + 0u];
            uint pv3 = BufU32(v_rva1).d[vidx + 4u];
            f16vec2 va0 = unpackFloat2x16(pv0);
            f16vec2 va1 = unpackFloat2x16(pv1);
            f16vec2 vb0 = unpackFloat2x16(pv2);
            f16vec2 vb1 = unpackFloat2x16(pv3);
#elif KV_DTYPE_V == 4
            const uint v_blk_off = (d_sg_base >> 5u) * 34u;
            const uint v_qidx    = ((d_sg_base & 31u) + cm_c) >> 1u;
            const uint64_t vb0a  = v_rva0 + uint64_t(v_blk_off);
            const uint64_t vb1a  = v_rva1 + uint64_t(v_blk_off);
            const float16_t sc0  = BufF16(vb0a).d[0];
            const float16_t sc1  = BufF16(vb1a).d[0];
            i8vec2 q0a = BufI8V2(vb0a + 2ul).d[v_qidx + 0u];
            i8vec2 q1a = BufI8V2(vb0a + 2ul).d[v_qidx + 4u];
            i8vec2 q0b = BufI8V2(vb1a + 2ul).d[v_qidx + 0u];
            i8vec2 q1b = BufI8V2(vb1a + 2ul).d[v_qidx + 4u];
            f16vec2 va0 = f16vec2(q0a) * sc0;
            f16vec2 va1 = f16vec2(q1a) * sc0;
            f16vec2 vb0 = f16vec2(q0b) * sc1;
            f16vec2 vb1 = f16vec2(q1b) * sc1;
#else
            const uint vidx = (d_sg_base + cm_c) >> 1u;
            uint16_t bv0 = BufU16(v_rva0).d[vidx + 0u];
            uint16_t bv1 = BufU16(v_rva0).d[vidx + 4u];
            uint16_t bv2 = BufU16(v_rva1).d[vidx + 0u];
            uint16_t bv3 = BufU16(v_rva1).d[vidx + 4u];
            f16vec2 va0 = pf_e4m3_pair_to_f16x2(bv0);
            f16vec2 va1 = pf_e4m3_pair_to_f16x2(bv1);
            f16vec2 vb0 = pf_e4m3_pair_to_f16x2(bv2);
            f16vec2 vb1 = pf_e4m3_pair_to_f16x2(bv3);
#endif
            if (vr0_raw >= k_end) { va0 = f16vec2(float16_t(0.0)); va1 = f16vec2(float16_t(0.0)); }
            if (vr1_raw >= k_end) { vb0 = f16vec2(float16_t(0.0)); vb1 = f16vec2(float16_t(0.0)); }

            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> Vm0, Vm1, Vm2, Vm3;
            Vm0[0] = va0.x; Vm0[1] = va0.y;
            Vm1[0] = va1.x; Vm1[1] = va1.y;
            Vm2[0] = vb0.x; Vm2[1] = vb0.y;
            Vm3[0] = vb1.x; Vm3[1] = vb1.y;

            const uint p_col0 = (k16 + cm_c) >> 1u;
            [[unroll]] for (uint m = 0u; m < PF4_Q_TILES; ++m) {
                const uint p_row = (m * 8u + cm_r) * PF4_PF_STR;
                f16vec2 p0 = unpackFloat2x16(sh4_pf[p_row + p_col0 + 0u]);
                f16vec2 p1 = unpackFloat2x16(sh4_pf[p_row + p_col0 + 4u]);
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> Pm0, Pm1;
                Pm0[0] = p0.x; Pm0[1] = p0.y;
                Pm1[0] = p1.x; Pm1[1] = p1.y;
                OfMat[m][0] = coopMatMulAdd(Pm0, Vm0, OfMat[m][0]);
                OfMat[m][1] = coopMatMulAdd(Pm0, Vm1, OfMat[m][1]);
                OfMat[m][0] = coopMatMulAdd(Pm1, Vm2, OfMat[m][0]);
                OfMat[m][1] = coopMatMulAdd(Pm1, Vm3, OfMat[m][1]);
            }
        }
    }

    if (pc.n_splits > 1u) {
        // Direct zero-barrier partial store feeding PASS_MODE=1 Phase 2 reduce!
        BufF32W pb = BufF32W(pc.partial_va);
        [[unroll]] for (uint m = 0u; m < PF4_Q_TILES; ++m) {
            const uint rl = m * 8u + cm_r;
            if (rl < n_q_wg) {
                const uint q_tok = wg_t0 + (rl / gqa);
                const uint h_q   = h_kv * gqa + (rl % gqa);
                const uint base  = ((q_tok * pc.n_head_q + h_q) * pc.n_splits + split) * PARTIAL_STRIDE;
                const uint d0    = d_sg_base + cm_c;
                pb.d[base + d0 + 0u] = OfMat[m][0][0];
                pb.d[base + d0 + 1u] = OfMat[m][0][1];
                pb.d[base + d0 + 8u] = OfMat[m][1][0];
                pb.d[base + d0 + 9u] = OfMat[m][1][1];
            }
        }
        if (lane == 0u) {
            [[unroll]] for (uint r = 0u; r < PF4_SM_ROWS; ++r) {
                const uint rl = sg * PF4_SM_ROWS + r;
                if (rl < n_q_wg) {
                    const uint q_tok = wg_t0 + (rl / gqa);
                    const uint h_q   = h_kv * gqa + (rl % gqa);
                    const uint base  = ((q_tok * pc.n_head_q + h_q) * pc.n_splits + split) * PARTIAL_STRIDE;
                    pb.d[base + 128u] = Mf[r];
                    pb.d[base + 129u] = Lf[r];
                }
            }
        }
        return;
    }

    // Single-split epilogue: Sink + InvL + Optional FWHT64 + Optional QGate + Store
    [[dont_unroll]] for (uint r = 0u; r < PF4_SM_ROWS; ++r) {
        const uint rl = sg * PF4_SM_ROWS + r;
        float ms = 1.0f;
        float L  = Lf[r];
        float M  = Mf[r];
        if (rl < n_q_wg) {
            const uint q_tok = wg_t0 + (rl / gqa);
            const uint h_q   = h_kv * gqa + (rl % gqa);
            bool  has_sink;
            float eff_sink;
            get_sink_info(q_tok, h_q, has_sink, eff_sink);
            if (has_sink) {
                float vs = 1.0f;
                if (eff_sink > M) { ms = (M > -1.0e30f) ? exp(M - eff_sink) : 0.0f; }
                else              { vs = exp(eff_sink - M); }
                L = L * ms + vs;
            }
        }
        if (lane == 0u) {
            sh4_eM[rl] = (L > 0.0f) ? (ms / L) : 0.0f;
        }
    }
    barrier();

    [[unroll]] for (uint m = 0u; m < PF4_Q_TILES; ++m) {
        const float invL = sh4_eM[m * 8u + cm_r];
        OfMat[m][0][0] *= invL; OfMat[m][0][1] *= invL;
        OfMat[m][1][0] *= invL; OfMat[m][1][1] *= invL;
    }

    const bool do_fwht = (pc.flags & FLAG_FWHT64) != 0u;
    const bool do_qg32 = (pc.flags & FLAG_QGATE_F32) != 0u && (pc.q_gate_va != 0ul);
    const bool do_qg16 = (pc.flags & FLAG_QGATE_F16) != 0u && (pc.q_gate_va != 0ul);
    const bool out_f16 = (pc.flags & FLAG_OUT_F16) != 0u;

    if (!do_fwht) {
        [[unroll]] for (uint m = 0u; m < PF4_Q_TILES; ++m) {
            const uint rl = m * 8u + cm_r;
            if (rl < n_q_wg) {
                const uint q_tok = wg_t0 + (rl / gqa);
                const uint h_q   = h_kv * gqa + (rl % gqa);
                const uint base_elem = (q_tok * pc.n_head_q + h_q) * HEAD_DIM + d_sg_base + cm_c;
                vec2 v0 = vec2(OfMat[m][0][0], OfMat[m][0][1]);
                vec2 v1 = vec2(OfMat[m][1][0], OfMat[m][1][1]);
                if (do_qg32) {
                    v0 /= (vec2(1.0f) + exp(-vec2(BufF32(pc.q_gate_va).d[base_elem],      BufF32(pc.q_gate_va).d[base_elem + 1u])));
                    v1 /= (vec2(1.0f) + exp(-vec2(BufF32(pc.q_gate_va).d[base_elem + 8u], BufF32(pc.q_gate_va).d[base_elem + 9u])));
                } else if (do_qg16) {
                    vec2 g0 = vec2(unpackFloat2x16(BufU32(pc.q_gate_va).d[base_elem >> 1u]));
                    vec2 g1 = vec2(unpackFloat2x16(BufU32(pc.q_gate_va).d[(base_elem + 8u) >> 1u]));
                    v0 /= (vec2(1.0f) + exp(-g0));
                    v1 /= (vec2(1.0f) + exp(-g1));
                }
                if (out_f16) {
                    BufF16W(pc.out_va).d[base_elem + 0u] = float16_t(v0.x);
                    BufF16W(pc.out_va).d[base_elem + 1u] = float16_t(v0.y);
                    BufF16W(pc.out_va).d[base_elem + 8u] = float16_t(v1.x);
                    BufF16W(pc.out_va).d[base_elem + 9u] = float16_t(v1.y);
                } else {
                    BufF32W(pc.out_va).d[base_elem + 0u] = v0.x;
                    BufF32W(pc.out_va).d[base_elem + 1u] = v0.y;
                    BufF32W(pc.out_va).d[base_elem + 8u] = v1.x;
                    BufF32W(pc.out_va).d[base_elem + 9u] = v1.y;
                }
            }
        }
    } else {
        [[dont_unroll]] for (uint half_i = 0u; half_i < 2u; ++half_i) {
            barrier();
            if ((sg >> 2u) == half_i) {
                const uint col_off = (sg & 3u) * 16u + cm_c;
                [[unroll]] for (uint m = 0u; m < PF4_Q_TILES; ++m) {
                    const uint row_off = (m * 8u + cm_r) * PF4_SF_STR;
                    sh4_sf[row_off + col_off + 0u] = OfMat[m][0][0];
                    sh4_sf[row_off + col_off + 1u] = OfMat[m][0][1];
                    sh4_sf[row_off + col_off + 8u] = OfMat[m][1][0];
                    sh4_sf[row_off + col_off + 9u] = OfMat[m][1][1];
                }
            }
            barrier();
            [[dont_unroll]] for (uint r = 0u; r < PF4_SM_ROWS; ++r) {
                const uint rl = sg * PF4_SM_ROWS + r;
                if (rl < n_q_wg) {
                    const uint q_tok = wg_t0 + (rl / gqa);
                    const uint h_q   = h_kv * gqa + (rl % gqa);
                    float a = sh4_sf[rl * PF4_SF_STR + lane];
                    float b = sh4_sf[rl * PF4_SF_STR + lane + 32u];
                    float t0 = a + b; float t1 = a - b;
                    a = t0; b = t1;
                    [[unroll]] for (uint step = 1u; step < 32u; step <<= 1u) {
                        float sa = subgroupShuffleXor(a, step);
                        float sb = subgroupShuffleXor(b, step);
                        bool hi = (lane & step) != 0u;
                        a = hi ? (sa - a) : (a + sa);
                        b = hi ? (sb - b) : (b + sb);
                    }
                    a *= 0.125f; b *= 0.125f;
                    const uint base = (q_tok * pc.n_head_q + h_q) * HEAD_DIM + half_i * 64u;
                    if (do_qg32) {
                        a /= (1.0f + exp(-BufF32(pc.q_gate_va).d[base + lane]));
                        b /= (1.0f + exp(-BufF32(pc.q_gate_va).d[base + lane + 32u]));
                    } else if (do_qg16) {
                        a /= (1.0f + exp(-float(BufF16(pc.q_gate_va).d[base + lane])));
                        b /= (1.0f + exp(-float(BufF16(pc.q_gate_va).d[base + lane + 32u])));
                    }
                    if (out_f16) {
                        BufF16W(pc.out_va).d[base + lane]       = float16_t(a);
                        BufF16W(pc.out_va).d[base + lane + 32u] = float16_t(b);
                    } else {
                        BufF32W(pc.out_va).d[base + lane]       = a;
                        BufF32W(pc.out_va).d[base + lane + 32u] = b;
                    }
                }
            }
        }
    }
}
#endif // PASS_MODE == 3 vs 4
#endif // PASS_MODE == 0 vs 3/4

#elif PASS_MODE == 1

// Phase 2: Split-K Reduction (1 simdgroup per (h_q, tok_global))
void main() {
    const uint lane       = gl_LocalInvocationID.x;
    const uint h_q        = gl_WorkGroupID.x;
    const uint tok_global = gl_WorkGroupID.y;
    const uint n_batches  = max(1u, pc.n_batches);

    if (h_q >= pc.n_head_q || tok_global >= pc.n_tokens * n_batches) {
        return;
    }

    const uint batch = (n_batches > 1u) ? (tok_global / pc.n_tokens) : 0u;
    const uint tok   = (n_batches > 1u) ? (tok_global - batch * pc.n_tokens) : tok_global;

    bool  has_sink;
    float eff_sink;
    get_sink_info(tok_global, h_q, has_sink, eff_sink);

    BufF32 pb = BufF32(pc.partial_va);
    const uint head_base = (tok_global * pc.n_head_q + h_q) * pc.n_splits * PARTIAL_STRIDE;

    float m_tot = has_sink ? eff_sink : (-3.402823466e+38f * 0.5f);
    for (uint s = 0u; s < pc.n_splits; ++s) {
        uint off = head_base + s * PARTIAL_STRIDE;
        float ls = pb.d[off + uint(HEAD_DIM) + 1u];
        if (ls > 0.0f) {
            m_tot = max(m_tot, pb.d[off + uint(HEAD_DIM) + 0u]);
        }
    }

    float l_tot = has_sink ? exp(eff_sink - m_tot) : 0.0f;
    VEC_T o_tot = VEC_T(0.0f);
    for (uint s = 0u; s < pc.n_splits; ++s) {
        uint off = head_base + s * PARTIAL_STRIDE;
        float ls = pb.d[off + uint(HEAD_DIM) + 1u];
        if (ls > 0.0f) {
            float ms = pb.d[off + uint(HEAD_DIM) + 0u];
            float w  = exp(ms - m_tot);
            l_tot += ls * w;
            uint d_off = off + lane * ELEMS_PER_LANE;
#if HEAD_DIM == 64
            o_tot += vec2(pb.d[d_off + 0u], pb.d[d_off + 1u]) * w;
#else
            o_tot += vec4(pb.d[d_off + 0u], pb.d[d_off + 1u],
                          pb.d[d_off + 2u], pb.d[d_off + 3u]) * w;
#endif
        }
    }

    VEC_T out_v = (l_tot > 0.0f) ? (o_tot / l_tot) : VEC_T(0.0f);
    apply_epilogue_and_store(out_v, batch, tok, h_q, lane);
}

#elif PASS_MODE == 2

// ============================================================================
// Fused KV Append Kernel (1 simdgroup per (h_kv, tok), D=128)
// ============================================================================
layout(push_constant) uniform PushAppend {
    uint64_t k_src_va;
    uint64_t v_src_va;
    uint64_t dst_k_or_pt_va;
    uint64_t dst_v_va;
    uint64_t dst_ks_va;
    uint64_t dst_vs_va;
    uint64_t pos_dst_va;
    uint64_t pos_src_va;
    uint     n_tokens;
    uint     n_head_kv;
    uint     kv_write_base;
    uint     ring_mask;
    uint     page_v_off_B;
    uint     page_ks_off_B;
    uint     page_vs_off_B;
    uint     flags;
} pa;

void store_quant_vec4(vec4 val, uint64_t data_va, uint64_t scale_va, uint head_idx, uint lane) {
#if KV_DTYPE == 0
    uint b0 = encode_e4m3_byte(val.x);
    uint b1 = encode_e4m3_byte(val.y);
    uint b2 = encode_e4m3_byte(val.z);
    uint b3 = encode_e4m3_byte(val.w);
    BufU32W(data_va).d[head_idx * 32u + lane] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
#elif KV_DTYPE == 1
    float amax = max(max(abs(val.x), abs(val.y)), max(abs(val.z), abs(val.w)));
    amax = max(amax, subgroupShuffleXor(amax, 1u));
    amax = max(amax, subgroupShuffleXor(amax, 2u));
    amax = max(amax, subgroupShuffleXor(amax, 4u));
    float d     = amax / 127.0f;
    float id    = (d != 0.0f) ? (1.0f / d) : 0.0f;
    int q0 = int(clamp(roundEven(val.x * id), -127.0f, 127.0f));
    int q1 = int(clamp(roundEven(val.y * id), -127.0f, 127.0f));
    int q2 = int(clamp(roundEven(val.z * id), -127.0f, 127.0f));
    int q3 = int(clamp(roundEven(val.w * id), -127.0f, 127.0f));
    uint packed = (uint(q0) & 0xFFu)
                | ((uint(q1) & 0xFFu) << 8)
                | ((uint(q2) & 0xFFu) << 16)
                | ((uint(q3) & 0xFFu) << 24);
    BufU32W(data_va).d[head_idx * 32u + lane] = packed;
    if ((lane & 7u) == 0u) {
        BufF16W(scale_va).d[head_idx * 4u + (lane >> 3)] = float16_t(d);
    }
#else
    uvec2 p = uvec2(packFloat2x16(f16vec2(val.xy)), packFloat2x16(f16vec2(val.zw)));
    BufUvec2W(data_va).d[head_idx * 32u + lane] = p;
#endif
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint h_kv = gl_WorkGroupID.x;
    const uint tok  = gl_WorkGroupID.y;

    if (h_kv >= pa.n_head_kv || tok >= pa.n_tokens) {
        return;
    }

    const uint src_head = tok * pa.n_head_kv + h_kv;
    const bool is_paged = (pa.flags & 1u) != 0u;
    const bool is_f16   = (pa.flags & 2u) != 0u;

    vec4 kv_k;
    vec4 kv_v;
    if (is_f16) {
        uvec2 pk = BufUvec2(pa.k_src_va).d[src_head * 32u + lane];
        uvec2 pv = BufUvec2(pa.v_src_va).d[src_head * 32u + lane];
        kv_k = vec4(unpackHalf2x16(pk.x), unpackHalf2x16(pk.y));
        kv_v = vec4(unpackHalf2x16(pv.x), unpackHalf2x16(pv.y));
    } else {
        BufF32 kf = BufF32(pa.k_src_va);
        BufF32 vf = BufF32(pa.v_src_va);
        uint o = src_head * 128u + lane * 4u;
        kv_k = vec4(kf.d[o + 0u], kf.d[o + 1u], kf.d[o + 2u], kf.d[o + 3u]);
        kv_v = vec4(vf.d[o + 0u], vf.d[o + 1u], vf.d[o + 2u], vf.d[o + 3u]);
    }

    const int pos = (pa.pos_src_va != 0ul)
        ? BufI32(pa.pos_src_va).d[tok]
        : int(pa.kv_write_base + tok);

    if (is_paged) {
        const uint kv_idx  = pa.kv_write_base + tok;
        const uint64_t pg  = BufU64(pa.dst_k_or_pt_va).d[kv_idx >> 6];
        const uint in_page = kv_idx & 63u;
        const uint dst_hd  = in_page * pa.n_head_kv + h_kv;
        store_quant_vec4(kv_k, pg,                           pg + uint64_t(pa.page_ks_off_B), dst_hd, lane);
        store_quant_vec4(kv_v, pg + uint64_t(pa.page_v_off_B), pg + uint64_t(pa.page_vs_off_B), dst_hd, lane);
        if (h_kv == 0u && lane == 0u && pa.pos_dst_va != 0ul) {
            BufI32W(pa.pos_dst_va).d[kv_idx] = pos;
        }
    } else {
        const uint ring_idx = uint(pos) & pa.ring_mask;
        const uint dst_hd   = ring_idx * pa.n_head_kv + h_kv;
        store_quant_vec4(kv_k, pa.dst_k_or_pt_va, pa.dst_ks_va, dst_hd, lane);
        store_quant_vec4(kv_v, pa.dst_v_va,       pa.dst_vs_va, dst_hd, lane);
        if (h_kv == 0u && lane == 0u && pa.pos_dst_va != 0ul) {
            BufI32W(pa.pos_dst_va).d[ring_idx] = pos;
        }
    }
}

#endif // PASS_MODE
