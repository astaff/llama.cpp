// Push constants for Phase 1 & Phase 2: 256 bytes (exact AGX_MAX_PUSH_BYTES!)
layout(push_constant) uniform PushAttn {
    uint64_t q_va;
    uint64_t k_or_pt_va;      // paged: page_table_va[max_pages]; ext: ext_k_va
    uint64_t v_va;            // ext: ext_v_va (paged uses page_va + page_v_off_B)
    uint64_t pos_kv_va;       // int32_t pos_full[n_kv] (0 -> kv_idx)
    uint64_t rel_table_va;    // [M, Hq, n_rel_extent+1] or banded [B*M, Hq, rel_table_len] F32
    uint64_t sinks_va;        // [Hq] or [B*M, Hq] F32
    uint64_t q_gate_va;       // [B, M, Hq, D] F32/F16
    uint64_t pos_q_va;        // [M] int32_t (0 -> pos_q_base + tok)
    uint64_t kq_mask_va;      // optional [B, Hmask, M, n_kv] F16/F32
    uint64_t partial_va;      // SLC scratch: [B*M, Hq, n_splits, PARTIAL_STRIDE] F32 (or kv_bounds in P3)
    uint64_t out_va;          // [B, M, Hq, D] F32/F16

    uint     n_tokens;        // M (per batch)
    uint     n_kv;            // total KV entries
    uint     n_splits;        // 1..64
    uint     n_head_q;        // 24
    uint     n_head_kv;       // 8
    uint     head_dim;        // 64 or 128
    uint     n_rel_extent;
    uint     pos_q_base;
    uint     flags;
    uint     page_v_off_B;    // paged: byte offset to V data inside 64-tok page
    uint     page_ks_off_B;   // paged Q8_0: byte offset to K scales
    uint     page_vs_off_B;   // paged Q8_0: byte offset to V scales
    uint     ext_k_nb1;       // ext: byte stride per KV token
    uint     ext_k_nb2;       // ext: byte stride per KV head
    uint     ext_v_nb1;
    uint     ext_v_nb2;
    uint     ext_mask_nb1;    // ext mask row byte stride
    uint     ext_mask_nb2;    // ext mask head byte stride (0 = broadcast)
    uint     ext_mask_ne2;    // ext mask head count (for h_q % ext_mask_ne2)
    uint     q_nb1;           // Q token byte stride
    uint     q_nb2;           // Q head byte stride
    uint     mask_n_head_log2;
    float    kq_scale;
    float    logit_softcap;
    float    m0;
    float    m1;

    uint64_t rel_pos_pack_va; // O(n_kv) packed I32: [cell_pos | q_pos | tile64_minmax]
    uint     rel_table_len;   // eff_rows <= n_rel_extent
    uint     rel_cp_off;      // I32 offset to cell_pos for batch 0
    uint     rel_qp_off;      // I32 offset to q_pos for batch 0
    uint     rel_tm_off;      // I32 offset to tile64_minmax for batch 0
    uint     n_batches;       // 0 or 1 = single batch; >1 = native batched PASS_MODE=0/1 (Batch 8x!)
    uint     batch_q_nb3;     // byte stride per batch in q_va
    uint     batch_k_nb3;     // byte stride per (b / batch_rk3) in k_or_pt_va
    uint     batch_v_nb3;     // byte stride per (b / batch_rv3) in v_va
    uint     batch_mask_nb3;  // byte stride per (b % batch_mask_ne3) in kq_mask_va
    uint     batch_out_nb3;   // byte stride per batch in out_va
    uint     batch_qgate_nb3; // byte stride per batch in q_gate_va
    uint     batch_rk3;       // q->ne[3] / k->ne[3] (>= 1)
    uint     batch_rv3;       // q->ne[3] / v->ne[3] (>= 1)
    uint     batch_mask_ne3;  // mask->ne[3] (>= 1)
} pc;

float compute_alibi_slope(uint h_q) {
    if ((pc.flags & FLAG_ALIBI) == 0u) {
        return 1.0f;
    }
    uint n_log2 = pc.mask_n_head_log2;
    float base  = (h_q < n_log2) ? pc.m0 : pc.m1;
    int   exph  = (h_q < n_log2) ? int(h_q + 1u) : int(2u * (h_q - n_log2) + 1u);
    return pow(base, float(exph));
}

void apply_epilogue_and_store(VEC_T out_v, uint batch, uint tok, uint h_q, uint lane) {
    const uint q_head_off = (tok * pc.n_head_q + h_q) * uint(HEAD_DIM) + lane * ELEMS_PER_LANE;
    const uint64_t qg_va  = (pc.q_gate_va != 0ul)
        ? (pc.q_gate_va + uint64_t(batch) * uint64_t(pc.batch_qgate_nb3))
        : 0ul;
    const uint64_t dst_va = pc.out_va + uint64_t(batch) * uint64_t(pc.batch_out_nb3);

    if ((pc.flags & FLAG_FWHT64) != 0u) {
        out_v = fwht64_in_reg(out_v, lane);
    }

    if ((pc.flags & FLAG_QGATE_F32) != 0u && qg_va != 0ul) {
#if HEAD_DIM == 64
        BufF32 gb = BufF32(qg_va);
        vec2 g = vec2(gb.d[q_head_off + 0u], gb.d[q_head_off + 1u]);
#else
        vec4 g;
        if ((qg_va & 15ul) == 0ul) {
            g = BufVec4R(qg_va).d[q_head_off >> 2u];
        } else {
            BufF32 gb = BufF32(qg_va);
            g = vec4(gb.d[q_head_off + 0u], gb.d[q_head_off + 1u],
                     gb.d[q_head_off + 2u], gb.d[q_head_off + 3u]);
        }
#endif
        out_v *= 1.0f / (1.0f + exp(-g));
    } else if ((pc.flags & FLAG_QGATE_F16) != 0u && qg_va != 0ul) {
#if HEAD_DIM == 64
        uint gp = BufU32(qg_va).d[(tok * pc.n_head_q + h_q) * 32u + lane];
        vec2 g = unpackHalf2x16(gp);
#else
        uvec2 gp = BufUvec2(qg_va).d[(tok * pc.n_head_q + h_q) * 32u + lane];
        vec4 g = vec4(unpackHalf2x16(gp.x), unpackHalf2x16(gp.y));
#endif
        out_v *= 1.0f / (1.0f + exp(-g));
    }

    if ((pc.flags & FLAG_OUT_F16) != 0u) {
#if HEAD_DIM == 64
        BufF16W ob = BufF16W(dst_va);
        ob.d[q_head_off + 0u] = float16_t(out_v.x);
        ob.d[q_head_off + 1u] = float16_t(out_v.y);
#else
        if ((dst_va & 7ul) == 0ul) {
            BufUvec2W(dst_va).d[q_head_off >> 2u] = uvec2(
                packFloat2x16(f16vec2(out_v.xy)),
                packFloat2x16(f16vec2(out_v.zw)));
        } else {
            BufF16W ob = BufF16W(dst_va);
            ob.d[q_head_off + 0u] = float16_t(out_v.x);
            ob.d[q_head_off + 1u] = float16_t(out_v.y);
            ob.d[q_head_off + 2u] = float16_t(out_v.z);
            ob.d[q_head_off + 3u] = float16_t(out_v.w);
        }
#endif
    } else {
#if HEAD_DIM == 64
        BufF32W ob = BufF32W(dst_va);
        ob.d[q_head_off + 0u] = out_v.x;
        ob.d[q_head_off + 1u] = out_v.y;
#else
        if ((dst_va & 15ul) == 0ul) {
            BufVec4W(dst_va).d[q_head_off >> 2u] = out_v;
        } else {
            BufF32W ob = BufF32W(dst_va);
            ob.d[q_head_off + 0u] = out_v.x;
            ob.d[q_head_off + 1u] = out_v.y;
            ob.d[q_head_off + 2u] = out_v.z;
            ob.d[q_head_off + 3u] = out_v.w;
        }
#endif
    }
}

void get_sink_info(uint tok, uint h_q, out bool has_sink, out float eff_sink) {
    has_sink = false;
    eff_sink = 0.0f;
    if ((pc.flags & FLAG_REL_TABLE_SINK) != 0u) {
        has_sink = true;
        eff_sink = 0.0f;
    } else if ((pc.flags & FLAG_SINK_PER_TOK_HEAD) != 0u && pc.sinks_va != 0ul) {
        has_sink = true;
        eff_sink = BufF32(pc.sinks_va).d[tok * pc.n_head_q + h_q];
    } else if ((pc.flags & FLAG_SINK_PER_HEAD) != 0u && pc.sinks_va != 0ul) {
        has_sink = true;
        eff_sink = BufF32(pc.sinks_va).d[h_q];
    }
}

