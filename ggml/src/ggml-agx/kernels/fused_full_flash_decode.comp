    f16vec2 hi = agx_q8_u16_magic_to_f16vec2(uint(qb.d[sub16 + 1u]));
    return vec4(lo, hi) * sc;
#else
    uvec2 p = BufUvec2(row_va).d[lane];
    return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y));
