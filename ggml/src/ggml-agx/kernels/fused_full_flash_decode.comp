#if PASS_MODE == 0
#if GQA_GRP == 3 && HEAD_DIM == 128
// ============================================================================
// Wave 10 GQA=3 Grouped Split-K Flash-Decode (grid.x = n_head_kv):
//   - Shares 1x DRAM K/V load, 1x mask load, and 1x tile64_minmax/cell_pos load
//     across all 3 GQA Q-heads of each h_kv -> EXACT 3.0x KV DRAM reduction!
//   - ZERO barriers inside KV loop, 2,080 B SRAM, ~58 GPR32, 24-32 ActSGs/core!
// ============================================================================
void gqa3_reduce_and_emit(vec4 o_i, float m_i, float l_i,
                          uint h_q, uint tok_global, uint split,
                          uint n_batches, uint sg, uint lane) {
    if (lane == 0u) {
        sh_m[sg] = m_i;
        sh_l[sg] = l_i;
    }
    sh_o[sg][lane] = o_i;
    barrier();

    if (sg == 0u) {
        float m_wg = -3.402823466e+38f * 0.5f;
        for (uint s = 0u; s < N_SG; ++s) {
            if (sh_l[s] > 0.0f) {
                m_wg = max(m_wg, sh_m[s]);
            }
        }
        float l_wg = 0.0f;
        vec4  o_wg = vec4(0.0f);
        for (uint s = 0u; s < N_SG; ++s) {
            if (sh_l[s] > 0.0f) {
                float w = exp(sh_m[s] - m_wg);
                l_wg += sh_l[s] * w;
                o_wg += sh_o[s][lane] * w;
            }
        }
        if (pc.n_splits == 1u) {
            bool  has_sink;
            float eff_sink;
            get_sink_info(tok_global, h_q, has_sink, eff_sink);
            if (has_sink) {
                float m_fin = (l_wg > 0.0f) ? max(m_wg, eff_sink) : eff_sink;
                float w_o   = (l_wg > 0.0f) ? exp(m_wg - m_fin) : 0.0f;
                float w_s   = exp(eff_sink - m_fin);
                o_wg = o_wg * w_o;
                l_wg = l_wg * w_o + w_s;
            }
            vec4 out_v = (l_wg > 0.0f) ? (o_wg / l_wg) : vec4(0.0f);
            const uint ep_b = (n_batches > 1u) ? (tok_global / pc.n_tokens) : 0u;
            const uint ep_t = (n_batches > 1u) ? (tok_global - ep_b * pc.n_tokens) : tok_global;
            apply_epilogue_and_store(out_v, ep_b, ep_t, h_q, lane);
        } else {
            const uint base = ((tok_global * pc.n_head_q + h_q) * pc.n_splits + split) * PARTIAL_STRIDE;
            BufF32W pb = BufF32W(pc.partial_va);
            pb.d[base + lane * 4u + 0u] = o_wg.x;
            pb.d[base + lane * 4u + 1u] = o_wg.y;
            pb.d[base + lane * 4u + 2u] = o_wg.z;
            pb.d[base + lane * 4u + 3u] = o_wg.w;
            if (lane == 0u) {
                pb.d[base + 128u] = m_wg;
                pb.d[base + 129u] = l_wg;
            }
        }
    }
}

vec4 gqa3_load_q(uint64_t q_va, uint lane) {
    if ((pc.flags & FLAG_Q_F16) != 0u) {
        uvec2 qp = BufUvec2(q_va).d[lane];
        return vec4(unpackHalf2x16(qp.x), unpackHalf2x16(qp.y)) * pc.kq_scale;
    }
    BufF32 qb = BufF32(q_va);
    uint o = lane * 4u;
    return vec4(qb.d[o + 0u], qb.d[o + 1u], qb.d[o + 2u], qb.d[o + 3u]) * pc.kq_scale;
}

void main() {
    const uint lane       = gl_LocalInvocationID.x;
    const uint sg         = gl_LocalInvocationID.y;
    const uint h_kv       = gl_WorkGroupID.x;
    const uint tok_global = gl_WorkGroupID.y;
    const uint split      = gl_WorkGroupID.z;
    const uint n_batches  = max(1u, pc.n_batches);

    if (h_kv >= pc.n_head_kv || tok_global >= pc.n_tokens * n_batches || split >= pc.n_splits) {
        return;
    }

    const uint batch = (n_batches > 1u) ? (tok_global / pc.n_tokens) : 0u;
    const uint tok   = (n_batches > 1u) ? (tok_global - batch * pc.n_tokens) : tok_global;
    const uint h_q0  = h_kv * 3u;

    const uint64_t q_base_va = pc.q_va
        + uint64_t(batch) * uint64_t(pc.batch_q_nb3)
        + uint64_t(tok)   * uint64_t(pc.q_nb1)
        + uint64_t(h_q0)  * uint64_t(pc.q_nb2);
    const vec4 q0 = gqa3_load_q(q_base_va + uint64_t(0u) * uint64_t(pc.q_nb2), lane);
    const vec4 q1 = gqa3_load_q(q_base_va + uint64_t(1u) * uint64_t(pc.q_nb2), lane);
    const vec4 q2 = gqa3_load_q(q_base_va + uint64_t(2u) * uint64_t(pc.q_nb2), lane);

    const uint n_blk64 = (pc.n_kv + 63u) >> 6u;
    const uint b_start = (pc.n_splits == 1u) ? 0u : uint((uint64_t(split)      * uint64_t(n_blk64)) / uint64_t(pc.n_splits));
    const uint b_end   = (pc.n_splits == 1u) ? n_blk64 : uint((uint64_t(split + 1u) * uint64_t(n_blk64)) / uint64_t(pc.n_splits));
    const uint k_start = min(b_start << 6u, pc.n_kv);
    const uint k_end   = min(b_end   << 6u, pc.n_kv);

    const bool is_causal    = (pc.flags & FLAG_CAUSAL) != 0u;
    const bool has_banded   = (pc.flags & FLAG_BANDED_REL_BIAS) != 0u && (pc.rel_table_va != 0ul) && (pc.rel_pos_pack_va != 0ul);
    const bool has_mask_f16 = (pc.flags & FLAG_HAS_MASK_F16) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask_f32 = (pc.flags & FLAG_HAS_MASK_F32) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_softcap  = (pc.flags & FLAG_SOFTCAP) != 0u && (pc.logit_softcap != 0.0f);

    const uint64_t k_base_va = (n_batches > 1u)
        ? (pc.k_or_pt_va + uint64_t(batch / max(1u, pc.batch_rk3)) * uint64_t(pc.batch_k_nb3))
        : pc.k_or_pt_va;
    const uint64_t v_base_va = (n_batches > 1u)
        ? (pc.v_va + uint64_t(batch / max(1u, pc.batch_rv3)) * uint64_t(pc.batch_v_nb3))
        : pc.v_va;
    const uint64_t mask_row_va = pc.kq_mask_va
        + ((n_batches > 1u) ? uint64_t(batch % max(1u, pc.batch_mask_ne3)) * uint64_t(pc.batch_mask_nb3) : 0ul)
        + uint64_t(tok) * uint64_t(pc.ext_mask_nb1);

    const float neg_inf = -3.402823466e+38f * 0.5f;
    float m0 = neg_inf, m1 = neg_inf, m2 = neg_inf;
    float l0 = 0.0f,    l1 = 0.0f,    l2 = 0.0f;
    vec4  o0 = vec4(0.0f), o1 = vec4(0.0f), o2 = vec4(0.0f);
    uint cur_b64 = 0xFFFFFFFFu;
    bool cur_tile_has_rel = false;

    for (uint kv = k_start + sg; kv < k_end; kv += N_SG) {
        float mv = 0.0f;
        if (has_mask_f16) {
            mv = float(BufF16(mask_row_va).d[kv]);
            if (!(mv > -1.0e30f)) {
                continue;
            }
        } else if (has_mask_f32) {
            mv = BufF32(mask_row_va).d[kv];
            if (!(mv > -1.0e30f)) {
                continue;
            }
        }

        if (is_causal) {
            int pos_q = (pc.pos_q_va != 0ul) ? BufI32(pc.pos_q_va).d[tok] : int(pc.pos_q_base + tok);
            int pos_k = (pc.pos_kv_va != 0ul) ? BufI32(pc.pos_kv_va).d[kv] : int(kv);
            if (pos_k < 0 || pos_q < pos_k) {
                continue;
            }
        }

        // Single K + V DRAM load shared across all 3 GQA Q-heads (3.0x DRAM BW amplification!)
        vec4 k_reg = load_ext_k(k_base_va, pc.ext_k_nb1, pc.ext_k_nb2, kv, h_kv, lane);
        vec4 v_reg = load_ext_v(v_base_va, pc.ext_v_nb1, pc.ext_v_nb2, kv, h_kv, lane);

        float s0 = subgroupAdd(dot(q0, k_reg));
        float s1 = subgroupAdd(dot(q1, k_reg));
        float s2 = subgroupAdd(dot(q2, k_reg));
        if (has_softcap) {
            s0 = pc.logit_softcap * tanh(s0);
            s1 = pc.logit_softcap * tanh(s1);
            s2 = pc.logit_softcap * tanh(s2);
        }
        s0 += mv;
        s1 += mv;
        s2 += mv;

        if (has_banded) {
            const uint b64 = kv >> 6u;
            const int b_pos_q = BufI32(pc.rel_pos_pack_va).d[pc.rel_qp_off + tok_global];
            if (b64 != cur_b64) {
                cur_b64 = b64;
                const uint b_tm_off = pc.rel_tm_off + batch * n_blk64 * 2u;
                const int tmin = BufI32(pc.rel_pos_pack_va).d[b_tm_off + b64 * 2u + 0u];
                const int tmax = BufI32(pc.rel_pos_pack_va).d[b_tm_off + b64 * 2u + 1u];
                cur_tile_has_rel = (b_pos_q >= tmin) && (b_pos_q < tmax + int(pc.n_rel_extent));
            }
            if (cur_tile_has_rel) {
                int kp = BufI32(pc.rel_pos_pack_va).d[pc.rel_cp_off + batch * pc.n_kv + kv];
                int bd = b_pos_q - kp;
                if (bd >= 0 && uint(bd) < pc.n_rel_extent && uint(bd) < pc.rel_table_len) {
                    const uint ubd = uint(bd);
                    const uint64_t rt_h_step = uint64_t(pc.rel_table_len) * 4ul;
                    const uint64_t b_rt_va0  = pc.rel_table_va + uint64_t(tok_global * pc.n_head_q + h_q0) * rt_h_step;
                    s0 += BufF32(b_rt_va0).d[ubd];
                    s1 += BufF32(b_rt_va0 + rt_h_step).d[ubd];
                    s2 += BufF32(b_rt_va0 + rt_h_step * 2ul).d[ubd];
                }
            }
        }

        float m0n = max(m0, s0); float a0 = exp(m0 - m0n); float p0 = exp(s0 - m0n);
        o0 = o0 * a0 + v_reg * p0; l0 = l0 * a0 + p0; m0 = m0n;

        float m1n = max(m1, s1); float a1 = exp(m1 - m1n); float p1 = exp(s1 - m1n);
        o1 = o1 * a1 + v_reg * p1; l1 = l1 * a1 + p1; m1 = m1n;

        float m2n = max(m2, s2); float a2 = exp(m2 - m2n); float p2 = exp(s2 - m2n);
        o2 = o2 * a2 + v_reg * p2; l2 = l2 * a2 + p2; m2 = m2n;
    }

    gqa3_reduce_and_emit(o0, m0, l0, h_q0 + 0u, tok_global, split, n_batches, sg, lane);
    barrier();
    gqa3_reduce_and_emit(o1, m1, l1, h_q0 + 1u, tok_global, split, n_batches, sg, lane);
    barrier();
    gqa3_reduce_and_emit(o2, m2, l2, h_q0 + 2u, tok_global, split, n_batches, sg, lane);
}
