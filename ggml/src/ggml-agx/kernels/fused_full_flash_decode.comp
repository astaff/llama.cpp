// ============================================================================
// Shared FP16 External KV Loaders for 8x8 Coopmat Prefill (Mode 3 & Mode 4)
// ============================================================================
f16vec4 load_ext_k_f16(uint64_t base_va, uint nb1, uint nb2, uint kv_idx, uint h_kv, uint lane) {
    const uint64_t row_va = base_va + uint64_t(kv_idx) * uint64_t(nb1) + uint64_t(h_kv) * uint64_t(nb2);
#if KV_DTYPE_K == 0
    return agx_e4m3_u32_to_f16vec4(BufU32(row_va).d[lane]);
#elif KV_DTYPE_K == 2
    uvec2 p = BufUvec2(row_va).d[lane];
    return f16vec4(unpackFloat2x16(p.x), unpackFloat2x16(p.y));
#elif KV_DTYPE_K == 4
    uint blk = lane >> 3;
    uint sub16 = (lane & 7u) * 2u;
    uint64_t blk_va = row_va + uint64_t(blk) * 34ul;
    float sc = float(BufF16(blk_va).d[0]);
    BufU16 qb = BufU16(blk_va + 2ul);
    f16vec2 lo = agx_q8_u16_magic_to_f16vec2(uint(qb.d[sub16 + 0u]));
    f16vec2 hi = agx_q8_u16_magic_to_f16vec2(uint(qb.d[sub16 + 1u]));
    return f16vec4(clamp(vec4(lo, hi) * sc, vec4(-65504.0f), vec4(65504.0f)));
#elif KV_DTYPE_K == 3
    BufF32 fb = BufF32(row_va);
    uint o = lane * 4u;
    return f16vec4(clamp(vec4(fb.d[o + 0u], fb.d[o + 1u], fb.d[o + 2u], fb.d[o + 3u]),
                         vec4(-65504.0f), vec4(65504.0f)));
#else
    uvec2 p = BufUvec2(row_va).d[lane];
    return f16vec4(unpackFloat2x16(p.x), unpackFloat2x16(p.y));
#endif
}

