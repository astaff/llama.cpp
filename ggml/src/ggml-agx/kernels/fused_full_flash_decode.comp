#if HEAD_DIM == 128
vec4 load_paged_kv(uint64_t page_va, uint v_or_k_off_B, uint sc_off_B, uint in_page, uint h_kv, uint lane) {
    const uint head_idx = in_page * pc.n_head_kv + h_kv;
    const uint64_t data_va = page_va + uint64_t(v_or_k_off_B);
#if KV_DTYPE_K == 0
    uint packed = BufU32(data_va).d[head_idx * 32u + lane];
    return decode_e4m3_u32(packed);
#elif KV_DTYPE_K == 1
    uint packed = BufU32(data_va).d[head_idx * 32u + lane];
    float sc = float(BufF16(page_va + uint64_t(sc_off_B)).d[head_idx * 4u + (lane >> 3)]);
    return vec4(agx_q8_u32_magic_to_f16vec4(packed)) * sc;
#elif KV_DTYPE_K == 2
    uvec2 p = BufUvec2(data_va).d[head_idx * 32u + lane];
    return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y));
#else
    BufF32 fb = BufF32(data_va);
    uint off = head_idx * 128u + lane * 4u;
    return vec4(fb.d[off + 0u], fb.d[off + 1u], fb.d[off + 2u], fb.d[off + 3u]);
#endif
}
#else
vec2 load_paged_kv(uint64_t page_va, uint v_or_k_off_B, uint sc_off_B, uint in_page, uint h_kv, uint lane) {
    const uint head_idx = in_page * pc.n_head_kv + h_kv;
    const uint64_t data_va = page_va + uint64_t(v_or_k_off_B);
#if KV_DTYPE_K == 0
    uint packed = uint(BufU16(data_va).d[head_idx * 32u + lane]);
    return decode_e4m3_u16(packed);
#elif KV_DTYPE_K == 1
    uint packed = uint(BufU16(data_va).d[head_idx * 32u + lane]);
    float sc = float(BufF16(page_va + uint64_t(sc_off_B)).d[head_idx * 2u + (lane >> 4)]);
    return vec2(agx_q8_u16_magic_to_f16vec2(packed)) * sc;
#elif KV_DTYPE_K == 2
    uint p = BufU32(data_va).d[head_idx * 32u + lane];
    return unpackHalf2x16(p);
#else
    BufF32 fb = BufF32(data_va);
    uint off = head_idx * 64u + lane * 2u;
    return vec2(fb.d[off + 0u], fb.d[off + 1u]);
#endif
}
#endif

#if HEAD_DIM == 64
vec2 load_ext_k(uint64_t base_va, uint nb1, uint nb2, uint kv_idx, uint h_kv, uint lane) {
    const uint64_t row_va = base_va + uint64_t(kv_idx) * uint64_t(nb1) + uint64_t(h_kv) * uint64_t(nb2);
#if KV_DTYPE_K == 0
    return decode_e4m3_u16(uint(BufU16(row_va).d[lane]));
#elif KV_DTYPE_K == 2
    return unpackHalf2x16(BufU32(row_va).d[lane]);
#elif KV_DTYPE_K == 3
    BufF32 fb = BufF32(row_va);
    uint o = lane * 2u;
    return vec2(fb.d[o + 0u], fb.d[o + 1u]);
#elif KV_DTYPE_K == 4
    // ggml block_q8_0 (34B = 2B fp16 d + 32B int8 qs): 2B-aligned u16 load + magic-bias decode!
    uint blk = lane >> 4;
    uint sub16 = lane & 15u;
    uint64_t blk_va = row_va + uint64_t(blk) * 34ul;
    float sc = float(BufF16(blk_va).d[0]);
    uint p16 = uint(BufU16(blk_va + 2ul).d[sub16]);
    return vec2(agx_q8_u16_magic_to_f16vec2(p16)) * sc;
#else
    return unpackHalf2x16(BufU32(row_va).d[lane]);
#endif
}

vec2 load_ext_v(uint64_t base_va, uint nb1, uint nb2, uint kv_idx, uint h_kv, uint lane) {
    const uint64_t row_va = base_va + uint64_t(kv_idx) * uint64_t(nb1) + uint64_t(h_kv) * uint64_t(nb2);
#if KV_DTYPE_V == 0
    return decode_e4m3_u16(uint(BufU16(row_va).d[lane]));
#elif KV_DTYPE_V == 2
    return unpackHalf2x16(BufU32(row_va).d[lane]);
#elif KV_DTYPE_V == 3
    BufF32 fb = BufF32(row_va);
    uint o = lane * 2u;
    return vec2(fb.d[o + 0u], fb.d[o + 1u]);
#elif KV_DTYPE_V == 4
    uint blk = lane >> 4;
    uint sub16 = lane & 15u;
    uint64_t blk_va = row_va + uint64_t(blk) * 34ul;
    float sc = float(BufF16(blk_va).d[0]);
    uint p16 = uint(BufU16(blk_va + 2ul).d[sub16]);
    return vec2(agx_q8_u16_magic_to_f16vec2(p16)) * sc;
#else
    return unpackHalf2x16(BufU32(row_va).d[lane]);
#endif
}
#else
vec4 load_ext_k(uint64_t base_va, uint nb1, uint nb2, uint kv_idx, uint h_kv, uint lane) {
    const uint64_t row_va = base_va + uint64_t(kv_idx) * uint64_t(nb1) + uint64_t(h_kv) * uint64_t(nb2);
#if KV_DTYPE_K == 0
    return decode_e4m3_u32(BufU32(row_va).d[lane]);
#elif KV_DTYPE_K == 2
    uvec2 p = BufUvec2(row_va).d[lane];
    return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y));
#elif KV_DTYPE_K == 3
    BufF32 fb = BufF32(row_va);
    uint o = lane * 4u;
    return vec4(fb.d[o + 0u], fb.d[o + 1u], fb.d[o + 2u], fb.d[o + 3u]);
#elif KV_DTYPE_K == 4
    // ggml block_q8_0 (34B = 2B fp16 d + 32B int8 qs): 2x 2B-aligned u16 loads + magic-bias decode!
    uint blk = lane >> 3;
    uint sub16 = (lane & 7u) * 2u;
    uint64_t blk_va = row_va + uint64_t(blk) * 34ul;
    float sc = float(BufF16(blk_va).d[0]);
    BufU16 qb = BufU16(blk_va + 2ul);
    f16vec2 lo = agx_q8_u16_magic_to_f16vec2(uint(qb.d[sub16 + 0u]));
    f16vec2 hi = agx_q8_u16_magic_to_f16vec2(uint(qb.d[sub16 + 1u]));
    return vec4(lo, hi) * sc;
#else
    uvec2 p = BufUvec2(row_va).d[lane];
    return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y));
#endif
}

vec4 load_ext_v(uint64_t base_va, uint nb1, uint nb2, uint kv_idx, uint h_kv, uint lane) {
    const uint64_t row_va = base_va + uint64_t(kv_idx) * uint64_t(nb1) + uint64_t(h_kv) * uint64_t(nb2);
#if KV_DTYPE_V == 0
    return decode_e4m3_u32(BufU32(row_va).d[lane]);
#elif KV_DTYPE_V == 2
    uvec2 p = BufUvec2(row_va).d[lane];
    return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y));
#elif KV_DTYPE_V == 3
    BufF32 fb = BufF32(row_va);
    uint o = lane * 4u;
    return vec4(fb.d[o + 0u], fb.d[o + 1u], fb.d[o + 2u], fb.d[o + 3u]);
#elif KV_DTYPE_V == 4
    uint blk = lane >> 3;
    uint sub16 = (lane & 7u) * 2u;
    uint64_t blk_va = row_va + uint64_t(blk) * 34ul;
    float sc = float(BufF16(blk_va).d[0]);
    BufU16 qb = BufU16(blk_va + 2ul);
    f16vec2 lo = agx_q8_u16_magic_to_f16vec2(uint(qb.d[sub16 + 0u]));
    f16vec2 hi = agx_q8_u16_magic_to_f16vec2(uint(qb.d[sub16 + 1u]));
    return vec4(lo, hi) * sc;
#else
    uvec2 p = BufUvec2(row_va).d[lane];
    return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y));
#endif
}
#endif

#if PASS_MODE == 0
void main() {
    const uint lane  = gl_LocalInvocationID.x;
    const uint sg    = gl_LocalInvocationID.y;
    const uint h_q   = gl_WorkGroupID.x;
    const uint tok   = gl_WorkGroupID.y;
    const uint split = gl_WorkGroupID.z;

    if (h_q >= pc.n_head_q || tok >= pc.n_tokens || split >= pc.n_splits) {
        return;
    }

    const uint     gqa_ratio = pc.n_head_q / pc.n_head_kv;
    const uint     h_kv      = h_q / gqa_ratio;
    const uint64_t q_row_va  = pc.q_va + uint64_t(tok) * uint64_t(pc.q_nb1) + uint64_t(h_q) * uint64_t(pc.q_nb2);

    VEC_T q_reg;
    if ((pc.flags & FLAG_Q_F16) != 0u) {
#if HEAD_DIM == 64
        q_reg = unpackHalf2x16(BufU32(q_row_va).d[lane]) * pc.kq_scale;
#else
        uvec2 qp = BufUvec2(q_row_va).d[lane];
        q_reg = vec4(unpackHalf2x16(qp.x), unpackHalf2x16(qp.y)) * pc.kq_scale;
#endif
    } else {
        BufF32 qb = BufF32(q_row_va);
        uint o = lane * ELEMS_PER_LANE;
#if HEAD_DIM == 64
        q_reg = vec2(qb.d[o + 0u], qb.d[o + 1u]) * pc.kq_scale;
#else
        q_reg = vec4(qb.d[o + 0u], qb.d[o + 1u], qb.d[o + 2u], qb.d[o + 3u]) * pc.kq_scale;
#endif
    }

    const uint k_start = uint((uint64_t(split)      * uint64_t(pc.n_kv)) / uint64_t(pc.n_splits));
    const uint k_end   = uint((uint64_t(split + 1u) * uint64_t(pc.n_kv)) / uint64_t(pc.n_splits));

    const int  pos_q        = (pc.pos_q_va != 0ul) ? BufI32(pc.pos_q_va).d[tok] : int(pc.pos_q_base + tok);
    const bool is_paged     = (pc.flags & FLAG_PAGED_KV) != 0u;
    const bool is_causal    = (pc.flags & FLAG_CAUSAL) != 0u;
    const bool has_rel      = (pc.flags & FLAG_HAS_REL_TABLE) != 0u && (pc.rel_table_va != 0ul);
    const bool has_mask_f16 = (pc.flags & FLAG_HAS_MASK_F16) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask_f32 = (pc.flags & FLAG_HAS_MASK_F32) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_softcap  = (pc.flags & FLAG_SOFTCAP) != 0u && (pc.logit_softcap != 0.0f);
    const float slope       = compute_alibi_slope(h_q);

    const uint rel_stride = pc.n_rel_extent + 1u;
    const uint rel_base   = (tok * pc.n_head_q + h_q) * rel_stride;
    const uint h_mask     = (pc.ext_mask_ne2 > 1u) ? (h_q % pc.ext_mask_ne2) : 0u;
    const uint64_t mask_row_va = pc.kq_mask_va
        + uint64_t(tok) * uint64_t(pc.ext_mask_nb1)
        + uint64_t(h_mask) * uint64_t(pc.ext_mask_nb2);

    float m_i = -3.402823466e+38f * 0.5f;
    float l_i = 0.0f;
    VEC_T o_i = VEC_T(0.0f);

    for (uint kv = k_start + sg; kv < k_end; kv += N_SG) {
        float mv = 0.0f;
        if (has_mask_f16) {
            mv = float(BufF16(mask_row_va).d[kv]) * slope;
            if (!(mv > -1.0e30f)) {
                continue;
            }
        } else if (has_mask_f32) {
            mv = BufF32(mask_row_va).d[kv] * slope;
            if (!(mv > -1.0e30f)) {
                continue;
            }
        }

        int pos_k = (pc.pos_kv_va != 0ul) ? BufI32(pc.pos_kv_va).d[kv] : int(kv);
        int dist  = pos_q - pos_k;
        if (is_causal && (pos_k < 0 || dist < 0)) {
            continue;
        }

        VEC_T k_reg;
        VEC_T v_reg;
        if (is_paged) {
            uint64_t page_va = BufU64(pc.k_or_pt_va).d[kv >> 6];
            uint     in_page = kv & 63u;
            k_reg = load_paged_kv(page_va, 0u,              pc.page_ks_off_B, in_page, h_kv, lane);
            v_reg = load_paged_kv(page_va, pc.page_v_off_B, pc.page_vs_off_B, in_page, h_kv, lane);
        } else {
            k_reg = load_ext_k(pc.k_or_pt_va, pc.ext_k_nb1, pc.ext_k_nb2, kv, h_kv, lane);
            v_reg = load_ext_v(pc.v_va,       pc.ext_v_nb1, pc.ext_v_nb2, kv, h_kv, lane);
        }

        float score = subgroupAdd(dot(q_reg, k_reg));
        if (has_softcap) {
            score = pc.logit_softcap * tanh(score);
        }
        score += mv;

        if (has_rel) {
            uint d_idx = (dist >= 0) ? min(uint(dist), pc.n_rel_extent) : pc.n_rel_extent;
            score += BufF32(pc.rel_table_va).d[rel_base + d_idx];
        }

        float m_new = max(m_i, score);
        float alpha = exp(m_i - m_new);
        float p_w   = exp(score - m_new);
        o_i = o_i * alpha + v_reg * p_w;
        l_i = l_i * alpha + p_w;
        m_i = m_new;
    }

    if (lane == 0u) {
        sh_m[sg] = m_i;
        sh_l[sg] = l_i;
    }
    sh_o[sg][lane] = o_i;
    barrier();

    if (sg == 0u) {
        float m_wg = -3.402823466e+38f * 0.5f;
        for (uint s = 0u; s < N_SG; ++s) {
            if (sh_l[s] > 0.0f) {
                m_wg = max(m_wg, sh_m[s]);
            }
        }

        float l_wg = 0.0f;
        VEC_T o_wg = VEC_T(0.0f);
        for (uint s = 0u; s < N_SG; ++s) {
            if (sh_l[s] > 0.0f) {
                float w = exp(sh_m[s] - m_wg);
                l_wg += sh_l[s] * w;
                o_wg += sh_o[s][lane] * w;
            }
        }

        if (pc.n_splits == 1u) {
            bool  has_sink;
            float eff_sink;
            get_sink_info(tok, h_q, has_sink, eff_sink);
            if (has_sink) {
                float m_fin = (l_wg > 0.0f) ? max(m_wg, eff_sink) : eff_sink;
                float w_o   = (l_wg > 0.0f) ? exp(m_wg - m_fin) : 0.0f;
                float w_s   = exp(eff_sink - m_fin);
                o_wg = o_wg * w_o;
                l_wg = l_wg * w_o + w_s;
            }
            VEC_T out_v = (l_wg > 0.0f) ? (o_wg / l_wg) : VEC_T(0.0f);
            apply_epilogue_and_store(out_v, tok, h_q, lane);
        } else {
            const uint base = ((tok * pc.n_head_q + h_q) * pc.n_splits + split) * PARTIAL_STRIDE;
            BufF32W pb = BufF32W(pc.partial_va);
            pb.d[base + lane * ELEMS_PER_LANE + 0u] = o_wg.x;
            pb.d[base + lane * ELEMS_PER_LANE + 1u] = o_wg.y;
#if HEAD_DIM != 64
            pb.d[base + lane * ELEMS_PER_LANE + 2u] = o_wg.z;
            pb.d[base + lane * ELEMS_PER_LANE + 3u] = o_wg.w;
#endif
            if (lane == 0u) {
                pb.d[base + uint(HEAD_DIM) + 0u] = m_wg;
                pb.d[base + uint(HEAD_DIM) + 1u] = l_wg;
            }
        }
    }
}

