#if PASS_MODE == 3

// ============================================================================
// Phase 3: Hardware 8x8 FP16 Coopmat Prefill Flash-Attention (HEAD_DIM=128)
//   - 4 simdgroups x 8 Q-tokens/sg = 32 Q/WG, TILE_KV = 16 -> 32x KV reuse!
//   - Q[8,128] x K^T[16,128] -> S[8,16] (FP32) via 8x8 hardware f32matmad8x8
//   - In-register FP32 online softmax via 2 shuffles (^1, ^8) along layout_8!
//   - P[8,16] (FP16) x V[16,128] -> O[8,128] (FP32) via 8x8 hardware f32matmad8x8
//   - 14.76 KB TG SRAM (< 16 KB -> 2 WGs/core = 8 sgs/core!), <= 72 GPR32, 0:0 spills
// ============================================================================
#define PF_BQ   32u
#define PF_BK   16u
#define PF_SH_D 136u // 128 + 8 halfs bank-conflict-free padding (272 B = 16B aligned)

shared float16_t sh_q[PF_BQ * PF_SH_D];   // 8,704 B
shared float16_t sh_kv[PF_BK * PF_SH_D];  // 4,352 B (reused for K then V per tile)
shared float     sh_ep[N_SG * 128u];      // 2,048 B (per-sg epilogue staging, 0 WG barriers!)
shared uint      sh_any_valid[2];         // 8 B (double-buffered causal tile skip -> 1 barrier!)

void main() {
    const uint lane  = gl_LocalInvocationID.x; // 0..31
    const uint sg    = gl_LocalInvocationID.y; // 0..3
    const uint tid   = sg * 32u + lane;        // 0..127
    const uint h_q   = gl_WorkGroupID.x;
    const uint wg_q0 = gl_WorkGroupID.y * PF_BQ;

    if (h_q >= pc.n_head_q || wg_q0 >= pc.n_tokens) {
        return;
    }

    const uint gqa_ratio = pc.n_head_q / pc.n_head_kv;
    const uint h_kv      = h_q / gqa_ratio;

    const uint sg_q0  = wg_q0 + sg * 8u;
    const bool sg_ok  = (sg_q0 < pc.n_tokens);
    const uint lr     = agx_cmat8_row(lane);   // 0..7
    const uint lc0    = agx_cmat8_col0(lane);  // 0, 2, 4, 6
    const uint tok    = sg_q0 + lr;
    const bool tok_ok = (tok < pc.n_tokens);

    // Cooperative load of Q[wg_q0..+32, 0..127] * kq_scale -> sh_q (8 rows/sg, 4 elems/lane)
    const bool q_is_f16 = (pc.flags & FLAG_Q_F16) != 0u;
    for (uint r = 0u; r < 8u; ++r) {
        const uint ql   = sg * 8u + r;
        const uint qtok = wg_q0 + ql;
        f16vec4 q4 = f16vec4(float16_t(0.0));
        if (qtok < pc.n_tokens) {
            uint64_t qva = pc.q_va + uint64_t(qtok) * uint64_t(pc.q_nb1) + uint64_t(h_q) * uint64_t(pc.q_nb2);
            vec4 qf;
            if (q_is_f16) {
                uvec2 qp = BufUvec2(qva).d[lane];
                qf = vec4(unpackHalf2x16(qp.x), unpackHalf2x16(qp.y)) * pc.kq_scale;
            } else {
                BufF32 qb = BufF32(qva);
                uint o = lane * 4u;
                qf = vec4(qb.d[o + 0u], qb.d[o + 1u], qb.d[o + 2u], qb.d[o + 3u]) * pc.kq_scale;
            }
            q4 = f16vec4(clamp(qf, vec4(-65504.0f), vec4(65504.0f)));
        }
        const uint dst = ql * PF_SH_D + lane * 4u;
        sh_q[dst + 0u] = q4.x;
        sh_q[dst + 1u] = q4.y;
        sh_q[dst + 2u] = q4.z;
        sh_q[dst + 3u] = q4.w;
    }

    if (tid < 2u) {
        sh_any_valid[tid] = 0u;
    }
    barrier();

    const bool has_mask_f16 = (pc.flags & FLAG_HAS_MASK_F16) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask_f32 = (pc.flags & FLAG_HAS_MASK_F32) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask     = has_mask_f16 || has_mask_f32;
    const bool has_softcap  = (pc.flags & FLAG_SOFTCAP) != 0u && (pc.logit_softcap != 0.0f);
    const float slope       = compute_alibi_slope(h_q);
    const uint h_mask       = (pc.ext_mask_ne2 > 1u) ? (h_q % pc.ext_mask_ne2) : 0u;
    const uint64_t mask_head_va = pc.kq_mask_va + uint64_t(h_mask) * uint64_t(pc.ext_mask_nb2);
    const uint64_t mask_row_va  = mask_head_va + uint64_t(tok) * uint64_t(pc.ext_mask_nb1);

    const float neg_inf = -3.402823466e+38f * 0.5f;
    float m_i = neg_inf;
    float l_i = 0.0f;

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> O[16];
    for (uint dv = 0u; dv < 16u; ++dv) {
        O[dv] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    }

    const uint q_sg_off = (sg * 8u) * PF_SH_D;

    for (uint kv0 = 0u; kv0 < pc.n_kv; kv0 += PF_BK) {
        const uint tile_len = min(PF_BK, pc.n_kv - kv0);

        // 1-barrier double-buffered parallel mask tile skip (also separates previous tile's V reads!)
        const uint ping = (kv0 >> 4) & 1u;
        if (has_mask) {
            bool any_ok = false;
            for (uint step = 0u; step < 4u; ++step) {
                const uint idx = tid + step * 128u;
                const uint ql  = idx >> 4;   // 0..31
                const uint kl  = idx & 15u;  // 0..15
                if (wg_q0 + ql < pc.n_tokens && kl < tile_len) {
                    uint64_t mva = mask_head_va + uint64_t(wg_q0 + ql) * uint64_t(pc.ext_mask_nb1);
                    float mv = has_mask_f16
                        ? float(BufF16(mva).d[kv0 + kl]) * slope
                        : BufF32(mva).d[kv0 + kl] * slope;
                    if (mv > -1.0e30f) {
                        any_ok = true;
                    }
                }
            }
            if (any_ok) {
                sh_any_valid[ping] = 1u;
            }
            barrier();
            if (sh_any_valid[ping] == 0u) {
                continue;
            }
        }

        // Cooperative 128-thread load of K[kv0..+16, 0..127] into 4.25 KB sh_kv
        for (uint kl = sg; kl < PF_BK; kl += 4u) {
            f16vec4 kv_k = (kl < tile_len)
                ? load_ext_k_f16(pc.k_or_pt_va, pc.ext_k_nb1, pc.ext_k_nb2, kv0 + kl, h_kv, lane)
                : f16vec4(float16_t(0.0));
            const uint dst = kl * PF_SH_D + lane * 4u;
            sh_kv[dst + 0u] = kv_k.x;
            sh_kv[dst + 1u] = kv_k.y;
            sh_kv[dst + 2u] = kv_k.z;
            sh_kv[dst + 3u] = kv_k.w;
        }
        barrier();

        // All threads have exited mask-skip check -> race-free reset of sh_any_valid[ping]
        if (has_mask && tid == 0u) {
            sh_any_valid[ping] = 0u;
        }

        // Hardware 8x8 FP16 coopmat: S[8, 16] = Q[8, 128] x K^T[16, 128] + FP32 online softmax
        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> P0 =
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> P1 =
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
        bool sg_active = false;

        if (sg_ok) {
            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> S0 =
                coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> S1 =
                coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);

            for (uint kd = 0u; kd < 128u; kd += 8u) {
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matQ;
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matK0, matK1;
                coopMatLoad(matQ,  sh_q,  q_sg_off + kd,     PF_SH_D, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(matK0, sh_kv, 0u * PF_SH_D + kd, PF_SH_D, gl_CooperativeMatrixLayoutColumnMajor);
                coopMatLoad(matK1, sh_kv, 8u * PF_SH_D + kd, PF_SH_D, gl_CooperativeMatrixLayoutColumnMajor);
                S0 = coopMatMulAdd(matQ, matK0, S0);
                S1 = coopMatMulAdd(matQ, matK1, S1);
            }

            float s00 = S0[0];
            float s01 = S0[1];
            float s10 = S1[0];
            float s11 = S1[1];

            const uint k00 = lc0;
            const uint k01 = lc0 + 1u;
            const uint k10 = 8u + lc0;
            const uint k11 = 8u + lc0 + 1u;

            bool ok00 = tok_ok && (k00 < tile_len);
            bool ok01 = tok_ok && (k01 < tile_len);
            bool ok10 = tok_ok && (k10 < tile_len);
            bool ok11 = tok_ok && (k11 < tile_len);

            if (has_softcap) {
                s00 = pc.logit_softcap * tanh(s00);
                s01 = pc.logit_softcap * tanh(s01);
                s10 = pc.logit_softcap * tanh(s10);
                s11 = pc.logit_softcap * tanh(s11);
            }

            if (has_mask_f16) {
                BufF16 mb = BufF16(mask_row_va);
                if (ok00) { float mv = float(mb.d[kv0 + k00]) * slope; if (mv > -1.0e30f) s00 += mv; else ok00 = false; }
                if (ok01) { float mv = float(mb.d[kv0 + k01]) * slope; if (mv > -1.0e30f) s01 += mv; else ok01 = false; }
                if (ok10) { float mv = float(mb.d[kv0 + k10]) * slope; if (mv > -1.0e30f) s10 += mv; else ok10 = false; }
                if (ok11) { float mv = float(mb.d[kv0 + k11]) * slope; if (mv > -1.0e30f) s11 += mv; else ok11 = false; }
            } else if (has_mask_f32) {
                BufF32 mb = BufF32(mask_row_va);
                if (ok00) { float mv = mb.d[kv0 + k00] * slope; if (mv > -1.0e30f) s00 += mv; else ok00 = false; }
                if (ok01) { float mv = mb.d[kv0 + k01] * slope; if (mv > -1.0e30f) s01 += mv; else ok01 = false; }
                if (ok10) { float mv = mb.d[kv0 + k10] * slope; if (mv > -1.0e30f) s10 += mv; else ok10 = false; }
                if (ok11) { float mv = mb.d[kv0 + k11] * slope; if (mv > -1.0e30f) s11 += mv; else ok11 = false; }
            }

            if (!ok00) s00 = neg_inf;
            if (!ok01) s01 = neg_inf;
            if (!ok10) s10 = neg_inf;
            if (!ok11) s11 = neg_inf;

            // Row-wise max across all 16 columns of row `lr` via 2 shuffles (^1, ^8)!
            float tile_max = max(max(s00, s01), max(s10, s11));
            tile_max = max(tile_max, subgroupShuffleXor(tile_max, 1u));
            tile_max = max(tile_max, subgroupShuffleXor(tile_max, 8u));

            if (tile_max > -1.0e30f) {
                float m_new = max(m_i, tile_max);
                float alpha = (l_i > 0.0f) ? exp(m_i - m_new) : 0.0f;
                float p00   = ok00 ? exp(s00 - m_new) : 0.0f;
                float p01   = ok01 ? exp(s01 - m_new) : 0.0f;
                float p10   = ok10 ? exp(s10 - m_new) : 0.0f;
                float p11   = ok11 ? exp(s11 - m_new) : 0.0f;

                float rsum = (p00 + p01) + (p10 + p11);
                rsum += subgroupShuffleXor(rsum, 1u);
                rsum += subgroupShuffleXor(rsum, 8u);

                if (l_i > 0.0f && alpha != 1.0f) {
                    for (uint dv = 0u; dv < 16u; ++dv) {
                        O[dv][0] *= alpha;
                        O[dv][1] *= alpha;
                    }
                }
                l_i = l_i * alpha + rsum;
                m_i = m_new;

                P0[0] = float16_t(p00);
                P0[1] = float16_t(p01);
                P1[0] = float16_t(p10);
                P1[1] = float16_t(p11);
            }

            sg_active = subgroupMax(tile_max) > -1.0e30f;
        }
        barrier();

        // Cooperative 128-thread load of V[kv0..+16, 0..127] into sh_kv
        for (uint kl = sg; kl < PF_BK; kl += 4u) {
            f16vec4 kv_v = (kl < tile_len)
                ? load_ext_v_f16(pc.v_va, pc.ext_v_nb1, pc.ext_v_nb2, kv0 + kl, h_kv, lane)
                : f16vec4(float16_t(0.0));
            const uint dst = kl * PF_SH_D + lane * 4u;
            sh_kv[dst + 0u] = kv_v.x;
            sh_kv[dst + 1u] = kv_v.y;
            sh_kv[dst + 2u] = kv_v.z;
            sh_kv[dst + 3u] = kv_v.w;
        }
        barrier();

        // Hardware 8x8 FP16 coopmat: O[8, 128] += P[8, 16] x V[16, 128]
        if (sg_active) {
            for (uint dv = 0u; dv < 16u; ++dv) {
                const uint d_off = dv * 8u;
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matV0, matV1;
                coopMatLoad(matV0, sh_kv, 0u * PF_SH_D + d_off, PF_SH_D, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(matV1, sh_kv, 8u * PF_SH_D + d_off, PF_SH_D, gl_CooperativeMatrixLayoutRowMajor);
                O[dv] = coopMatMulAdd(P0, matV0, O[dv]);
                O[dv] = coopMatMulAdd(P1, matV1, O[dv]);
            }
        }
        if (!has_mask) {
            barrier();
        }
    }

    // Per-simdgroup epilogue: sink + normalize + coalesced sh_ep staging -> apply_epilogue_and_store
    if (sg_ok) {
        float scale_o = 0.0f;
        if (tok_ok) {
            bool has_sink;
            float eff_sink;
            get_sink_info(tok, h_q, has_sink, eff_sink);
            if (has_sink) {
                float mf = (l_i > 0.0f) ? max(m_i, eff_sink) : eff_sink;
                float wo = (l_i > 0.0f) ? exp(m_i - mf) : 0.0f;
                float lf = l_i * wo + exp(eff_sink - mf);
                scale_o  = (lf > 0.0f) ? (wo / lf) : 0.0f;
            } else {
                scale_o  = (l_i > 0.0f) ? (1.0f / l_i) : 0.0f;
            }
        }
        for (uint dv = 0u; dv < 16u; ++dv) {
            O[dv][0] *= scale_o;
            O[dv][1] *= scale_o;
        }

        const uint ep_base = sg * 128u;
        for (uint r = 0u; r < 8u; ++r) {
            const uint out_tok = sg_q0 + r;
            if (out_tok >= pc.n_tokens) {
                break;
            }
            if (lr == r) {
                for (uint dv = 0u; dv < 16u; ++dv) {
                    const uint d_idx = ep_base + dv * 8u + lc0;
                    sh_ep[d_idx + 0u] = O[dv][0];
                    sh_ep[d_idx + 1u] = O[dv][1];
                }
            }
            controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
            const uint o4 = ep_base + lane * 4u;
            vec4 out_v = vec4(sh_ep[o4 + 0u], sh_ep[o4 + 1u], sh_ep[o4 + 2u], sh_ep[o4 + 3u]);
            apply_epilogue_and_store(out_v, out_tok, h_q, lane);
            controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
        }
    }
}

#else // PASS_MODE == 4

// ============================================================================
// Phase 4: DSpark M=2..15 Split-K 2-SG D-Split 8x8 FP16 Coopmat Attention (D=128)
//   - 2 simdgroups (64 threads) splitting D = 64 + 64 -> ONLY O[8] (16 GPR32!)
//   - BQ = 8 Q/WG, BK = 16 KV/tile -> 8x KV reuse, <= 72 GPR32, 0:0 spills across ALL dtypes!
//   - 7.95 KB TG SRAM (4 WGs/core = 8 sgs/core!), feeds PASS_MODE=1 Phase 2 when n_splits > 1.
// ============================================================================
#define PF4_BQ   8u
#define PF4_BK   16u
#define PF4_SH_D 136u

shared float16_t sh4_q[PF4_BQ * PF4_SH_D];   // 2,176 B
shared float16_t sh4_kv[PF4_BK * PF4_SH_D];  // 4,352 B
shared float     sh4_s[2u * 128u];           // 1,024 B (S_lo + S_hi cross-sg merge)
shared float     sh4_ep[128u];               // 512 B
shared float     sh4_m[PF4_BQ];              // 32 B
shared float     sh4_l[PF4_BQ];              // 32 B
shared uint      sh4_any[2];                 // 8 B (double-buffered causal tile skip)

void main() {
    const uint lane      = gl_LocalInvocationID.x; // 0..31
    const uint sg        = gl_LocalInvocationID.y; // 0 (D=0..63) or 1 (D=64..127)
    const uint tid       = sg * 32u + lane;        // 0..63
    const uint d_sg_base = sg * 64u;
    const uint h_q       = gl_WorkGroupID.x;
    const uint wg_q0     = gl_WorkGroupID.y * PF4_BQ;
    const uint split     = gl_WorkGroupID.z;

    if (h_q >= pc.n_head_q || wg_q0 >= pc.n_tokens || split >= pc.n_splits) {
        return;
    }

    const uint gqa_ratio = pc.n_head_q / pc.n_head_kv;
    const uint h_kv      = h_q / gqa_ratio;

    const uint lr     = agx_cmat8_row(lane);   // 0..7
    const uint lc0    = agx_cmat8_col0(lane);  // 0, 2, 4, 6
    const uint tok    = wg_q0 + lr;
    const bool tok_ok = (tok < pc.n_tokens);

    // Cooperative 64-thread load of Q[wg_q0..+8, 0..127] * kq_scale -> sh4_q (4 rows/sg)
    const bool q_is_f16 = (pc.flags & FLAG_Q_F16) != 0u;
    for (uint r = sg; r < PF4_BQ; r += 2u) {
        const uint qtok = wg_q0 + r;
        f16vec4 q4 = f16vec4(float16_t(0.0));
        if (qtok < pc.n_tokens) {
            uint64_t qva = pc.q_va + uint64_t(qtok) * uint64_t(pc.q_nb1) + uint64_t(h_q) * uint64_t(pc.q_nb2);
            vec4 qf;
            if (q_is_f16) {
                uvec2 qp = BufUvec2(qva).d[lane];
                qf = vec4(unpackHalf2x16(qp.x), unpackHalf2x16(qp.y)) * pc.kq_scale;
            } else {
                BufF32 qb = BufF32(qva);
                uint o = lane * 4u;
                qf = vec4(qb.d[o + 0u], qb.d[o + 1u], qb.d[o + 2u], qb.d[o + 3u]) * pc.kq_scale;
            }
            q4 = f16vec4(clamp(qf, vec4(-65504.0f), vec4(65504.0f)));
        }
        const uint dst = r * PF4_SH_D + lane * 4u;
        sh4_q[dst + 0u] = q4.x;
        sh4_q[dst + 1u] = q4.y;
        sh4_q[dst + 2u] = q4.z;
        sh4_q[dst + 3u] = q4.w;
    }
    if (tid < 2u) {
        sh4_any[tid] = 0u;
    }
    barrier();

    const uint k_start = uint((uint64_t(split)      * uint64_t(pc.n_kv)) / uint64_t(pc.n_splits));
    const uint k_end   = uint((uint64_t(split + 1u) * uint64_t(pc.n_kv)) / uint64_t(pc.n_splits));

    const bool has_mask_f16 = (pc.flags & FLAG_HAS_MASK_F16) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask_f32 = (pc.flags & FLAG_HAS_MASK_F32) != 0u && (pc.kq_mask_va != 0ul);
    const bool has_mask     = has_mask_f16 || has_mask_f32;
    const bool has_softcap  = (pc.flags & FLAG_SOFTCAP) != 0u && (pc.logit_softcap != 0.0f);
    const float slope       = compute_alibi_slope(h_q);
    const uint h_mask       = (pc.ext_mask_ne2 > 1u) ? (h_q % pc.ext_mask_ne2) : 0u;
    const uint64_t mask_head_va = pc.kq_mask_va + uint64_t(h_mask) * uint64_t(pc.ext_mask_nb2);

    const float neg_inf = -3.402823466e+38f * 0.5f;
    float m_i = neg_inf;
    float l_i = 0.0f;

    // ONLY 8 FP32 8x8 coopmat accumulators per simdgroup (16 GPR32 -> 0:0 spills across ALL KV dtypes!)
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> O[8];
    for (uint dv = 0u; dv < 8u; ++dv) {
        O[dv] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    }

    for (uint kv0 = k_start; kv0 < k_end; kv0 += PF4_BK) {
        const uint tile_len = min(PF4_BK, k_end - kv0);
        const uint ping     = ((kv0 - k_start) >> 4) & 1u;

        // 1-barrier double-buffered 64-thread mask tile skip (also separates prev tile V reads!)
        if (has_mask) {
            bool any_ok = false;
            for (uint step = 0u; step < 2u; ++step) {
                const uint idx = tid + step * 64u;
                const uint ql  = idx >> 4;   // 0..7
                const uint kl  = idx & 15u;  // 0..15
                if (wg_q0 + ql < pc.n_tokens && kl < tile_len) {
                    uint64_t mva = mask_head_va + uint64_t(wg_q0 + ql) * uint64_t(pc.ext_mask_nb1);
                    float mv = has_mask_f16
                        ? float(BufF16(mva).d[kv0 + kl]) * slope
                        : BufF32(mva).d[kv0 + kl] * slope;
                    if (mv > -1.0e30f) {
                        any_ok = true;
                    }
                }
            }
            if (any_ok) {
                sh4_any[ping] = 1u;
            }
            barrier();
            if (sh4_any[ping] == 0u) {
                continue;
            }
        }

        // Cooperative 64-thread load of K[kv0..+16, 0..127] -> sh4_kv (8 rows/sg)
        for (uint kl = sg; kl < PF4_BK; kl += 2u) {
            f16vec4 kv_k = (kl < tile_len)
                ? load_ext_k_f16(pc.k_or_pt_va, pc.ext_k_nb1, pc.ext_k_nb2, kv0 + kl, h_kv, lane)
                : f16vec4(float16_t(0.0));
            const uint dst = kl * PF4_SH_D + lane * 4u;
            sh4_kv[dst + 0u] = kv_k.x;
            sh4_kv[dst + 1u] = kv_k.y;
            sh4_kv[dst + 2u] = kv_k.z;
            sh4_kv[dst + 3u] = kv_k.w;
        }
        barrier();

        if (has_mask && tid == 0u) {
            sh4_any[ping] = 0u;
        }

        // Split-D 8x8 coopmat: sg 0 computes D=0..63, sg 1 computes D=64..127 in parallel!
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> S0 =
            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> S1 =
            coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);

        for (uint kd = d_sg_base; kd < d_sg_base + 64u; kd += 8u) {
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matQ;
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matK0, matK1;
            coopMatLoad(matQ,  sh4_q,  kd,                 PF4_SH_D, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(matK0, sh4_kv, 0u * PF4_SH_D + kd, PF4_SH_D, gl_CooperativeMatrixLayoutColumnMajor);
            coopMatLoad(matK1, sh4_kv, 8u * PF4_SH_D + kd, PF4_SH_D, gl_CooperativeMatrixLayoutColumnMajor);
            S0 = coopMatMulAdd(matQ, matK0, S0);
            S1 = coopMatMulAdd(matQ, matK1, S1);
        }

        const uint s_off = sg * 128u + lane * 4u;
        sh4_s[s_off + 0u] = S0[0];
        sh4_s[s_off + 1u] = S0[1];
        sh4_s[s_off + 2u] = S1[0];
        sh4_s[s_off + 3u] = S1[1];
        barrier();

        // Merge S_lo + S_hi; both sgs run identical FP32 online softmax (barrier above frees sh4_kv!)
        const uint l4 = lane * 4u;
        float s00 = sh4_s[l4 + 0u] + sh4_s[128u + l4 + 0u];
        float s01 = sh4_s[l4 + 1u] + sh4_s[128u + l4 + 1u];
        float s10 = sh4_s[l4 + 2u] + sh4_s[128u + l4 + 2u];
        float s11 = sh4_s[l4 + 3u] + sh4_s[128u + l4 + 3u];

        bool ok00 = tok_ok && (lc0       < tile_len);
        bool ok01 = tok_ok && (lc0 + 1u  < tile_len);
        bool ok10 = tok_ok && (lc0 + 8u  < tile_len);
        bool ok11 = tok_ok && (lc0 + 9u  < tile_len);

        if (has_softcap) {
            s00 = pc.logit_softcap * tanh(s00);
            s01 = pc.logit_softcap * tanh(s01);
            s10 = pc.logit_softcap * tanh(s10);
            s11 = pc.logit_softcap * tanh(s11);
        }

        if (has_mask_f16) {
            BufF16 mb = BufF16(mask_head_va + uint64_t(tok) * uint64_t(pc.ext_mask_nb1));
            if (ok00) { float mv = float(mb.d[kv0 + lc0     ]) * slope; if (mv > -1.0e30f) s00 += mv; else ok00 = false; }
            if (ok01) { float mv = float(mb.d[kv0 + lc0 + 1u]) * slope; if (mv > -1.0e30f) s01 += mv; else ok01 = false; }
            if (ok10) { float mv = float(mb.d[kv0 + lc0 + 8u]) * slope; if (mv > -1.0e30f) s10 += mv; else ok10 = false; }
            if (ok11) { float mv = float(mb.d[kv0 + lc0 + 9u]) * slope; if (mv > -1.0e30f) s11 += mv; else ok11 = false; }
        } else if (has_mask_f32) {
            BufF32 mb = BufF32(mask_head_va + uint64_t(tok) * uint64_t(pc.ext_mask_nb1));
            if (ok00) { float mv = mb.d[kv0 + lc0     ] * slope; if (mv > -1.0e30f) s00 += mv; else ok00 = false; }
            if (ok01) { float mv = mb.d[kv0 + lc0 + 1u] * slope; if (mv > -1.0e30f) s01 += mv; else ok01 = false; }
            if (ok10) { float mv = mb.d[kv0 + lc0 + 8u] * slope; if (mv > -1.0e30f) s10 += mv; else ok10 = false; }
            if (ok11) { float mv = mb.d[kv0 + lc0 + 9u] * slope; if (mv > -1.0e30f) s11 += mv; else ok11 = false; }
        }

        if (!ok00) s00 = neg_inf;
        if (!ok01) s01 = neg_inf;
        if (!ok10) s10 = neg_inf;
        if (!ok11) s11 = neg_inf;

        float tile_max = max(max(s00, s01), max(s10, s11));
        tile_max = max(tile_max, subgroupShuffleXor(tile_max, 1u));
        tile_max = max(tile_max, subgroupShuffleXor(tile_max, 8u));

        if (subgroupMax(tile_max) <= -1.0e30f) {
            if (!has_mask) {
                barrier();
            }
            continue;
        }

        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> P0 =
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> P1 =
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));

        if (tile_max > -1.0e30f) {
            float m_new = max(m_i, tile_max);
            float alpha = (l_i > 0.0f) ? exp(m_i - m_new) : 0.0f;
            float p00   = ok00 ? exp(s00 - m_new) : 0.0f;
            float p01   = ok01 ? exp(s01 - m_new) : 0.0f;
            float p10   = ok10 ? exp(s10 - m_new) : 0.0f;
            float p11   = ok11 ? exp(s11 - m_new) : 0.0f;

            float rsum = (p00 + p01) + (p10 + p11);
            rsum += subgroupShuffleXor(rsum, 1u);
            rsum += subgroupShuffleXor(rsum, 8u);

            if (l_i > 0.0f && alpha != 1.0f) {
                for (uint dv = 0u; dv < 8u; ++dv) {
                    O[dv][0] *= alpha;
                    O[dv][1] *= alpha;
                }
            }
            l_i = l_i * alpha + rsum;
            m_i = m_new;

            P0[0] = float16_t(p00);
            P0[1] = float16_t(p01);
            P1[0] = float16_t(p10);
            P1[1] = float16_t(p11);
        }

        // Cooperative 64-thread load of V[kv0..+16, 0..127] -> sh4_kv (8 rows/sg)
        for (uint kl = sg; kl < PF4_BK; kl += 2u) {
            f16vec4 kv_v = (kl < tile_len)
                ? load_ext_v_f16(pc.v_va, pc.ext_v_nb1, pc.ext_v_nb2, kv0 + kl, h_kv, lane)
                : f16vec4(float16_t(0.0));
            const uint dst = kl * PF4_SH_D + lane * 4u;
            sh4_kv[dst + 0u] = kv_v.x;
            sh4_kv[dst + 1u] = kv_v.y;
            sh4_kv[dst + 2u] = kv_v.z;
            sh4_kv[dst + 3u] = kv_v.w;
        }
        barrier();

        // Split-D 8x8 coopmat: sg 0 updates D=0..63, sg 1 updates D=64..127!
        for (uint dv = 0u; dv < 8u; ++dv) {
            const uint d_off = d_sg_base + dv * 8u;
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matV0, matV1;
            coopMatLoad(matV0, sh4_kv, 0u * PF4_SH_D + d_off, PF4_SH_D, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(matV1, sh4_kv, 8u * PF4_SH_D + d_off, PF4_SH_D, gl_CooperativeMatrixLayoutRowMajor);
            O[dv] = coopMatMulAdd(P0, matV0, O[dv]);
            O[dv] = coopMatMulAdd(P1, matV1, O[dv]);
        }
        if (!has_mask) {
            barrier();
        }
    }

    if (pc.n_splits == 1u) {
        float scale_o = 0.0f;
        if (tok_ok) {
            bool has_sink;
            float eff_sink;
            get_sink_info(tok, h_q, has_sink, eff_sink);
            if (has_sink) {
                float mf = (l_i > 0.0f) ? max(m_i, eff_sink) : eff_sink;
                float wo = (l_i > 0.0f) ? exp(m_i - mf) : 0.0f;
                float lf = l_i * wo + exp(eff_sink - mf);
                scale_o  = (lf > 0.0f) ? (wo / lf) : 0.0f;
            } else {
                scale_o  = (l_i > 0.0f) ? (1.0f / l_i) : 0.0f;
            }
        }
        for (uint dv = 0u; dv < 8u; ++dv) {
            O[dv][0] *= scale_o;
            O[dv][1] *= scale_o;
        }

        for (uint r = 0u; r < PF4_BQ; ++r) {
            const uint out_tok = wg_q0 + r;
            if (out_tok >= pc.n_tokens) {
                break;
            }
            if (lr == r) {
                for (uint dv = 0u; dv < 8u; ++dv) {
                    const uint d_idx = d_sg_base + dv * 8u + lc0;
                    sh4_ep[d_idx + 0u] = O[dv][0];
                    sh4_ep[d_idx + 1u] = O[dv][1];
                }
            }
            barrier();
            if (sg == 0u) {
                const uint o4 = lane * 4u;
                vec4 out_v = vec4(sh4_ep[o4 + 0u], sh4_ep[o4 + 1u], sh4_ep[o4 + 2u], sh4_ep[o4 + 3u]);
                apply_epilogue_and_store(out_v, out_tok, h_q, lane);
            }
            barrier();
        }
    } else {
        if (sg == 0u && lc0 == 0u) {
            sh4_m[lr] = m_i;
            sh4_l[lr] = l_i;
        }
        BufF32W pb = BufF32W(pc.partial_va);
        for (uint r = 0u; r < PF4_BQ; ++r) {
            const uint out_tok = wg_q0 + r;
            if (out_tok >= pc.n_tokens) {
                break;
            }
            if (lr == r) {
                for (uint dv = 0u; dv < 8u; ++dv) {
                    const uint d_idx = d_sg_base + dv * 8u + lc0;
                    sh4_ep[d_idx + 0u] = O[dv][0];
                    sh4_ep[d_idx + 1u] = O[dv][1];
                }
            }
            barrier();
            if (sg == 0u) {
                const uint base = ((out_tok * pc.n_head_q + h_q) * pc.n_splits + split) * PARTIAL_STRIDE;
                const uint o4   = lane * 4u;
                pb.d[base + o4 + 0u] = sh4_ep[o4 + 0u];
                pb.d[base + o4 + 1u] = sh4_ep[o4 + 1u];
                pb.d[base + o4 + 2u] = sh4_ep[o4 + 2u];
                pb.d[base + o4 + 3u] = sh4_ep[o4 + 3u];
                if (lane == 0u) {
                    pb.d[base + 128u] = sh4_m[r];
                    pb.d[base + 129u] = sh4_l[r];
                }
            }
            barrier();
        }
    }
}
#endif // PASS_MODE == 3 vs 4
#endif // PASS_MODE == 0 vs 3/4

#elif PASS_MODE == 1

// Phase 2: Split-K Reduction (1 simdgroup per (h_q, tok))
void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint h_q  = gl_WorkGroupID.x;
    const uint tok  = gl_WorkGroupID.y;

    if (h_q >= pc.n_head_q || tok >= pc.n_tokens) {
        return;
    }

    bool  has_sink;
    float eff_sink;
    get_sink_info(tok, h_q, has_sink, eff_sink);

    BufF32 pb = BufF32(pc.partial_va);
    const uint head_base = (tok * pc.n_head_q + h_q) * pc.n_splits * PARTIAL_STRIDE;

    float m_tot = has_sink ? eff_sink : (-3.402823466e+38f * 0.5f);
    for (uint s = 0u; s < pc.n_splits; ++s) {
        uint off = head_base + s * PARTIAL_STRIDE;
        float ls = pb.d[off + uint(HEAD_DIM) + 1u];
        if (ls > 0.0f) {
            m_tot = max(m_tot, pb.d[off + uint(HEAD_DIM) + 0u]);
        }
    }

    float l_tot = has_sink ? exp(eff_sink - m_tot) : 0.0f;
    VEC_T o_tot = VEC_T(0.0f);
    for (uint s = 0u; s < pc.n_splits; ++s) {
        uint off = head_base + s * PARTIAL_STRIDE;
        float ls = pb.d[off + uint(HEAD_DIM) + 1u];
        if (ls > 0.0f) {
            float ms = pb.d[off + uint(HEAD_DIM) + 0u];
            float w  = exp(ms - m_tot);
            l_tot += ls * w;
            uint d_off = off + lane * ELEMS_PER_LANE;
#if HEAD_DIM == 64
            o_tot += vec2(pb.d[d_off + 0u], pb.d[d_off + 1u]) * w;
#else
            o_tot += vec4(pb.d[d_off + 0u], pb.d[d_off + 1u],
                          pb.d[d_off + 2u], pb.d[d_off + 3u]) * w;
#endif
        }
    }

    VEC_T out_v = (l_tot > 0.0f) ? (o_tot / l_tot) : VEC_T(0.0f);
    apply_epilogue_and_store(out_v, tok, h_q, lane);
}

#elif PASS_MODE == 2

// ============================================================================
// Fused KV Append Kernel (1 simdgroup per (h_kv, tok), D=128)
// ============================================================================
layout(push_constant) uniform PushAppend {
    uint64_t k_src_va;
    uint64_t v_src_va;
    uint64_t dst_k_or_pt_va;
    uint64_t dst_v_va;
    uint64_t dst_ks_va;
    uint64_t dst_vs_va;
    uint64_t pos_dst_va;
    uint64_t pos_src_va;
    uint     n_tokens;
    uint     n_head_kv;
    uint     kv_write_base;
    uint     ring_mask;
    uint     page_v_off_B;
    uint     page_ks_off_B;
    uint     page_vs_off_B;
    uint     flags;
} pa;

void store_quant_vec4(vec4 val, uint64_t data_va, uint64_t scale_va, uint head_idx, uint lane) {
#if KV_DTYPE == 0
    uint b0 = encode_e4m3_byte(val.x);
    uint b1 = encode_e4m3_byte(val.y);
    uint b2 = encode_e4m3_byte(val.z);
    uint b3 = encode_e4m3_byte(val.w);
    BufU32W(data_va).d[head_idx * 32u + lane] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
#elif KV_DTYPE == 1
    float amax = max(max(abs(val.x), abs(val.y)), max(abs(val.z), abs(val.w)));
    amax = max(amax, subgroupShuffleXor(amax, 1u));
    amax = max(amax, subgroupShuffleXor(amax, 2u));
    amax = max(amax, subgroupShuffleXor(amax, 4u));
    float d     = amax / 127.0f;
    float id    = (d != 0.0f) ? (1.0f / d) : 0.0f;
    int q0 = int(clamp(roundEven(val.x * id), -127.0f, 127.0f));
    int q1 = int(clamp(roundEven(val.y * id), -127.0f, 127.0f));
    int q2 = int(clamp(roundEven(val.z * id), -127.0f, 127.0f));
    int q3 = int(clamp(roundEven(val.w * id), -127.0f, 127.0f));
    uint packed = (uint(q0) & 0xFFu)
                | ((uint(q1) & 0xFFu) << 8)
                | ((uint(q2) & 0xFFu) << 16)
                | ((uint(q3) & 0xFFu) << 24);
    BufU32W(data_va).d[head_idx * 32u + lane] = packed;
    if ((lane & 7u) == 0u) {
        BufF16W(scale_va).d[head_idx * 4u + (lane >> 3)] = float16_t(d);
    }
#else
    uvec2 p = uvec2(packHalf2x16(val.xy), packHalf2x16(val.zw));
    BufUvec2W(data_va).d[head_idx * 32u + lane] = p;
#endif
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint h_kv = gl_WorkGroupID.x;
    const uint tok  = gl_WorkGroupID.y;

    if (h_kv >= pa.n_head_kv || tok >= pa.n_tokens) {
        return;
    }

    const uint src_head = tok * pa.n_head_kv + h_kv;
    const bool is_paged = (pa.flags & 1u) != 0u;
    const bool is_f16   = (pa.flags & 2u) != 0u;

    vec4 kv_k;
    vec4 kv_v;
    if (is_f16) {
        uvec2 pk = BufUvec2(pa.k_src_va).d[src_head * 32u + lane];
        uvec2 pv = BufUvec2(pa.v_src_va).d[src_head * 32u + lane];
        kv_k = vec4(unpackHalf2x16(pk.x), unpackHalf2x16(pk.y));
        kv_v = vec4(unpackHalf2x16(pv.x), unpackHalf2x16(pv.y));
    } else {
        BufF32 kf = BufF32(pa.k_src_va);
        BufF32 vf = BufF32(pa.v_src_va);
        uint o = src_head * 128u + lane * 4u;
        kv_k = vec4(kf.d[o + 0u], kf.d[o + 1u], kf.d[o + 2u], kf.d[o + 3u]);
        kv_v = vec4(vf.d[o + 0u], vf.d[o + 1u], vf.d[o + 2u], vf.d[o + 3u]);
    }

    const int pos = (pa.pos_src_va != 0ul)
        ? BufI32(pa.pos_src_va).d[tok]
        : int(pa.kv_write_base + tok);

    if (is_paged) {
        const uint kv_idx  = pa.kv_write_base + tok;
        const uint64_t pg  = BufU64(pa.dst_k_or_pt_va).d[kv_idx >> 6];
        const uint in_page = kv_idx & 63u;
        const uint dst_hd  = in_page * pa.n_head_kv + h_kv;
        store_quant_vec4(kv_k, pg,                           pg + uint64_t(pa.page_ks_off_B), dst_hd, lane);
        store_quant_vec4(kv_v, pg + uint64_t(pa.page_v_off_B), pg + uint64_t(pa.page_vs_off_B), dst_hd, lane);
        if (h_kv == 0u && lane == 0u && pa.pos_dst_va != 0ul) {
            BufI32W(pa.pos_dst_va).d[kv_idx] = pos;
        }
    } else {
        const uint ring_idx = uint(pos) & pa.ring_mask;
        const uint dst_hd   = ring_idx * pa.n_head_kv + h_kv;
        store_quant_vec4(kv_k, pa.dst_k_or_pt_va, pa.dst_ks_va, dst_hd, lane);
        store_quant_vec4(kv_v, pa.dst_v_va,       pa.dst_vs_va, dst_hd, lane);
        if (h_kv == 0u && lane == 0u && pa.pos_dst_va != 0ul) {
            BufI32W(pa.pos_dst_va).d[ring_idx] = pos;
        }
    }
}

#endif // PASS_MODE
