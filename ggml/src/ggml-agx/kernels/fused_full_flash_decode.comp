vec4 load_ext_k(uint64_t base_va, uint nb1, uint nb2, uint kv_idx, uint h_kv, uint lane) {
    const uint64_t row_va = base_va + uint64_t(kv_idx) * uint64_t(nb1) + uint64_t(h_kv) * uint64_t(nb2);
#if KV_DTYPE_K == 0
    return decode_e4m3_u32(BufU32(row_va).d[lane]);
#elif KV_DTYPE_K == 2
    uvec2 p = BufUvec2(row_va).d[lane];
