#elif KV_DTYPE_K == 3
    BufF32 fb = BufF32(row_va);
    uint o = lane * 4u;
    return vec4(fb.d[o + 0u], fb.d[o + 1u], fb.d[o + 2u], fb.d[o + 3u]);
#elif KV_DTYPE_K == 4
    // ggml block_q8_0 (34B = 2B fp16 d + 32B int8 qs): 2x 2B-aligned u16 loads + magic-bias decode!
    uint blk = lane >> 3;
    uint sub16 = (lane & 7u) * 2u;
    uint64_t blk_va = row_va + uint64_t(blk) * 34ul;
    float sc = float(BufF16(blk_va).d[0]);
    BufU16 qb = BufU16(blk_va + 2ul);
