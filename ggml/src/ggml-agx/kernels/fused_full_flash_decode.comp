#if HEAD_DIM == 128
vec4 load_paged_kv(uint64_t page_va, uint v_or_k_off_B, uint sc_off_B, uint in_page, uint h_kv, uint lane) {
    const uint head_idx = in_page * pc.n_head_kv + h_kv;
    const uint64_t data_va = page_va + uint64_t(v_or_k_off_B);
#if KV_DTYPE_K == 0
    uint packed = BufU32(data_va).d[head_idx * 32u + lane];
    return decode_e4m3_u32(packed);
#elif KV_DTYPE_K == 1
    uint packed = BufU32(data_va).d[head_idx * 32u + lane];
    float sc = float(BufF16(page_va + uint64_t(sc_off_B)).d[head_idx * 4u + (lane >> 3)]);
    return vec4(agx_q8_u32_magic_to_f16vec4(packed)) * sc;
#elif KV_DTYPE_K == 2
    uvec2 p = BufUvec2(data_va).d[head_idx * 32u + lane];
    return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y));
#else
    BufF32 fb = BufF32(data_va);
    uint off = head_idx * 128u + lane * 4u;
    return vec4(fb.d[off + 0u], fb.d[off + 1u], fb.d[off + 2u], fb.d[off + 3u]);
#endif
}
#else
vec2 load_paged_kv(uint64_t page_va, uint v_or_k_off_B, uint sc_off_B, uint in_page, uint h_kv, uint lane) {
    const uint head_idx = in_page * pc.n_head_kv + h_kv;
    const uint64_t data_va = page_va + uint64_t(v_or_k_off_B);
#if KV_DTYPE_K == 0
    uint packed = uint(BufU16(data_va).d[head_idx * 32u + lane]);
    return decode_e4m3_u16(packed);
#elif KV_DTYPE_K == 1
    uint packed = uint(BufU16(data_va).d[head_idx * 32u + lane]);
    float sc = float(BufF16(page_va + uint64_t(sc_off_B)).d[head_idx * 2u + (lane >> 4)]);
    return vec2(agx_q8_u16_magic_to_f16vec2(packed)) * sc;
#elif KV_DTYPE_K == 2
    uint p = BufU32(data_va).d[head_idx * 32u + lane];
    return unpackHalf2x16(p);
#else
    BufF32 fb = BufF32(data_va);
    uint off = head_idx * 64u + lane * 2u;
    return vec2(fb.d[off + 0u], fb.d[off + 1u]);
#endif
}
#endif

#if HEAD_DIM == 64
vec2 load_ext_k(uint64_t base_va, uint nb1, uint nb2, uint kv_idx, uint h_kv, uint lane) {
    const uint64_t row_va = base_va + uint64_t(kv_idx) * uint64_t(nb1) + uint64_t(h_kv) * uint64_t(nb2);
#if KV_DTYPE_K == 0
    return decode_e4m3_u16(uint(BufU16(row_va).d[lane]));
#elif KV_DTYPE_K == 2
    return unpackHalf2x16(BufU32(row_va).d[lane]);
#elif KV_DTYPE_K == 3
    BufF32 fb = BufF32(row_va);
    uint o = lane * 2u;
    return vec2(fb.d[o + 0u], fb.d[o + 1u]);
#elif KV_DTYPE_K == 4
    // ggml block_q8_0 (34B = 2B fp16 d + 32B int8 qs): 2B-aligned u16 load + magic-bias decode!
    uint blk = lane >> 4;
    uint sub16 = lane & 15u;
    uint64_t blk_va = row_va + uint64_t(blk) * 34ul;
    float sc = float(BufF16(blk_va).d[0]);
    uint p16 = uint(BufU16(blk_va + 2ul).d[sub16]);
    return vec2(agx_q8_u16_magic_to_f16vec2(p16)) * sc;
#else
    return unpackHalf2x16(BufU32(row_va).d[lane]);
#endif
}

vec2 load_ext_v(uint64_t base_va, uint nb1, uint nb2, uint kv_idx, uint h_kv, uint lane) {
    const uint64_t row_va = base_va + uint64_t(kv_idx) * uint64_t(nb1) + uint64_t(h_kv) * uint64_t(nb2);
#if KV_DTYPE_V == 0
    return decode_e4m3_u16(uint(BufU16(row_va).d[lane]));
#elif KV_DTYPE_V == 2
    return unpackHalf2x16(BufU32(row_va).d[lane]);
#elif KV_DTYPE_V == 3
    BufF32 fb = BufF32(row_va);
    uint o = lane * 2u;
    return vec2(fb.d[o + 0u], fb.d[o + 1u]);
#elif KV_DTYPE_V == 4
    uint blk = lane >> 4;
