    barrier();
    float rms = s_red[0];

    for (uint i4 = tid; i4 < D4; i4 += 256u) {
        BufVec4(d_va).v[i4] = (ConstBufVec4(s_va).v[i4] * rms) * ConstBufVec4(nw_va).v[i4];
