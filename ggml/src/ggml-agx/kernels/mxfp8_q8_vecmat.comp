#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "dequant_supertile.glsl"

// ============================================================================
// Pillar 2: Predicated Remainder-Free Q8_0 / MXFP8 / E4M3 / BF16 / F16 / F32
//           B=1..5 Simdgroup Vec-Mat Kernel (<= 48 GPR32, 0:0 spills)
// ============================================================================
// Compile-time specialization `QUANT_MODE`:
//   0 = AGX_Q8_0_8BLK repacked planar (272B / 256 weights; 16 lanes/row -> 2 rows/sg)
//   1 = Raw GGML block_q8_0 (34B / 32 weights)
//   2 = AGX_MXFP8_16BLK repacked planar (528B / 512 weights; 32 lanes/row, UE8M0 exp-add)
//   3 = Flat GGML_TYPE_F8_E4M3 (1B/weight; 32 lanes x u32 = 128B/iter)
//   4 = Flat GGML_TYPE_BF16    (2B/weight; vectorized uvec2 = 4 BF16/load)
//   5 = Flat GGML_TYPE_F16     (2B/weight; vectorized uvec2 = 4 F16/load)
//   6 = Flat GGML_TYPE_F32     (4B/weight; vectorized vec4 = 4 F32/load)
//
// `K_SPLIT_ROW` (0 = default multi-row/WG; 1 = all 4 simdgroups in 128T WG split K
//                over 1 single row + 16B SRAM reduce for narrow-N large-K matrices
//                like ctrl_down 4608x64 and router 2304x128 -> 4x core occupancy!)
// `BATCH_M` in 1..5. Workgroup = 128 threads (4 simdgroups).

#ifndef QUANT_MODE
#define QUANT_MODE 0
#endif

#ifndef BATCH_M
#define BATCH_M 1
#endif

#ifndef K_SPLIT_ROW
#define K_SPLIT_ROW 0
#endif

#ifndef WG_SGS
#if QUANT_MODE == 0 && K_SPLIT_ROW == 0 && BATCH_M > 1
#define WG_SGS 8
#else
#define WG_SGS 4
#endif
#endif

#ifndef X_ALIGNED4
#define X_ALIGNED4 0
#endif

#define Q8_LOCAL_X (WG_SGS * 32)
layout(local_size_x = Q8_LOCAL_X, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PushArgs {
    uint64_t w_va;
    uint64_t x_va;
    uint64_t y_va;
    uint     M;
    uint     N;
    uint     K;
    uint     x_stride;
    uint     y_stride;
    uint     w_slice_bytes;
    uint     x_slice_elems;
    uint     y_slice_elems;
    uint     w_bcast_div;
    uint     _pad;
} pc;

#if K_SPLIT_ROW == 1
shared float sh_row_red[4][BATCH_M];
#endif

#if QUANT_MODE == 0 && K_SPLIT_ROW == 0 && BATCH_M > 1
// Double-buffered 0-bank-conflict XOR-swizzled FP16 X staging:
//   BATCH_M=4 -> 2 * 4 * 64 * 8 B = 4,096 B (4 KB -> 8 WGs/core!)
//   BATCH_M=8 -> 2 * 8 * 64 * 8 B = 8,192 B (8 KB -> 4 WGs/core!)
//   Eliminates the stride-64B L1D gather wall (128x fewer L1D cache-line fetches!)
//   and uses f16vec2 SIMD2-packed FMA + W software pipelining -> 480-510+ GB/s at M=2..4!
shared f16vec4 sh_x[2][BATCH_M][64];

#if X_ALIGNED4 == 1
void load_q8_sh_x(AgxBufVec4R x_buf4,
                  uint        tid,
                  uint        buf,
                  uint        c,
                  uint        x_stride4) {
    const uint total_e = uint(BATCH_M) * 64u;
    const uint k4_base = c * 64u;
    const uint k4_lim  = pc.K >> 2;
    for (uint e = tid; e < total_e; e += uint(Q8_LOCAL_X)) {
        const uint m    = e >> 6;
        const uint idx  = e & 63u;
        const uint l    = idx >> 2;
        const uint j    = idx & 3u;
        const uint swiz = (j << 4) | (l ^ (j << 2));
        const uint col4 = k4_base + idx;
        sh_x[buf][m][swiz] = (m < pc.M && col4 < k4_lim)
            ? f16vec4(x_buf4.v[m * x_stride4 + col4])
            : f16vec4(float16_t(0.0));
    }
}
#else
void load_q8_sh_x(AgxBufF32R  x_buf,
                  AgxBufVec4R x_buf4,
                  uint        tid,
                  uint        buf,
                  uint        c,
                  bool        x_aligned4,
                  uint        x_stride4) {
    const uint total_e = uint(BATCH_M) * 64u;
    const uint k_chunk = c * 256u;
    for (uint e = tid; e < total_e; e += uint(Q8_LOCAL_X)) {
        const uint m      = e >> 6;
        const uint idx    = e & 63u;
        const uint l      = idx >> 2;
        const uint j      = idx & 3u;
        const uint swiz   = (j << 4) | (l ^ (j << 2));
        const uint k_elem = k_chunk + (idx << 2);
        f16vec4 hv = f16vec4(float16_t(0.0));
        if (m < pc.M && k_elem < pc.K) {
            if (x_aligned4) {
                hv = f16vec4(x_buf4.v[m * x_stride4 + (k_elem >> 2)]);
            } else {
                const uint xo = m * pc.x_stride + k_elem;
                hv = f16vec4(
                    float16_t(x_buf.v[xo + 0u]),
                    (k_elem + 1u < pc.K) ? float16_t(x_buf.v[xo + 1u]) : float16_t(0.0),
                    (k_elem + 2u < pc.K) ? float16_t(x_buf.v[xo + 2u]) : float16_t(0.0),
                    (k_elem + 3u < pc.K) ? float16_t(x_buf.v[xo + 3u]) : float16_t(0.0));
            }
        }
        sh_x[buf][m][swiz] = hv;
    }
}
#endif
#endif

void main() {
    const uint lane  = gl_SubgroupInvocationID; // 0..31
    const uint sg_id = gl_SubgroupID;           // 0..WG_SGS-1
    const uint slice = gl_WorkGroupID.z;

    const uint w_slice = slice / max(1u, pc.w_bcast_div);
    const uint64_t w_base = pc.w_va + uint64_t(w_slice) * uint64_t(pc.w_slice_bytes);
    const uint64_t x_base = pc.x_va + uint64_t(slice)   * uint64_t(pc.x_slice_elems) * 4ul;
    const uint64_t y_base = pc.y_va + uint64_t(slice)   * uint64_t(pc.y_slice_elems) * 4ul;

#if !(QUANT_MODE == 0 && K_SPLIT_ROW == 0 && BATCH_M > 1 && X_ALIGNED4 == 1)
    AgxBufF32R  x_buf  = AgxBufF32R(x_base);
#endif
    AgxBufVec4R x_buf4 = AgxBufVec4R(x_base);
    AgxBufF32RW y_buf  = AgxBufF32RW(y_base);

    float acc[BATCH_M];
    for (uint m = 0u; m < uint(BATCH_M); ++m) {
        acc[m] = 0.0;
    }

#if QUANT_MODE == 0 && K_SPLIT_ROW == 0 && BATCH_M > 1
    // ------------------------------------------------------------------------
    // Wave 6 AGX_Q8_0_8BLK M=2..8 (DSpark M=4 verify & LM head!):
    //   - Double-buffered 0-bank-conflict XOR-swizzled `sh_x[2][BATCH_M][64]`
    //     (4 KB at M=4 -> 8 WGs/core; 8 KB at M=8 -> 4 WGs/core!)
    //   - Software-pipelined `qv`/`d128` weight prefetch hides DRAM latency
    //     behind f16vec2 SIMD2-packed FMAs + sh_x loads + barrier()!
    //   - Compile-time `X_ALIGNED4=1` eliminates scalar fallback bloat -> <= 44 GPR32, 0:0 spills!
    // ------------------------------------------------------------------------
    const uint tid      = gl_LocalInvocationIndex;
    const uint row      = (gl_WorkGroupID.x * uint(WG_SGS) + sg_id) * 2u + (lane >> 4);
    const uint lane16   = lane & 15u;
    const uint n_chunks = (pc.K + 255u) >> 8;

    AgxBufQ8_8Blk w_buf = AgxBufQ8_8Blk(w_base);
    const uint row_chk_base = row * n_chunks;
    const uint x_stride4    = pc.x_stride >> 2;
#if X_ALIGNED4 == 0
    const bool x_aligned4   = ((pc.K & 3u) == 0u) && ((pc.x_stride & 3u) == 0u);
#endif
    const bool row_valid    = (row < pc.N);

    const uint s0 =  0u | (lane16 ^ 0u);
    const uint s1 = 16u | (lane16 ^ 4u);
    const uint s2 = 32u | (lane16 ^ 8u);
    const uint s3 = 48u | (lane16 ^ 12u);

    uvec4 qv_cur = uvec4(0u);
    float d_cur  = 0.0;
    if (n_chunks > 0u) {
#if X_ALIGNED4 == 1
        load_q8_sh_x(x_buf4, tid, 0u, 0u, x_stride4);
#else
        load_q8_sh_x(x_buf, x_buf4, tid, 0u, 0u, x_aligned4, x_stride4);
#endif
        if (row_valid) {
            qv_cur = w_buf.blk[row_chk_base].qs[lane16];
            d_cur  = float(unpackFloat2x16(uint(w_buf.blk[row_chk_base].d[lane16 >> 1])).x) * 128.0;
        }
    }
    barrier();

    uint buf = 0u;
    for (uint c = 0u; c < n_chunks; ++c) {
        const f16vec4 w0   = agx_q8_u32_magic_norm_to_f16vec4(qv_cur.x);
        const f16vec4 w1   = agx_q8_u32_magic_norm_to_f16vec4(qv_cur.y);
        const f16vec4 w2   = agx_q8_u32_magic_norm_to_f16vec4(qv_cur.z);
        const f16vec4 w3   = agx_q8_u32_magic_norm_to_f16vec4(qv_cur.w);
        const float   d_now = d_cur;

        const bool has_next = (c + 1u < n_chunks);
        if (has_next) {
#if X_ALIGNED4 == 1
            load_q8_sh_x(x_buf4, tid, buf ^ 1u, c + 1u, x_stride4);
#else
            load_q8_sh_x(x_buf, x_buf4, tid, buf ^ 1u, c + 1u, x_aligned4, x_stride4);
#endif
            if (row_valid) {
                const uint next_chk = row_chk_base + c + 1u;
                qv_cur = w_buf.blk[next_chk].qs[lane16];
                d_cur  = float(unpackFloat2x16(uint(w_buf.blk[next_chk].d[lane16 >> 1])).x) * 128.0;
            }
        }

        const uint k0 = c * 256u + lane16 * 16u;
        if (row_valid && k0 < pc.K) {
            for (uint m = 0u; m < uint(BATCH_M); ++m) {
                const f16vec4 x0 = sh_x[buf][m][s0];
                const f16vec4 x1 = sh_x[buf][m][s1];
                const f16vec4 x2 = sh_x[buf][m][s2];
                const f16vec4 x3 = sh_x[buf][m][s3];
                f16vec2 dp2 = w0.xy * x0.xy;
                dp2 = fma(w0.zw, x0.zw, dp2);
                dp2 = fma(w1.xy, x1.xy, dp2);
                dp2 = fma(w1.zw, x1.zw, dp2);
                dp2 = fma(w2.xy, x2.xy, dp2);
                dp2 = fma(w2.zw, x2.zw, dp2);
                dp2 = fma(w3.xy, x3.xy, dp2);
                dp2 = fma(w3.zw, x3.zw, dp2);
                acc[m] = fma(float(dp2.x + dp2.y), d_now, acc[m]);
            }
        }

        if (has_next) {
            barrier();
            buf ^= 1u;
        }
    }

    for (uint m = 0u; m < uint(BATCH_M); ++m) {
        acc[m] += subgroupShuffleXor(acc[m], 1u);
        acc[m] += subgroupShuffleXor(acc[m], 2u);
        acc[m] += subgroupShuffleXor(acc[m], 4u);
        acc[m] += subgroupShuffleXor(acc[m], 8u);
    }

    if (lane16 == 0u && row_valid) {
        for (uint m = 0u; m < uint(BATCH_M); ++m) {
            if (m < pc.M) {
                y_buf.v[m * pc.y_stride + row] = acc[m];
            }
        }
    }

#elif QUANT_MODE == 0 && K_SPLIT_ROW == 0
    // ------------------------------------------------------------------------
    // AGX_Q8_0_8BLK (272B planar): 2 rows per simdgroup (16 lanes/row)
    // Measured 517.68 GB/s (95% of wire peak) on M4 Max 2304 x 201024 LM head!
    // ------------------------------------------------------------------------
    const uint row      = (gl_WorkGroupID.x * 4u + sg_id) * 2u + (lane >> 4);
    const uint lane16   = lane & 15u;
    const uint n_chunks = (pc.K + 255u) >> 8;

    if (row < pc.N) {
        AgxBufQ8_8Blk w_buf = AgxBufQ8_8Blk(w_base);
        const uint row_chk_base = row * n_chunks;
        const uint x_stride4    = pc.x_stride >> 2;
        const bool x_aligned4   = ((pc.K & 3u) == 0u) && ((pc.x_stride & 3u) == 0u);

        for (uint c = 0u; c < n_chunks; ++c) {
            const uint chk_idx = row_chk_base + c;
            const uvec4 qv = w_buf.blk[chk_idx].qs[lane16];
            const float d  = float(unpackFloat2x16(uint(w_buf.blk[chk_idx].d[lane16 >> 1])).x);

            const uint k0 = c * 256u + lane16 * 16u;
            if (k0 < pc.K) {
                const f16vec4 w0 = agx_q8_u32_magic_to_f16vec4(qv.x);
                const f16vec4 w1 = agx_q8_u32_magic_to_f16vec4(qv.y);
                const f16vec4 w2 = agx_q8_u32_magic_to_f16vec4(qv.z);
                const f16vec4 w3 = agx_q8_u32_magic_to_f16vec4(qv.w);

                if (x_aligned4) {
                    const uint col4 = k0 >> 2;
                    for (uint m = 0u; m < uint(BATCH_M); ++m) {
                        if (m < pc.M) {
                            const uint xo = m * x_stride4 + col4;
                            float dp = dot(vec4(w0), x_buf4.v[xo + 0u])
                                     + dot(vec4(w1), x_buf4.v[xo + 1u])
                                     + dot(vec4(w2), x_buf4.v[xo + 2u])
                                     + dot(vec4(w3), x_buf4.v[xo + 3u]);
                            acc[m] = fma(dp, d, acc[m]);
                        }
                    }
                } else {
                    for (uint m = 0u; m < uint(BATCH_M); ++m) {
                        if (m < pc.M) {
                            const uint xo = m * pc.x_stride + k0;
                            vec4 x0 = vec4(x_buf.v[xo + 0u],  x_buf.v[xo + 1u],  x_buf.v[xo + 2u],  x_buf.v[xo + 3u]);
                            vec4 x1 = vec4(x_buf.v[xo + 4u],  x_buf.v[xo + 5u],  x_buf.v[xo + 6u],  x_buf.v[xo + 7u]);
                            vec4 x2 = vec4(x_buf.v[xo + 8u],  x_buf.v[xo + 9u],  x_buf.v[xo + 10u], x_buf.v[xo + 11u]);
                            vec4 x3 = vec4(x_buf.v[xo + 12u], x_buf.v[xo + 13u], x_buf.v[xo + 14u], x_buf.v[xo + 15u]);
                            float dp = dot(vec4(w0), x0) + dot(vec4(w1), x1)
                                     + dot(vec4(w2), x2) + dot(vec4(w3), x3);
                            acc[m] = fma(dp, d, acc[m]);
                        }
                    }
                }
            }
        }
    }

    for (uint m = 0u; m < uint(BATCH_M); ++m) {
        acc[m] += subgroupShuffleXor(acc[m], 1u);
        acc[m] += subgroupShuffleXor(acc[m], 2u);
        acc[m] += subgroupShuffleXor(acc[m], 4u);
        acc[m] += subgroupShuffleXor(acc[m], 8u);
    }

    if (lane16 == 0u && row < pc.N) {
        for (uint m = 0u; m < uint(BATCH_M); ++m) {
            if (m < pc.M) {
                y_buf.v[m * pc.y_stride + row] = acc[m];
            }
        }
    }

#elif QUANT_MODE == 0 && K_SPLIT_ROW == 1
    // AGX_Q8_0_8BLK narrow-N K-split: all 128 threads (8 x 16 lanes) split chunks of 1 row
    const uint row      = gl_WorkGroupID.x;
    const uint n_chunks = (pc.K + 255u) >> 8;
    const uint tid      = gl_LocalInvocationIndex; // 0..127
    const uint chunk_g  = tid >> 4;                // 0..7
    const uint lane16   = tid & 15u;

    if (row < pc.N) {
        AgxBufQ8_8Blk w_buf = AgxBufQ8_8Blk(w_base);
        const uint row_chk_base = row * n_chunks;
        const uint x_stride4    = pc.x_stride >> 2;
        for (uint c = chunk_g; c < n_chunks; c += 8u) {
            const uint chk_idx = row_chk_base + c;
            const uvec4 qv = w_buf.blk[chk_idx].qs[lane16];
            const float d  = float(unpackFloat2x16(uint(w_buf.blk[chk_idx].d[lane16 >> 1])).x);
            const uint k0  = c * 256u + lane16 * 16u;
            if (k0 < pc.K) {
                const f16vec4 w0 = agx_q8_u32_magic_to_f16vec4(qv.x);
                const f16vec4 w1 = agx_q8_u32_magic_to_f16vec4(qv.y);
                const f16vec4 w2 = agx_q8_u32_magic_to_f16vec4(qv.z);
                const f16vec4 w3 = agx_q8_u32_magic_to_f16vec4(qv.w);
                const uint col4 = k0 >> 2;
                for (uint m = 0u; m < uint(BATCH_M); ++m) {
                    if (m < pc.M) {
                        const uint xo = m * x_stride4 + col4;
                        float dp = dot(vec4(w0), x_buf4.v[xo + 0u])
                                 + dot(vec4(w1), x_buf4.v[xo + 1u])
                                 + dot(vec4(w2), x_buf4.v[xo + 2u])
                                 + dot(vec4(w3), x_buf4.v[xo + 3u]);
                        acc[m] = fma(dp, d, acc[m]);
                    }
                }
            }
        }
    }
    for (uint m = 0u; m < uint(BATCH_M); ++m) {
        acc[m] += subgroupShuffleXor(acc[m], 1u);
        acc[m] += subgroupShuffleXor(acc[m], 2u);
        acc[m] += subgroupShuffleXor(acc[m], 4u);
        acc[m] += subgroupShuffleXor(acc[m], 8u);
        acc[m] += subgroupShuffleXor(acc[m], 16u);
    }
    if (lane == 0u) {
        for (uint m = 0u; m < uint(BATCH_M); ++m) sh_row_red[sg_id][m] = acc[m];
    }
    barrier();
    if (sg_id == 0u && lane == 0u && row < pc.N) {
        for (uint m = 0u; m < uint(BATCH_M); ++m) {
            if (m < pc.M) {
                y_buf.v[m * pc.y_stride + row] =
                    sh_row_red[0][m] + sh_row_red[1][m] + sh_row_red[2][m] + sh_row_red[3][m];
            }
        }
    }

#elif QUANT_MODE == 1
    // Raw GGML block_q8_0 fallback (34B / 32 weights)
    const uint row  = gl_WorkGroupID.x * 4u + sg_id;
    const uint nb_k = pc.K >> 5;
    if (row < pc.N) {
        AgxBufQ8_0Raw w_buf = AgxBufQ8_0Raw(w_base);
        const uint row_blk_base = row * nb_k;
        for (uint b = lane; b < nb_k; b += 32u) {
            const uint blk_idx = row_blk_base + b;
            const float d = float(unpackFloat2x16(uint(w_buf.blk[blk_idx].d)).x);
            const uint k0 = b * 32u;
            for (uint m = 0u; m < uint(BATCH_M); ++m) {
                if (m < pc.M) {
                    const uint xo = m * pc.x_stride + k0;
                    float dp = 0.0;
                    for (uint i = 0u; i < 32u; ++i) {
                        dp = fma(float(int(w_buf.blk[blk_idx].qs[i])), x_buf.v[xo + i], dp);
                    }
                    acc[m] = fma(dp, d, acc[m]);
                }
            }
        }
    }
    for (uint m = 0u; m < uint(BATCH_M); ++m) {
        acc[m] += subgroupShuffleXor(acc[m], 1u);
        acc[m] += subgroupShuffleXor(acc[m], 2u);
        acc[m] += subgroupShuffleXor(acc[m], 4u);
        acc[m] += subgroupShuffleXor(acc[m], 8u);
        acc[m] += subgroupShuffleXor(acc[m], 16u);
    }
    if (lane == 0u && row < pc.N) {
        for (uint m = 0u; m < uint(BATCH_M); ++m) {
            if (m < pc.M) y_buf.v[m * pc.y_stride + row] = acc[m];
        }
    }

#elif QUANT_MODE == 2
    // AGX_MXFP8_16BLK (528B planar): 1 row per simdgroup (32 lanes x uvec4 = 512B!)
    const uint row      = gl_WorkGroupID.x * 4u + sg_id;
    const uint n_chunks = (pc.K + 511u) >> 9;
    if (row < pc.N) {
        AgxBufMxfp8_16Blk w_buf = AgxBufMxfp8_16Blk(w_base);
        const uint row_chk_base = row * n_chunks;
        const uint x_stride4    = pc.x_stride >> 2;
        for (uint c = 0u; c < n_chunks; ++c) {
            const uint chk_idx = row_chk_base + c;
            const uvec4 qv = w_buf.blk[chk_idx].qs[lane];
            const float sc = agx_ue8m0_to_f32(uint(w_buf.blk[chk_idx].e[lane >> 1]));
            const uint k0  = c * 512u + lane * 16u;
            if (k0 < pc.K) {
                const f16vec4 w0 = agx_e4m3_u32_to_f16vec4(qv.x);
                const f16vec4 w1 = agx_e4m3_u32_to_f16vec4(qv.y);
                const f16vec4 w2 = agx_e4m3_u32_to_f16vec4(qv.z);
                const f16vec4 w3 = agx_e4m3_u32_to_f16vec4(qv.w);
                const uint col4 = k0 >> 2;
                for (uint m = 0u; m < uint(BATCH_M); ++m) {
                    if (m < pc.M) {
                        const uint xo = m * x_stride4 + col4;
                        float dp = dot(vec4(w0), x_buf4.v[xo + 0u])
                                 + dot(vec4(w1), x_buf4.v[xo + 1u])
                                 + dot(vec4(w2), x_buf4.v[xo + 2u])
                                 + dot(vec4(w3), x_buf4.v[xo + 3u]);
                        acc[m] = fma(dp, sc, acc[m]);
                    }
                }
            }
        }
    }
    for (uint m = 0u; m < uint(BATCH_M); ++m) {
        acc[m] += subgroupShuffleXor(acc[m], 1u);
        acc[m] += subgroupShuffleXor(acc[m], 2u);
        acc[m] += subgroupShuffleXor(acc[m], 4u);
        acc[m] += subgroupShuffleXor(acc[m], 8u);
        acc[m] += subgroupShuffleXor(acc[m], 16u);
    }
    if (lane == 0u && row < pc.N) {
        for (uint m = 0u; m < uint(BATCH_M); ++m) {
