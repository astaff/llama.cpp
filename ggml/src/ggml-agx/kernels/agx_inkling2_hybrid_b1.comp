#version 450

// ============================================================================
// Wave 5 Pillar 3 (Pass-5): agx_inkling2_hybrid_b1.comp
// Lean <= 64-GPR32 Persistent 40-WG SENSE_BARRIER Hybrid Super-Stages for B=1
// ============================================================================
// Pairs with full-wire-speed (517/475 GB/s, 24-32 SGs/core) weight-streaming ops
// (`agx_w5_attn_in_b1`, `Wo`, `MoE gate_up`, `MoE down`) while collapsing ALL
// ~680 small, control, prep, FlashAttn, router, and post-conv ops into 3 lean
// 40-WG x 256T (100% 40-core co-resident) SENSE_BARRIER stages:
//
//   HYBRID_MODE == 0 (local_size_x = 256, KV_Q8 = 0 | 1, ~6.8 KB SRAM, <= 60 GPR32):
//     Fused qkv_prep_store (Q in SRAM + R + 256T/head RelBias -> sh_mask[1024]
//     pinned in TG SRAM for n_kv <= 1024 + K/V conv/state/KV-store)
//     -> sense_barrier -> 24-WG (8 sgs/head) FlashAttn + inline FWHT128 + Qgate!
//
//   HYBRID_MODE == 1 (local_size_x = 256, HAS_LOOP = 0 | 1, ~10.8 KB SRAM):
//     Fused stage_post_attn (+ folded FFN ctrl norm_cat!) -> sense_barrier ->
//     [optional FFN loop ctrl: 1-wave 40-core 4-SG/row ctrl_down[3] -> bar ->
//      4x-prefetch ctrl_up_mix -> bar -> rmsnorm -> bar]
//     -> 1-wave 40-core 2-SG/row 3x-unrolled router GEMM -> sense_barrier -> WG 0 bitonic Top-8!
//
//   HYBRID_MODE == 2 (local_size_x = 256, ~9.7 KB SRAM):
//     Fused stage_post_ffn[v] -> sense_barrier -> pass[v+1] QKV loop ctrl
//     (msg_mix + norm_cat -> bar -> 1-wave 40-core 1-SG/row 4x-unrolled 3x ctrl_down
//      [0 WG barriers!] -> bar -> single-barrier flat 216-tile 3x ctrl_up_mix
//      -> bar -> batch_rmsnorm)!
// ============================================================================

