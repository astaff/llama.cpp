        const uint n_chunks  = (pc.K + 255u) >> 8;
        const uint w_sub     = lc0 >> 2;
        const uint p_shift   = ((lc0 >> 1) & 1u) << 4;
        const uint gn_base   = sg_n0 + lr;
        const uint w_row0    = gn_base * n_chunks;
        const uint w_row_inc = 8u * n_chunks;

        if (x_vec4_ok) {
            uint buf_idx = 0u;
            for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
                const uint sh_off = buf_idx * SH_X_SLAB;
                const uint kb4    = k_base >> 2;

                for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                    const MAT_VEC4 xv = (gm0 + s * X_ROWS_STEP < pc.M)
                        ? MAT_VEC4(x_buf4.v[x_off0 + s * x_step_s + kb4])
                        : MAT_VEC4(MAT_T(0.0));
                    store_x_vec4_to_sh_T(sh_off, sh_dst0 + s * X_ROWS_STEP, xv);
                }

                const uint c   = k_base >> 8;
                const uint blk = (k_base >> 5) & 7u;
                const uint vi0 = blk * 2u;
                uvec2     w_cur[SG_TILES_N];
                float16_t sc_cur[SG_TILES_N];
                for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                    if (gn_base + in_t * 8u < pc.N) {
                        const uint chk_idx = w_row0 + in_t * w_row_inc + c;
                        sc_cur[in_t] = unpackFloat2x16(uint(w_buf.blk[chk_idx].d[blk])).x;
                        w_cur[in_t]  = uvec2(pack_lane_q8_u32(w_buf.blk[chk_idx].qs[vi0],      w_sub, p_shift),
                                             pack_lane_q8_u32(w_buf.blk[chk_idx].qs[vi0 + 1u], w_sub, p_shift));
                    } else {
                        sc_cur[in_t] = float16_t(0.0);
                        w_cur[in_t]  = uvec2(0u);
                    }
                }
                barrier();

                for (uint ks = 0u; ks < 4u; ++ks) {
                    coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        const uint w_word = (ks < 2u) ? w_cur[in_t].x : w_cur[in_t].y;
                        const uint w16    = ((ks & 1u) == 0u) ? (w_word & 0xFFFFu) : (w_word >> 16);
                        const f16vec2 q2  = agx_q8_u16_magic_to_f16vec2(w16);
    #if PREC_F32 == 1
                        const vec2 wp     = vec2(q2) * float(sc_cur[in_t]);
    #else
                        const f16vec2 wp  = q2 * sc_cur[in_t];
    #endif
                        matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                        matA[in_t][0] = wp.x;
                        matA[in_t][1] = wp.y;
                    }
                    const uint ks_row_off = sh_off + (ks * 8u) * SH_X_STRIDE + sg_m_off;
                    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                        coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                            acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                        }
                    }
                }
                buf_idx ^= 1u;
            }
        } else {
            AgxBufF32R x_buf = AgxBufF32R(x_base);
            uint buf_idx = 0u;
            for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
                const uint sh_off = buf_idx * SH_X_SLAB;
                load_sh_x_scalar_T(x_buf, tid, wg_m0, sh_off, k_base);
                barrier();
                const uint c   = k_base >> 8;
                const uint blk = (k_base >> 5) & 7u;
                for (uint ks = 0u; ks < 4u; ++ks) {
                    const uint vi = blk * 2u + (ks >> 1);
                    const uint wi = w_sub + ((ks & 1u) << 1);
                    coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        MAT_VEC2 wp = MAT_VEC2(MAT_T(0.0));
                        if (gn_base + in_t * 8u < pc.N) {
                            const uint chk_idx = w_row0 + in_t * w_row_inc + c;
                            const float16_t sc = unpackFloat2x16(uint(w_buf.blk[chk_idx].d[blk])).x;
                            const uint w_word  = w_buf.blk[chk_idx].qs[vi][wi];
                            const f16vec2 q2   = agx_q8_u16_magic_to_f16vec2((w_word >> p_shift) & 0xFFFFu);
    #if PREC_F32 == 1
                            wp = vec2(q2) * float(sc);
    #else
                            wp = q2 * sc;
    #endif
                        }
                        matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                        matA[in_t][0] = wp.x;
                        matA[in_t][1] = wp.y;
                    }
                    const uint ks_row_off = sh_off + (ks * 8u) * SH_X_STRIDE + sg_m_off;
                    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                        coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                            acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                        }
                    }
                }
                buf_idx ^= 1u;
            }
        }
    }

  #else
    uint buf_idx = 0u;
    for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
        const uint sh_off = buf_idx * SH_X_SLAB;
        if (x_vec4_ok && (k_base + TILE_K <= pc.K)) {
            const uint kb4 = k_base >> 2;
            for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                MAT_VEC4 xv = (gm0 + s * X_ROWS_STEP < pc.M)
                    ? MAT_VEC4(x_buf4.v[x_off0 + s * x_step_s + kb4])
                    : MAT_VEC4(MAT_T(0.0));
                store_x_vec4_to_sh_T(sh_off, sh_dst0 + s * X_ROWS_STEP, xv);
            }
        } else {
            load_sh_x_scalar_T(AgxBufF32R(x_base), tid, wg_m0, sh_off, k_base);
        }
        barrier();

        for (uint ks = 0u; ks < TILE_K; ks += 8u) {
            coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
            for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                const uint gn = sg_n0 + in_t * 8u + lr;
                const uint gk = k_base + ks + lc0;
                const MAT_VEC2 wp = load_w_pair(w_base, gn, gk);
                matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                matA[in_t][0] = wp.x;
                matA[in_t][1] = wp.y;
            }
            const uint ks_row_off = sh_off + ks * SH_X_STRIDE + sg_m_off;
            for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                    acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                }
            }
        }
        buf_idx ^= 1u;
    }
  #endif

    // Direct epilogue store from acc[in_t][im_t] (zero sh_y SRAM, zero barriers!)
    AgxBufF32RW y_buf = AgxBufF32RW(pc.y_va + uint64_t(slice) * uint64_t(pc.y_slice_elems) * 4ul);
    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
        const uint gm0_out = wg_m0 + sg_m_off + im_t * 8u + lc0;
        const bool m0_ok   = (gm0_out      < pc.M);
        const bool m1_ok   = (gm0_out + 1u < pc.M);
        if (m0_ok || m1_ok) {
            const uint y_row0 = gm0_out * pc.y_stride;
            const uint y_row1 = y_row0 + pc.y_stride;
            for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                const uint gn = sg_n0 + in_t * 8u + lr;
                if (gn < pc.N) {
                    if (m0_ok) y_buf.v[y_row0 + gn] = acc[in_t][im_t][0];
                    if (m1_ok) y_buf.v[y_row1 + gn] = acc[in_t][im_t][1];
                }
            }
        }
    }
#endif
}
