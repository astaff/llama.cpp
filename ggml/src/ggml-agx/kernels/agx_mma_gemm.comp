#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

#include "dequant_supertile.glsl"

// ============================================================================
// Pillar 2: Wave 4 High-AI 8x8 simdgroup_matrix (AGX3B) Prefill GEMM
// ============================================================================
// Targets 11-13+ TFLOPS on M4 Max (zero dynamic shuffles, <= 64 GPR32, 0:0 spills!):
//   1. `TILE_MODE=0, PREC_F32=0`: `64N x 64M` (`4x1` SGs, `SG_TILES_N=2, SG_TILES_M=8`):
//      - Cuts `matA` dequant overhead, `W` loads, and `barrier()`s per MMA in HALF!
//      - Keeps `SG_TILES_N=2` & `SG_M_CNT=1` (zero duplicate WG weight loads, compact
//        `W` register footprint vs Wave 3 `#79`'s 4x4 register spill/occupancy cliff!).
//   2. Transposed `RowMajor` 0-bank-conflict `sh_x[lk][lm]` (`SH_X_STRIDE = WG_M + 8`):
//      - Every `coopMatLoad(matB)` becomes ONE 32-bit `local_load` instead of TWO
//        16-bit strided `local_load`s -> 2x fewer SRAM load instructions!
//      - Exact 0-bank-conflict across all 32 banks for `WG_M = 16, 32, 64`!
//   3. Compact 3-GPR `X` addressing + interleaved 1-`vec4`-per-`ks` `X` prefetch
//      converted immediately to `f16vec4` (2 GPR32) + 2-at-a-time `matB` streaming
//      (2 GPR32) -> keeps peak GPR32 <= 64!
//   4. Direct epilogue store from `acc[in_t][im_t]` -> eliminates `sh_y` (`-2.2 KB`
//      SRAM) & all epilogue barriers -> `9.0 KB` total SRAM = `3` WGs/core (`12` sgs/core)!

#ifndef WEIGHT_MODE
#define WEIGHT_MODE 0
#endif

#ifndef TILE_MODE
#define TILE_MODE 0
#endif

#ifndef PREC_F32
#define PREC_F32 0
#endif

#define TILE_K 32u

#if TILE_MODE == 0
  // High-occupancy Prefill tile: 64(N) x 32(M) across 4 sgs (4 along N, 1 along M, 128 threads)
  // 8 FP32 8x8 accumulators/sg (16 GPR32), 5.0 KB FP16 RowMajor sh_x -> 6 WGs/core (24 SGs/core!),
  // 1x 32-bit coopMatLoad(matB), 1-at-a-time matB streaming, in-place W prefetch, direct epilogue!
  #define LOCAL_SIZE_X 128u
  #define WG_N         64u
  #define WG_M         32u
  #define SG_N_CNT     4u
  #define SG_M_CNT     1u
  #define SG_TILES_N   2u  // 2 x 8 = 16 rows/sg
  #define SG_TILES_M   4u  // 4 x 8 = 32 cols/sg
#elif TILE_MODE == 1
  // Medium batch tile (`M = 9..32`): 32(N) x 16(M) across 4 sgs (4 along N, 1 along M)
  #define LOCAL_SIZE_X 128u
  #define WG_N         32u
  #define WG_M         16u
  #define SG_N_CNT     4u
  #define SG_M_CNT     1u
  #define SG_TILES_N   1u  // 1 x 8 = 8 rows/sg
  #define SG_TILES_M   2u  // 2 x 8 = 16 cols/sg
#else
  // Narrow-N high-occupancy tile (`N <= 128`): 16(N) x 16(M) across 4 sgs (2x2)
  #define LOCAL_SIZE_X 128u
  #define WG_N         16u
  #define WG_M         16u
  #define SG_N_CNT     2u
  #define SG_M_CNT     2u
  #define SG_TILES_N   1u  // 1 x 8 = 8 rows/sg
  #define SG_TILES_M   1u  // 1 x 8 = 8 cols/sg
#endif

#define X_VEC4_PER_T  ((WG_M * TILE_K) / (LOCAL_SIZE_X * 4u))
#define X_ROWS_STEP   (LOCAL_SIZE_X / 8u)

#if PREC_F32 == 1
  #define MAT_T       float
  #define MAT_VEC2    vec2
  #define MAT_VEC4    vec4
#else
  #define MAT_T       float16_t
  #define MAT_VEC2    f16vec2
  #define MAT_VEC4    f16vec4
#endif

// Transposed RowMajor sh_x[lk][lm]: WG_M + 8 gives 0-bank-conflict 32-bit coopMatLoad
// across all 32 banks for WG_M = 16 (24 halfs), 32 (40 halfs), and 64 (72 halfs)!
#define SH_X_STRIDE (WG_M + 8u)
#define SH_X_SLAB   (TILE_K * SH_X_STRIDE)

layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PushArgs {
    uint64_t w_va;
    uint64_t x_va;
    uint64_t y_va;
    uint     M;
    uint     N;
    uint     K;
    uint     x_stride;
    uint     y_stride;
    uint     w_slice_bytes;
    uint     x_slice_elems;
    uint     y_slice_elems;
    uint     w_bcast_div;
    uint     _pad;
} pc;

shared MAT_T sh_x[2u * SH_X_SLAB];

#if WEIGHT_MODE != 0 && WEIGHT_MODE != 2
MAT_VEC2 load_w_pair(uint64_t w_base, uint row, uint k0) {
    if (row >= pc.N || k0 >= pc.K) {
        return MAT_VEC2(MAT_T(0.0));
    }

#if WEIGHT_MODE == 1
    const uint nb_k   = pc.K >> 6;
    const uint tk     = k0 >> 6;
    const uint k_in   = k0 & 63u;
    const uint sub    = k_in >> 4;
    const uint k16    = k_in & 15u;
    const uint j      = k16 & 7u;
    const uint sh     = (k16 >= 8u) ? 4u : 0u;
    AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
    const uint blk_idx = row * nb_k + tk;
    const uint b0 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + j]);
    const uint b1 = uint(raw_buf.blk[blk_idx].qs[sub * 8u + j + 1u]);
  #if PREC_F32 == 1
    return vec2(agx_e2m1_to_f32((b0 >> sh) & 0xFu),
                agx_e2m1_to_f32((b1 >> sh) & 0xFu)) * agx_ue4m3_to_f32(uint(raw_buf.blk[blk_idx].d[sub]));
  #else
    return f16vec2(agx_e2m1_to_f16((b0 >> sh) & 0xFu),
                   agx_e2m1_to_f16((b1 >> sh) & 0xFu)) * agx_ue4m3_to_f16(uint(raw_buf.blk[blk_idx].d[sub]));
  #endif

#elif WEIGHT_MODE == 3
    const uint nb_k   = pc.K >> 5;
    const uint b      = k0 >> 5;
    const uint k32    = k0 & 31u;
    AgxBufQ8_0Raw w_buf = AgxBufQ8_0Raw(w_base);
    const uint blk_idx = row * nb_k + b;
    const float16_t sc = unpackFloat2x16(uint(w_buf.blk[blk_idx].d)).x;
    const int q0 = int(w_buf.blk[blk_idx].qs[k32]);
    const int q1 = int(w_buf.blk[blk_idx].qs[k32 + 1u]);
  #if PREC_F32 == 1
    return vec2(float(q0), float(q1)) * float(sc);
  #else
    return f16vec2(float16_t(q0), float16_t(q1)) * sc;
  #endif

#elif WEIGHT_MODE == 4
    const uint n_chunks = (pc.K + 511u) >> 9;
    const uint c        = k0 >> 9;
    const uint k512     = k0 & 511u;
    const uint blk_in   = k512 >> 5;
    const uint vec_idx  = k512 >> 4;
    const uint word_idx = (k512 >> 2) & 3u;
    const uint pair_idx = (k512 >> 1) & 1u;

    AgxBufMxfp8_16Blk w_buf = AgxBufMxfp8_16Blk(w_base);
    const uint chk_idx = row * n_chunks + c;
    const float sc     = agx_ue8m0_to_f32(uint(w_buf.blk[chk_idx].e[blk_in]));
    const uint word    = w_buf.blk[chk_idx].qs[vec_idx][word_idx];
    const f16vec4 v4   = agx_e4m3_u32_to_f16vec4(word);
    const vec2 pair    = ((pair_idx == 0u) ? vec2(v4.xy) : vec2(v4.zw)) * sc;
    return MAT_VEC2(pair);

#elif WEIGHT_MODE == 5
    AgxBufU8R w_buf = AgxBufU8R(w_base + uint64_t(row) * uint64_t(pc.K));
    const float16_t v0 = agx_e4m3_to_f16(uint(w_buf.v[k0]));
    const float16_t v1 = (k0 + 1u < pc.K) ? agx_e4m3_to_f16(uint(w_buf.v[k0 + 1u])) : float16_t(0.0);
    return MAT_VEC2(MAT_T(v0), MAT_T(v1));

#elif WEIGHT_MODE == 6
    AgxBufU16R w_buf = AgxBufU16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
    const float v0 = agx_bf16_to_f32(w_buf.v[k0]);
    const float v1 = (k0 + 1u < pc.K) ? agx_bf16_to_f32(w_buf.v[k0 + 1u]) : 0.0;
    return MAT_VEC2(MAT_T(v0), MAT_T(v1));

#elif WEIGHT_MODE == 7
    AgxBufF16R w_buf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
    const float16_t v0 = w_buf.v[k0];
    const float16_t v1 = (k0 + 1u < pc.K) ? w_buf.v[k0 + 1u] : float16_t(0.0);
    return MAT_VEC2(MAT_T(v0), MAT_T(v1));

#else
    AgxBufF32R w_buf = AgxBufF32R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
    const float v0 = w_buf.v[k0];
    const float v1 = (k0 + 1u < pc.K) ? w_buf.v[k0 + 1u] : 0.0;
    return MAT_VEC2(MAT_T(v0), MAT_T(v1));
#endif
}
#endif

void store_x_vec4_to_sh_T(uint sh_off, uint dst_rel, MAT_VEC4 xv) {
    const uint d = sh_off + dst_rel;
    sh_x[d + 0u * SH_X_STRIDE] = xv.x;
    sh_x[d + 1u * SH_X_STRIDE] = xv.y;
    sh_x[d + 2u * SH_X_STRIDE] = xv.z;
    sh_x[d + 3u * SH_X_STRIDE] = xv.w;
}

void load_sh_x_scalar_T(AgxBufF32R x_buf, uint tid, uint wg_m0, uint sh_off, uint k_base) {
    const uint total_x = WG_M * TILE_K;
    for (uint idx = tid * 2u; idx < total_x; idx += LOCAL_SIZE_X * 2u) {
        const uint lm = idx >> 5;
        const uint lk = idx & 31u;
        const uint gm = wg_m0 + lm;
        const uint gk = k_base + lk;
        MAT_T v0 = (gm < pc.M && gk      < pc.K) ? MAT_T(x_buf.v[gm * pc.x_stride + gk])      : MAT_T(0.0);
        MAT_T v1 = (gm < pc.M && gk + 1u < pc.K) ? MAT_T(x_buf.v[gm * pc.x_stride + gk + 1u]) : MAT_T(0.0);
        sh_x[sh_off + lk        * SH_X_STRIDE + lm] = v0;
        sh_x[sh_off + (lk + 1u) * SH_X_STRIDE + lm] = v1;
    }
}

void main() {
    const uint tid   = gl_LocalInvocationIndex;
    const uint lane  = gl_SubgroupInvocationID; // 0..31
    const uint sg_id = gl_SubgroupID;
    const uint slice = gl_WorkGroupID.z;

    const uint w_slice = slice / max(1u, pc.w_bcast_div);
    const uint64_t w_base = pc.w_va + uint64_t(w_slice) * uint64_t(pc.w_slice_bytes);
    const uint64_t x_base = pc.x_va + uint64_t(slice)   * uint64_t(pc.x_slice_elems) * 4ul;

    AgxBufVec4R x_buf4 = AgxBufVec4R(x_base);

    const uint wg_n0 = gl_WorkGroupID.x * WG_N;
    const uint wg_m0 = gl_WorkGroupID.y * WG_M;

    const uint sg_n_idx = sg_id % SG_N_CNT;
    const uint sg_m_idx = sg_id / SG_N_CNT;
    const uint sg_n0    = wg_n0 + sg_n_idx * (SG_TILES_N * 8u);
    const uint sg_m_off = sg_m_idx * (SG_TILES_M * 8u);

    const uint lr  = agx_cmat8_row(lane);
    const uint lc0 = agx_cmat8_col0(lane);

    const bool x_vec4_ok = ((pc.K & 3u) == 0u) && ((pc.x_stride & 3u) == 0u);
    const uint x_stride4 = pc.x_stride >> 2;

    // Compact 3-GPR transposed X load addressing (X_ROWS_STEP = LOCAL_SIZE_X / 8)
    const uint lm0       = tid >> 3;
    const uint lk4       = tid & 7u;
    const uint gm0       = wg_m0 + lm0;
    const uint x_off0    = gm0 * x_stride4 + lk4;
    const uint x_step_s  = X_ROWS_STEP * x_stride4;
    const uint sh_dst0   = (lk4 << 2) * SH_X_STRIDE + lm0;

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> acc[SG_TILES_N][SG_TILES_M];
    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
        for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
            acc[in_t][im_t] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        }
    }

#if WEIGHT_MODE == 0
    // ------------------------------------------------------------------------
    // AGX_NVFP4_32x16: 64N x 32M (128T) RowMajor sh_x + <= 72 GPR32 Trim:
    //   - Hoisted x_vec4_ok fast loop (0 scalar-fallback regs inside K-loop!)
    //   - Raw uint16_t d_cur[2] (1 GPR32 vs 3 GPR32 for f16vec2 sc_cur + sc_hi!)
    //   - In-place qs_cur overwrite after qhi + 1-at-a-time matB streaming
    // ------------------------------------------------------------------------
    {
        AgxBufNvfp4ST st_buf = AgxBufNvfp4ST(w_base);
        const uint nb_k  = pc.K >> 6;
        const uint shift = lc0 << 2; // 0, 8, 16, 24

        // All SG_TILES_N rows (8 or 16) lie in the SAME 16-row half-tile!
        const uint gn_base   = sg_n0 + lr;
        const uint w_st_base = (gn_base >> 5) * nb_k;
        const uint w_l_base0 = ((gn_base >> 4) & 1u) * 32u + ((gn_base & 15u) << 1);

        if (x_vec4_ok) {
            for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                MAT_VEC4 xv = (gm0 + s * X_ROWS_STEP < pc.M)
                    ? MAT_VEC4(x_buf4.v[x_off0 + s * x_step_s])
                    : MAT_VEC4(MAT_T(0.0));
                store_x_vec4_to_sh_T(0u, sh_dst0 + s * X_ROWS_STEP, xv);
            }

            uvec4    qs_cur[SG_TILES_N];
            uint16_t d_cur[SG_TILES_N];
            for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                if (gn_base + in_t * 8u < pc.N) {
                    const uint l_idx = w_l_base0 + in_t * 16u;
                    qs_cur[in_t] = st_buf.st[w_st_base].qs[l_idx];
                    d_cur[in_t]  = st_buf.st[w_st_base].d[l_idx];
                } else {
                    qs_cur[in_t] = uvec4(0u);
                    d_cur[in_t]  = uint16_t(0u);
                }
            }
            barrier();

            uint buf_idx = 0u;
            for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
                const uint sh_off   = buf_idx * SH_X_SLAB;
                const uint next_k   = k_base + TILE_K;
                const bool has_next = (next_k < pc.K);
                const uint next_off = (buf_idx ^ 1u) * SH_X_SLAB;

                // Phase 1: Prefetch X[next_k] as compact MAT_VEC4 while running ks_i=0,1
                MAT_VEC4 xv_next[X_VEC4_PER_T];
                if (has_next) {
                    const uint nkb4 = next_k >> 2;
                    for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                        xv_next[s] = (gm0 + s * X_ROWS_STEP < pc.M)
                            ? MAT_VEC4(x_buf4.v[x_off0 + s * x_step_s + nkb4])
                            : MAT_VEC4(MAT_T(0.0));
                    }
                }

                MAT_T sc_lo[SG_TILES_N];
                for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
  #if PREC_F32 == 1
                    sc_lo[in_t] = agx_ue4m3_to_f32(uint(d_cur[in_t]) & 0xFFu);
  #else
                    sc_lo[in_t] = agx_ue4m3_to_f16(uint(d_cur[in_t]) & 0xFFu);
  #endif
                }

                for (uint ks_i = 0u; ks_i < 2u; ++ks_i) {
                    coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        const uint w_word = (ks_i == 0u) ? qs_cur[in_t].x : qs_cur[in_t].y;
                        const uint b2     = (w_word >> shift) & 0xFFu;
  #if PREC_F32 == 1
                        const vec2 wp     = agx_e2m1_byte_to_vec2(b2) * sc_lo[in_t];
  #else
                        const f16vec2 wp  = agx_e2m1_byte_to_f16vec2(b2) * sc_lo[in_t];
  #endif
                        matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                        matA[in_t][0] = wp.x;
                        matA[in_t][1] = wp.y;
                    }

                    const uint ks_row_off = sh_off + (ks_i * 8u) * SH_X_STRIDE + sg_m_off;
                    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                        coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                            acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                        }
                    }
                }

                if (has_next) {
                    for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                        store_x_vec4_to_sh_T(next_off, sh_dst0 + s * X_ROWS_STEP, xv_next[s]);
                    }
                }

                // Release qs_cur.xy early & overwrite qs_cur/d_cur IN-PLACE with W[next_k]
                uvec2 qs_hi[SG_TILES_N];
                MAT_T sc_hi[SG_TILES_N];
                for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                    qs_hi[in_t] = qs_cur[in_t].zw;
  #if PREC_F32 == 1
                    sc_hi[in_t] = agx_ue4m3_to_f32(uint(d_cur[in_t]) >> 8);
  #else
                    sc_hi[in_t] = agx_ue4m3_to_f16(uint(d_cur[in_t]) >> 8);
  #endif
                }

                if (has_next) {
                    const uint st_idx = w_st_base + (next_k >> 6);
                    const uint nkh    = (next_k >> 5) & 1u;
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        if (gn_base + in_t * 8u < pc.N) {
                            const uint l_idx = (w_l_base0 + in_t * 16u) | nkh;
                            qs_cur[in_t] = st_buf.st[st_idx].qs[l_idx];
                            d_cur[in_t]  = st_buf.st[st_idx].d[l_idx];
                        } else {
                            qs_cur[in_t] = uvec4(0u);
                            d_cur[in_t]  = uint16_t(0u);
                        }
                    }
                }

                for (uint ks_j = 0u; ks_j < 2u; ++ks_j) {
                    coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        const uint w_word = (ks_j == 0u) ? qs_hi[in_t].x : qs_hi[in_t].y;
                        const uint b2     = (w_word >> shift) & 0xFFu;
  #if PREC_F32 == 1
                        const vec2 wp     = agx_e2m1_byte_to_vec2(b2) * sc_hi[in_t];
  #else
                        const f16vec2 wp  = agx_e2m1_byte_to_f16vec2(b2) * sc_hi[in_t];
  #endif
                        matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                        matA[in_t][0] = wp.x;
                        matA[in_t][1] = wp.y;
                    }

                    const uint ks_row_off = sh_off + (16u + ks_j * 8u) * SH_X_STRIDE + sg_m_off;
                    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                        coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                            acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                        }
                    }
                }

                if (has_next) {
                    barrier();
                    buf_idx ^= 1u;
                }
            }
        } else {
            // Unaligned x_stride fallback (clean non-pipelined path)
            AgxBufF32R x_buf = AgxBufF32R(x_base);
            uint buf_idx = 0u;
            for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
                const uint sh_off = buf_idx * SH_X_SLAB;
                load_sh_x_scalar_T(x_buf, tid, wg_m0, sh_off, k_base);
                barrier();
                const uint st_idx = w_st_base + (k_base >> 6);
                const uint kh     = (k_base >> 5) & 1u;
                for (uint ks = 0u; ks < 4u; ++ks) {
                    coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        MAT_VEC2 wp = MAT_VEC2(MAT_T(0.0));
                        if (gn_base + in_t * 8u < pc.N) {
                            const uint l_idx  = (w_l_base0 + in_t * 16u) | kh;
                            const uint w_word = st_buf.st[st_idx].qs[l_idx][ks];
                            const uint dp     = uint(st_buf.st[st_idx].d[l_idx]);
                            const uint b2     = (w_word >> shift) & 0xFFu;
  #if PREC_F32 == 1
                            wp = agx_e2m1_byte_to_vec2(b2) * agx_ue4m3_to_f32((ks < 2u) ? (dp & 0xFFu) : (dp >> 8));
  #else
                            wp = agx_e2m1_byte_to_f16vec2(b2) * agx_ue4m3_to_f16((ks < 2u) ? (dp & 0xFFu) : (dp >> 8));
  #endif
                        }
                        matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                        matA[in_t][0] = wp.x;
                        matA[in_t][1] = wp.y;
                    }
                    const uint ks_row_off = sh_off + (ks * 8u) * SH_X_STRIDE + sg_m_off;
                    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                        coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                            acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                        }
                    }
                }
                buf_idx ^= 1u;
            }
        }
    }

#elif WEIGHT_MODE == 2
    // ------------------------------------------------------------------------
    // AGX_Q8_0_8BLK: 64N x 32M (128T) RowMajor sh_x + <= 68 GPR32 Trim:
    //   - Hoisted x_vec4_ok fast loop (0 scalar-fallback regs inside K-loop!)
    //   - Lean 8-GPR streaming q0_cur/q1_cur + in-place overwrite
    // ------------------------------------------------------------------------
    {
        AgxBufQ8_8Blk w_buf = AgxBufQ8_8Blk(w_base);
        const uint n_chunks  = (pc.K + 255u) >> 8;
        const uint w_sub     = lc0 >> 2;               // 0 or 1
        const uint p_shift   = ((lc0 >> 1) & 1u) << 4; // 0 or 16
        const uint gn_base   = sg_n0 + lr;
        const uint w_row0    = gn_base * n_chunks;
        const uint w_row_inc = 8u * n_chunks;

        if (x_vec4_ok) {
            for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                MAT_VEC4 xv = (gm0 + s * X_ROWS_STEP < pc.M)
                    ? MAT_VEC4(x_buf4.v[x_off0 + s * x_step_s])
                    : MAT_VEC4(MAT_T(0.0));
                store_x_vec4_to_sh_T(0u, sh_dst0 + s * X_ROWS_STEP, xv);
            }

            uvec2     q0_cur[SG_TILES_N];
            float16_t sc_cur[SG_TILES_N];
            for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                if (gn_base + in_t * 8u < pc.N) {
                    const uint chk_idx = w_row0 + in_t * w_row_inc;
                    sc_cur[in_t] = unpackFloat2x16(uint(w_buf.blk[chk_idx].d[0u])).x;
                    q0_cur[in_t] = uvec2(w_buf.blk[chk_idx].qs[0u][w_sub],
                                         w_buf.blk[chk_idx].qs[0u][w_sub + 2u]);
                } else {
                    sc_cur[in_t] = float16_t(0.0);
                    q0_cur[in_t] = uvec2(0u);
                }
            }
            barrier();

            uint buf_idx = 0u;
            for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
                const uint sh_off   = buf_idx * SH_X_SLAB;
                const uint next_k   = k_base + TILE_K;
                const bool has_next = (next_k < pc.K);
                const uint next_off = (buf_idx ^ 1u) * SH_X_SLAB;

                // Phase 1: Prefetch X[next_k] (compact MAT_VEC4) AND q1_cur while running ks_i=0,1!
                MAT_VEC4 xv_next[X_VEC4_PER_T];
                if (has_next) {
                    const uint nkb4 = next_k >> 2;
                    for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                        xv_next[s] = (gm0 + s * X_ROWS_STEP < pc.M)
                            ? MAT_VEC4(x_buf4.v[x_off0 + s * x_step_s + nkb4])
                            : MAT_VEC4(MAT_T(0.0));
                    }
                }
                uvec2 q1_cur[SG_TILES_N];
                {
                    const uint c   = k_base >> 8;
                    const uint vi1 = ((k_base >> 5) & 7u) * 2u + 1u;
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        if (gn_base + in_t * 8u < pc.N) {
                            const uint chk_idx = w_row0 + in_t * w_row_inc + c;
                            q1_cur[in_t] = uvec2(w_buf.blk[chk_idx].qs[vi1][w_sub],
                                                 w_buf.blk[chk_idx].qs[vi1][w_sub + 2u]);
                        } else {
                            q1_cur[in_t] = uvec2(0u);
                        }
                    }
                }

                for (uint ks_i = 0u; ks_i < 2u; ++ks_i) {
                    coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        const uint w_word = (ks_i == 0u) ? q0_cur[in_t].x : q0_cur[in_t].y;
                        const f16vec2 q2  = agx_q8_u16_magic_to_f16vec2((w_word >> p_shift) & 0xFFFFu);
  #if PREC_F32 == 1
                        const vec2 wp     = vec2(q2) * float(sc_cur[in_t]);
  #else
                        const f16vec2 wp  = q2 * sc_cur[in_t];
  #endif
                        matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                        matA[in_t][0] = wp.x;
                        matA[in_t][1] = wp.y;
                    }

                    const uint ks_row_off = sh_off + (ks_i * 8u) * SH_X_STRIDE + sg_m_off;
                    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                        coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                            acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                        }
                    }
                }

                if (has_next) {
                    for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                        store_x_vec4_to_sh_T(next_off, sh_dst0 + s * X_ROWS_STEP, xv_next[s]);
                    }
                }

                // Save sc_cur for Phase 2 & overwrite q0_cur/sc_cur IN-PLACE with W[next_k]
                float16_t sc_hi[SG_TILES_N];
                for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                    sc_hi[in_t] = sc_cur[in_t];
                }

                if (has_next) {
                    const uint nc   = next_k >> 8;
                    const uint nblk = (next_k >> 5) & 7u;
                    const uint vi0  = nblk * 2u;
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        if (gn_base + in_t * 8u < pc.N) {
                            const uint chk_idx = w_row0 + in_t * w_row_inc + nc;
                            sc_cur[in_t] = unpackFloat2x16(uint(w_buf.blk[chk_idx].d[nblk])).x;
                            q0_cur[in_t] = uvec2(w_buf.blk[chk_idx].qs[vi0][w_sub],
                                                 w_buf.blk[chk_idx].qs[vi0][w_sub + 2u]);
                        } else {
                            sc_cur[in_t] = float16_t(0.0);
                            q0_cur[in_t] = uvec2(0u);
                        }
                    }
                }

                for (uint ks_j = 0u; ks_j < 2u; ++ks_j) {
                    coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        const uint w_word = (ks_j == 0u) ? q1_cur[in_t].x : q1_cur[in_t].y;
                        const f16vec2 q2  = agx_q8_u16_magic_to_f16vec2((w_word >> p_shift) & 0xFFFFu);
  #if PREC_F32 == 1
                        const vec2 wp     = vec2(q2) * float(sc_hi[in_t]);
  #else
                        const f16vec2 wp  = q2 * sc_hi[in_t];
  #endif
                        matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                        matA[in_t][0] = wp.x;
                        matA[in_t][1] = wp.y;
                    }

                    const uint ks_row_off = sh_off + (16u + ks_j * 8u) * SH_X_STRIDE + sg_m_off;
                    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                        coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                            acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                        }
                    }
                }

                if (has_next) {
                    barrier();
                    buf_idx ^= 1u;
                }
            }
        } else {
            // Unaligned x_stride fallback
            AgxBufF32R x_buf = AgxBufF32R(x_base);
            uint buf_idx = 0u;
            for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
                const uint sh_off = buf_idx * SH_X_SLAB;
                load_sh_x_scalar_T(x_buf, tid, wg_m0, sh_off, k_base);
                barrier();
                const uint c   = k_base >> 8;
                const uint blk = (k_base >> 5) & 7u;
                for (uint ks = 0u; ks < 4u; ++ks) {
                    const uint vi = blk * 2u + (ks >> 1);
                    const uint wi = w_sub + ((ks & 1u) << 1);
                    coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
                    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                        MAT_VEC2 wp = MAT_VEC2(MAT_T(0.0));
                        if (gn_base + in_t * 8u < pc.N) {
                            const uint chk_idx = w_row0 + in_t * w_row_inc + c;
                            const float16_t sc = unpackFloat2x16(uint(w_buf.blk[chk_idx].d[blk])).x;
                            const uint w_word  = w_buf.blk[chk_idx].qs[vi][wi];
                            const f16vec2 q2   = agx_q8_u16_magic_to_f16vec2((w_word >> p_shift) & 0xFFFFu);
  #if PREC_F32 == 1
                            wp = vec2(q2) * float(sc);
  #else
                            wp = q2 * sc;
  #endif
                        }
                        matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                        matA[in_t][0] = wp.x;
                        matA[in_t][1] = wp.y;
                    }
                    const uint ks_row_off = sh_off + (ks * 8u) * SH_X_STRIDE + sg_m_off;
                    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                        coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                            acc[in_t][im_t] = coopMatMulAdd(matA[in_t], matB, acc[in_t][im_t]);
                        }
                    }
                }
                buf_idx ^= 1u;
            }
        }
    }

#else
    uint buf_idx = 0u;
    for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
        const uint sh_off = buf_idx * SH_X_SLAB;
        if (x_vec4_ok && (k_base + TILE_K <= pc.K)) {
            const uint kb4 = k_base >> 2;
            for (uint s = 0u; s < X_VEC4_PER_T; ++s) {
                MAT_VEC4 xv = (gm0 + s * X_ROWS_STEP < pc.M)
                    ? MAT_VEC4(x_buf4.v[x_off0 + s * x_step_s + kb4])
                    : MAT_VEC4(MAT_T(0.0));
                store_x_vec4_to_sh_T(sh_off, sh_dst0 + s * X_ROWS_STEP, xv);
            }
        } else {
            load_sh_x_scalar_T(AgxBufF32R(x_base), tid, wg_m0, sh_off, k_base);
        }
        barrier();

        for (uint ks = 0u; ks < TILE_K; ks += 8u) {
            coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA[SG_TILES_N];
            for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                const uint gn = sg_n0 + in_t * 8u + lr;
                const uint gk = k_base + ks + lc0;
                const MAT_VEC2 wp = load_w_pair(w_base, gn, gk);
                matA[in_t] = coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(MAT_T(0.0));
                matA[in_t][0] = wp.x;
                matA[in_t][1] = wp.y;
            }
            const uint ks_row_off = sh_off + ks * SH_X_STRIDE + sg_m_off;
  #if TILE_MODE != 2
            for (uint im_t = 0u; im_t < SG_TILES_M; im_t += 2u) {
                coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB0, matB1;
                coopMatLoad(matB0, sh_x, ks_row_off + im_t * 8u,      SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(matB1, sh_x, ks_row_off + im_t * 8u + 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                    acc[in_t][im_t]      = coopMatMulAdd(matA[in_t], matB0, acc[in_t][im_t]);
                    acc[in_t][im_t + 1u] = coopMatMulAdd(matA[in_t], matB1, acc[in_t][im_t + 1u]);
                }
            }
  #else
            coopmat<MAT_T, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB0;
            coopMatLoad(matB0, sh_x, ks_row_off, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                acc[in_t][0] = coopMatMulAdd(matA[in_t], matB0, acc[in_t][0]);
            }
  #endif
        }
        buf_idx ^= 1u;
    }
#endif

    // ------------------------------------------------------------------------
    // Direct epilogue store from acc[in_t][im_t] (zero sh_y SRAM, zero barriers!)
    // ------------------------------------------------------------------------
    AgxBufF32RW y_buf = AgxBufF32RW(pc.y_va + uint64_t(slice) * uint64_t(pc.y_slice_elems) * 4ul);
    for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
        const uint gm0_out = wg_m0 + sg_m_off + im_t * 8u + lc0;
        const bool m0_ok   = (gm0_out      < pc.M);
        const bool m1_ok   = (gm0_out + 1u < pc.M);
        if (m0_ok || m1_ok) {
            const uint y_row0 = gm0_out * pc.y_stride;
            const uint y_row1 = y_row0 + pc.y_stride;
            for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
                const uint gn = sg_n0 + in_t * 8u + lr;
                if (gn < pc.N) {
                    if (m0_ok) y_buf.v[y_row0 + gn] = acc[in_t][im_t][0];
                    if (m1_ok) y_buf.v[y_row1 + gn] = acc[in_t][im_t][1];
                }
            }
        }
    }
}
