#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

#include "dequant_supertile.glsl"

// ============================================================================
// Pillar 5b: Fused MoE Gate+Up + Exact Inkling SiTU + Down Scatter-Add
//            + Wave 4 Theorem W4.3 2-Stage Direct MoE (`PASS_STAGE == 5, 6`)
//            + Direct M=1 Roofline MUL_MAT_ID Fastpath (`PASS_STAGE == 4`)
//            + Lean BATCH_CAP=4 Dedup Vec-Mat (`PASS_STAGE == 0, 1`)
//            + Software-Pipelined 32M x 64N 8x8 MMA GEMM (`PASS_STAGE == 2, 3`)
// ============================================================================
// Target: Apple Silicon AGX3B (M4 Max, 40 cores, 32-lane simdgroup)
// Budget: <= 96 32-bit GPRs/lane, 0:0 spills across ALL modes!
//
// Compile-time specializations:
//   PASS_STAGE  = 0 : Gate+Up + SiTU/SwiGLU Vec-Mat (M_bucket <= 4; NVFP4 32 pairs/WG, Q8 4 pairs/WG)
//               = 1 : Down + Weight Scatter-Add Vec-Mat (M_bucket <= 4; NVFP4 64 rows/WG, Q8 8 rows/WG)
//               = 2 : Gate+Up + SiTU/SwiGLU 8x8 coopmat GEMM (M_bucket >= 5, 32 pairs x 32M/WG,
//                     TILE_K=32 double-buffered split-phase software-pipelined sh_x + hoisted W)
//               = 3 : Down + Weight Scatter-Add 8x8 coopmat GEMM (M_bucket >= 5, 64 rows x 32M/WG,
//                     TILE_K=32 double-buffered split-phase software-pipelined sh_x + coalesced sh_y)
//               = 4 : Direct M=1 Roofline MUL_MAT_ID (zero bucket/zero/indirect overhead!)
//               = 5 : Wave 4 Stage 2 — Direct Fused Gate+Up + In-Register SiTU -> SLC moe_inter
//                     (0 TG SRAM, 0 WG barriers, reads X ONCE for both gate & up, <=48 GPR32!)
//               = 6 : Wave 4 Stage 3 — Direct Fused Down + Exact Sequential precise-float Weighted-Sum
//                     + Optional Residual Add -> h_out (4 sgs split top_k, 0 atomics, 0-ULP!)
//   WEIGHT_MODE = 0 (AGX_NVFP4_32x16 repacked), 1 (raw block_nvfp4),
//                 2 (AGX_Q8_0_8BLK repacked),   3 (raw block_q8_0),
//                 4 (AGX_MXFP8_16BLK repacked), 5 (flat F8_E4M3),
//                 6 (flat BF16), 7 (flat F16),  8 (flat F32)
//   BATCH_CAP   = 1 or 4 (compile-time unroll cap for stages 0 & 1)
//   PREC_F32    = 0 (SWAR2 / Q8 magic-norm 2x-rate ffma16 + FP32 scale accum) or 1 (pure FP32)

#ifndef PASS_STAGE
#define PASS_STAGE 0
#endif

#ifndef WEIGHT_MODE
#define WEIGHT_MODE 0
#endif

#ifndef BATCH_CAP
#define BATCH_CAP 4
#endif

#ifndef PREC_F32
#define PREC_F32 0
#endif

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer BufU32RW { uint d[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer BufU32R { uint d[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer BufI32R { int d[]; };

struct AgxMoeBucket {
    uint expert_id;
    uint token_offset;
    uint count;
    uint pad0;
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer BufBucketArrR {
    AgxMoeBucket b[];
};

layout(buffer_reference, scalar, buffer_reference_align = 128) readonly buffer BufBucketHdrR {
    uint n_active_experts;
    uint n_vecmat_buckets;
    uint n_gemm_tiles;
    uint total_assignments;
    uint n_tokens;
    uint top_k;
    uint n_expert;
    uint n_skipped;
};

// Flags for PushMoe::flags
const uint MOE_FLAG_SEPARATE_GU      = 1u << 0;
const uint MOE_FLAG_X_F16            = 1u << 1;
const uint MOE_FLAG_RAW_MMID         = 1u << 2;
const uint MOE_FLAG_ACT_SILU         = 1u << 3;
const uint MOE_FLAG_ACT_GELU         = 1u << 4;
const uint MOE_FLAG_RAW_MMID_PERSLOT = 1u << 5;

// Push constants: 120 bytes (<= 256 B AGX push window)
layout(push_constant) uniform PushMoe {
    uint64_t header_va;       // agx_moe_bucket_header
    uint64_t buckets_va;      // vecmat_buckets (0,1), gemm_tiles (2,3), or direct ids_va (4,5,6)
    uint64_t sorted_tok_va;   // uint32_t[M * top_k]
    uint64_t sorted_kslot_va; // uint32_t[M * top_k]
    uint64_t sorted_w_va;     // float[M * top_k] (or direct topk_w_va for stage 6)
    uint64_t x_va;            // [M, K] (or [top_k, K] when PERSLOT, or moe_inter for stage 6)
    uint64_t w_gate_va;       // gate_up_va / gate_va / down_va
    uint64_t w_up_va;         // up_va if SEPARATE_GU (or optional res_va for stage 6)
    uint64_t y_va;            // moe_hidden / moe_inter (0,2,5) or moe_out / dst (1,3,4,6)
    uint64_t w_slice_B;       // byte stride between experts in W
    uint     K;
    uint     N;
    uint     n_ff;            // n_ff (0..3) OR n_expert bounds check (4,5,6)
    uint     top_k;
    uint     flags;
    float    situ_beta;       // situ_beta (0,2,5) OR exp_scale0 (6)
    float    situ_linear_beta;
    uint     ids_row_stride;  // PASS_STAGE=4,5,6: int32 stride between token rows in ids (0 -> top_k)
    uint64_t w_scale_va;      // optional per-expert FP32 2nd-level scale [n_expert] (0 -> 1.0f)
} pc;

void atomicAddF32(uint64_t addr_va, uint idx, float val) {
    if (val == 0.0f) {
        return;
    }
    BufU32RW buf = BufU32RW(addr_va);
    uint expected = buf.d[idx];
    for (;;) {
        float next_f  = uintBitsToFloat(expected) + val;
        uint  desired = floatBitsToUint(next_f);
        uint  prev    = atomicCompSwap(buf.d[idx], expected, desired);
        if (prev == expected) {
            break;
        }
        expected = prev;
    }
}

float eval_moe_act(float g, float u) {
    if ((pc.flags & MOE_FLAG_ACT_SILU) != 0u) {
        return (g / (1.0f + exp(-g))) * u;
    }
    if ((pc.flags & MOE_FLAG_ACT_GELU) != 0u) {
        const float k = 0.7978845608f * (g + 0.044715f * g * g * g);
        return 0.5f * g * (1.0f + tanh(k)) * u;
    }
    // Exact Inkling 2 Mini SiTU matching src/llama-graph.cpp:2638-2649 (0-ULP NoContraction)
    const float beta = pc.situ_beta;
    const float lb   = pc.situ_linear_beta;
    precise float g_s   = g * (1.0f / beta);
    precise float act_t = tanh(g_s) * beta;
    precise float sig_g = 1.0f / (1.0f + exp(-g));
    precise float act   = act_t * sig_g;
    precise float u_a   = (lb > 0.0f) ? (tanh(u * (1.0f / lb)) * lb) : u;
    precise float res   = act * u_a;
    return res;
}

float moe_dot_e2m1_u32_f32x2(uint w32, vec4 x0, vec4 x1) {
    return dot(agx_e2m1_u16_to_vec4(w32 & 0xFFFFu), x0)
         + dot(agx_e2m1_u16_to_vec4(w32 >> 16),     x1);
}

#if PREC_F32 == 0
float16_t moe_dot_e2m1_u32_f16x2(uint w32, f16vec4 hx0, f16vec4 hx1) {
    // 6-op SWAR2 masks bits [3:0] & [19:16] internally (no pre-mask needed!)
    f16vec2 v04 = agx_e2m1_swar2_to_f16vec2(w32);
    f16vec2 v15 = agx_e2m1_swar2_to_f16vec2(w32 >> 4);
    f16vec2 v26 = agx_e2m1_swar2_to_f16vec2(w32 >> 8);
    f16vec2 v37 = agx_e2m1_swar2_to_f16vec2(w32 >> 12);
    return dot(f16vec4(v04.x, v15.x, v26.x, v37.x), hx0)
         + dot(f16vec4(v04.y, v15.y, v26.y, v37.y), hx1);
}

void moe_decode_e2m1_u32_f16x2(uint w32, out f16vec4 w0, out f16vec4 w1) {
    f16vec2 v04 = agx_e2m1_swar2_to_f16vec2(w32);
    f16vec2 v15 = agx_e2m1_swar2_to_f16vec2(w32 >> 4);
    f16vec2 v26 = agx_e2m1_swar2_to_f16vec2(w32 >> 8);
    f16vec2 v37 = agx_e2m1_swar2_to_f16vec2(w32 >> 12);
    w0 = f16vec4(v04.x, v15.x, v26.x, v37.x);
    w1 = f16vec4(v04.y, v15.y, v26.y, v37.y);
}
#endif

#if PASS_STAGE == 4 || PASS_STAGE == 5 || PASS_STAGE == 6
#if WEIGHT_MODE == 0
void moe_nvfp4_accum_st(uint16_t dp, uvec4 qs, uint col4, AgxBufVec4R x_buf4, inout float acc) {
#if PREC_F32 == 0
    float16_t d0 = moe_dot_e2m1_u32_f16x2(qs.x, f16vec4(x_buf4.v[col4 + 0u]), f16vec4(x_buf4.v[col4 + 1u]));
    d0 += moe_dot_e2m1_u32_f16x2(qs.y, f16vec4(x_buf4.v[col4 + 2u]), f16vec4(x_buf4.v[col4 + 3u]));
    const vec2 sc = agx_ue4m3_pair_to_vec2(dp);
    acc = fma(float(d0), sc.x, acc);

    float16_t d1 = moe_dot_e2m1_u32_f16x2(qs.z, f16vec4(x_buf4.v[col4 + 4u]), f16vec4(x_buf4.v[col4 + 5u]));
    d1 += moe_dot_e2m1_u32_f16x2(qs.w, f16vec4(x_buf4.v[col4 + 6u]), f16vec4(x_buf4.v[col4 + 7u]));
    acc = fma(float(d1), sc.y, acc);
#else
    const vec2 sc = agx_ue4m3_pair_to_vec2(dp);
    float d0 = moe_dot_e2m1_u32_f32x2(qs.x, x_buf4.v[col4 + 0u], x_buf4.v[col4 + 1u])
             + moe_dot_e2m1_u32_f32x2(qs.y, x_buf4.v[col4 + 2u], x_buf4.v[col4 + 3u]);
    acc = fma(d0, sc.x, acc);

    float d1 = moe_dot_e2m1_u32_f32x2(qs.z, x_buf4.v[col4 + 4u], x_buf4.v[col4 + 5u])
             + moe_dot_e2m1_u32_f32x2(qs.w, x_buf4.v[col4 + 6u], x_buf4.v[col4 + 7u]);
    acc = fma(d1, sc.y, acc);
#endif
}
#elif WEIGHT_MODE == 2
void moe_q8_accum_chk(uvec4 qv, uint16_t d16, uint col4, AgxBufVec4R x_buf4, inout float acc) {
    const float d = float(unpackFloat2x16(uint(d16)).x);
    float dp = dot(vec4(agx_q8_u32_magic_to_f16vec4(qv.x)), x_buf4.v[col4 + 0u])
             + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv.y)), x_buf4.v[col4 + 1u])
             + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv.z)), x_buf4.v[col4 + 2u])
             + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv.w)), x_buf4.v[col4 + 3u]);
    acc = fma(dp, d, acc);
}
#endif
#endif // PASS_STAGE == 4 || PASS_STAGE == 6

// ============================================================================
// Stage 4: Direct M=1..8 Roofline MUL_MAT_ID Fastpath (Zero Bucket / Barriers)
// ============================================================================
#if PASS_STAGE == 4

void main() {
    const uint lane   = gl_SubgroupInvocationID; // 0..31
    const uint sg_id  = gl_SubgroupID;           // 0..3
    const uint k_slot = gl_WorkGroupID.y;        // 0..top_k-1
    const uint tok    = gl_WorkGroupID.z;        // 0..M-1

    if (k_slot >= pc.top_k) {
        return;
    }

    const uint ids_stride = (pc.ids_row_stride != 0u) ? pc.ids_row_stride : pc.top_k;
    const int  raw_eid    = BufI32R(pc.buckets_va).d[tok * ids_stride + k_slot];
    const bool valid_eid  = (raw_eid >= 0) && (uint(raw_eid) < pc.n_ff);
    const bool per_slot   = (pc.flags & MOE_FLAG_RAW_MMID_PERSLOT) != 0u;
    const uint y_slot     = tok * pc.top_k + k_slot;
    const uint row_x      = per_slot ? y_slot : tok;
    const uint64_t x_row_va = pc.x_va + uint64_t(row_x)  * uint64_t(pc.K) * 4ul;
    const uint64_t y_row_va = pc.y_va + uint64_t(y_slot) * uint64_t(pc.N) * 4ul;

    AgxBufF32R  x_buf  = AgxBufF32R(x_row_va);
    AgxBufVec4R x_buf4 = AgxBufVec4R(x_row_va);
    AgxBufF32RW y_buf  = AgxBufF32RW(y_row_va);

#if WEIGHT_MODE == 0
    const uint half_idx = gl_WorkGroupID.x * 4u + sg_id;
    const uint tn       = half_idx >> 1;
    const uint sub_s    = half_idx & 1u;
    const uint row_in_h = lane >> 1; // 0..15
    const uint kh       = lane & 1u; // 0 or 1
    const uint row      = half_idx * 16u + row_in_h;

    if (!valid_eid) {
        if (kh == 0u && row < pc.N) {
            y_buf.v[row] = 0.0f;
        }
        return;
    }

    float acc = 0.0f;

    if (half_idx * 16u < pc.N) {
        const uint64_t w_base = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
        AgxBufNvfp4ST st_buf  = AgxBufNvfp4ST(w_base);
        const uint nb_k       = pc.K >> 6;
        const uint st_base    = tn * nb_k;
        const uint l_idx      = sub_s * 32u + lane;
        const uint kh_col4    = kh * 8u;

        uint tk = 0u;
        for (; tk + 1u < nb_k; tk += 2u) {
            const uint     st0 = st_base + tk;
            const uint     st1 = st0 + 1u;
            const uint16_t dp0 = st_buf.st[st0].d[l_idx];
            const uvec4    qs0 = st_buf.st[st0].qs[l_idx];
            const uint16_t dp1 = st_buf.st[st1].d[l_idx];
            const uvec4    qs1 = st_buf.st[st1].qs[l_idx];
            const uint col4_0  = tk * 16u + kh_col4;
            moe_nvfp4_accum_st(dp0, qs0, col4_0,       x_buf4, acc);
            moe_nvfp4_accum_st(dp1, qs1, col4_0 + 16u, x_buf4, acc);
        }
        if (tk < nb_k) {
            const uint     st0 = st_base + tk;
            const uint16_t dp0 = st_buf.st[st0].d[l_idx];
            const uvec4    qs0 = st_buf.st[st0].qs[l_idx];
            moe_nvfp4_accum_st(dp0, qs0, tk * 16u + kh_col4, x_buf4, acc);
        }
    }

    acc += subgroupShuffleXor(acc, 1u);

    if (kh == 0u && row < pc.N) {
        y_buf.v[row] = acc;
    }

#elif WEIGHT_MODE == 2
    const uint row    = (gl_WorkGroupID.x * 4u + sg_id) * 2u + (lane >> 4);
    const uint lane16 = lane & 15u;

    if (!valid_eid) {
        if (lane16 == 0u && row < pc.N) y_buf.v[row] = 0.0f;
        return;
    }

    float acc = 0.0f;
    if (row < pc.N) {
        const uint64_t w_base = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
        AgxBufQ8_8Blk w_buf   = AgxBufQ8_8Blk(w_base);
        const uint n_full     = pc.K >> 8;
        const uint n_chunks   = (pc.K + 255u) >> 8;
        const uint row_c0     = row * n_chunks;
        const uint d_slot     = lane16 >> 1;
        const uint l16_col4   = lane16 * 4u;

        uint c = 0u;
        for (; c + 1u < n_full; c += 2u) {
            const uint     chk0 = row_c0 + c;
            const uint     chk1 = chk0 + 1u;
            const uvec4    qv0  = w_buf.blk[chk0].qs[lane16];
            const uint16_t d0   = w_buf.blk[chk0].d[d_slot];
            const uvec4    qv1  = w_buf.blk[chk1].qs[lane16];
            const uint16_t d1   = w_buf.blk[chk1].d[d_slot];
            const uint col4_0   = c * 64u + l16_col4;
            moe_q8_accum_chk(qv0, d0, col4_0,       x_buf4, acc);
            moe_q8_accum_chk(qv1, d1, col4_0 + 64u, x_buf4, acc);
        }
        for (; c < n_chunks; ++c) {
            const uint k0 = c * 256u + lane16 * 16u;
            if (k0 < pc.K) {
                const uint     chk_idx = row_c0 + c;
                const uvec4    qv      = w_buf.blk[chk_idx].qs[lane16];
                const uint16_t d0      = w_buf.blk[chk_idx].d[d_slot];
                moe_q8_accum_chk(qv, d0, k0 >> 2, x_buf4, acc);
            }
        }
    }

    acc += subgroupShuffleXor(acc, 1u);
    acc += subgroupShuffleXor(acc, 2u);
    acc += subgroupShuffleXor(acc, 4u);
    acc += subgroupShuffleXor(acc, 8u);

    if (lane16 == 0u && row < pc.N) {
        y_buf.v[row] = acc;
    }

#else
    const uint row = gl_WorkGroupID.x * 4u + sg_id;
    if (!valid_eid) {
        if (lane == 0u && row < pc.N) y_buf.v[row] = 0.0f;
        return;
    }

    float acc = 0.0f;
    if (row < pc.N) {
        const uint64_t w_base = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
        const uint K4 = pc.K >> 2;
#if WEIGHT_MODE == 1
        const uint nb_k = pc.K >> 6;
        AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
        const uint blk_row = row * nb_k;
        for (uint b = 0u; b < nb_k; ++b) {
            const uint blk_idx = blk_row + b;
            const uint sub     = lane >> 3;
            const uint j       = lane & 7u;
            const uint qbyte   = uint(raw_buf.blk[blk_idx].qs[sub * 8u + j]);
            const float sc     = agx_ue4m3_to_f32(uint(raw_buf.blk[blk_idx].d[sub]));
            const uint k_lo    = b * 64u + sub * 16u + j;
            acc = fma(agx_e2m1_to_f32(qbyte & 0xFu) * sc, x_buf.v[k_lo], acc);
            acc = fma(agx_e2m1_to_f32(qbyte >> 4)   * sc, x_buf.v[k_lo + 8u], acc);
        }
#elif WEIGHT_MODE == 3
        const uint nb_k = pc.K >> 5;
        AgxBufQ8_0Raw qbuf = AgxBufQ8_0Raw(w_base);
        const uint row_b0 = row * nb_k;
        for (uint b = 0u; b < nb_k; ++b) {
            const uint bidx = row_b0 + b;
            const float sc  = float(unpackFloat2x16(uint(qbuf.blk[bidx].d)).x);
            acc = fma(float(qbuf.blk[bidx].qs[lane]) * sc, x_buf.v[b * 32u + lane], acc);
        }
#elif WEIGHT_MODE == 4
        const uint n_chunks = (pc.K + 511u) >> 9;
        AgxBufMxfp8_16Blk mbuf = AgxBufMxfp8_16Blk(w_base);
        const uint row_c0 = row * n_chunks;
        for (uint c = 0u; c < n_chunks; ++c) {
            const uint cidx = row_c0 + c;
            const uvec4 qv  = mbuf.blk[cidx].qs[lane];
            const float sc  = agx_ue8m0_to_f32(uint(mbuf.blk[cidx].e[lane >> 1]));
            const uint k0   = c * 512u + lane * 16u;
            if (k0 < pc.K) {
                const uint col4 = k0 >> 2;
                float dp = dot(vec4(agx_e4m3_u32_to_f16vec4(qv.x)), x_buf4.v[col4 + 0u])
                         + dot(vec4(agx_e4m3_u32_to_f16vec4(qv.y)), x_buf4.v[col4 + 1u])
                         + dot(vec4(agx_e4m3_u32_to_f16vec4(qv.z)), x_buf4.v[col4 + 2u])
                         + dot(vec4(agx_e4m3_u32_to_f16vec4(qv.w)), x_buf4.v[col4 + 3u]);
                acc = fma(dp, sc, acc);
            }
        }
#elif WEIGHT_MODE == 5
        AgxBufU32R wbuf = AgxBufU32R(w_base + uint64_t(row) * uint64_t(pc.K));
        for (uint col4 = lane; col4 < K4; col4 += 32u) {
            acc += dot(vec4(agx_e4m3_u32_to_f16vec4(wbuf.v[col4])), x_buf4.v[col4]);
        }
#elif WEIGHT_MODE == 6
        AgxBufU16R wbuf = AgxBufU16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            acc = fma(agx_bf16_to_f32(wbuf.v[k]), x_buf.v[k], acc);
        }
#elif WEIGHT_MODE == 7
        AgxBufF16R wbuf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            acc = fma(float(wbuf.v[k]), x_buf.v[k], acc);
        }
#else
        AgxBufF32R wbuf = AgxBufF32R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            acc = fma(wbuf.v[k], x_buf.v[k], acc);
        }
#endif
    }

    float total = subgroupAdd(acc);
    if (lane == 0u && row < pc.N) {
        y_buf.v[row] = total;
    }
#endif
}

// ============================================================================
// Stage 5: Wave 4 Theorem W4.3 — Direct Fused Gate+Up + In-Register SiTU
//          -> SLC moe_inter[M, top_k, n_ff]
//   - ZERO TG SRAM, ZERO WG barriers, reads X ONCE for both gate & up!
//   - grid_x = ceil(N / pairs_per_wg), grid_y = top_k, grid_z = M
//   - NVFP4_32x16: 64 pairs/WG (144 WGs @ M=1, top_k=8, N=1152 -> 14.4 sgs/core!)
//   - Q8_0_8BLK:   8 pairs/WG  (1,152 WGs @ M=1, top_k=8, N=1152)
// ============================================================================
#elif PASS_STAGE == 5

void main() {
    const uint lane   = gl_SubgroupInvocationID; // 0..31
    const uint sg_id  = gl_SubgroupID;           // 0 (NVFP4 32T) or 0..3 (128T)
    const uint k_slot = gl_WorkGroupID.y;        // 0..top_k-1
    const uint tok    = gl_WorkGroupID.z;        // 0..M-1

    if (k_slot >= pc.top_k) {
        return;
    }

    const uint ids_stride = (pc.ids_row_stride != 0u) ? pc.ids_row_stride : pc.top_k;
    const int  raw_eid    = BufI32R(pc.buckets_va).d[tok * ids_stride + k_slot];
    const bool valid_eid  = (raw_eid >= 0) && (uint(raw_eid) < pc.n_ff);
    const bool sep_gu     = (pc.flags & MOE_FLAG_SEPARATE_GU) != 0u;

    const uint     y_slot   = tok * pc.top_k + k_slot;
    const uint64_t x_row_va = pc.x_va + uint64_t(tok)    * uint64_t(pc.K) * 4ul;
    const uint64_t y_row_va = pc.y_va + uint64_t(y_slot) * uint64_t(pc.N) * 4ul;

#if WEIGHT_MODE != 0 && WEIGHT_MODE != 2
    AgxBufF32R  x_buf  = AgxBufF32R(x_row_va);
#endif
    AgxBufVec4R x_buf4 = AgxBufVec4R(x_row_va);
#if WEIGHT_MODE != 0
    AgxBufF32RW y_buf  = AgxBufF32RW(y_row_va);
#endif

#if WEIGHT_MODE == 0
    // Wave 6 Pass-4 AGX_NVFP4_32x16: 64 (gate,up) pairs/WG (4 lockstep SGs sharing L1D X!)
    //   - ZERO barriers, ZERO SRAM, 1x X read shared across gate+up, deferred scale -> <= 64 GPR32!
    const uint half_g   = gl_WorkGroupID.x * 4u + sg_id;
    const uint row_in_h = lane >> 1; // 0..15
    const uint kh       = lane & 1u; // 0 or 1
    const uint row      = half_g * 16u + row_in_h;

    if (!valid_eid) {
        if (kh == 0u && row < pc.N) {
            AgxBufF32RW(y_row_va).v[row] = 0.0f;
        }
        return;
    }

    float acc_g = 0.0f;
    float acc_u = 0.0f;

    if (half_g * 16u < pc.N) {
        const uint64_t w_g_base = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
        const uint64_t w_u_base = (sep_gu ? pc.w_up_va : pc.w_gate_va) + uint64_t(raw_eid) * pc.w_slice_B;
        const uint     half_u   = sep_gu ? half_g : (half_g + (pc.N >> 4));

        AgxBufNvfp4ST st_g = AgxBufNvfp4ST(w_g_base);
        AgxBufNvfp4ST st_u = AgxBufNvfp4ST(w_u_base);

        const uint nb_k      = pc.K >> 6;
        const uint st_g_base = (half_g >> 1) * nb_k;
        const uint st_u_base = (half_u >> 1) * nb_k;
        const uint l_g       = (half_g & 1u) * 32u + lane;
        const uint l_u       = (half_u & 1u) * 32u + lane;
        const uint kh_col4   = kh * 8u;

        for (uint tk = 0u; tk < nb_k; ++tk) {
            const uint     sg_idx = st_g_base + tk;
            const uint     su_idx = st_u_base + tk;
            const uint16_t dg     = st_g.st[sg_idx].d[l_g];
            const uvec4    qg     = st_g.st[sg_idx].qs[l_g];
            const uint16_t du     = st_u.st[su_idx].d[l_u];
            const uvec4    qu     = st_u.st[su_idx].qs[l_u];
            const uint     col4   = tk * 16u + kh_col4;

#if PREC_F32 == 0
            f16vec4 hx0 = f16vec4(x_buf4.v[col4 + 0u]), hx1 = f16vec4(x_buf4.v[col4 + 1u]);
            float16_t dg0 = moe_dot_e2m1_u32_f16x2(qg.x, hx0, hx1);
            float16_t du0 = moe_dot_e2m1_u32_f16x2(qu.x, hx0, hx1);
            hx0 = f16vec4(x_buf4.v[col4 + 2u]); hx1 = f16vec4(x_buf4.v[col4 + 3u]);
            dg0 += moe_dot_e2m1_u32_f16x2(qg.y, hx0, hx1);
            du0 += moe_dot_e2m1_u32_f16x2(qu.y, hx0, hx1);
            const vec2 scg = agx_ue4m3_pair_to_vec2(dg);
            const vec2 scu = agx_ue4m3_pair_to_vec2(du);
            acc_g = fma(float(dg0), scg.x, acc_g);
            acc_u = fma(float(du0), scu.x, acc_u);

            hx0 = f16vec4(x_buf4.v[col4 + 4u]); hx1 = f16vec4(x_buf4.v[col4 + 5u]);
            float16_t dg1 = moe_dot_e2m1_u32_f16x2(qg.z, hx0, hx1);
            float16_t du1 = moe_dot_e2m1_u32_f16x2(qu.z, hx0, hx1);
            hx0 = f16vec4(x_buf4.v[col4 + 6u]); hx1 = f16vec4(x_buf4.v[col4 + 7u]);
            dg1 += moe_dot_e2m1_u32_f16x2(qg.w, hx0, hx1);
            du1 += moe_dot_e2m1_u32_f16x2(qu.w, hx0, hx1);
            acc_g = fma(float(dg1), scg.y, acc_g);
            acc_u = fma(float(du1), scu.y, acc_u);
#else
            const vec2 scg = agx_ue4m3_pair_to_vec2(dg);
            const vec2 scu = agx_ue4m3_pair_to_vec2(du);
            vec4 x0 = x_buf4.v[col4 + 0u], x1 = x_buf4.v[col4 + 1u];
            float dg0 = moe_dot_e2m1_u32_f32x2(qg.x, x0, x1);
            float du0 = moe_dot_e2m1_u32_f32x2(qu.x, x0, x1);
            x0 = x_buf4.v[col4 + 2u]; x1 = x_buf4.v[col4 + 3u];
            dg0 += moe_dot_e2m1_u32_f32x2(qg.y, x0, x1);
            du0 += moe_dot_e2m1_u32_f32x2(qu.y, x0, x1);
            acc_g = fma(dg0, scg.x, acc_g);
            acc_u = fma(du0, scu.x, acc_u);

            x0 = x_buf4.v[col4 + 4u]; x1 = x_buf4.v[col4 + 5u];
            float dg1 = moe_dot_e2m1_u32_f32x2(qg.z, x0, x1);
            float du1 = moe_dot_e2m1_u32_f32x2(qu.z, x0, x1);
            x0 = x_buf4.v[col4 + 6u]; x1 = x_buf4.v[col4 + 7u];
            dg1 += moe_dot_e2m1_u32_f32x2(qg.w, x0, x1);
            du1 += moe_dot_e2m1_u32_f32x2(qu.w, x0, x1);
            acc_g = fma(dg1, scg.y, acc_g);
            acc_u = fma(du1, scu.y, acc_u);
#endif
        }
    }

    acc_g += subgroupShuffleXor(acc_g, 1u);
    acc_u += subgroupShuffleXor(acc_u, 1u);

    if (kh == 0u && row < pc.N) {
        const float s2 = (pc.w_scale_va != 0ul) ? AgxBufF32R(pc.w_scale_va).v[uint(raw_eid)] : 1.0f;
        AgxBufF32RW(y_row_va).v[row] = eval_moe_act(acc_g * s2, acc_u * s2);
    }

#elif WEIGHT_MODE == 2
    // AGX_Q8_0_8BLK: 8 (gate,up) pairs/WG (4 sgs x 2 pairs/sg, 16 lanes/pair, 1x X load!)
    const uint row    = (gl_WorkGroupID.x * 4u + sg_id) * 2u + (lane >> 4);
    const uint lane16 = lane & 15u;

    if (!valid_eid) {
        if (lane16 == 0u && row < pc.N) y_buf.v[row] = 0.0f;
        return;
    }

    float acc_g = 0.0f;
    float acc_u = 0.0f;
    if (row < pc.N) {
        const uint64_t w_g_base = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
        const uint64_t w_u_base = (sep_gu ? pc.w_up_va : pc.w_gate_va) + uint64_t(raw_eid) * pc.w_slice_B;
        const uint     row_u    = sep_gu ? row : (pc.N + row);
        AgxBufQ8_8Blk wg_buf    = AgxBufQ8_8Blk(w_g_base);
        AgxBufQ8_8Blk wu_buf    = AgxBufQ8_8Blk(w_u_base);
        const uint n_chunks     = (pc.K + 255u) >> 8;
        const uint row_g0       = row   * n_chunks;
        const uint row_u0       = row_u * n_chunks;
        const uint d_slot       = lane16 >> 1;

        for (uint c = 0u; c < n_chunks; ++c) {
            const uint k0 = c * 256u + lane16 * 16u;
            if (k0 < pc.K) {
                const uint     cg   = row_g0 + c;
                const uint     cu   = row_u0 + c;
                const uvec4    qvg  = wg_buf.blk[cg].qs[lane16];
                const float    dg   = float(unpackFloat2x16(uint(wg_buf.blk[cg].d[d_slot])).x);
                const uvec4    qvu  = wu_buf.blk[cu].qs[lane16];
                const float    du   = float(unpackFloat2x16(uint(wu_buf.blk[cu].d[d_slot])).x);
                const uint     col4 = k0 >> 2;
                const vec4     x0   = x_buf4.v[col4 + 0u];
                const vec4     x1   = x_buf4.v[col4 + 1u];
                const vec4     x2   = x_buf4.v[col4 + 2u];
                const vec4     x3   = x_buf4.v[col4 + 3u];
                float dpg = dot(vec4(agx_q8_u32_magic_to_f16vec4(qvg.x)), x0)
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qvg.y)), x1)
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qvg.z)), x2)
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qvg.w)), x3);
                acc_g = fma(dpg, dg, acc_g);
                float dpu = dot(vec4(agx_q8_u32_magic_to_f16vec4(qvu.x)), x0)
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qvu.y)), x1)
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qvu.z)), x2)
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qvu.w)), x3);
                acc_u = fma(dpu, du, acc_u);
            }
        }
    }

    acc_g += subgroupShuffleXor(acc_g, 1u); acc_u += subgroupShuffleXor(acc_u, 1u);
    acc_g += subgroupShuffleXor(acc_g, 2u); acc_u += subgroupShuffleXor(acc_u, 2u);
    acc_g += subgroupShuffleXor(acc_g, 4u); acc_u += subgroupShuffleXor(acc_u, 4u);
    acc_g += subgroupShuffleXor(acc_g, 8u); acc_u += subgroupShuffleXor(acc_u, 8u);

    if (lane16 == 0u && row < pc.N) {
        const float s2 = (pc.w_scale_va != 0ul) ? AgxBufF32R(pc.w_scale_va).v[uint(raw_eid)] : 1.0f;
        y_buf.v[row] = eval_moe_act(acc_g * s2, acc_u * s2);
    }

#else
    // All other weight modes: 4 (gate,up) pairs/WG (32 lanes across K)
    const uint row = gl_WorkGroupID.x * 4u + sg_id;
    if (!valid_eid) {
        if (lane == 0u && row < pc.N) y_buf.v[row] = 0.0f;
        return;
    }

    float acc_g = 0.0f;
    float acc_u = 0.0f;
    if (row < pc.N) {
        const uint64_t w_g_base = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
        const uint64_t w_u_base = (sep_gu ? pc.w_up_va : pc.w_gate_va) + uint64_t(raw_eid) * pc.w_slice_B;
        const uint     row_u    = sep_gu ? row : (pc.N + row);
        const uint     K4       = pc.K >> 2;
#if WEIGHT_MODE == 1
        const uint nb_k = pc.K >> 6;
        AgxBufNvfp4Raw rg = AgxBufNvfp4Raw(w_g_base);
        AgxBufNvfp4Raw ru = AgxBufNvfp4Raw(w_u_base);
        const uint bg0 = row   * nb_k;
        const uint bu0 = row_u * nb_k;
        for (uint b = 0u; b < nb_k; ++b) {
            const uint sub  = lane >> 3;
            const uint j    = lane & 7u;
            const uint k_lo = b * 64u + sub * 16u + j;
            const float xlo = x_buf.v[k_lo];
            const float xhi = x_buf.v[k_lo + 8u];
            const uint qb_g = uint(rg.blk[bg0 + b].qs[sub * 8u + j]);
            const float scg = agx_ue4m3_to_f32(uint(rg.blk[bg0 + b].d[sub]));
            acc_g = fma(agx_e2m1_to_f32(qb_g & 0xFu) * scg, xlo, acc_g);
            acc_g = fma(agx_e2m1_to_f32(qb_g >> 4)   * scg, xhi, acc_g);
            const uint qb_u = uint(ru.blk[bu0 + b].qs[sub * 8u + j]);
            const float scu = agx_ue4m3_to_f32(uint(ru.blk[bu0 + b].d[sub]));
            acc_u = fma(agx_e2m1_to_f32(qb_u & 0xFu) * scu, xlo, acc_u);
            acc_u = fma(agx_e2m1_to_f32(qb_u >> 4)   * scu, xhi, acc_u);
        }
#elif WEIGHT_MODE == 3
        const uint nb_k = pc.K >> 5;
        AgxBufQ8_0Raw qg = AgxBufQ8_0Raw(w_g_base);
        AgxBufQ8_0Raw qu = AgxBufQ8_0Raw(w_u_base);
        const uint bg0 = row   * nb_k;
        const uint bu0 = row_u * nb_k;
        for (uint b = 0u; b < nb_k; ++b) {
            const float xv  = x_buf.v[b * 32u + lane];
            const float scg = float(unpackFloat2x16(uint(qg.blk[bg0 + b].d)).x);
            const float scu = float(unpackFloat2x16(uint(qu.blk[bu0 + b].d)).x);
            acc_g = fma(float(qg.blk[bg0 + b].qs[lane]) * scg, xv, acc_g);
            acc_u = fma(float(qu.blk[bu0 + b].qs[lane]) * scu, xv, acc_u);
        }
#elif WEIGHT_MODE == 4
        const uint n_chunks = (pc.K + 511u) >> 9;
        AgxBufMxfp8_16Blk mg = AgxBufMxfp8_16Blk(w_g_base);
        AgxBufMxfp8_16Blk mu = AgxBufMxfp8_16Blk(w_u_base);
        const uint cg0 = row   * n_chunks;
        const uint cu0 = row_u * n_chunks;
        for (uint c = 0u; c < n_chunks; ++c) {
            const uint k0 = c * 512u + lane * 16u;
            if (k0 < pc.K) {
                const uint col4 = k0 >> 2;
                const vec4 x0 = x_buf4.v[col4 + 0u];
                const vec4 x1 = x_buf4.v[col4 + 1u];
                const vec4 x2 = x_buf4.v[col4 + 2u];
                const vec4 x3 = x_buf4.v[col4 + 3u];
                const uvec4 qvg = mg.blk[cg0 + c].qs[lane];
                const float scg = agx_ue8m0_to_f32(uint(mg.blk[cg0 + c].e[lane >> 1]));
                float dpg = dot(vec4(agx_e4m3_u32_to_f16vec4(qvg.x)), x0)
                          + dot(vec4(agx_e4m3_u32_to_f16vec4(qvg.y)), x1)
                          + dot(vec4(agx_e4m3_u32_to_f16vec4(qvg.z)), x2)
                          + dot(vec4(agx_e4m3_u32_to_f16vec4(qvg.w)), x3);
                acc_g = fma(dpg, scg, acc_g);
                const uvec4 qvu = mu.blk[cu0 + c].qs[lane];
                const float scu = agx_ue8m0_to_f32(uint(mu.blk[cu0 + c].e[lane >> 1]));
                float dpu = dot(vec4(agx_e4m3_u32_to_f16vec4(qvu.x)), x0)
                          + dot(vec4(agx_e4m3_u32_to_f16vec4(qvu.y)), x1)
                          + dot(vec4(agx_e4m3_u32_to_f16vec4(qvu.z)), x2)
                          + dot(vec4(agx_e4m3_u32_to_f16vec4(qvu.w)), x3);
                acc_u = fma(dpu, scu, acc_u);
            }
        }
#elif WEIGHT_MODE == 5
        AgxBufU32R wg = AgxBufU32R(w_g_base + uint64_t(row)   * uint64_t(pc.K));
        AgxBufU32R wu = AgxBufU32R(w_u_base + uint64_t(row_u) * uint64_t(pc.K));
        for (uint col4 = lane; col4 < K4; col4 += 32u) {
            const vec4 xv = x_buf4.v[col4];
            acc_g += dot(vec4(agx_e4m3_u32_to_f16vec4(wg.v[col4])), xv);
            acc_u += dot(vec4(agx_e4m3_u32_to_f16vec4(wu.v[col4])), xv);
        }
#elif WEIGHT_MODE == 6
        AgxBufU16R wg = AgxBufU16R(w_g_base + uint64_t(row)   * uint64_t(pc.K) * 2ul);
        AgxBufU16R wu = AgxBufU16R(w_u_base + uint64_t(row_u) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float xv = x_buf.v[k];
            acc_g = fma(agx_bf16_to_f32(wg.v[k]), xv, acc_g);
            acc_u = fma(agx_bf16_to_f32(wu.v[k]), xv, acc_u);
        }
#elif WEIGHT_MODE == 7
        AgxBufF16R wg = AgxBufF16R(w_g_base + uint64_t(row)   * uint64_t(pc.K) * 2ul);
        AgxBufF16R wu = AgxBufF16R(w_u_base + uint64_t(row_u) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float xv = x_buf.v[k];
            acc_g = fma(float(wg.v[k]), xv, acc_g);
            acc_u = fma(float(wu.v[k]), xv, acc_u);
        }
#else
        AgxBufF32R wg = AgxBufF32R(w_g_base + uint64_t(row)   * uint64_t(pc.K) * 4ul);
        AgxBufF32R wu = AgxBufF32R(w_u_base + uint64_t(row_u) * uint64_t(pc.K) * 4ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float xv = x_buf.v[k];
            acc_g = fma(wg.v[k], xv, acc_g);
            acc_u = fma(wu.v[k], xv, acc_u);
        }
#endif
    }

    float tot_g = subgroupAdd(acc_g);
    float tot_u = subgroupAdd(acc_u);
    if (lane == 0u && row < pc.N) {
        const float s2 = (pc.w_scale_va != 0ul) ? AgxBufF32R(pc.w_scale_va).v[uint(raw_eid)] : 1.0f;
        y_buf.v[row] = eval_moe_act(tot_g * s2, tot_u * s2);
    }
#endif
}

// ============================================================================
// Stage 6: Wave 4 Theorem W4.3 — Direct Fused Down + Exact Sequential Weighted-Sum
//          + Optional Residual Add -> h_out[M, n_embd]
//   - 4 simdgroups split k_slot = 0..top_k-1 in parallel -> 4x MLP DRAM hiding!
//   - ZERO atomicAddF32, ZERO moe_zero_out, 0-ULP sequential precise-float wsum!
//   - grid_x = ceil(N / rows_per_wg), grid_y = 1, grid_z = M
//   - NVFP4_32x16: 16 rows/WG (144 WGs @ N=2304, M=1 -> 14.4 sgs/core, 1 KB SRAM!)
//   - Q8_0_8BLK:   2 rows/WG  (1,152 WGs @ N=2304, M=1, 128 B SRAM!)
// ============================================================================
#elif PASS_STAGE == 6

#if WEIGHT_MODE == 0
shared float sh_exp[16][16];
#elif WEIGHT_MODE == 2
shared float sh_exp[16][2];
#else
shared float sh_exp[16];
#endif

void main() {
    const uint lane       = gl_SubgroupInvocationID; // 0..31
    const uint sg_id      = gl_SubgroupID;           // 0..3
    const uint tok        = gl_WorkGroupID.z;        // 0..M-1
    const uint ids_stride = (pc.ids_row_stride != 0u) ? pc.ids_row_stride : pc.top_k;
    const float exp_scale = (pc.situ_beta != 0.0f) ? pc.situ_beta : 1.0f;
    const bool exact_ord  = (pc.top_k <= 16u);
    const uint n_slots    = exact_ord ? pc.top_k : 4u;

    BufI32R    ids_buf = BufI32R(pc.buckets_va);
    AgxBufF32R w_buf_r = AgxBufF32R(pc.sorted_w_va);
    const bool has_w   = (pc.sorted_w_va != 0ul);

#if WEIGHT_MODE == 0
    // Wave 6 Pass-3 AGX_NVFP4_32x16: 16 rows/WG, 4 sgs/WG (local_size_x=128 -> 6 WGs/core = 24 SGs/core!)
    //   - Clean inline buf ptrs + 1x qs0 -> <= 58-60 GPR32, 1 KB SRAM, 0-ULP sequential sum!
    const uint half_idx = gl_WorkGroupID.x;
    const uint tn       = half_idx >> 1;
    const uint sub_s    = half_idx & 1u;
    const uint row_in_h = lane >> 1; // 0..15
    const uint kh       = lane & 1u; // 0 or 1
    const uint row      = half_idx * 16u + row_in_h;

    if (half_idx * 16u >= pc.N) {
        return;
    }

    const uint nb_k    = pc.K >> 6;
    const uint st_base = tn * nb_k;
    const uint l_idx   = sub_s * 32u + lane;
    const uint kh_col4 = kh * 8u;

    float sg_acc = 0.0f;
    for (uint k_slot = sg_id; k_slot < pc.top_k; k_slot += 4u) {
        const int  raw_eid   = BufI32R(pc.buckets_va).d[tok * ids_stride + k_slot];
        const bool valid_eid = (raw_eid >= 0) && (uint(raw_eid) < pc.n_ff);
        float acc = 0.0f;
        if (valid_eid) {
            const uint     x_slot   = tok * pc.top_k + k_slot;
            const uint64_t x_row_va = pc.x_va + uint64_t(x_slot) * uint64_t(pc.K) * 4ul;
            AgxBufVec4R    x_buf4   = AgxBufVec4R(x_row_va);
            const uint64_t w_base   = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
            AgxBufNvfp4ST  st_buf   = AgxBufNvfp4ST(w_base);

            for (uint tk = 0u; tk < nb_k; ++tk) {
                const uint     st0 = st_base + tk;
                const uint16_t dp0 = st_buf.st[st0].d[l_idx];
                const uvec4    qs0 = st_buf.st[st0].qs[l_idx];
                moe_nvfp4_accum_st(dp0, qs0, tk * 16u + kh_col4, x_buf4, acc);
            }
        }
        acc += subgroupShuffleXor(acc, 1u);
        const float s2 = (valid_eid && pc.w_scale_va != 0ul) ? AgxBufF32R(pc.w_scale_va).v[uint(raw_eid)] : 1.0f;
        const float wt = (has_w ? AgxBufF32R(pc.sorted_w_va).v[tok * pc.top_k + k_slot] : 1.0f) * exp_scale;
        precise float scaled = acc * s2;
        precise float prod   = scaled * wt;
        if (exact_ord) {
            if (kh == 0u) {
                sh_exp[k_slot][row_in_h] = prod;
            }
        } else {
            sg_acc += prod;
        }
    }
    if (!exact_ord && kh == 0u) {
        sh_exp[sg_id][row_in_h] = sg_acc;
    }
    barrier();

    if (sg_id == 0u && kh == 0u && row < pc.N) {
        precise float total = (n_slots > 0u) ? sh_exp[0][row_in_h] : 0.0f;
        for (uint k = 1u; k < n_slots; ++k) {
            total = total + sh_exp[k][row_in_h];
        }
        if (pc.w_up_va != 0ul) {
            total = total + AgxBufF32R(pc.w_up_va).v[tok * pc.N + row];
        }
        AgxBufF32RW(pc.y_va).v[tok * pc.N + row] = total;
    }

#elif WEIGHT_MODE == 2
    // AGX_Q8_0_8BLK: 2 rows/WG (16 lanes/row), 4 sgs split top_k experts in parallel!
    const uint r_half   = lane >> 4; // 0 or 1
    const uint lane16   = lane & 15u;
    const uint row      = gl_WorkGroupID.x * 2u + r_half;
    const uint n_full   = pc.K >> 8;
    const uint n_chunks = (pc.K + 255u) >> 8;
    const uint row_c0   = row * n_chunks;
    const uint d_slot   = lane16 >> 1;
    const uint l16_col4 = lane16 * 4u;

    float sg_acc = 0.0f;
    for (uint k_slot = sg_id; k_slot < pc.top_k; k_slot += 4u) {
        const int  raw_eid   = ids_buf.d[tok * ids_stride + k_slot];
        const bool valid_eid = (raw_eid >= 0) && (uint(raw_eid) < pc.n_ff) && (row < pc.N);
        float acc = 0.0f;
        if (valid_eid) {
            const uint     x_slot   = tok * pc.top_k + k_slot;
            const uint64_t x_row_va = pc.x_va + uint64_t(x_slot) * uint64_t(pc.K) * 4ul;
            AgxBufVec4R    x_buf4   = AgxBufVec4R(x_row_va);
            const uint64_t w_base   = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
            AgxBufQ8_8Blk  w_buf    = AgxBufQ8_8Blk(w_base);

            uint c = 0u;
            for (; c + 1u < n_full; c += 2u) {
                const uint     chk0 = row_c0 + c;
                const uint     chk1 = chk0 + 1u;
                const uvec4    qv0  = w_buf.blk[chk0].qs[lane16];
                const uint16_t d0   = w_buf.blk[chk0].d[d_slot];
                const uvec4    qv1  = w_buf.blk[chk1].qs[lane16];
                const uint16_t d1   = w_buf.blk[chk1].d[d_slot];
                const uint col4_0   = c * 64u + l16_col4;
                moe_q8_accum_chk(qv0, d0, col4_0,       x_buf4, acc);
                moe_q8_accum_chk(qv1, d1, col4_0 + 64u, x_buf4, acc);
            }
            for (; c < n_chunks; ++c) {
                const uint k0 = c * 256u + lane16 * 16u;
                if (k0 < pc.K) {
                    const uint     chk_idx = row_c0 + c;
                    const uvec4    qv      = w_buf.blk[chk_idx].qs[lane16];
                    const uint16_t d0      = w_buf.blk[chk_idx].d[d_slot];
                    moe_q8_accum_chk(qv, d0, k0 >> 2, x_buf4, acc);
                }
            }
        }
        acc += subgroupShuffleXor(acc, 1u);
        acc += subgroupShuffleXor(acc, 2u);
        acc += subgroupShuffleXor(acc, 4u);
        acc += subgroupShuffleXor(acc, 8u);
        const float s2 = (valid_eid && pc.w_scale_va != 0ul) ? AgxBufF32R(pc.w_scale_va).v[uint(raw_eid)] : 1.0f;
        const float wt = (has_w ? w_buf_r.v[tok * pc.top_k + k_slot] : 1.0f) * exp_scale;
        precise float scaled = acc * s2;
        precise float prod   = scaled * wt;
        if (exact_ord) {
            if (lane16 == 0u) {
                sh_exp[k_slot][r_half] = prod;
            }
        } else {
            sg_acc += prod;
        }
    }
    if (!exact_ord && lane16 == 0u) {
        sh_exp[sg_id][r_half] = sg_acc;
    }
    barrier();

    if (sg_id == 0u && lane16 == 0u && row < pc.N) {
        precise float total = (n_slots > 0u) ? sh_exp[0][r_half] : 0.0f;
        for (uint k = 1u; k < n_slots; ++k) {
            total = total + sh_exp[k][r_half];
        }
        if (pc.w_up_va != 0ul) {
            total = total + AgxBufF32R(pc.w_up_va).v[tok * pc.N + row];
        }
        AgxBufF32RW(pc.y_va).v[tok * pc.N + row] = total;
    }

#else
    // All other weight modes: 1 row/WG, 4 sgs split top_k experts, 32 lanes across K
    const uint row = gl_WorkGroupID.x;
    if (row >= pc.N) {
        return;
    }
    const uint K4 = pc.K >> 2;

    float sg_acc = 0.0f;
    for (uint k_slot = sg_id; k_slot < pc.top_k; k_slot += 4u) {
        const int  raw_eid   = ids_buf.d[tok * ids_stride + k_slot];
        const bool valid_eid = (raw_eid >= 0) && (uint(raw_eid) < pc.n_ff);
        float acc = 0.0f;
        if (valid_eid) {
            const uint     x_slot   = tok * pc.top_k + k_slot;
            const uint64_t x_row_va = pc.x_va + uint64_t(x_slot) * uint64_t(pc.K) * 4ul;
            AgxBufF32R     x_buf    = AgxBufF32R(x_row_va);
            AgxBufVec4R    x_buf4   = AgxBufVec4R(x_row_va);
            const uint64_t w_base   = pc.w_gate_va + uint64_t(raw_eid) * pc.w_slice_B;
#if WEIGHT_MODE == 1
            const uint nb_k = pc.K >> 6;
            AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
            const uint blk_row = row * nb_k;
            for (uint b = 0u; b < nb_k; ++b) {
                const uint blk_idx = blk_row + b;
                const uint sub     = lane >> 3;
                const uint j       = lane & 7u;
                const uint qbyte   = uint(raw_buf.blk[blk_idx].qs[sub * 8u + j]);
                const float sc     = agx_ue4m3_to_f32(uint(raw_buf.blk[blk_idx].d[sub]));
                const uint k_lo    = b * 64u + sub * 16u + j;
                acc = fma(agx_e2m1_to_f32(qbyte & 0xFu) * sc, x_buf.v[k_lo], acc);
                acc = fma(agx_e2m1_to_f32(qbyte >> 4)   * sc, x_buf.v[k_lo + 8u], acc);
            }
#elif WEIGHT_MODE == 3
            const uint nb_k = pc.K >> 5;
            AgxBufQ8_0Raw qbuf = AgxBufQ8_0Raw(w_base);
            const uint row_b0 = row * nb_k;
            for (uint b = 0u; b < nb_k; ++b) {
                const uint bidx = row_b0 + b;
                const float sc  = float(unpackFloat2x16(uint(qbuf.blk[bidx].d)).x);
                acc = fma(float(qbuf.blk[bidx].qs[lane]) * sc, x_buf.v[b * 32u + lane], acc);
            }
#elif WEIGHT_MODE == 4
            const uint n_chunks = (pc.K + 511u) >> 9;
            AgxBufMxfp8_16Blk mbuf = AgxBufMxfp8_16Blk(w_base);
            const uint row_c0 = row * n_chunks;
            for (uint c = 0u; c < n_chunks; ++c) {
                const uint cidx = row_c0 + c;
                const uvec4 qv  = mbuf.blk[cidx].qs[lane];
                const float sc  = agx_ue8m0_to_f32(uint(mbuf.blk[cidx].e[lane >> 1]));
                const uint k0   = c * 512u + lane * 16u;
                if (k0 < pc.K) {
                    const uint col4 = k0 >> 2;
                    float dp = dot(vec4(agx_e4m3_u32_to_f16vec4(qv.x)), x_buf4.v[col4 + 0u])
                             + dot(vec4(agx_e4m3_u32_to_f16vec4(qv.y)), x_buf4.v[col4 + 1u])
                             + dot(vec4(agx_e4m3_u32_to_f16vec4(qv.z)), x_buf4.v[col4 + 2u])
                             + dot(vec4(agx_e4m3_u32_to_f16vec4(qv.w)), x_buf4.v[col4 + 3u]);
                    acc = fma(dp, sc, acc);
                }
            }
#elif WEIGHT_MODE == 5
            AgxBufU32R wbuf = AgxBufU32R(w_base + uint64_t(row) * uint64_t(pc.K));
            for (uint col4 = lane; col4 < K4; col4 += 32u) {
                acc += dot(vec4(agx_e4m3_u32_to_f16vec4(wbuf.v[col4])), x_buf4.v[col4]);
            }
#elif WEIGHT_MODE == 6
            AgxBufU16R wbuf = AgxBufU16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
            for (uint k = lane; k < pc.K; k += 32u) {
                acc = fma(agx_bf16_to_f32(wbuf.v[k]), x_buf.v[k], acc);
            }
#elif WEIGHT_MODE == 7
            AgxBufF16R wbuf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
            for (uint k = lane; k < pc.K; k += 32u) {
                acc = fma(float(wbuf.v[k]), x_buf.v[k], acc);
            }
#else
            AgxBufF32R wbuf = AgxBufF32R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
            for (uint k = lane; k < pc.K; k += 32u) {
                acc = fma(wbuf.v[k], x_buf.v[k], acc);
            }
#endif
        }
        float tot_k = subgroupAdd(acc);
        const float s2 = (valid_eid && pc.w_scale_va != 0ul) ? AgxBufF32R(pc.w_scale_va).v[uint(raw_eid)] : 1.0f;
        const float wt = (has_w ? w_buf_r.v[tok * pc.top_k + k_slot] : 1.0f) * exp_scale;
        precise float scaled = tot_k * s2;
        precise float prod   = scaled * wt;
        if (exact_ord) {
            if (lane == 0u) {
                sh_exp[k_slot] = prod;
            }
        } else {
            sg_acc += prod;
        }
    }
    if (!exact_ord && lane == 0u) {
        sh_exp[sg_id] = sg_acc;
    }
    barrier();

    if (sg_id == 0u && lane == 0u) {
        precise float total = (n_slots > 0u) ? sh_exp[0] : 0.0f;
        for (uint k = 1u; k < n_slots; ++k) {
            total = total + sh_exp[k];
        }
        if (pc.w_up_va != 0ul) {
            total = total + AgxBufF32R(pc.w_up_va).v[tok * pc.N + row];
        }
        AgxBufF32RW(pc.y_va).v[tok * pc.N + row] = total;
    }
#endif
}

// ============================================================================
// Stages 0 & 1: Lean Array-Free Predicated K-Coalesced Vec-Mat (M_bucket <= 4!)
//   - NVFP4_32x16: explicit scalar a0..a3 + clamped xb0..xb3, WG-uniform m_cnt,
//     16-elem FP16 sub-block dot -> 1 scale FMA/sub-block (<=50 GPR32, 0:0 spills!)
//   - Q8_0_8BLK:   2 rows/sg (4 pairs/WG stage 0, 8 rows/WG stage 1 -> ZERO r2 loop!),
//     explicit scalar a0..a3 + q/128 magic-norm ffma16 (<=48 GPR32, 0:0 spills!)
// ============================================================================
#elif PASS_STAGE == 0 || PASS_STAGE == 1

#if PASS_STAGE == 0
#if WEIGHT_MODE == 2
shared float sh_gate[BATCH_CAP][4];
shared float sh_up[BATCH_CAP][4];
#else
shared float sh_gate[BATCH_CAP][32];
shared float sh_up[BATCH_CAP][32];
#endif
#endif

#if BATCH_CAP > 1
shared uint sh_tok[BATCH_CAP];
shared uint sh_xrow[BATCH_CAP];
#if PASS_STAGE == 1
shared uint sh_ksl[BATCH_CAP];
#endif
#if PREC_F32 == 0
shared uint sh_xb[BATCH_CAP];
#if WEIGHT_MODE == 0
// Wave 5 Pass-2: Lean double-buffered FP16 X staging (1 super-tile = 64 K = 16 f16vec4/tok):
//   2 buffers x BATCH_CAP tokens x 16 f16vec4 = 1.0 KB (cap 4) / 2.0 KB (cap 8) SRAM!
//   <= 1 vec4 load/thread (ZERO loop!), 100% hardware broadcast, <= 60 GPR32, ~1.2K instrs!
shared f16vec4 sh_x_nv[2][BATCH_CAP][16];

void moe_nvfp4_accum_shx(uint16_t dp, uvec4 qs, uint buf, uint x_off, uint m_cnt,
                         inout float acc[BATCH_CAP]) {
    // Lean <= 64 GPR32 dot: zero w0..w3 (saves 8 GPR32!) & zero d[BATCH_CAP] array!
    const vec2 sc = agx_ue4m3_pair_to_vec2(dp);
    {
        float16_t d0 = moe_dot_e2m1_u32_f16x2(qs.x, sh_x_nv[buf][0][x_off + 0u], sh_x_nv[buf][0][x_off + 1u])
                     + moe_dot_e2m1_u32_f16x2(qs.y, sh_x_nv[buf][0][x_off + 2u], sh_x_nv[buf][0][x_off + 3u]);
        acc[0] = fma(float(d0), sc.x, acc[0]);
        float16_t d1 = moe_dot_e2m1_u32_f16x2(qs.x, sh_x_nv[buf][1][x_off + 0u], sh_x_nv[buf][1][x_off + 1u])
                     + moe_dot_e2m1_u32_f16x2(qs.y, sh_x_nv[buf][1][x_off + 2u], sh_x_nv[buf][1][x_off + 3u]);
        acc[1] = fma(float(d1), sc.x, acc[1]);
        for (uint m = 2u; m < uint(BATCH_CAP); ++m) {
            if (m < m_cnt) {
                float16_t dm = moe_dot_e2m1_u32_f16x2(qs.x, sh_x_nv[buf][m][x_off + 0u], sh_x_nv[buf][m][x_off + 1u])
                             + moe_dot_e2m1_u32_f16x2(qs.y, sh_x_nv[buf][m][x_off + 2u], sh_x_nv[buf][m][x_off + 3u]);
                acc[m] = fma(float(dm), sc.x, acc[m]);
            }
        }
    }
    {
        float16_t d0 = moe_dot_e2m1_u32_f16x2(qs.z, sh_x_nv[buf][0][x_off + 4u], sh_x_nv[buf][0][x_off + 5u])
                     + moe_dot_e2m1_u32_f16x2(qs.w, sh_x_nv[buf][0][x_off + 6u], sh_x_nv[buf][0][x_off + 7u]);
        acc[0] = fma(float(d0), sc.y, acc[0]);
        float16_t d1 = moe_dot_e2m1_u32_f16x2(qs.z, sh_x_nv[buf][1][x_off + 4u], sh_x_nv[buf][1][x_off + 5u])
                     + moe_dot_e2m1_u32_f16x2(qs.w, sh_x_nv[buf][1][x_off + 6u], sh_x_nv[buf][1][x_off + 7u]);
        acc[1] = fma(float(d1), sc.y, acc[1]);
        for (uint m = 2u; m < uint(BATCH_CAP); ++m) {
            if (m < m_cnt) {
                float16_t dm = moe_dot_e2m1_u32_f16x2(qs.z, sh_x_nv[buf][m][x_off + 4u], sh_x_nv[buf][m][x_off + 5u])
                             + moe_dot_e2m1_u32_f16x2(qs.w, sh_x_nv[buf][m][x_off + 6u], sh_x_nv[buf][m][x_off + 7u]);
                acc[m] = fma(float(dm), sc.y, acc[m]);
            }
        }
    }
}
#elif WEIGHT_MODE == 2
// Wave 5: Double-buffered 0-bank-conflict XOR-swizzled FP16 X staging for M_bucket=2..BATCH_CAP Q8_0_8BLK:
//   2 buffers x BATCH_CAP tokens x 256 K-elems (64 f16vec4) = 4 KB (cap 4) / 8 KB (cap 8) SRAM!
shared f16vec4 sh_x_q8[2][BATCH_CAP][64];
#endif
#endif
#endif

void vecmat_rows(
    uint64_t w_base,
    uint     row_base,
    uint     row_limit,
    uint     m_cnt,
    uint     xrow0,
    uint     tok_off,
    bool     x_is_contiguous_assign,
    uint     lane,
    out float res_out[BATCH_CAP],
    out uint  out_row_idx,
    out bool  lane_writes)
{
    AgxBufVec4R x_buf4 = AgxBufVec4R(pc.x_va);
#if WEIGHT_MODE != 0 && WEIGHT_MODE != 2
    AgxBufF32R  x_buf1 = AgxBufF32R(pc.x_va);
#endif
    const uint  K4     = pc.K >> 2;

#if WEIGHT_MODE == 0
    // AGX_NVFP4_32x16: 16 rows/sg (<= 64 GPR32 for max occupancy across 1,000+ DSpark WGs!)
    //   - m_cnt == 1: 0-barrier lean 1x qs0 loop (ZERO live res_out[1..BATCH_CAP-1]!)
    //   - m_cnt == 2..BATCH_CAP (PREC_F32==0): lean 1-ST double-buffered FP16 sh_x_nv (1-2 KB SRAM!)
    const uint half_idx = row_base >> 4;
    const uint tn       = half_idx >> 1;
    const uint sub_s    = half_idx & 1u;
    const uint row_in_h = lane >> 1;
    const uint kh       = lane & 1u;
    out_row_idx         = row_base + row_in_h;
    lane_writes         = (kh == 0u) && (out_row_idx < row_limit);

    AgxBufNvfp4ST st_buf = AgxBufNvfp4ST(w_base);
    const uint nb_k        = pc.K >> 6;
    const uint st_row_base = tn * nb_k;
    const uint l_idx       = sub_s * 32u + lane;
    const uint kh_col4     = kh * 8u;
    const bool row_ok      = (row_base < row_limit);

    const uint xb0 = (x_is_contiguous_assign ? tok_off : xrow0) * K4;

    if (m_cnt == 1u) {
        // Dedicated m_cnt == 1 lean direct loop (0 barriers, 1x qs0 -> <=64 GPR32!)
        float a0 = 0.0f;
        if (row_ok) {
            for (uint tk = 0u; tk < nb_k; ++tk) {
                const uint st0    = st_row_base + tk;
                const vec2 sc0    = agx_ue4m3_pair_to_vec2(st_buf.st[st0].d[l_idx]);
                const uvec4 qs0   = st_buf.st[st0].qs[l_idx];
                const uint col4_0 = xb0 + tk * 16u + kh_col4;
#if PREC_F32 == 0
                float16_t d0 = moe_dot_e2m1_u32_f16x2(qs0.x, f16vec4(x_buf4.v[col4_0 + 0u]), f16vec4(x_buf4.v[col4_0 + 1u]))
                             + moe_dot_e2m1_u32_f16x2(qs0.y, f16vec4(x_buf4.v[col4_0 + 2u]), f16vec4(x_buf4.v[col4_0 + 3u]));
                a0 = fma(float(d0), sc0.x, a0);
                float16_t d1 = moe_dot_e2m1_u32_f16x2(qs0.z, f16vec4(x_buf4.v[col4_0 + 4u]), f16vec4(x_buf4.v[col4_0 + 5u]))
                             + moe_dot_e2m1_u32_f16x2(qs0.w, f16vec4(x_buf4.v[col4_0 + 6u]), f16vec4(x_buf4.v[col4_0 + 7u]));
                a0 = fma(float(d1), sc0.y, a0);
#else
                float d0 = moe_dot_e2m1_u32_f32x2(qs0.x, x_buf4.v[col4_0 + 0u], x_buf4.v[col4_0 + 1u])
                         + moe_dot_e2m1_u32_f32x2(qs0.y, x_buf4.v[col4_0 + 2u], x_buf4.v[col4_0 + 3u]);
                a0 = fma(d0, sc0.x, a0);
                float d1 = moe_dot_e2m1_u32_f32x2(qs0.z, x_buf4.v[col4_0 + 4u], x_buf4.v[col4_0 + 5u])
                         + moe_dot_e2m1_u32_f32x2(qs0.w, x_buf4.v[col4_0 + 6u], x_buf4.v[col4_0 + 7u]);
                a0 = fma(d1, sc0.y, a0);
#endif
            }
        }
        res_out[0] = a0 + subgroupShuffleXor(a0, 1u);
        for (uint m = 1u; m < uint(BATCH_CAP); ++m) {
            res_out[m] = 0.0f;
        }
    }
#if BATCH_CAP > 1
    else {
        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            res_out[m] = 0.0f;
        }
#if PREC_F32 == 0
        // Lean 1-super-tile double-buffered FP16 sh_x_nv (<= 1 vec4/thread, ZERO loop, 1-2 KB SRAM!)
        // Accumulates directly in res_out (eliminates duplicate acc[BATCH_CAP] -> <= 64 GPR32!)
        const uint tid     = gl_LocalInvocationIndex;
        const uint total_e = m_cnt * 16u; // <= 128 for BATCH_CAP <= 8!
        const uint lm      = tid >> 4;
        const uint idx16   = tid & 15u;
        const bool load_x  = (tid < total_e);
        const uint xb_tid  = load_x ? (sh_xb[lm] + idx16) : 0u;

        if (nb_k > 0u && load_x) {
            sh_x_nv[0][lm][idx16] = f16vec4(x_buf4.v[xb_tid]);
        }
        barrier();

        uint buf = 0u;
        for (uint tk = 0u; tk < nb_k; ++tk) {
            const bool has_next = (tk + 1u < nb_k);

            uvec4    qs0 = uvec4(0u);
            uint16_t dp0 = uint16_t(0u);
            if (row_ok) {
                const uint st0 = st_row_base + tk;
                qs0 = st_buf.st[st0].qs[l_idx];
                dp0 = st_buf.st[st0].d[l_idx];
            }

            if (has_next && load_x) {
                sh_x_nv[buf ^ 1u][lm][idx16] = f16vec4(x_buf4.v[xb_tid + (tk + 1u) * 16u]);
            }

            if (row_ok) {
                moe_nvfp4_accum_shx(dp0, qs0, buf, kh_col4, m_cnt, res_out);
            }

            if (has_next) {
                barrier();
                buf ^= 1u;
            }
        }
#else
        if (row_ok) {
            for (uint tk = 0u; tk < nb_k; ++tk) {
                const uint  st_idx = st_row_base + tk;
                const vec2  scales = agx_ue4m3_pair_to_vec2(st_buf.st[st_idx].d[l_idx]);
                const uvec4 qs     = st_buf.st[st_idx].qs[l_idx];
                const uint  col4   = tk * 16u + kh_col4;

                vec4 w0 = agx_e2m1_u16_to_vec4(qs.x & 0xFFFFu);
                vec4 w1 = agx_e2m1_u16_to_vec4(qs.x >> 16);
                vec4 w2 = agx_e2m1_u16_to_vec4(qs.y & 0xFFFFu);
                vec4 w3 = agx_e2m1_u16_to_vec4(qs.y >> 16);
                for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                    if (m < m_cnt) {
                        const uint xbm = (x_is_contiguous_assign ? (tok_off + m) : sh_xrow[m]) * K4 + col4;
                        float dm = dot(w0, x_buf4.v[xbm + 0u]) + dot(w1, x_buf4.v[xbm + 1u])
                                 + dot(w2, x_buf4.v[xbm + 2u]) + dot(w3, x_buf4.v[xbm + 3u]);
                        res_out[m] = fma(dm, scales.x, res_out[m]);
                    }
                }

                w0 = agx_e2m1_u16_to_vec4(qs.z & 0xFFFFu);
                w1 = agx_e2m1_u16_to_vec4(qs.z >> 16);
                w2 = agx_e2m1_u16_to_vec4(qs.w & 0xFFFFu);
                w3 = agx_e2m1_u16_to_vec4(qs.w >> 16);
                for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                    if (m < m_cnt) {
                        const uint xbm = (x_is_contiguous_assign ? (tok_off + m) : sh_xrow[m]) * K4 + col4;
                        float dm = dot(w0, x_buf4.v[xbm + 4u]) + dot(w1, x_buf4.v[xbm + 5u])
                                 + dot(w2, x_buf4.v[xbm + 6u]) + dot(w3, x_buf4.v[xbm + 7u]);
                        res_out[m] = fma(dm, scales.y, res_out[m]);
                    }
                }
            }
        }
#endif

        res_out[0] += subgroupShuffleXor(res_out[0], 1u);
        res_out[1] += subgroupShuffleXor(res_out[1], 1u);
        for (uint m = 2u; m < uint(BATCH_CAP); ++m) {
            if (m < m_cnt) {
                res_out[m] += subgroupShuffleXor(res_out[m], 1u);
            }
        }
    }
#endif

#elif WEIGHT_MODE == 2
    // AGX_Q8_0_8BLK: 2 rows/sg (16 lanes/row, ZERO outer r2 loop!)
    //   - m_cnt == 1: 0-barrier 2x chunk-unroll direct (515 GB/s!)
    //   - m_cnt == 2..BATCH_CAP (PREC_F32==0): double-buffered 0-bank-conflict XOR-swizzled sh_x_q8!
    const uint lane16 = lane & 15u;
    const uint r_half = lane >> 4; // 0 or 1
    out_row_idx       = row_base + r_half;
    lane_writes       = (lane16 == 0u) && (out_row_idx < row_limit);

    const uint n_full   = pc.K >> 8;
    const uint n_chunks = (pc.K + 255u) >> 8;
    const uint d_slot   = lane16 >> 1;
    const uint l16_col4 = lane16 * 4u;
    AgxBufQ8_8Blk qbuf  = AgxBufQ8_8Blk(w_base);

    const uint xb0 = (x_is_contiguous_assign ? tok_off : xrow0) * K4;

    if (m_cnt == 1u) {
        float a0 = 0.0f;
        if (out_row_idx < row_limit) {
            const uint row_c0 = out_row_idx * n_chunks;
            uint c = 0u;
            for (; c + 1u < n_full; c += 2u) {
                const uint     chk0 = row_c0 + c;
                const uint     chk1 = chk0 + 1u;
                const uvec4    qv0  = qbuf.blk[chk0].qs[lane16];
                const uint16_t d0   = qbuf.blk[chk0].d[d_slot];
                const uvec4    qv1  = qbuf.blk[chk1].qs[lane16];
                const uint16_t d1   = qbuf.blk[chk1].d[d_slot];
                const uint col4_0   = xb0 + c * 64u + l16_col4;
                float dp0 = dot(vec4(agx_q8_u32_magic_to_f16vec4(qv0.x)), x_buf4.v[col4_0 + 0u])
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv0.y)), x_buf4.v[col4_0 + 1u])
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv0.z)), x_buf4.v[col4_0 + 2u])
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv0.w)), x_buf4.v[col4_0 + 3u]);
                a0 = fma(dp0, float(unpackFloat2x16(uint(d0)).x), a0);
                float dp1 = dot(vec4(agx_q8_u32_magic_to_f16vec4(qv1.x)), x_buf4.v[col4_0 + 64u])
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv1.y)), x_buf4.v[col4_0 + 65u])
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv1.z)), x_buf4.v[col4_0 + 66u])
                          + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv1.w)), x_buf4.v[col4_0 + 67u]);
                a0 = fma(dp1, float(unpackFloat2x16(uint(d1)).x), a0);
            }
            for (; c < n_chunks; ++c) {
                const uint k0 = c * 256u + lane16 * 16u;
                if (k0 < pc.K) {
                    const uint  cidx = row_c0 + c;
                    const uvec4 qv   = qbuf.blk[cidx].qs[lane16];
                    const float sc   = float(unpackFloat2x16(uint(qbuf.blk[cidx].d[d_slot])).x);
                    const uint  xo   = xb0 + (k0 >> 2);
                    float dp = dot(vec4(agx_q8_u32_magic_to_f16vec4(qv.x)), x_buf4.v[xo + 0u])
                             + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv.y)), x_buf4.v[xo + 1u])
                             + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv.z)), x_buf4.v[xo + 2u])
                             + dot(vec4(agx_q8_u32_magic_to_f16vec4(qv.w)), x_buf4.v[xo + 3u]);
                    a0 = fma(dp, sc, a0);
                }
            }
        }
        a0 += subgroupShuffleXor(a0, 1u);
        a0 += subgroupShuffleXor(a0, 2u);
        a0 += subgroupShuffleXor(a0, 4u);
        a0 += subgroupShuffleXor(a0, 8u);
        res_out[0] = a0;
        for (uint m = 1u; m < uint(BATCH_CAP); ++m) {
            res_out[m] = 0.0f;
        }
    }
#if BATCH_CAP > 1
    else {
        float acc[BATCH_CAP];
        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            acc[m] = 0.0f;
        }

#if PREC_F32 == 0
        // Double-buffered 0-bank-conflict XOR-swizzled FP16 sh_x_q8 + q/128 magic-norm ffma16!
        const uint tid     = gl_LocalInvocationIndex;
        const uint row_c0  = out_row_idx * n_chunks;
        const bool row_ok  = (out_row_idx < row_limit);
        const uint total_e = m_cnt * 64u;
        const uint s0 =  0u | (lane16 ^ 0u);
        const uint s1 = 16u | (lane16 ^ 4u);
        const uint s2 = 32u | (lane16 ^ 8u);
        const uint s3 = 48u | (lane16 ^ 12u);

        if (n_chunks > 0u) {
            for (uint e = tid; e < total_e; e += 128u) {
                const uint m    = e >> 6;
                const uint idx  = e & 63u;
                const uint swiz = ((idx & 3u) << 4) | ((idx >> 2) ^ ((idx & 3u) << 2));
                sh_x_q8[0][m][swiz] = (idx < K4) ? f16vec4(x_buf4.v[sh_xb[m] + idx]) : f16vec4(float16_t(0.0));
            }
        }
        barrier();

        uint buf = 0u;
        for (uint c = 0u; c < n_chunks; ++c) {
            const uint k0       = c * 256u + lane16 * 16u;
            const bool do_comp  = row_ok && (k0 < pc.K);
            const bool has_next = (c + 1u < n_chunks);

            uvec4 qv   = uvec4(0u);
            float d128 = 0.0f;
            if (do_comp) {
                const uint cidx = row_c0 + c;
                qv   = qbuf.blk[cidx].qs[lane16];
                d128 = float(unpackFloat2x16(uint(qbuf.blk[cidx].d[d_slot])).x) * 128.0f;
            }

            if (has_next) {
                const uint c4_base = (c + 1u) * 64u;
                for (uint e = tid; e < total_e; e += 128u) {
                    const uint m    = e >> 6;
                    const uint idx  = e & 63u;
                    const uint swiz = ((idx & 3u) << 4) | ((idx >> 2) ^ ((idx & 3u) << 2));
                    sh_x_q8[buf ^ 1u][m][swiz] = (c4_base + idx < K4)
                        ? f16vec4(x_buf4.v[sh_xb[m] + c4_base + idx]) : f16vec4(float16_t(0.0));
                }
            }

            if (do_comp) {
                const f16vec4 w0 = agx_q8_u32_magic_norm_to_f16vec4(qv.x);
                const f16vec4 w1 = agx_q8_u32_magic_norm_to_f16vec4(qv.y);
                const f16vec4 w2 = agx_q8_u32_magic_norm_to_f16vec4(qv.z);
                const f16vec4 w3 = agx_q8_u32_magic_norm_to_f16vec4(qv.w);

                float16_t dp0 = dot(w0, sh_x_q8[buf][0][s0]) + dot(w1, sh_x_q8[buf][0][s1])
                              + dot(w2, sh_x_q8[buf][0][s2]) + dot(w3, sh_x_q8[buf][0][s3]);
                acc[0] = fma(float(dp0), d128, acc[0]);
                float16_t dp1 = dot(w0, sh_x_q8[buf][1][s0]) + dot(w1, sh_x_q8[buf][1][s1])
                              + dot(w2, sh_x_q8[buf][1][s2]) + dot(w3, sh_x_q8[buf][1][s3]);
                acc[1] = fma(float(dp1), d128, acc[1]);
                for (uint m = 2u; m < uint(BATCH_CAP); ++m) {
                    if (m < m_cnt) {
                        float16_t dpm = dot(w0, sh_x_q8[buf][m][s0]) + dot(w1, sh_x_q8[buf][m][s1])
                                      + dot(w2, sh_x_q8[buf][m][s2]) + dot(w3, sh_x_q8[buf][m][s3]);
                        acc[m] = fma(float(dpm), d128, acc[m]);
                    }
                }
            }

            if (has_next) {
                barrier();
                buf ^= 1u;
            }
        }
#else
        if (out_row_idx < row_limit) {
            const uint row_c0 = out_row_idx * n_chunks;
            for (uint c = 0u; c < n_chunks; ++c) {
                const uint k0 = c * 256u + lane16 * 16u;
                if (k0 < pc.K) {
                    const uint  cidx = row_c0 + c;
                    const uvec4 qv   = qbuf.blk[cidx].qs[lane16];
                    const uint  col4 = k0 >> 2;
                    const float sc = float(unpackFloat2x16(uint(qbuf.blk[cidx].d[d_slot])).x);
                    const vec4  w0 = vec4(agx_q8_u32_magic_to_f16vec4(qv.x));
                    const vec4  w1 = vec4(agx_q8_u32_magic_to_f16vec4(qv.y));
                    const vec4  w2 = vec4(agx_q8_u32_magic_to_f16vec4(qv.z));
                    const vec4  w3 = vec4(agx_q8_u32_magic_to_f16vec4(qv.w));

                    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                        if (m < m_cnt) {
                            const uint xbm = (x_is_contiguous_assign ? (tok_off + m) : sh_xrow[m]) * K4 + col4;
                            float dpm = dot(w0, x_buf4.v[xbm + 0u]) + dot(w1, x_buf4.v[xbm + 1u])
                                      + dot(w2, x_buf4.v[xbm + 2u]) + dot(w3, x_buf4.v[xbm + 3u]);
                            acc[m] = fma(dpm, sc, acc[m]);
                        }
                    }
                }
            }
        }
#endif

        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            if (m < m_cnt) {
                acc[m] += subgroupShuffleXor(acc[m], 1u);
                acc[m] += subgroupShuffleXor(acc[m], 2u);
                acc[m] += subgroupShuffleXor(acc[m], 4u);
                acc[m] += subgroupShuffleXor(acc[m], 8u);
                res_out[m] = acc[m];
            }
        }
    }
#endif

#else
    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
        res_out[m] = 0.0f;
    }
    out_row_idx = row_base + lane;
    lane_writes = (lane < 16u) && (out_row_idx < row_limit);

    for (uint rr = 0u; rr < 16u; ++rr) {
        const uint row = row_base + rr;
        if (row >= row_limit) {
            break;
        }
        float acc[BATCH_CAP];
        for (uint m = 0u; m < uint(BATCH_CAP); ++m) acc[m] = 0.0f;

#if WEIGHT_MODE == 1
        const uint nb_k = pc.K >> 6;
        AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
        const uint blk_row = row * nb_k;
        for (uint b = 0u; b < nb_k; ++b) {
            const uint blk_idx = blk_row + b;
            const uint sub     = lane >> 3;
            const uint j       = lane & 7u;
            const uint qbyte   = uint(raw_buf.blk[blk_idx].qs[sub * 8u + j]);
            const float sc     = agx_ue4m3_to_f32(uint(raw_buf.blk[blk_idx].d[sub]));
            const float w_lo   = agx_e2m1_to_f32(qbyte & 0xFu) * sc;
            const float w_hi   = agx_e2m1_to_f32(qbyte >> 4)   * sc;
            const uint k_lo    = b * 64u + sub * 16u + j;
            const uint k_hi    = k_lo + 8u;
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
#if BATCH_CAP > 1
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : ((m_cnt == 1u) ? xrow0 : sh_xrow[m]);
#else
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : xrow0;
#endif
                    acc[m] += w_lo * x_buf1.v[row_x * pc.K + k_lo]
                            + w_hi * x_buf1.v[row_x * pc.K + k_hi];
                }
            }
        }
#elif WEIGHT_MODE == 3
        const uint nb_k = pc.K >> 5;
        AgxBufQ8_0Raw qbuf = AgxBufQ8_0Raw(w_base);
        const uint row_b0 = row * nb_k;
        for (uint b = 0u; b < nb_k; ++b) {
            const uint bidx = row_b0 + b;
            const float sc  = float(unpackFloat2x16(uint(qbuf.blk[bidx].d)).x);
            const float wv  = float(qbuf.blk[bidx].qs[lane]) * sc;
            const uint  k   = b * 32u + lane;
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
#if BATCH_CAP > 1
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : ((m_cnt == 1u) ? xrow0 : sh_xrow[m]);
#else
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : xrow0;
#endif
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#elif WEIGHT_MODE == 4
        const uint n_chunks = (pc.K + 511u) >> 9;
        AgxBufMxfp8_16Blk mbuf = AgxBufMxfp8_16Blk(w_base);
        const uint row_c0 = row * n_chunks;
        for (uint c = 0u; c < n_chunks; ++c) {
            const uint cidx = row_c0 + c;
            const uvec4 qv  = mbuf.blk[cidx].qs[lane];
            const float sc  = agx_ue8m0_to_f32(uint(mbuf.blk[cidx].e[lane >> 1]));
            const uint k0   = c * 512u + lane * 16u;
            if (k0 < pc.K) {
                const vec4 w0 = vec4(agx_e4m3_u32_to_f16vec4(qv.x));
                const vec4 w1 = vec4(agx_e4m3_u32_to_f16vec4(qv.y));
                const vec4 w2 = vec4(agx_e4m3_u32_to_f16vec4(qv.z));
                const vec4 w3 = vec4(agx_e4m3_u32_to_f16vec4(qv.w));
                const uint col4 = k0 >> 2;
                for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                    if (m < m_cnt) {
#if BATCH_CAP > 1
                        const uint row_x = x_is_contiguous_assign ? (tok_off + m) : ((m_cnt == 1u) ? xrow0 : sh_xrow[m]);
#else
                        const uint row_x = x_is_contiguous_assign ? (tok_off + m) : xrow0;
#endif
                        const uint xo    = row_x * K4 + col4;
                        float dp = dot(w0, x_buf4.v[xo + 0u]) + dot(w1, x_buf4.v[xo + 1u])
                                 + dot(w2, x_buf4.v[xo + 2u]) + dot(w3, x_buf4.v[xo + 3u]);
                        acc[m] = fma(dp, sc, acc[m]);
                    }
                }
            }
        }
#elif WEIGHT_MODE == 5
        AgxBufU32R wbuf = AgxBufU32R(w_base + uint64_t(row) * uint64_t(pc.K));
        for (uint col4 = lane; col4 < K4; col4 += 32u) {
            const vec4 wv = vec4(agx_e4m3_u32_to_f16vec4(wbuf.v[col4]));
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
#if BATCH_CAP > 1
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : ((m_cnt == 1u) ? xrow0 : sh_xrow[m]);
#else
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : xrow0;
#endif
                    acc[m] += dot(wv, x_buf4.v[row_x * K4 + col4]);
                }
            }
        }
#elif WEIGHT_MODE == 6
        AgxBufU16R wbuf = AgxBufU16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float wv = agx_bf16_to_f32(wbuf.v[k]);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
#if BATCH_CAP > 1
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : ((m_cnt == 1u) ? xrow0 : sh_xrow[m]);
#else
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : xrow0;
#endif
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#elif WEIGHT_MODE == 7
        AgxBufF16R wbuf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float wv = float(wbuf.v[k]);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
#if BATCH_CAP > 1
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : ((m_cnt == 1u) ? xrow0 : sh_xrow[m]);
#else
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : xrow0;
#endif
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#else
        AgxBufF32R wbuf = AgxBufF32R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float wv = wbuf.v[k];
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
#if BATCH_CAP > 1
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : ((m_cnt == 1u) ? xrow0 : sh_xrow[m]);
#else
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : xrow0;
#endif
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#endif

        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            float s = subgroupAdd(acc[m]);
            if (lane == rr) {
                res_out[m] = s;
            }
        }
    }
#endif
}

void main() {
    const uint lane       = gl_SubgroupInvocationID;
    const uint sg_id      = gl_SubgroupID;
    const uint bucket_idx = gl_WorkGroupID.y;

    if (bucket_idx >= BufBucketHdrR(pc.header_va).n_vecmat_buckets) {
        return;
    }

    const AgxMoeBucket bkt = BufBucketArrR(pc.buckets_va).b[bucket_idx];
    const uint m_cnt   = min(bkt.count, uint(BATCH_CAP));
    const uint tok_off = bkt.token_offset;

    BufU32R stok = BufU32R(pc.sorted_tok_va);
    const uint tok0 = (m_cnt > 0u) ? stok.d[tok_off] : 0u;

#if PASS_STAGE == 0
#if BATCH_CAP > 1
    if (m_cnt > 1u) {
        const uint tid = gl_LocalInvocationIndex;
        if (tid < uint(BATCH_CAP)) {
            const uint t_id = (tid < m_cnt) ? stok.d[tok_off + tid] : 0u;
            sh_tok[tid]  = t_id;
            sh_xrow[tid] = t_id;
#if PREC_F32 == 0
            sh_xb[tid]   = t_id * (pc.K >> 2);
#endif
        }
        barrier();
    }
#endif
    const uint pair_half = sg_id >> 1;
    const bool is_up     = (sg_id & 1u) != 0u;
#if WEIGHT_MODE == 2
    const uint n_wg0     = gl_WorkGroupID.x * 4u;
    const uint local_r0  = pair_half * 2u;
#else
    const uint n_wg0     = gl_WorkGroupID.x * 32u;
    const uint local_r0  = pair_half * 16u;
#endif

    uint64_t w_base;
    uint     row_base;
    uint     row_limit;
    if ((pc.flags & MOE_FLAG_SEPARATE_GU) != 0u) {
        w_base    = (is_up ? pc.w_up_va : pc.w_gate_va) + uint64_t(bkt.expert_id) * pc.w_slice_B;
        row_base  = n_wg0 + local_r0;
        row_limit = pc.N;
    } else {
        w_base    = pc.w_gate_va + uint64_t(bkt.expert_id) * pc.w_slice_B;
        row_base  = (is_up ? pc.n_ff : 0u) + n_wg0 + local_r0;
        row_limit = (is_up ? (2u * pc.n_ff) : pc.n_ff);
    }

    float vals[BATCH_CAP];
    uint  out_r;
    bool  writes;
    vecmat_rows(w_base, row_base, row_limit, m_cnt, tok0, tok_off, false, lane,
                vals, out_r, writes);

    if (writes) {
        uint lr = out_r - (is_up && ((pc.flags & MOE_FLAG_SEPARATE_GU) == 0u) ? pc.n_ff : 0u) - n_wg0;
        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            if (m < m_cnt) {
                if (is_up) sh_up[m][lr]   = vals[m];
                else       sh_gate[m][lr] = vals[m];
            }
        }
    }
    barrier();

    // All 128 threads participate in SiTU/SwiGLU/GeGLU epilogue (supports BATCH_CAP=1,4,8!)
    const uint ep_tid = gl_LocalInvocationIndex;
    const float s2 = (pc.w_scale_va != 0ul)
        ? AgxBufF32R(pc.w_scale_va).v[bkt.expert_id]
        : 1.0f;
#if WEIGHT_MODE == 2
    for (uint ep_i = ep_tid; ep_i < m_cnt * 4u; ep_i += 128u) {
        const uint m  = ep_i >> 2;
        const uint ln = ep_i & 3u;
#else
    for (uint ep_i = ep_tid; ep_i < m_cnt * 32u; ep_i += 128u) {
        const uint m  = ep_i >> 5;
        const uint ln = ep_i & 31u;
#endif
        const uint n_row = n_wg0 + ln;
        if (n_row < pc.N) {
            AgxBufF32RW(pc.y_va).v[(tok_off + m) * pc.N + n_row] =
                eval_moe_act(sh_gate[m][ln] * s2, sh_up[m][ln] * s2);
        }
    }

#else
    const uint64_t w_base   = pc.w_gate_va + uint64_t(bkt.expert_id) * pc.w_slice_B;
#if WEIGHT_MODE == 2
    const uint     row_base = gl_WorkGroupID.x * 8u + sg_id * 2u;
#else
    const uint     row_base = gl_WorkGroupID.x * 64u + sg_id * 16u;
#endif

    const bool raw_mmid = (pc.flags & MOE_FLAG_RAW_MMID) != 0u;
    const bool per_slot = (pc.flags & MOE_FLAG_RAW_MMID_PERSLOT) != 0u;
    BufU32R sksl_x = BufU32R(pc.sorted_kslot_va);
    const uint ksl0  = (m_cnt > 0u) ? sksl_x.d[tok_off] : 0u;
    const uint xrow0 = per_slot ? (tok0 * pc.top_k + ksl0) : tok0;

#if BATCH_CAP > 1
    if (m_cnt > 1u) {
        const uint tid = gl_LocalInvocationIndex;
        if (tid < uint(BATCH_CAP)) {
            const uint t_id = (tid < m_cnt) ? stok.d[tok_off + tid]   : 0u;
            const uint ksl  = (tid < m_cnt) ? sksl_x.d[tok_off + tid] : 0u;
            const uint xr   = per_slot ? (t_id * pc.top_k + ksl) : t_id;
            sh_tok[tid]  = t_id;
            sh_ksl[tid]  = ksl;
            sh_xrow[tid] = xr;
#if PREC_F32 == 0
            sh_xb[tid]   = ((!raw_mmid) ? (tok_off + tid) : xr) * (pc.K >> 2);
#endif
        }
        barrier();
    }
#endif

    float vals[BATCH_CAP];
    uint  out_r;
    bool  writes;
    vecmat_rows(w_base, row_base, pc.N, m_cnt, xrow0, tok_off, !raw_mmid, lane,
                vals, out_r, writes);

    if (writes) {
        if (raw_mmid) {
            AgxBufF32RW ybuf = AgxBufF32RW(pc.y_va);
            if (m_cnt == 1u) {
                ybuf.v[(tok0 * pc.top_k + ksl0) * pc.N + out_r] = vals[0];
            }
#if BATCH_CAP > 1
            else {
                for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                    if (m < m_cnt) {
                        ybuf.v[(sh_tok[m] * pc.top_k + sh_ksl[m]) * pc.N + out_r] = vals[m];
                    }
                }
            }
#endif
        } else {
            const float s2 = (pc.w_scale_va != 0ul)
                ? AgxBufF32R(pc.w_scale_va).v[bkt.expert_id]
                : 1.0f;
            AgxBufF32R sw = AgxBufF32R(pc.sorted_w_va);
            if (m_cnt == 1u) {
                precise float scaled = vals[0] * s2;
                atomicAddF32(pc.y_va, tok0 * pc.N + out_r, scaled * sw.v[tok_off]);
            }
#if BATCH_CAP > 1
            else {
                for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                    if (m < m_cnt) {
                        precise float scaled = vals[m] * s2;
                        atomicAddF32(pc.y_va, sh_tok[m] * pc.N + out_r, scaled * sw.v[tok_off + m]);
                    }
                }
            }
#endif
        }
    }
#endif
}

// ============================================================================
// Stages 2 & 3: Wave 6 Theorem W6.1 — sh_w-Staged Bucketed-MMA 32M x 64N GEMM
//   - TILE_M = 32 matches avg cnt=32 on n_ubatch=512 (ZERO padding waste!)
//   - 128 threads cooperatively dequant 64N x 32K W (16 weights/thread, 100%
//     coalesced, ZERO 4x-redundant lane decode!) -> sh_w[64 x 40] (5,120 B)
//   - Transposed RowMajor sh_x[32 x 40] (2,560 B, 0 bank conflicts!)
//   - Pure 32-MMA inner loop with ZERO dequant ALU & 2-at-a-time matB0/matB1
//     streaming -> <= 60 GPR32, 0:0 spills!
//   - Stage 2 direct sh_u_tile[2][32] (256 B) SiTU epilogue & Stage 3 direct
//     64-bit epilogue -> BOTH stages = 8,064 B <= 8,192 B (4 WGs/core = 16 SGs/core!)
// ============================================================================
#else // PASS_STAGE == 2 || PASS_STAGE == 3

#define TILE_K      32u
#define WG_M        32u
#define SG_TILES_N  2u
#define SG_TILES_M  4u
// Transposed RowMajor sh_x[lk][lm]: WG_M + 8 = 40 halfs -> exact 0-bank-conflict 32-bit coopMatLoad!
#define SH_X_STRIDE (WG_M + 8u)
#define SH_W_STRIDE 40u

#if WEIGHT_MODE == 0 || WEIGHT_MODE == 2
shared float16_t sh_w[64u * SH_W_STRIDE];     // 5,120 B (0 bank conflicts!)
#endif
shared float16_t sh_x[TILE_K * SH_X_STRIDE];  // 2,560 B (0 bank conflicts!)
shared uint      sh_row_x[WG_M];              //   128 B

#if PASS_STAGE == 2
shared float sh_u_tile[2][32];                //   256 B (Total 8,064 B <= 8 KiB = 4 WGs/core!)
#else
shared uint  sh_y_row[WG_M];                  //   128 B
shared float sh_tok_w[WG_M];                  //   128 B (Total 8,064 B <= 8 KiB = 4 WGs/core!)
#endif

void store_x_h4_sh_T(uint dst_rel, f16vec4 xv) {
    sh_x[dst_rel + 0u * SH_X_STRIDE] = xv.x;
    sh_x[dst_rel + 1u * SH_X_STRIDE] = xv.y;
    sh_x[dst_rel + 2u * SH_X_STRIDE] = xv.z;
    sh_x[dst_rel + 3u * SH_X_STRIDE] = xv.w;
}

#if WEIGHT_MODE == 0 || WEIGHT_MODE == 2
void store_f16vec4_sh_w(uint off, f16vec4 v) {
    sh_w[off + 0u] = v.x;
    sh_w[off + 1u] = v.y;
    sh_w[off + 2u] = v.z;
    sh_w[off + 3u] = v.w;
}
#endif

#if WEIGHT_MODE == 0
void moe_decode_e2m1_u32_f16x2_scaled(uint w32, float16_t sc, out f16vec4 w0, out f16vec4 w1) {
    f16vec2 v04 = agx_e2m1_swar2_to_f16vec2(w32) * sc;
    f16vec2 v15 = agx_e2m1_swar2_to_f16vec2(w32 >> 4) * sc;
    f16vec2 v26 = agx_e2m1_swar2_to_f16vec2(w32 >> 8) * sc;
    f16vec2 v37 = agx_e2m1_swar2_to_f16vec2(w32 >> 12) * sc;
    w0 = f16vec4(v04.x, v15.x, v26.x, v37.x);
    w1 = f16vec4(v04.y, v15.y, v26.y, v37.y);
}
#endif

#if WEIGHT_MODE != 0 && WEIGHT_MODE != 2
f16vec2 load_w_pair_f16(uint64_t w_base, uint row, uint row_limit, uint k0) {
    if (row >= row_limit || k0 >= pc.K) {
        return f16vec2(float16_t(0.0));
    }
#if WEIGHT_MODE == 1
    const uint nb_k  = pc.K >> 6;
    const uint b_idx = row * nb_k + (k0 >> 6);
    const uint k_in  = k0 & 63u;
    const uint sub   = k_in >> 4;
    const uint pos   = k_in & 15u;
    AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
    const float16_t sc = agx_ue4m3_to_f16(uint(raw_buf.blk[b_idx].d[sub]));
    const uint j0 = pos & 7u;
    const uint j1 = (pos + 1u) & 7u;
    const uint b0 = uint(raw_buf.blk[b_idx].qs[sub * 8u + j0]);
    const uint b1 = uint(raw_buf.blk[b_idx].qs[sub * 8u + j1]);
    const uint n0 = (pos < 8u) ? (b0 & 0xFu) : (b0 >> 4);
    const uint n1 = ((pos + 1u) < 8u) ? (b1 & 0xFu) : (b1 >> 4);
    return f16vec2(agx_e2m1_to_f16(n0), agx_e2m1_to_f16(n1)) * sc;
#elif WEIGHT_MODE == 3
    const uint nb_k  = pc.K >> 5;
    const uint b_idx = row * nb_k + (k0 >> 5);
    const uint q_in  = k0 & 31u;
    AgxBufQ8_0Raw qbuf = AgxBufQ8_0Raw(w_base);
    const float16_t sc = unpackFloat2x16(uint(qbuf.blk[b_idx].d)).x;
    return f16vec2(float16_t(qbuf.blk[b_idx].qs[q_in]),
                   float16_t(qbuf.blk[b_idx].qs[q_in + 1u])) * sc;
#elif WEIGHT_MODE == 4
    const uint n_chunks = (pc.K + 511u) >> 9;
    const uint c_idx = row * n_chunks + (k0 >> 9);
    const uint k_in  = k0 & 511u;
    const uint blk   = k_in >> 5;
    const uint q_in  = k_in & 31u;
    AgxBufMxfp8_16Blk mbuf = AgxBufMxfp8_16Blk(w_base);
    const float sc = agx_ue8m0_to_f32(uint(mbuf.blk[c_idx].e[blk]));
    const uint v_idx = blk * 2u + (q_in >> 4);
    const uint word  = mbuf.blk[c_idx].qs[v_idx][(q_in >> 2) & 3u];
    const uint b0    = (word >> ((q_in & 3u) * 8u)) & 0xFFu;
    const uint b1    = (word >> (((q_in & 3u) + 1u) * 8u)) & 0xFFu;
    return f16vec2(float16_t(float(agx_e4m3_to_f16(b0)) * sc),
                   float16_t(float(agx_e4m3_to_f16(b1)) * sc));
#elif WEIGHT_MODE == 5
    AgxBufU8R wbuf = AgxBufU8R(w_base + uint64_t(row) * uint64_t(pc.K));
    return f16vec2(agx_e4m3_to_f16(uint(wbuf.v[k0])),
                   (k0 + 1u < pc.K) ? agx_e4m3_to_f16(uint(wbuf.v[k0 + 1u])) : float16_t(0.0));
#elif WEIGHT_MODE == 6
    AgxBufU16R wbuf = AgxBufU16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
    const float v0 = agx_bf16_to_f32(wbuf.v[k0]);
    const float v1 = (k0 + 1u < pc.K) ? agx_bf16_to_f32(wbuf.v[k0 + 1u]) : 0.0f;
    return f16vec2(float16_t(v0), float16_t(v1));
#elif WEIGHT_MODE == 7
    AgxBufF16R wbuf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
    return f16vec2(wbuf.v[k0], (k0 + 1u < pc.K) ? wbuf.v[k0 + 1u] : float16_t(0.0));
#else
    AgxBufF32R wbuf = AgxBufF32R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
    return f16vec2(float16_t(wbuf.v[k0]),
                   (k0 + 1u < pc.K) ? float16_t(wbuf.v[k0 + 1u]) : float16_t(0.0));
#endif
}
#endif

void main() {
    const uint tid      = gl_LocalInvocationIndex; // 0..127
    const uint lane     = gl_SubgroupInvocationID; // 0..31
    const uint sg_id    = gl_SubgroupID;           // 0..3
    const uint tile_idx = gl_WorkGroupID.y;

    if (tile_idx >= BufBucketHdrR(pc.header_va).n_gemm_tiles) {
        return;
    }

    const AgxMoeBucket tile = BufBucketArrR(pc.buckets_va).b[tile_idx];
    const uint m_len     = min(tile.count, WG_M);
    const uint active_im = (m_len + 7u) >> 3; // 1..4 (WG-uniform!)
    const uint tok_off   = tile.token_offset;

    BufU32R stok   = BufU32R(pc.sorted_tok_va);
    BufU32R sksl_g = BufU32R(pc.sorted_kslot_va);

    const uint lr  = agx_cmat8_row(lane);
    const uint lc0 = agx_cmat8_col0(lane);

#if PASS_STAGE == 2
    const uint pair_half = sg_id >> 1;
    const bool is_up     = (sg_id & 1u) != 0u;
    const uint n_wg0     = gl_WorkGroupID.x * 32u;
    const bool sep_gu    = (pc.flags & MOE_FLAG_SEPARATE_GU) != 0u;
    const uint w_sg_off  = ((is_up ? 32u : 0u) + pair_half * 16u) * SH_W_STRIDE;
#if WEIGHT_MODE != 0 && WEIGHT_MODE != 2
    uint64_t w_base;
    uint     sg_n0;
    uint     row_limit;
    if (sep_gu) {
        w_base    = (is_up ? pc.w_up_va : pc.w_gate_va) + uint64_t(tile.expert_id) * pc.w_slice_B;
        sg_n0     = n_wg0 + pair_half * 16u;
        row_limit = pc.N;
    } else {
        w_base    = pc.w_gate_va + uint64_t(tile.expert_id) * pc.w_slice_B;
        sg_n0     = (is_up ? pc.n_ff : 0u) + n_wg0 + pair_half * 16u;
        row_limit = is_up ? (2u * pc.n_ff) : pc.n_ff;
    }
#endif
    const bool x_is_assign = false;
#else
    const uint     wg_n0       = gl_WorkGroupID.x * 64u;
    const uint64_t w_base      = pc.w_gate_va + uint64_t(tile.expert_id) * pc.w_slice_B;
    const uint     sg_n0       = wg_n0 + sg_id * 16u;
    const uint     w_sg_off    = (sg_id * 16u) * SH_W_STRIDE;
    const uint     row_limit   = pc.N;
    const bool     raw_mmid    = (pc.flags & MOE_FLAG_RAW_MMID) != 0u;
    const bool     per_slot    = (pc.flags & MOE_FLAG_RAW_MMID_PERSLOT) != 0u;
    const bool     x_is_assign = !raw_mmid;
#endif

    // Pre-load per-row X/Y indices & weights ONCE into SRAM
    if (tid < WG_M) {
        if (tid < m_len) {
            const uint t_id = stok.d[tok_off + tid];
#if PASS_STAGE == 3
            const uint ksl  = sksl_g.d[tok_off + tid];
            sh_row_x[tid]   = x_is_assign ? (tok_off + tid) : (per_slot ? (t_id * pc.top_k + ksl) : t_id);
            sh_y_row[tid]   = raw_mmid ? (t_id * pc.top_k + ksl) : t_id;
            sh_tok_w[tid]   = raw_mmid ? 1.0f : AgxBufF32R(pc.sorted_w_va).v[tok_off + tid];
#else
            sh_row_x[tid]   = t_id;
#endif
        } else {
            sh_row_x[tid] = 0u;
#if PASS_STAGE == 3
            sh_y_row[tid] = 0u;
            sh_tok_w[tid] = 0.0f;
#endif
        }
    }
    barrier();

    const uint K4      = pc.K >> 2;
    const uint x_lm0   = tid >> 3;          // 0..15 (s=1 is +16)
    const uint x_lk4   = tid & 7u;          // 0..7
    const uint sh_dst0 = (x_lk4 << 2) * SH_X_STRIDE + x_lm0;
    const uint64_t x_row_B = uint64_t(pc.K) * 4ul;
    AgxBufVec4R x_row0 = AgxBufVec4R(pc.x_va + uint64_t(sh_row_x[x_lm0])       * x_row_B);
    AgxBufVec4R x_row1 = AgxBufVec4R(pc.x_va + uint64_t(sh_row_x[x_lm0 + 16u]) * x_row_B);

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> acc[SG_TILES_N][SG_TILES_M];
    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
        for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
            acc[in_t][im_t] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        }
    }

#if WEIGHT_MODE == 0
    // ------------------------------------------------------------------------
    // AGX_NVFP4_32x16: Wave 6 Pass-4 sh_w(f16vec4)-Staged 64N x 32M (4 WGs/core!)
    //   - 8,064 B <= 8 KiB = 4 WGs/core (16 SGs/core), <= 64 GPR32, 0:0 spills!
    //   - shared f16vec4 sh_w (4x fewer SRAM stores!) + W-only prefetch (uvec2 half-load!)
    // ------------------------------------------------------------------------
    {
        const uint nb_k = pc.K >> 6;
#if PASS_STAGE == 2
        const uint w_is_up   = tid >> 6;          // 0 = gate (sh_w[0..31]), 1 = up (sh_w[32..63])
        const uint t64       = tid & 63u;
        const uint row_in_32 = t64 >> 1;          // 0..31
        const uint half_k16  = t64 & 1u;          // 0 (cols 0..15) or 1 (cols 16..31)
        const uint row_in_64 = w_is_up * 32u + row_in_32;
        const uint64_t w_base_t = (sep_gu ? ((w_is_up != 0u) ? pc.w_up_va : pc.w_gate_va) : pc.w_gate_va)
                                + uint64_t(tile.expert_id) * pc.w_slice_B;
        const uint grow_t    = (sep_gu ? 0u : ((w_is_up != 0u) ? pc.n_ff : 0u)) + n_wg0 + row_in_32;
        const bool row_ok_t  = sep_gu ? (grow_t < pc.N) : (grow_t < ((w_is_up != 0u) ? (2u * pc.n_ff) : pc.n_ff));
#else
        const uint row_in_64 = tid >> 1;          // 0..63
        const uint half_k16  = tid & 1u;          // 0 or 1
        const uint64_t w_base_t = w_base;
        const uint grow_t    = wg_n0 + row_in_64;
        const bool row_ok_t  = (grow_t < row_limit);
#endif
        AgxBufNvfp4ST st_buf = AgxBufNvfp4ST(w_base_t);
        const uint st_base_t = (grow_t >> 5) * nb_k;
        const uint r32_t     = grow_t & 31u;
        const uint l_base_t  = (r32_t >> 4) * 32u + ((r32_t & 15u) << 1);
        const uint sh_w_dst  = row_in_64 * SH_W_STRIDE + half_k16 * 16u;

        // Prologue: stage k_base = 0 into sh_w & sh_x (half-load uvec2 = 8B/thread!)
        if (pc.K > 0u) {
            store_x_h4_sh_T(sh_dst0,       (x_lm0 < m_len && x_lk4 < K4)
                ? f16vec4(x_row0.v[x_lk4]) : f16vec4(float16_t(0.0)));
            store_x_h4_sh_T(sh_dst0 + 16u, ((x_lm0 + 16u) < m_len && x_lk4 < K4)
                ? f16vec4(x_row1.v[x_lk4]) : f16vec4(float16_t(0.0)));
            f16vec4 w0 = f16vec4(float16_t(0.0));
            f16vec4 w1 = f16vec4(float16_t(0.0));
            f16vec4 w2 = f16vec4(float16_t(0.0));
            f16vec4 w3 = f16vec4(float16_t(0.0));
            if (row_ok_t) {
                const uint dp  = uint(st_buf.st[st_base_t].d[l_base_t]);
                const uvec2 q2 = (half_k16 == 0u) ? st_buf.st[st_base_t].qs[l_base_t].xy
                                                  : st_buf.st[st_base_t].qs[l_base_t].zw;
                const float16_t sc = agx_ue4m3_to_f16((half_k16 == 0u) ? (dp & 0xFFu) : (dp >> 8));
                moe_decode_e2m1_u32_f16x2_scaled(q2.x, sc, w0, w1);
                moe_decode_e2m1_u32_f16x2_scaled(q2.y, sc, w2, w3);
            }
            store_f16vec4_sh_w(sh_w_dst +  0u, w0);
            store_f16vec4_sh_w(sh_w_dst +  4u, w1);
            store_f16vec4_sh_w(sh_w_dst +  8u, w2);
            store_f16vec4_sh_w(sh_w_dst + 12u, w3);
            barrier();
        }

        // Software-pipelined W-prefetch K-loop: overlap W(k+32) DRAM fetch (+3 GPR32) with 32 MMAs!
        for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
            const uint kn = k_base + TILE_K;
            const bool has_next = (kn < pc.K);
            uvec2 q2_next = uvec2(0u);
            uint  dp_next = 0u;
            if (has_next && row_ok_t) {
                const uint st_idx = st_base_t + (kn >> 6);
                const uint l_idx  = l_base_t | ((kn >> 5) & 1u);
                dp_next = uint(st_buf.st[st_idx].d[l_idx]);
                q2_next = (half_k16 == 0u) ? st_buf.st[st_idx].qs[l_idx].xy
                                           : st_buf.st[st_idx].qs[l_idx].zw;
            }

            // Pure 32-MMA compute loop (unbranched active_im == 4u fastpath!)
            for (uint ks = 0u; ks < 4u; ++ks) {
                const uint koff = ks * 8u;
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA0, matA1;
                coopMatLoad(matA0, sh_w, w_sg_off + 0u * SH_W_STRIDE + koff, SH_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(matA1, sh_w, w_sg_off + 8u * SH_W_STRIDE + koff, SH_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                const uint ks_row_off = koff * SH_X_STRIDE;
                if (active_im == 4u) {
                    for (uint im_t = 0u; im_t < 4u; im_t += 2u) {
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB0, matB1;
                        coopMatLoad(matB0, sh_x, ks_row_off + im_t * 8u,      SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        coopMatLoad(matB1, sh_x, ks_row_off + im_t * 8u + 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        acc[0][im_t]      = coopMatMulAdd(matA0, matB0, acc[0][im_t]);
                        acc[1][im_t]      = coopMatMulAdd(matA1, matB0, acc[1][im_t]);
                        acc[0][im_t + 1u] = coopMatMulAdd(matA0, matB1, acc[0][im_t + 1u]);
                        acc[1][im_t + 1u] = coopMatMulAdd(matA1, matB1, acc[1][im_t + 1u]);
                    }
                } else {
                    for (uint im_t = 0u; im_t < 4u; ++im_t) {
                        if (im_t < active_im) {
                            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                            coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                            acc[0][im_t] = coopMatMulAdd(matA0, matB, acc[0][im_t]);
                            acc[1][im_t] = coopMatMulAdd(matA1, matB, acc[1][im_t]);
                        }
                    }
                }
            }

            if (has_next) {
                barrier();
                const uint kb4 = (kn >> 2) + x_lk4;
                store_x_h4_sh_T(sh_dst0,       (x_lm0 < m_len && kb4 < K4)
                    ? f16vec4(x_row0.v[kb4]) : f16vec4(float16_t(0.0)));
                store_x_h4_sh_T(sh_dst0 + 16u, ((x_lm0 + 16u) < m_len && kb4 < K4)
                    ? f16vec4(x_row1.v[kb4]) : f16vec4(float16_t(0.0)));
                f16vec4 w0 = f16vec4(float16_t(0.0));
                f16vec4 w1 = f16vec4(float16_t(0.0));
                f16vec4 w2 = f16vec4(float16_t(0.0));
                f16vec4 w3 = f16vec4(float16_t(0.0));
                if (row_ok_t) {
                    const float16_t sc = agx_ue4m3_to_f16((half_k16 == 0u) ? (dp_next & 0xFFu) : (dp_next >> 8));
                    moe_decode_e2m1_u32_f16x2_scaled(q2_next.x, sc, w0, w1);
                    moe_decode_e2m1_u32_f16x2_scaled(q2_next.y, sc, w2, w3);
                }
                store_f16vec4_sh_w(sh_w_dst +  0u, w0);
                store_f16vec4_sh_w(sh_w_dst +  4u, w1);
                store_f16vec4_sh_w(sh_w_dst +  8u, w2);
                store_f16vec4_sh_w(sh_w_dst + 12u, w3);
                barrier();
            }
        }
    }

#elif WEIGHT_MODE == 2
    // ------------------------------------------------------------------------
    // AGX_Q8_0_8BLK: Wave 6 Pass-4 sh_w-Staged 64N x 32M (4 WGs/core!)
    //   - 8,064 B <= 8 KiB = 4 WGs/core (16 SGs/core), <= 64 GPR32, 0:0 spills!
    //   - shared float16_t sh_w (proven fastest Borealis coopMatLoad!) + W-only prefetch!
    // ------------------------------------------------------------------------
    {
        const uint n_chunks = (pc.K + 255u) >> 8;
#if PASS_STAGE == 2
        const uint w_is_up   = tid >> 6;
        const uint t64       = tid & 63u;
        const uint row_in_32 = t64 >> 1;
        const uint half_k16  = t64 & 1u;
        const uint row_in_64 = w_is_up * 32u + row_in_32;
        const uint64_t w_base_t = (sep_gu ? ((w_is_up != 0u) ? pc.w_up_va : pc.w_gate_va) : pc.w_gate_va)
                                + uint64_t(tile.expert_id) * pc.w_slice_B;
        const uint grow_t    = (sep_gu ? 0u : ((w_is_up != 0u) ? pc.n_ff : 0u)) + n_wg0 + row_in_32;
        const bool row_ok_t  = sep_gu ? (grow_t < pc.N) : (grow_t < ((w_is_up != 0u) ? (2u * pc.n_ff) : pc.n_ff));
#else
        const uint row_in_64 = tid >> 1;
        const uint half_k16  = tid & 1u;
        const uint64_t w_base_t = w_base;
        const uint grow_t    = wg_n0 + row_in_64;
        const bool row_ok_t  = (grow_t < row_limit);
#endif
        AgxBufQ8_8Blk qbuf_t = AgxBufQ8_8Blk(w_base_t);
        const uint row_chk0  = grow_t * n_chunks;
        const uint sh_w_dst  = row_in_64 * SH_W_STRIDE + half_k16 * 16u;

        // Prologue: stage k_base = 0 into sh_w & sh_x
        if (pc.K > 0u) {
            store_x_h4_sh_T(sh_dst0,       (x_lm0 < m_len && x_lk4 < K4)
                ? f16vec4(x_row0.v[x_lk4]) : f16vec4(float16_t(0.0)));
            store_x_h4_sh_T(sh_dst0 + 16u, ((x_lm0 + 16u) < m_len && x_lk4 < K4)
                ? f16vec4(x_row1.v[x_lk4]) : f16vec4(float16_t(0.0)));
            f16vec4 w0 = f16vec4(float16_t(0.0));
            f16vec4 w1 = f16vec4(float16_t(0.0));
            f16vec4 w2 = f16vec4(float16_t(0.0));
            f16vec4 w3 = f16vec4(float16_t(0.0));
            if (row_ok_t) {
                const uvec4 qv    = qbuf_t.blk[row_chk0].qs[half_k16];
                const float16_t d = unpackFloat2x16(uint(qbuf_t.blk[row_chk0].d[0])).x;
                w0 = agx_q8_u32_magic_to_f16vec4(qv.x) * d;
                w1 = agx_q8_u32_magic_to_f16vec4(qv.y) * d;
                w2 = agx_q8_u32_magic_to_f16vec4(qv.z) * d;
                w3 = agx_q8_u32_magic_to_f16vec4(qv.w) * d;
            }
            store_f16vec4_sh_w(sh_w_dst +  0u, w0);
            store_f16vec4_sh_w(sh_w_dst +  4u, w1);
            store_f16vec4_sh_w(sh_w_dst +  8u, w2);
            store_f16vec4_sh_w(sh_w_dst + 12u, w3);
            barrier();
        }

        // Software-pipelined W-prefetch K-loop: overlap W(k+32) DRAM fetch (+5 GPR32) with 32 MMAs!
        for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
            const uint kn = k_base + TILE_K;
            const bool has_next = (kn < pc.K);
            uvec4    qv_next = uvec4(0u);
            uint16_t d_next  = uint16_t(0u);
            if (has_next && row_ok_t) {
                const uint c       = kn >> 8;
                const uint blk     = (kn >> 5) & 7u;
                const uint chk_idx = row_chk0 + c;
                qv_next = qbuf_t.blk[chk_idx].qs[blk * 2u + half_k16];
                d_next  = qbuf_t.blk[chk_idx].d[blk];
            }

            // Pure 32-MMA compute loop (unbranched active_im == 4u fastpath!)
            for (uint ks = 0u; ks < 4u; ++ks) {
                const uint koff = ks * 8u;
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA0, matA1;
                coopMatLoad(matA0, sh_w, w_sg_off + 0u * SH_W_STRIDE + koff, SH_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(matA1, sh_w, w_sg_off + 8u * SH_W_STRIDE + koff, SH_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                const uint ks_row_off = koff * SH_X_STRIDE;
                if (active_im == 4u) {
                    for (uint im_t = 0u; im_t < 4u; im_t += 2u) {
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB0, matB1;
                        coopMatLoad(matB0, sh_x, ks_row_off + im_t * 8u,      SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        coopMatLoad(matB1, sh_x, ks_row_off + im_t * 8u + 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        acc[0][im_t]      = coopMatMulAdd(matA0, matB0, acc[0][im_t]);
                        acc[1][im_t]      = coopMatMulAdd(matA1, matB0, acc[1][im_t]);
                        acc[0][im_t + 1u] = coopMatMulAdd(matA0, matB1, acc[0][im_t + 1u]);
                        acc[1][im_t + 1u] = coopMatMulAdd(matA1, matB1, acc[1][im_t + 1u]);
                    }
                } else {
                    for (uint im_t = 0u; im_t < 4u; ++im_t) {
                        if (im_t < active_im) {
                            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                            coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                            acc[0][im_t] = coopMatMulAdd(matA0, matB, acc[0][im_t]);
                            acc[1][im_t] = coopMatMulAdd(matA1, matB, acc[1][im_t]);
                        }
                    }
                }
            }

            if (has_next) {
                barrier();
                const uint kb4 = (kn >> 2) + x_lk4;
                store_x_h4_sh_T(sh_dst0,       (x_lm0 < m_len && kb4 < K4)
                    ? f16vec4(x_row0.v[kb4]) : f16vec4(float16_t(0.0)));
                store_x_h4_sh_T(sh_dst0 + 16u, ((x_lm0 + 16u) < m_len && kb4 < K4)
                    ? f16vec4(x_row1.v[kb4]) : f16vec4(float16_t(0.0)));
                f16vec4 w0 = f16vec4(float16_t(0.0));
                f16vec4 w1 = f16vec4(float16_t(0.0));
                f16vec4 w2 = f16vec4(float16_t(0.0));
                f16vec4 w3 = f16vec4(float16_t(0.0));
                if (row_ok_t) {
                    const float16_t d = unpackFloat2x16(uint(d_next)).x;
                    w0 = agx_q8_u32_magic_to_f16vec4(qv_next.x) * d;
                    w1 = agx_q8_u32_magic_to_f16vec4(qv_next.y) * d;
                    w2 = agx_q8_u32_magic_to_f16vec4(qv_next.z) * d;
                    w3 = agx_q8_u32_magic_to_f16vec4(qv_next.w) * d;
                }
                store_f16vec4_sh_w(sh_w_dst +  0u, w0);
                store_f16vec4_sh_w(sh_w_dst +  4u, w1);
                store_f16vec4_sh_w(sh_w_dst +  8u, w2);
                store_f16vec4_sh_w(sh_w_dst + 12u, w3);
                barrier();
            }
        }
    }

#else
    for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
        const uint kb4 = (k_base >> 2) + x_lk4;
        store_x_h4_sh_T(sh_dst0,       (x_lm0 < m_len && kb4 < K4)
            ? f16vec4(clamp(x_row0.v[kb4], vec4(-65504.0f), vec4(65504.0f))) : f16vec4(float16_t(0.0)));
        store_x_h4_sh_T(sh_dst0 + 16u, ((x_lm0 + 16u) < m_len && kb4 < K4)
            ? f16vec4(clamp(x_row1.v[kb4], vec4(-65504.0f), vec4(65504.0f))) : f16vec4(float16_t(0.0)));
        barrier();

        for (uint ks = 0u; ks < TILE_K; ks += 8u) {
            const uint ks_row_off = ks * SH_X_STRIDE;
            const uint gk = k_base + ks + lc0;
            const f16vec2 wp0 = load_w_pair_f16(w_base, sg_n0 + lr,      row_limit, gk);
            const f16vec2 wp1 = load_w_pair_f16(w_base, sg_n0 + 8u + lr, row_limit, gk);
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA0 =
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA1 =
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
            matA0[0] = wp0.x; matA0[1] = wp0.y;
            matA1[0] = wp1.x; matA1[1] = wp1.y;
            for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                if (im_t < active_im) {
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                    coopMatLoad(matB, sh_x, ks_row_off + im_t * 8u, SH_X_STRIDE,
                                gl_CooperativeMatrixLayoutRowMajor);
                    acc[0][im_t] = coopMatMulAdd(matA0, matB, acc[0][im_t]);
                    acc[1][im_t] = coopMatMulAdd(matA1, matB, acc[1][im_t]);
                }
            }
        }
        if (k_base + TILE_K < pc.K) {
            barrier();
        }
    }
#endif

#if PASS_STAGE == 2
    // Direct SiTU epilogue using ONLY 256 B sh_u_tile[2][32] (gate stays in acc -> 8,064 B <= 8 KiB!)
    const float s2 = (pc.w_scale_va != 0ul)
        ? AgxBufF32R(pc.w_scale_va).v[tile.expert_id]
        : 1.0f;
    const uint64_t y_row_B = uint64_t(pc.N) * 4ul;
    for (uint im_t = 0u; im_t < active_im; ++im_t) {
        for (uint p2 = 0u; p2 < 4u; ++p2) {
            const bool in_p2 = ((lc0 >> 1) == p2);
            if (is_up && in_p2) {
                for (uint in_t = 0u; in_t < 2u; ++in_t) {
                    const uint sh_n = pair_half * 16u + in_t * 8u + lr;
                    sh_u_tile[0][sh_n] = acc[in_t][im_t][0];
                    sh_u_tile[1][sh_n] = acc[in_t][im_t][1];
                }
            }
            barrier();
            if (!is_up && in_p2) {
                const uint gm0   = im_t * 8u + lc0;
                const uint gm1   = gm0 + 1u;
                const bool m0_ok = (gm0 < m_len);
                const bool m1_ok = (gm1 < m_len);
                if (m0_ok || m1_ok) {
                    const uint64_t y_va0 = m0_ok ? (pc.y_va + uint64_t(tok_off + gm0) * y_row_B) : pc.y_va;
                    const uint64_t y_va1 = m1_ok ? (pc.y_va + uint64_t(tok_off + gm1) * y_row_B) : pc.y_va;
                    for (uint in_t = 0u; in_t < 2u; ++in_t) {
                        const uint sh_n  = pair_half * 16u + in_t * 8u + lr;
                        const uint n_row = n_wg0 + sh_n;
                        if (n_row < pc.N) {
                            if (m0_ok) AgxBufF32RW(y_va0).v[n_row] = eval_moe_act(acc[in_t][im_t][0] * s2, sh_u_tile[0][sh_n] * s2);
                            if (m1_ok) AgxBufF32RW(y_va1).v[n_row] = eval_moe_act(acc[in_t][im_t][1] * s2, sh_u_tile[1][sh_n] * s2);
                        }
                    }
                }
            }
            if (p2 < 3u || (im_t + 1u < active_im)) {
                barrier();
            }
        }
    }

#else
    // Wave 6 Direct Epilogue Store (ZERO sh_y SRAM, ZERO epilogue barriers -> 8,064 B = 4 WGs/core!)
    const float s2 = (!raw_mmid && pc.w_scale_va != 0ul)
        ? AgxBufF32R(pc.w_scale_va).v[tile.expert_id]
        : 1.0f;
    const uint64_t y_row_B = uint64_t(pc.N) * 4ul;
    for (uint im_t = 0u; im_t < active_im; ++im_t) {
        const uint gm0   = im_t * 8u + lc0;
        const uint gm1   = gm0 + 1u;
        const bool m0_ok = (gm0 < m_len);
        const bool m1_ok = (gm1 < m_len);
        if (m0_ok || m1_ok) {
            const uint64_t y_va0 = m0_ok ? (pc.y_va + uint64_t(sh_y_row[gm0]) * y_row_B) : pc.y_va;
            const uint64_t y_va1 = m1_ok ? (pc.y_va + uint64_t(sh_y_row[gm1]) * y_row_B) : pc.y_va;
            for (uint in_t = 0u; in_t < 2u; ++in_t) {
                const uint gn = sg_n0 + in_t * 8u + lr;
                if (gn < pc.N) {
                    if (raw_mmid) {
                        if (m0_ok) AgxBufF32RW(y_va0).v[gn] = acc[in_t][im_t][0];
                        if (m1_ok) AgxBufF32RW(y_va1).v[gn] = acc[in_t][im_t][1];
                    } else {
                        if (m0_ok) {
                            precise float scaled = acc[in_t][im_t][0] * s2;
                            atomicAddF32(y_va0, gn, scaled * sh_tok_w[gm0]);
                        }
                        if (m1_ok) {
                            precise float scaled = acc[in_t][im_t][1] * s2;
                            atomicAddF32(y_va1, gn, scaled * sh_tok_w[gm1]);
                        }
                    }
                }
            }
        }
    }
#endif
}

#endif // PASS_STAGE
