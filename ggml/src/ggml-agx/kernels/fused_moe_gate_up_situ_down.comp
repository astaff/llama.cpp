                    const f16vec4 w3   = agx_q8_u32_magic_norm_to_f16vec4(qv.w);

                    float16_t dp0 = dot(w0, f16vec4(x_buf4.v[xb0 + col4 + 0u])) + dot(w1, f16vec4(x_buf4.v[xb0 + col4 + 1u]))
