#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

#include "dequant_supertile.glsl"

// ============================================================================
// Pillar 5b: Fused MoE Gate+Up + Exact Inkling SiTU + Down Scatter-Add
//            with Predicated Vec-Mat (M_bucket <= 5) & 8x8 MMA GEMM (M_bucket >= 6)
// ============================================================================
// Target: Apple Silicon AGX3B (M4 Max, 40 cores, 32-lane simdgroup)
// Budget: <= 96 32-bit GPRs/lane, 0:0 spills across ALL modes!
//
// Compile-time specializations:
//   PASS_STAGE  = 0 : Gate+Up + SiTU/SwiGLU Vec-Mat (M_bucket <= 5, 32 pairs/WG)
//               = 1 : Down + Weight Scatter-Add Vec-Mat (M_bucket <= 5, 64 rows/WG)
//               = 2 : Gate+Up + SiTU/SwiGLU 8x8 coopmat GEMM (M_bucket >= 6, 32 pairs x 16M/WG)
//               = 3 : Down + Weight Scatter-Add 8x8 coopmat GEMM (M_bucket >= 6, 64 rows x 16M/WG)
//   WEIGHT_MODE = 0 (AGX_NVFP4_32x16 repacked), 1 (raw block_nvfp4),
//                 2 (AGX_Q8_0_8BLK repacked),   3 (raw block_q8_0),
//                 4 (AGX_MXFP8_16BLK repacked), 5 (flat F8_E4M3),
//                 6 (flat BF16), 7 (flat F16),  8 (flat F32)
//   BATCH_CAP   = 1 or 5 (compile-time unroll cap for vec-mat: B=1 decode uses 1 acc -> ~36 GPRs;
//                         DSpark M=2..5 uses 5 acc -> ~60 GPRs; zero spills!)

#ifndef PASS_STAGE
#define PASS_STAGE 0
#endif

#ifndef WEIGHT_MODE
#define WEIGHT_MODE 0
#endif

#ifndef BATCH_CAP
#define BATCH_CAP 5
#endif

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer BufU32RW { uint d[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer BufU32R { uint d[]; };

struct AgxMoeBucket {
    uint expert_id;
    uint token_offset;
    uint count;
    uint pad0;
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer BufBucketArrR {
    AgxMoeBucket b[];
};

layout(buffer_reference, scalar, buffer_reference_align = 128) readonly buffer BufBucketHdrR {
    uint n_active_experts;
    uint n_vecmat_buckets;
    uint n_gemm_tiles;
    uint total_assignments;
    uint n_tokens;
    uint top_k;
    uint n_expert;
    uint pad0;
};

// Flags for PushMoe::flags
const uint MOE_FLAG_SEPARATE_GU = 1u << 0; // gate_va and up_va are separate buffers
const uint MOE_FLAG_X_F16       = 1u << 1; // input ffn_x is F16
const uint MOE_FLAG_RAW_MMID    = 1u << 2; // generic GGML_OP_MUL_MAT_ID direct store (no atomic scatter)
const uint MOE_FLAG_ACT_SILU    = 1u << 3; // SwiGLU instead of Inkling SiTU
const uint MOE_FLAG_ACT_GELU    = 1u << 4; // GeGLU instead of Inkling SiTU

// Push constants: 144 bytes (<= 256 B AGX push window)
layout(push_constant) uniform PushMoe {
    uint64_t header_va;       // agx_moe_bucket_header
    uint64_t buckets_va;      // vecmat_buckets (stages 0,1) or gemm_tiles (stages 2,3)
    uint64_t sorted_tok_va;   // uint32_t[M * top_k]
    uint64_t sorted_kslot_va; // uint32_t[M * top_k]
    uint64_t sorted_w_va;     // float[M * top_k] (already includes exp_scale0!)
    uint64_t x_va;            // [M, K] (ffn_x for stages 0/2; moe_hidden for stages 1/3)
    uint64_t w_gate_va;       // gate_up_va (or gate_va if MOE_FLAG_SEPARATE_GU, or down_va)
    uint64_t w_up_va;         // up_va if MOE_FLAG_SEPARATE_GU, else w_gate_va + up_row_offset
    uint64_t y_va;            // moe_hidden (stages 0/2) or moe_out (stages 1/3)
    uint64_t w_slice_B;       // byte stride between experts in W
    uint     K;               // input dim (n_embd=2304 for gate_up; n_ff=1152 for down)
    uint     N;               // output dim (n_ff=1152 for gate_up; n_embd=2304 for down)
    uint     n_ff;            // 1152 (row offset of up inside merged gate_up)
    uint     top_k;           // 8
    uint     flags;
    float    situ_beta;
    float    situ_linear_beta;
    uint     pad0;
} pc;

// Portable FP32 atomic add via uint CAS (zero dependency on EXT_shader_atomic_float!)
void atomicAddF32(uint64_t addr_va, uint idx, float val) {
    if (val == 0.0f) {
        return;
    }
    BufU32RW buf = BufU32RW(addr_va);
    uint expected = buf.d[idx];
    for (;;) {
        float next_f  = uintBitsToFloat(expected) + val;
        uint  desired = floatBitsToUint(next_f);
        uint  prev    = atomicCompSwap(buf.d[idx], expected, desired);
        if (prev == expected) {
            break;
        }
        expected = prev;
    }
}

// Exact Inkling 2 Mini SiTU / SwiGLU / GeGLU activation (matches src/llama-graph.cpp:2636-2650)
float eval_moe_act(float g, float u) {
    if ((pc.flags & MOE_FLAG_ACT_SILU) != 0u) {
        return (g / (1.0f + exp(-g))) * u;
    }
    if ((pc.flags & MOE_FLAG_ACT_GELU) != 0u) {
        // Exact tanh-approx GeLU matching ggml
        const float k = 0.7978845608f * (g + 0.044715f * g * g * g);
        return 0.5f * g * (1.0f + tanh(k)) * u;
    }
    // Inkling 2 SiTU: beta * tanh(g / beta) * sigmoid(g) * (lb > 0 ? lb * tanh(u / lb) : u)
    float beta = pc.situ_beta;
    float lb   = pc.situ_linear_beta;
    float act  = beta * tanh(g / beta) * (1.0f / (1.0f + exp(-g)));
    float u_a  = (lb > 0.0f) ? (lb * tanh(u / lb)) : u;
    return act * u_a;
}

// ============================================================================
// Stages 0 & 1: Predicated K-Coalesced Vec-Mat (M_bucket <= 5)
// ============================================================================
#if PASS_STAGE == 0 || PASS_STAGE == 1

#if PASS_STAGE == 0
shared float sh_gate[BATCH_CAP][32];
shared float sh_up[BATCH_CAP][32];
#endif

// Compute dot(W[row, 0..K-1], X[m, 0..K-1]) for a 16-row block `row_base..row_base+15`
// across all `m_cnt` tokens in this bucket, fetching W ONCE from DRAM!
void vecmat_16rows(
    uint64_t w_base,
    uint     row_base,
    uint     row_limit,
    uint     m_cnt,
    uint     tok_ids[BATCH_CAP],
    uint     tok_off,
    bool     x_is_contiguous_assign,
    uint     lane,
    out float res_out[BATCH_CAP],
    out uint  out_row_idx,
    out bool  lane_writes)
{
    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
        res_out[m] = 0.0f;
    }

    AgxBufVec4R x_buf4 = AgxBufVec4R(pc.x_va);
    AgxBufF32R  x_buf1 = AgxBufF32R(pc.x_va);
    const uint  K4     = pc.K >> 2;

#if WEIGHT_MODE == 0
    // AGX_NVFP4_32x16 super-tile: 32 lanes cover 16 rows in parallel (2 lanes/row)!
    const uint half_idx = row_base >> 4;
    const uint tn       = half_idx >> 1;
    const uint sub_s    = half_idx & 1u;
    const uint row_in_h = lane >> 1;   // 0..15
    const uint kh       = lane & 1u;   // 0..1
    out_row_idx         = row_base + row_in_h;
    lane_writes         = (kh == 0u) && (out_row_idx < row_limit);

    if (row_base < row_limit) {
        AgxBufNvfp4ST st_buf = AgxBufNvfp4ST(w_base);
        const uint nb_k        = pc.K >> 6;
        const uint st_row_base = tn * nb_k;
        const uint l_idx       = sub_s * 32u + lane;

        for (uint tk = 0u; tk < nb_k; ++tk) {
            const uint st_idx     = st_row_base + tk;
            const uint16_t d_pair = st_buf.st[st_idx].d[l_idx];
            const uvec4    qs     = st_buf.st[st_idx].qs[l_idx];

            const f16vec2 scales  = agx_ue4m3_pair_to_f16vec2(d_pair);
            const float   sc0     = float(scales.x);
            const float   sc1     = float(scales.y);

            f16vec4 w0, w1, w2, w3;
            agx_e2m1_u32_to_f16x8(qs.x, w0, w1);
            agx_e2m1_u32_to_f16x8(qs.y, w2, w3);

            const uint col4 = (tk * 64u + kh * 32u) >> 2;
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    const uint xo    = row_x * K4 + col4;
                    float d0 = dot(vec4(w0), x_buf4.v[xo + 0u])
                             + dot(vec4(w1), x_buf4.v[xo + 1u])
                             + dot(vec4(w2), x_buf4.v[xo + 2u])
                             + dot(vec4(w3), x_buf4.v[xo + 3u]);
                    res_out[m] += d0 * sc0;
                }
            }

            agx_e2m1_u32_to_f16x8(qs.z, w0, w1);
            agx_e2m1_u32_to_f16x8(qs.w, w2, w3);

            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    const uint xo    = row_x * K4 + col4 + 4u;
                    float d1 = dot(vec4(w0), x_buf4.v[xo + 0u])
                             + dot(vec4(w1), x_buf4.v[xo + 1u])
                             + dot(vec4(w2), x_buf4.v[xo + 2u])
                             + dot(vec4(w3), x_buf4.v[xo + 3u]);
                    res_out[m] += d1 * sc1;
                }
            }
        }

        // 1-cycle horizontal reduction across K-halves (lanes 2*r and 2*r+1)
        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            res_out[m] += subgroupShuffleXor(res_out[m], 1u);
        }
    }
#else
    // Generic K-parallel simdgroup loop (32 lanes coalesce 128B along K per row).
    // Note: processes 16 rows in sequence, writing each row's result into lane `r`!
    out_row_idx = row_base + lane;
    lane_writes = (lane < 16u) && (out_row_idx < row_limit);

    for (uint rr = 0u; rr < 16u; ++rr) {
        const uint row = row_base + rr;
        if (row >= row_limit) {
            break;
        }
        float acc[BATCH_CAP];
        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            acc[m] = 0.0f;
        }

#if WEIGHT_MODE == 1
        // Raw GGML block_nvfp4 (64 elems/block)
        const uint nb_k = pc.K >> 6;
        AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
        const uint blk_row = row * nb_k;
        for (uint b = 0u; b < nb_k; ++b) {
            const uint blk_idx = blk_row + b;
            const uint sub     = lane >> 3;        // 0..3
            const uint j       = lane & 7u;        // 0..7
            const uint qbyte   = uint(raw_buf.blk[blk_idx].qs[sub * 8u + j]);
            const float sc     = float(agx_ue4m3_to_f16(uint(raw_buf.blk[blk_idx].d[sub])));
            const float w_lo   = float(agx_e2m1_to_f16(qbyte & 0xFu)) * sc;
            const float w_hi   = float(agx_e2m1_to_f16(qbyte >> 4))   * sc;
            const uint k_lo    = b * 64u + sub * 16u + j;
            const uint k_hi    = k_lo + 8u;
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    acc[m] += w_lo * x_buf1.v[row_x * pc.K + k_lo]
                            + w_hi * x_buf1.v[row_x * pc.K + k_hi];
                }
            }
        }
#elif WEIGHT_MODE == 2
        // AGX_Q8_0_8BLK repacked planar (256 weights = 2 x 128B coalesced cache lines!)
        const uint n_chunks = (pc.K + 255u) >> 8;
        AgxBufQ8_8Blk qbuf = AgxBufQ8_8Blk(w_base);
        const uint row_c0 = row * n_chunks;
        for (uint c = 0u; c < n_chunks; ++c) {
            const uint cidx = row_c0 + c;
            // Half 0 (weights 0..127 -> blocks 0..3)
            {
                const uint v_idx = lane >> 2;
                const uint comp  = lane & 3u;
                const uint w32   = qbuf.blk[cidx].qs[v_idx][comp];
                const float sc   = float(unpackFloat2x16(uint(qbuf.blk[cidx].d[lane >> 3])).x);
                const vec4 wv    = vec4(agx_q8_u32_magic_to_f16vec4(w32)) * sc;
                const uint col4  = (c * 256u + lane * 4u) >> 2;
                if (col4 < K4) {
                    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                        if (m < m_cnt) {
                            const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                            acc[m] += dot(wv, x_buf4.v[row_x * K4 + col4]);
                        }
                    }
                }
            }
            // Half 1 (weights 128..255 -> blocks 4..7)
            {
                const uint v_idx = 8u + (lane >> 2);
                const uint comp  = lane & 3u;
                const uint w32   = qbuf.blk[cidx].qs[v_idx][comp];
                const float sc   = float(unpackFloat2x16(uint(qbuf.blk[cidx].d[4u + (lane >> 3)])).x);
                const vec4 wv    = vec4(agx_q8_u32_magic_to_f16vec4(w32)) * sc;
                const uint col4  = (c * 256u + 128u + lane * 4u) >> 2;
                if (col4 < K4) {
                    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                        if (m < m_cnt) {
                            const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                            acc[m] += dot(wv, x_buf4.v[row_x * K4 + col4]);
                        }
                    }
                }
            }
        }
#elif WEIGHT_MODE == 3
        // Raw GGML block_q8_0 (32 weights/block)
        const uint nb_k = pc.K >> 5;
        AgxBufQ8_0Raw qbuf = AgxBufQ8_0Raw(w_base);
        const uint row_b0 = row * nb_k;
        for (uint b = 0u; b < nb_k; ++b) {
            const uint bidx = row_b0 + b;
            const float sc  = float(unpackFloat2x16(uint(qbuf.blk[bidx].d)).x);
            const float wv  = float(qbuf.blk[bidx].qs[lane]) * sc;
            const uint  k   = b * 32u + lane;
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#elif WEIGHT_MODE == 4
        // AGX_MXFP8_16BLK repacked planar (512 weights = 4 x 128B cache lines)
        const uint n_chunks = (pc.K + 511u) >> 9;
        AgxBufMxfp8_16Blk mbuf = AgxBufMxfp8_16Blk(w_base);
        const uint row_c0 = row * n_chunks;
        for (uint c = 0u; c < n_chunks; ++c) {
            const uint cidx = row_c0 + c;
            for (uint q = 0u; q < 4u; ++q) {
                const uint v_idx = q * 8u + (lane >> 2);
                const uint comp  = lane & 3u;
                const uint w32   = mbuf.blk[cidx].qs[v_idx][comp];
                const float sc   = agx_ue8m0_to_f32(uint(mbuf.blk[cidx].e[q * 4u + (lane >> 3)]));
                const vec4 wv    = vec4(agx_e4m3_u32_to_f16vec4(w32)) * sc;
                const uint col4  = (c * 512u + q * 128u + lane * 4u) >> 2;
                if (col4 < K4) {
                    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                        if (m < m_cnt) {
                            const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                            acc[m] += dot(wv, x_buf4.v[row_x * K4 + col4]);
                        }
                    }
                }
            }
        }
#elif WEIGHT_MODE == 5
        // Flat OCP F8_E4M3
        AgxBufU32R wbuf = AgxBufU32R(w_base + uint64_t(row) * uint64_t(pc.K));
        for (uint col4 = lane; col4 < K4; col4 += 32u) {
            const vec4 wv = vec4(agx_e4m3_u32_to_f16vec4(wbuf.v[col4]));
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    acc[m] += dot(wv, x_buf4.v[row_x * K4 + col4]);
                }
            }
        }
#elif WEIGHT_MODE == 6
        // Flat BF16
        AgxBufU16R wbuf = AgxBufU16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float wv = agx_bf16_to_f32(wbuf.v[k]);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#elif WEIGHT_MODE == 7
        // Flat F16
        AgxBufF16R wbuf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float wv = float(wbuf.v[k]);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#else
        // Flat F32 (default fallback)
        AgxBufVec4R wbuf4 = AgxBufVec4R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
        for (uint col4 = lane; col4 < K4; col4 += 32u) {
            const vec4 wv = wbuf4.v[col4];
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    acc[m] += dot(wv, x_buf4.v[row_x * K4 + col4]);
                }
            }
        }
#endif

        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            float s = subgroupAdd(acc[m]);
            if (lane == rr) {
                res_out[m] = s;
            }
        }
    }
#endif // WEIGHT_MODE == 0 vs generic
}

void main() {
    const uint lane       = gl_SubgroupInvocationID; // 0..31
    const uint sg_id      = gl_SubgroupID;           // 0..3
    const uint bucket_idx = gl_WorkGroupID.y;

    // Safe guard for dummy 1-WG indirect dispatch when n_vecmat_buckets == 0
    if (bucket_idx >= BufBucketHdrR(pc.header_va).n_vecmat_buckets) {
        return;
    }

    const AgxMoeBucket bkt = BufBucketArrR(pc.buckets_va).b[bucket_idx];
    const uint m_cnt   = min(bkt.count, uint(BATCH_CAP));
    const uint tok_off = bkt.token_offset;

    uint tok_ids[BATCH_CAP];
    BufU32R stok = BufU32R(pc.sorted_tok_va);
    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
        tok_ids[m] = (m < m_cnt) ? stok.d[tok_off + m] : 0u;
    }

#if PASS_STAGE == 0
    // Stage 0: Gate+Up + Exact SiTU (32 output pairs/WG: sg0=g0..15, sg1=u0..15, sg2=g16..31, sg3=u16..31)
    const uint pair_half = sg_id >> 1;      // 0 or 1 (16-row half within WG's 32 pairs)
    const bool is_up     = (sg_id & 1u) != 0u;
    const uint n_wg0     = gl_WorkGroupID.x * 32u;
    const uint local_r0  = pair_half * 16u;

    uint64_t w_base;
    uint     row_base;
    uint     row_limit;
    if ((pc.flags & MOE_FLAG_SEPARATE_GU) != 0u) {
        w_base    = (is_up ? pc.w_up_va : pc.w_gate_va) + uint64_t(bkt.expert_id) * pc.w_slice_B;
        row_base  = n_wg0 + local_r0;
        row_limit = pc.N;
    } else {
        // Merged ffn_gate_up_exps: rows [0..n_ff-1] = gate, rows [n_ff..2*n_ff-1] = up
        w_base    = pc.w_gate_va + uint64_t(bkt.expert_id) * pc.w_slice_B;
        row_base  = (is_up ? pc.n_ff : 0u) + n_wg0 + local_r0;
        row_limit = (is_up ? (2u * pc.n_ff) : pc.n_ff);
    }

    float vals[BATCH_CAP];
    uint  out_r;
    bool  writes;
    vecmat_16rows(w_base, row_base, row_limit, m_cnt, tok_ids, tok_off, false, lane,
                  vals, out_r, writes);

    if (writes) {
        uint lr = out_r - (is_up && ((pc.flags & MOE_FLAG_SEPARATE_GU) == 0u) ? pc.n_ff : 0u) - n_wg0;
        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            if (m < m_cnt) {
                if (is_up) {
                    sh_up[m][lr] = vals[m];
                } else {
                    sh_gate[m][lr] = vals[m];
                }
            }
        }
    }
    barrier();

    // Simdgroup 0 applies exact SiTU (or SwiGLU/GeGLU) across all 32 pairs and stores moe_hidden
    if (sg_id == 0u) {
        const uint n_row = n_wg0 + lane;
        if (n_row < pc.N) {
            AgxBufF32RW hid = AgxBufF32RW(pc.y_va);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    float h = eval_moe_act(sh_gate[m][lane], sh_up[m][lane]);
                    hid.v[(tok_off + m) * pc.N + n_row] = h;
                }
            }
        }
    }

#else
    // Stage 1: Down Projection + Weighted Scatter-Add (64 output rows/WG, 16 rows/simdgroup)
    const uint64_t w_base = pc.w_gate_va + uint64_t(bkt.expert_id) * pc.w_slice_B;
    const uint     row_base = gl_WorkGroupID.x * 64u + sg_id * 16u;

    const bool raw_mmid = (pc.flags & MOE_FLAG_RAW_MMID) != 0u;

    float vals[BATCH_CAP];
    uint  out_r;
    bool  writes;
    vecmat_16rows(w_base, row_base, pc.N, m_cnt, tok_ids, tok_off, !raw_mmid, lane,
                  vals, out_r, writes);

    if (writes) {
        if (raw_mmid) {
            // Generic GGML_OP_MUL_MAT_ID: direct store to [M, top_k, N]
            BufU32R sksl = BufU32R(pc.sorted_kslot_va);
            AgxBufF32RW ybuf   = AgxBufF32RW(pc.y_va);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    uint ksl = sksl.d[tok_off + m];
                    ybuf.v[(tok_ids[m] * pc.top_k + ksl) * pc.N + out_r] = vals[m];
                }
            }
        } else {
            // Weighted FP32 scatter-add into SLC-pinned moe_out[tok, row]
            AgxBufF32R sw = AgxBufF32R(pc.sorted_w_va);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    float w = sw.v[tok_off + m];
                    atomicAddF32(pc.y_va, tok_ids[m] * pc.N + out_r, vals[m] * w);
                }
            }
        }
    }
#endif
}

// ============================================================================
// Stages 2 & 3: Register-Direct 8x8 simdgroup_matrix GEMM (M_bucket >= 6)
// ============================================================================
#else // PASS_STAGE == 2 || PASS_STAGE == 3

#define TILE_K      32u
#define WG_M        16u
#define SH_X_STRIDE (TILE_K + 8u) // +8 half padding prevents SRAM bank conflicts

shared float16_t sh_x[WG_M * SH_X_STRIDE]; // 1.28 KB SRAM

#if PASS_STAGE == 2
shared float sh_g_tile[WG_M][32]; // 2.0 KB SRAM
shared float sh_u_tile[WG_M][32]; // 2.0 KB SRAM
#endif

// Register-direct 2-weight FP16 decode matching AGX3B layout_8 (zero SRAM for weights!)
f16vec2 load_w_pair_f16(uint64_t w_base, uint row, uint row_limit, uint k0) {
    if (row >= row_limit || k0 >= pc.K) {
        return f16vec2(float16_t(0.0));
    }
#if WEIGHT_MODE == 0
    const uint nb_k  = pc.K >> 6;
    const uint tn    = row >> 5;
    const uint lr    = row & 31u;
    const uint sub_s = lr >> 4;
    const uint r     = lr & 15u;
    const uint tk    = k0 >> 6;
    const uint k_in  = k0 & 63u;
    const uint kh    = k_in >> 5;
    const uint k32   = k_in & 31u;
    const uint l_idx = sub_s * 32u + ((r << 1) | kh);

    AgxBufNvfp4ST st_buf = AgxBufNvfp4ST(w_base);
    const uint st_idx = tn * nb_k + tk;
    const uint d_pair = uint(st_buf.st[st_idx].d[l_idx]);
    const uint d_u8   = (k32 < 16u) ? (d_pair & 0xFFu) : (d_pair >> 8);
    const float16_t sc = agx_ue4m3_to_f16(d_u8);
    const uint w32    = st_buf.st[st_idx].qs[l_idx][k32 >> 3];
    const uint shift  = (k32 & 7u) * 4u;
    const uint b      = (w32 >> shift) & 0xFFu;
    return agx_e2m1_byte_to_f16vec2(b) * sc;
#elif WEIGHT_MODE == 1
    const uint nb_k  = pc.K >> 6;
    const uint b_idx = row * nb_k + (k0 >> 6);
    const uint k_in  = k0 & 63u;
    const uint sub   = k_in >> 4;
    const uint pos   = k_in & 15u;
    AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
    const float16_t sc = agx_ue4m3_to_f16(uint(raw_buf.blk[b_idx].d[sub]));
    const uint j0 = pos & 7u;
    const uint j1 = (pos + 1u) & 7u;
    const uint b0 = uint(raw_buf.blk[b_idx].qs[sub * 8u + j0]);
    const uint b1 = uint(raw_buf.blk[b_idx].qs[sub * 8u + j1]);
    const uint n0 = (pos < 8u) ? (b0 & 0xFu) : (b0 >> 4);
    const uint n1 = ((pos + 1u) < 8u) ? (b1 & 0xFu) : (b1 >> 4);
    return f16vec2(agx_e2m1_to_f16(n0), agx_e2m1_to_f16(n1)) * sc;
#elif WEIGHT_MODE == 2
    const uint n_chunks = (pc.K + 255u) >> 8;
    const uint c_idx = row * n_chunks + (k0 >> 8);
    const uint k_in  = k0 & 255u;
    const uint blk   = k_in >> 5;
    const uint q_in  = k_in & 31u;
    AgxBufQ8_8Blk qbuf = AgxBufQ8_8Blk(w_base);
    const float16_t sc = unpackFloat2x16(uint(qbuf.blk[c_idx].d[blk])).x;
    const uint v_idx = blk * 2u + (q_in >> 4);
    const uint word  = qbuf.blk[c_idx].qs[v_idx][(q_in >> 2) & 3u];
    const uint b0    = (word >> ((q_in & 3u) * 8u)) & 0xFFu;
    const uint b1    = (word >> (((q_in & 3u) + 1u) * 8u)) & 0xFFu;
    const float16_t v0 = unpackFloat2x16(0x6400u | (b0 ^ 0x80u)).x - float16_t(1152.0);
    const float16_t v1 = unpackFloat2x16(0x6400u | (b1 ^ 0x80u)).x - float16_t(1152.0);
    return f16vec2(v0, v1) * sc;
#elif WEIGHT_MODE == 3
    const uint nb_k  = pc.K >> 5;
    const uint b_idx = row * nb_k + (k0 >> 5);
    const uint q_in  = k0 & 31u;
    AgxBufQ8_0Raw qbuf = AgxBufQ8_0Raw(w_base);
    const float16_t sc = unpackFloat2x16(uint(qbuf.blk[b_idx].d)).x;
    return f16vec2(float16_t(qbuf.blk[b_idx].qs[q_in]),
                   float16_t(qbuf.blk[b_idx].qs[q_in + 1u])) * sc;
#elif WEIGHT_MODE == 4
    const uint n_chunks = (pc.K + 511u) >> 9;
    const uint c_idx = row * n_chunks + (k0 >> 9);
    const uint k_in  = k0 & 511u;
    const uint blk   = k_in >> 5;
    const uint q_in  = k_in & 31u;
    AgxBufMxfp8_16Blk mbuf = AgxBufMxfp8_16Blk(w_base);
    const float sc = agx_ue8m0_to_f32(uint(mbuf.blk[c_idx].e[blk]));
    const uint v_idx = blk * 2u + (q_in >> 4);
    const uint word  = mbuf.blk[c_idx].qs[v_idx][(q_in >> 2) & 3u];
    const uint b0    = (word >> ((q_in & 3u) * 8u)) & 0xFFu;
    const uint b1    = (word >> (((q_in & 3u) + 1u) * 8u)) & 0xFFu;
    return f16vec2(float16_t(float(agx_e4m3_to_f16(b0)) * sc),
                   float16_t(float(agx_e4m3_to_f16(b1)) * sc));
#elif WEIGHT_MODE == 5
    AgxBufU8R wbuf = AgxBufU8R(w_base + uint64_t(row) * uint64_t(pc.K));
    return f16vec2(agx_e4m3_to_f16(uint(wbuf.v[k0])),
                   (k0 + 1u < pc.K) ? agx_e4m3_to_f16(uint(wbuf.v[k0 + 1u])) : float16_t(0.0));
#elif WEIGHT_MODE == 6
    AgxBufU16R wbuf = AgxBufU16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
    const float v0 = agx_bf16_to_f32(wbuf.v[k0]);
    const float v1 = (k0 + 1u < pc.K) ? agx_bf16_to_f32(wbuf.v[k0 + 1u]) : 0.0f;
    return f16vec2(float16_t(v0), float16_t(v1));
#elif WEIGHT_MODE == 7
    AgxBufF16R wbuf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
    return f16vec2(wbuf.v[k0], (k0 + 1u < pc.K) ? wbuf.v[k0 + 1u] : float16_t(0.0));
#else
    AgxBufF32R wbuf = AgxBufF32R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
    return f16vec2(float16_t(wbuf.v[k0]),
                   (k0 + 1u < pc.K) ? float16_t(wbuf.v[k0 + 1u]) : float16_t(0.0));
#endif
}

void main() {
    const uint tid      = gl_LocalInvocationIndex; // 0..127
    const uint lane     = gl_SubgroupInvocationID; // 0..31
    const uint sg_id    = gl_SubgroupID;           // 0..3
    const uint tile_idx = gl_WorkGroupID.y;

    if (tile_idx >= BufBucketHdrR(pc.header_va).n_gemm_tiles) {
        return;
    }

    const AgxMoeBucket tile = BufBucketArrR(pc.buckets_va).b[tile_idx];
    const uint m_len   = min(tile.count, WG_M);
    const uint tok_off = tile.token_offset;

    BufU32R    stok  = BufU32R(pc.sorted_tok_va);
    AgxBufF32R x_buf = AgxBufF32R(pc.x_va);

    const uint lr  = agx_cmat8_row(lane);
    const uint lc0 = agx_cmat8_col0(lane);

#if PASS_STAGE == 2
    const uint pair_half = sg_id >> 1;
    const bool is_up     = (sg_id & 1u) != 0u;
    const uint n_wg0     = gl_WorkGroupID.x * 32u;
    uint64_t w_base;
    uint     sg_n0;
    uint     row_limit;
    if ((pc.flags & MOE_FLAG_SEPARATE_GU) != 0u) {
        w_base    = (is_up ? pc.w_up_va : pc.w_gate_va) + uint64_t(tile.expert_id) * pc.w_slice_B;
        sg_n0     = n_wg0 + pair_half * 16u;
        row_limit = pc.N;
    } else {
        w_base    = pc.w_gate_va + uint64_t(tile.expert_id) * pc.w_slice_B;
        sg_n0     = (is_up ? pc.n_ff : 0u) + n_wg0 + pair_half * 16u;
        row_limit = is_up ? (2u * pc.n_ff) : pc.n_ff;
    }
    const bool x_is_assign = false;
#else
    const uint64_t w_base  = pc.w_gate_va + uint64_t(tile.expert_id) * pc.w_slice_B;
    const uint     sg_n0   = gl_WorkGroupID.x * 64u + sg_id * 16u;
    const uint     row_limit = pc.N;
    const bool     raw_mmid = (pc.flags & MOE_FLAG_RAW_MMID) != 0u;
    const bool     x_is_assign = !raw_mmid;
#endif

    // 2(N) x 2(M) = 4 FP32 8x8 coopmat accumulators per simdgroup (only 8 GPRs!)
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> acc[2][2];
    for (uint in_t = 0u; in_t < 2u; ++in_t) {
        for (uint im_t = 0u; im_t < 2u; ++im_t) {
            acc[in_t][im_t] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        }
    }

    for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
        // Cooperative load of X[0..m_len-1, k_base..+32] -> sh_x (FP16)
        for (uint idx = tid * 2u; idx < WG_M * TILE_K; idx += 256u) {
            const uint lm = idx / TILE_K;
            const uint lk = idx % TILE_K;
            const uint gk = k_base + lk;
            float16_t v0 = float16_t(0.0);
            float16_t v1 = float16_t(0.0);
            if (lm < m_len) {
                const uint row_x = x_is_assign ? (tok_off + lm) : stok.d[tok_off + lm];
                if (gk < pc.K) {
                    v0 = float16_t(x_buf.v[row_x * pc.K + gk]);
                }
                if (gk + 1u < pc.K) {
                    v1 = float16_t(x_buf.v[row_x * pc.K + gk + 1u]);
                }
            }
            sh_x[lm * SH_X_STRIDE + lk]      = v0;
            sh_x[lm * SH_X_STRIDE + lk + 1u] = v1;
        }
        barrier();

        for (uint ks = 0u; ks < TILE_K; ks += 8u) {
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB[2];
            coopMatLoad(matB[0], sh_x, 0u * SH_X_STRIDE + ks, SH_X_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
            coopMatLoad(matB[1], sh_x, 8u * SH_X_STRIDE + ks, SH_X_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);

            for (uint in_t = 0u; in_t < 2u; ++in_t) {
                const uint gn = sg_n0 + in_t * 8u + lr;
                const uint gk = k_base + ks + lc0;
                const f16vec2 wp = load_w_pair_f16(w_base, gn, row_limit, gk);
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                matA[0] = wp.x;
                matA[1] = wp.y;
                acc[in_t][0] = coopMatMulAdd(matA, matB[0], acc[in_t][0]);
                acc[in_t][1] = coopMatMulAdd(matA, matB[1], acc[in_t][1]);
            }
        }
        barrier();
    }

#if PASS_STAGE == 2
    // Stage 2 epilogue: write gate & up tiles to SRAM, apply exact SiTU, store moe_hidden
    for (uint in_t = 0u; in_t < 2u; ++in_t) {
        const uint local_n = pair_half * 16u + in_t * 8u + lr;
        for (uint im_t = 0u; im_t < 2u; ++im_t) {
            const uint lm0 = im_t * 8u + lc0;
            const uint lm1 = lm0 + 1u;
            if (lm0 < m_len) {
                if (is_up) sh_u_tile[lm0][local_n] = acc[in_t][im_t][0];
                else       sh_g_tile[lm0][local_n] = acc[in_t][im_t][0];
            }
            if (lm1 < m_len) {
                if (is_up) sh_u_tile[lm1][local_n] = acc[in_t][im_t][1];
                else       sh_g_tile[lm1][local_n] = acc[in_t][im_t][1];
            }
        }
    }
    barrier();

    // All 128 threads cooperatively evaluate SiTU over 16 x 32 = 512 elements (4 elems/thread)
    AgxBufF32RW hid = AgxBufF32RW(pc.y_va);
    for (uint idx = tid; idx < m_len * 32u; idx += 128u) {
        const uint lm    = idx >> 5;
        const uint ln    = idx & 31u;
        const uint n_row = n_wg0 + ln;
        if (n_row < pc.N) {
            float h = eval_moe_act(sh_g_tile[lm][ln], sh_u_tile[lm][ln]);
            hid.v[(tok_off + lm) * pc.N + n_row] = h;
        }
    }

#else
    // Stage 3 epilogue: register-direct weighted scatter-add (or direct store for raw MMID)
    AgxBufF32R sw   = AgxBufF32R(pc.sorted_w_va);
    BufU32R    sksl = BufU32R(pc.sorted_kslot_va);
    AgxBufF32RW      ybuf = AgxBufF32RW(pc.y_va);

    for (uint in_t = 0u; in_t < 2u; ++in_t) {
        const uint gn = sg_n0 + in_t * 8u + lr;
        if (gn < pc.N) {
            for (uint im_t = 0u; im_t < 2u; ++im_t) {
                const uint lm0 = im_t * 8u + lc0;
                const uint lm1 = lm0 + 1u;
                if (lm0 < m_len) {
                    const uint tok0 = stok.d[tok_off + lm0];
                    if (raw_mmid) {
                        ybuf.v[(tok0 * pc.top_k + sksl.d[tok_off + lm0]) * pc.N + gn] = acc[in_t][im_t][0];
                    } else {
                        atomicAddF32(pc.y_va, tok0 * pc.N + gn, acc[in_t][im_t][0] * sw.v[tok_off + lm0]);
                    }
                }
                if (lm1 < m_len) {
                    const uint tok1 = stok.d[tok_off + lm1];
                    if (raw_mmid) {
                        ybuf.v[(tok1 * pc.top_k + sksl.d[tok_off + lm1]) * pc.N + gn] = acc[in_t][im_t][1];
                    } else {
                        atomicAddF32(pc.y_va, tok1 * pc.N + gn, acc[in_t][im_t][1] * sw.v[tok_off + lm1]);
                    }
                }
            }
        }
    }
#endif
}

#endif // PASS_STAGE
