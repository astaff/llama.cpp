            }
        }
#elif WEIGHT_MODE == 7
        AgxBufF16R wbuf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float wv = float(wbuf.v[k]);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#else
        AgxBufF32R wbuf = AgxBufF32R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
        for (uint k = lane; k < pc.K; k += 32u) {
            const float wv = wbuf.v[k];
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    const uint row_x = x_is_contiguous_assign ? (tok_off + m) : tok_ids[m];
                    acc[m] += wv * x_buf1.v[row_x * pc.K + k];
                }
            }
        }
#endif

        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            float s = subgroupAdd(acc[m]);
            if (lane == rr) {
                res_out[m] = s;
            }
        }
    }
#endif
}

void main() {
    const uint lane       = gl_SubgroupInvocationID;
    const uint sg_id      = gl_SubgroupID;
    const uint bucket_idx = gl_WorkGroupID.y;

    if (bucket_idx >= BufBucketHdrR(pc.header_va).n_vecmat_buckets) {
        return;
    }

    const AgxMoeBucket bkt = BufBucketArrR(pc.buckets_va).b[bucket_idx];
    const uint m_cnt   = min(bkt.count, uint(BATCH_CAP));
    const uint tok_off = bkt.token_offset;

    uint tok_ids[BATCH_CAP];
    BufU32R stok = BufU32R(pc.sorted_tok_va);
    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
        tok_ids[m] = (m < m_cnt) ? stok.d[tok_off + m] : 0u;
    }

#if PASS_STAGE == 0
    const uint pair_half = sg_id >> 1;
    const bool is_up     = (sg_id & 1u) != 0u;
#if WEIGHT_MODE == 2
    const uint n_wg0     = gl_WorkGroupID.x * 4u;
    const uint local_r0  = pair_half * 2u;
#else
    const uint n_wg0     = gl_WorkGroupID.x * 32u;
    const uint local_r0  = pair_half * 16u;
#endif

    uint64_t w_base;
    uint     row_base;
    uint     row_limit;
    if ((pc.flags & MOE_FLAG_SEPARATE_GU) != 0u) {
        w_base    = (is_up ? pc.w_up_va : pc.w_gate_va) + uint64_t(bkt.expert_id) * pc.w_slice_B;
        row_base  = n_wg0 + local_r0;
        row_limit = pc.N;
    } else {
        w_base    = pc.w_gate_va + uint64_t(bkt.expert_id) * pc.w_slice_B;
        row_base  = (is_up ? pc.n_ff : 0u) + n_wg0 + local_r0;
        row_limit = (is_up ? (2u * pc.n_ff) : pc.n_ff);
    }

    float vals[BATCH_CAP];
    uint  out_r;
    bool  writes;
    vecmat_rows(w_base, row_base, row_limit, m_cnt, tok_ids, tok_off, false, lane,
                vals, out_r, writes);

    if (writes) {
        uint lr = out_r - (is_up && ((pc.flags & MOE_FLAG_SEPARATE_GU) == 0u) ? pc.n_ff : 0u) - n_wg0;
        for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
            if (m < m_cnt) {
                if (is_up) sh_up[m][lr]   = vals[m];
                else       sh_gate[m][lr] = vals[m];
            }
        }
    }
    barrier();

#if WEIGHT_MODE == 2
    if (sg_id == 0u && lane < 4u) {
#else
    if (sg_id == 0u) {
#endif
        const uint n_row = n_wg0 + lane;
        if (n_row < pc.N) {
            const float s2 = (pc.w_scale_va != 0ul)
                ? AgxBufF32R(pc.w_scale_va).v[BufBucketArrR(pc.buckets_va).b[bucket_idx].expert_id]
                : 1.0f;
            AgxBufF32RW hid = AgxBufF32RW(pc.y_va);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    hid.v[(tok_off + m) * pc.N + n_row] = eval_moe_act(sh_gate[m][lane] * s2, sh_up[m][lane] * s2);
                }
            }
        }
    }

#else
    const uint64_t w_base   = pc.w_gate_va + uint64_t(bkt.expert_id) * pc.w_slice_B;
#if WEIGHT_MODE == 2
    const uint     row_base = gl_WorkGroupID.x * 8u + sg_id * 2u;
#else
    const uint     row_base = gl_WorkGroupID.x * 64u + sg_id * 16u;
#endif

    const bool raw_mmid = (pc.flags & MOE_FLAG_RAW_MMID) != 0u;
    const bool per_slot = (pc.flags & MOE_FLAG_RAW_MMID_PERSLOT) != 0u;

    uint x_rows[BATCH_CAP];
    BufU32R sksl_x = BufU32R(pc.sorted_kslot_va);
    for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
        if (m < m_cnt) {
            x_rows[m] = per_slot ? (tok_ids[m] * pc.top_k + sksl_x.d[tok_off + m]) : tok_ids[m];
        } else {
            x_rows[m] = 0u;
        }
    }

    float vals[BATCH_CAP];
    uint  out_r;
    bool  writes;
    vecmat_rows(w_base, row_base, pc.N, m_cnt, x_rows, tok_off, !raw_mmid, lane,
                vals, out_r, writes);

    if (writes) {
        if (raw_mmid) {
            BufU32R     sksl = BufU32R(pc.sorted_kslot_va);
            AgxBufF32RW ybuf = AgxBufF32RW(pc.y_va);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    uint ksl = sksl.d[tok_off + m];
                    ybuf.v[(tok_ids[m] * pc.top_k + ksl) * pc.N + out_r] = vals[m];
                }
            }
        } else {
            const float s2 = (pc.w_scale_va != 0ul)
                ? AgxBufF32R(pc.w_scale_va).v[BufBucketArrR(pc.buckets_va).b[bucket_idx].expert_id]
                : 1.0f;
            AgxBufF32R sw = AgxBufF32R(pc.sorted_w_va);
            for (uint m = 0u; m < uint(BATCH_CAP); ++m) {
                if (m < m_cnt) {
                    precise float scaled = vals[m] * s2;
                    atomicAddF32(pc.y_va, tok_ids[m] * pc.N + out_r, scaled * sw.v[tok_off + m]);
                }
            }
        }
    }
#endif
}

// ============================================================================
// Stages 2 & 3: Software-Pipelined 32M x 64N 8x8 simdgroup_matrix GEMM
//   - Double-buffered sh_x (5.0 KB FP16) + split-phase software pipelining:
//     * X[k+32] DRAM/SLC load overlaps with ks_i = 0, 1 MMAs
//     * W[k+32] DRAM load overlaps with ks_i = 2, 3 MMAs
//     * Halves K-loop barriers (144 -> 72 at K=2304)!
//   - WG-uniform active_im = ceil(m_len / 8) skips wasted MMAs on M=5..8 buckets!
//   - Total TG SRAM <= 7.7 KB (< 8 KB -> 4 WGs/core!), <= 72 GPR32, 0:0 spills!
// ============================================================================
#else // PASS_STAGE == 2 || PASS_STAGE == 3

#define TILE_K      32u
#define WG_M        32u
#define SG_TILES_N  2u
#define SG_TILES_M  4u
#define SH_X_STRIDE (TILE_K + 8u) // 40 halfs: bank-conflict-free
#define SH_X_SLAB   (WG_M * SH_X_STRIDE)

shared float16_t sh_x[2u * SH_X_SLAB]; // 5.12 KB double-buffered SRAM
shared uint      sh_row_x[WG_M];       // 128 B SRAM

#if PASS_STAGE == 2
shared float sh_g_tile[8][36]; // 1.15 KB SRAM (staged per im_t)
shared float sh_u_tile[8][36]; // 1.15 KB SRAM
#else
#define SH_Y_STRIDE 68u
shared uint  sh_y_row[WG_M];        // 128 B SRAM
shared float sh_w[WG_M];            // 128 B SRAM
shared float sh_y[8 * SH_Y_STRIDE]; // 2.17 KB SRAM (8 rows x 64 cols coalesced!)
#endif

void store_x_h4_sh(uint sh_off, uint dst_rel, f16vec4 xv) {
    const uint d = sh_off + dst_rel;
    sh_x[d + 0u] = xv.x;
    sh_x[d + 1u] = xv.y;
    sh_x[d + 2u] = xv.z;
    sh_x[d + 3u] = xv.w;
}

#if WEIGHT_MODE != 0 && WEIGHT_MODE != 2
f16vec2 load_w_pair_f16(uint64_t w_base, uint row, uint row_limit, uint k0) {
    if (row >= row_limit || k0 >= pc.K) {
        return f16vec2(float16_t(0.0));
    }
#if WEIGHT_MODE == 1
    const uint nb_k  = pc.K >> 6;
    const uint b_idx = row * nb_k + (k0 >> 6);
    const uint k_in  = k0 & 63u;
    const uint sub   = k_in >> 4;
    const uint pos   = k_in & 15u;
    AgxBufNvfp4Raw raw_buf = AgxBufNvfp4Raw(w_base);
    const float16_t sc = agx_ue4m3_to_f16(uint(raw_buf.blk[b_idx].d[sub]));
    const uint j0 = pos & 7u;
    const uint j1 = (pos + 1u) & 7u;
    const uint b0 = uint(raw_buf.blk[b_idx].qs[sub * 8u + j0]);
    const uint b1 = uint(raw_buf.blk[b_idx].qs[sub * 8u + j1]);
    const uint n0 = (pos < 8u) ? (b0 & 0xFu) : (b0 >> 4);
    const uint n1 = ((pos + 1u) < 8u) ? (b1 & 0xFu) : (b1 >> 4);
    return f16vec2(agx_e2m1_to_f16(n0), agx_e2m1_to_f16(n1)) * sc;
#elif WEIGHT_MODE == 3
    const uint nb_k  = pc.K >> 5;
    const uint b_idx = row * nb_k + (k0 >> 5);
    const uint q_in  = k0 & 31u;
    AgxBufQ8_0Raw qbuf = AgxBufQ8_0Raw(w_base);
    const float16_t sc = unpackFloat2x16(uint(qbuf.blk[b_idx].d)).x;
    return f16vec2(float16_t(qbuf.blk[b_idx].qs[q_in]),
                   float16_t(qbuf.blk[b_idx].qs[q_in + 1u])) * sc;
#elif WEIGHT_MODE == 4
    const uint n_chunks = (pc.K + 511u) >> 9;
    const uint c_idx = row * n_chunks + (k0 >> 9);
    const uint k_in  = k0 & 511u;
    const uint blk   = k_in >> 5;
    const uint q_in  = k_in & 31u;
    AgxBufMxfp8_16Blk mbuf = AgxBufMxfp8_16Blk(w_base);
    const float sc = agx_ue8m0_to_f32(uint(mbuf.blk[c_idx].e[blk]));
    const uint v_idx = blk * 2u + (q_in >> 4);
    const uint word  = mbuf.blk[c_idx].qs[v_idx][(q_in >> 2) & 3u];
    const uint b0    = (word >> ((q_in & 3u) * 8u)) & 0xFFu;
    const uint b1    = (word >> (((q_in & 3u) + 1u) * 8u)) & 0xFFu;
    return f16vec2(float16_t(float(agx_e4m3_to_f16(b0)) * sc),
                   float16_t(float(agx_e4m3_to_f16(b1)) * sc));
#elif WEIGHT_MODE == 5
    AgxBufU8R wbuf = AgxBufU8R(w_base + uint64_t(row) * uint64_t(pc.K));
    return f16vec2(agx_e4m3_to_f16(uint(wbuf.v[k0])),
                   (k0 + 1u < pc.K) ? agx_e4m3_to_f16(uint(wbuf.v[k0 + 1u])) : float16_t(0.0));
#elif WEIGHT_MODE == 6
    AgxBufU16R wbuf = AgxBufU16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
    const float v0 = agx_bf16_to_f32(wbuf.v[k0]);
    const float v1 = (k0 + 1u < pc.K) ? agx_bf16_to_f32(wbuf.v[k0 + 1u]) : 0.0f;
    return f16vec2(float16_t(v0), float16_t(v1));
#elif WEIGHT_MODE == 7
    AgxBufF16R wbuf = AgxBufF16R(w_base + uint64_t(row) * uint64_t(pc.K) * 2ul);
    return f16vec2(wbuf.v[k0], (k0 + 1u < pc.K) ? wbuf.v[k0 + 1u] : float16_t(0.0));
#else
    AgxBufF32R wbuf = AgxBufF32R(w_base + uint64_t(row) * uint64_t(pc.K) * 4ul);
    return f16vec2(float16_t(wbuf.v[k0]),
                   (k0 + 1u < pc.K) ? float16_t(wbuf.v[k0 + 1u]) : float16_t(0.0));
#endif
}
#endif

void main() {
    const uint tid      = gl_LocalInvocationIndex; // 0..127
    const uint lane     = gl_SubgroupInvocationID; // 0..31
    const uint sg_id    = gl_SubgroupID;           // 0..3
    const uint tile_idx = gl_WorkGroupID.y;

    if (tile_idx >= BufBucketHdrR(pc.header_va).n_gemm_tiles) {
        return;
    }

    const AgxMoeBucket tile = BufBucketArrR(pc.buckets_va).b[tile_idx];
    const uint m_len     = min(tile.count, WG_M);
    const uint active_im = (m_len + 7u) >> 3; // 1..4 (WG-uniform!)
    const uint tok_off   = tile.token_offset;

    BufU32R     stok   = BufU32R(pc.sorted_tok_va);
    BufU32R     sksl_g = BufU32R(pc.sorted_kslot_va);
    AgxBufVec4R x_buf4 = AgxBufVec4R(pc.x_va);

    const uint lr  = agx_cmat8_row(lane);
    const uint lc0 = agx_cmat8_col0(lane);

#if PASS_STAGE == 2
    const uint pair_half = sg_id >> 1;
    const bool is_up     = (sg_id & 1u) != 0u;
    const uint n_wg0     = gl_WorkGroupID.x * 32u;
    uint64_t w_base;
    uint     sg_n0;
    uint     row_limit;
    if ((pc.flags & MOE_FLAG_SEPARATE_GU) != 0u) {
        w_base    = (is_up ? pc.w_up_va : pc.w_gate_va) + uint64_t(tile.expert_id) * pc.w_slice_B;
        sg_n0     = n_wg0 + pair_half * 16u;
        row_limit = pc.N;
    } else {
        w_base    = pc.w_gate_va + uint64_t(tile.expert_id) * pc.w_slice_B;
        sg_n0     = (is_up ? pc.n_ff : 0u) + n_wg0 + pair_half * 16u;
        row_limit = is_up ? (2u * pc.n_ff) : pc.n_ff;
    }
    const bool x_is_assign = false;
#else
    const uint     wg_n0       = gl_WorkGroupID.x * 64u;
    const uint64_t w_base      = pc.w_gate_va + uint64_t(tile.expert_id) * pc.w_slice_B;
    const uint     sg_n0       = wg_n0 + sg_id * 16u;
    const uint     row_limit   = pc.N;
    const bool     raw_mmid    = (pc.flags & MOE_FLAG_RAW_MMID) != 0u;
    const bool     per_slot    = (pc.flags & MOE_FLAG_RAW_MMID_PERSLOT) != 0u;
    const bool     x_is_assign = !raw_mmid;
#endif

    // Pre-load per-row X/Y indices & weights ONCE into SRAM
    if (tid < WG_M) {
        if (tid < m_len) {
            const uint t_id = stok.d[tok_off + tid];
#if PASS_STAGE == 3
            const uint ksl  = sksl_g.d[tok_off + tid];
            sh_row_x[tid]   = x_is_assign ? (tok_off + tid) : (per_slot ? (t_id * pc.top_k + ksl) : t_id);
            sh_y_row[tid]   = raw_mmid ? (t_id * pc.top_k + ksl) : t_id;
            sh_w[tid]       = raw_mmid ? 1.0f : AgxBufF32R(pc.sorted_w_va).v[tok_off + tid];
#else
            sh_row_x[tid]   = t_id;
#endif
        } else {
            sh_row_x[tid] = 0u;
#if PASS_STAGE == 3
            sh_y_row[tid] = 0u;
            sh_w[tid]     = 0.0f;
#endif
        }
    }
    barrier();

    const uint K4      = pc.K >> 2;
    const uint x_lm0   = tid >> 3;          // 0..15 (s=1 is x_lm0 + 16)
    const uint x_lk4   = tid & 7u;          // 0..7  (identical for s=0 and s=1!)
    const uint sh_dst0 = x_lm0 * SH_X_STRIDE + (x_lk4 << 2);
    const uint x_off0  = sh_row_x[x_lm0]       * K4 + x_lk4;
    const uint x_off1  = sh_row_x[x_lm0 + 16u] * K4 + x_lk4;

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> acc[SG_TILES_N][SG_TILES_M];
    for (uint in_t = 0u; in_t < SG_TILES_N; ++in_t) {
        for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
            acc[in_t][im_t] = coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
        }
    }

#if WEIGHT_MODE == 0
    // ------------------------------------------------------------------------
    // AGX_NVFP4_32x16: TILE_K=32 double-buffered split-phase software-pipelined
    //   Compact f16vec4 xv_next + 1-at-a-time matB + early qs_cur.xy release -> <=78 GPR32, 0:0 spills!
    // ------------------------------------------------------------------------
    {
        AgxBufNvfp4ST st_buf = AgxBufNvfp4ST(w_base);
        const uint nb_k  = pc.K >> 6;
        const uint shift = lc0 << 2;

        bool w_ok[2];
        uint w_st_base[2];
        uint w_l_base[2];
        for (uint in_t = 0u; in_t < 2u; ++in_t) {
            const uint gn   = sg_n0 + in_t * 8u + lr;
            w_ok[in_t]      = (gn < row_limit);
            w_st_base[in_t] = (gn >> 5) * nb_k;
            w_l_base[in_t]  = ((gn >> 4) & 1u) * 32u + ((gn & 15u) << 1);
        }

        // Prologue: load X[0..31] -> sh_x[0] AND W[0..31] -> registers
        store_x_h4_sh(0u, sh_dst0, (x_lm0 < m_len && x_lk4 < K4)
            ? f16vec4(clamp(x_buf4.v[x_off0], vec4(-65504.0f), vec4(65504.0f))) : f16vec4(float16_t(0.0)));
        store_x_h4_sh(0u, sh_dst0 + 16u * SH_X_STRIDE, ((x_lm0 + 16u) < m_len && x_lk4 < K4)
            ? f16vec4(clamp(x_buf4.v[x_off1], vec4(-65504.0f), vec4(65504.0f))) : f16vec4(float16_t(0.0)));

        uvec4   qs_cur[2];
        f16vec2 sc_cur[2];
        for (uint in_t = 0u; in_t < 2u; ++in_t) {
            if (w_ok[in_t]) {
                const uint sidx  = w_st_base[in_t];
                const uint l_idx = w_l_base[in_t];
                qs_cur[in_t] = st_buf.st[sidx].qs[l_idx];
                sc_cur[in_t] = agx_ue4m3_pair_to_f16vec2(st_buf.st[sidx].d[l_idx]);
            } else {
                qs_cur[in_t] = uvec4(0u);
                sc_cur[in_t] = f16vec2(float16_t(0.0));
            }
        }
        barrier();

        uint buf_idx = 0u;
        for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
            const uint sh_off   = buf_idx * SH_X_SLAB;
            const uint next_k   = k_base + TILE_K;
            const bool has_next = (next_k < pc.K);
            const uint next_off = (buf_idx ^ 1u) * SH_X_SLAB;

            // Phase 0: Issue X[next_k] loads into f16vec4 (4 GPR32 vs 8 GPR32) to overlap with ks_i = 0, 1
            f16vec4 xv_n0 = f16vec4(float16_t(0.0));
            f16vec4 xv_n1 = f16vec4(float16_t(0.0));
            if (has_next) {
                const uint nkb4 = next_k >> 2;
                if (x_lm0 < m_len && (nkb4 + x_lk4) < K4) {
                    xv_n0 = f16vec4(clamp(x_buf4.v[x_off0 + nkb4], vec4(-65504.0f), vec4(65504.0f)));
                }
                if ((x_lm0 + 16u) < m_len && (nkb4 + x_lk4) < K4) {
                    xv_n1 = f16vec4(clamp(x_buf4.v[x_off1 + nkb4], vec4(-65504.0f), vec4(65504.0f)));
                }
            }

            for (uint ks_i = 0u; ks_i < 2u; ++ks_i) {
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA0 =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA1 =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                const uint w0 = (ks_i == 0u) ? qs_cur[0].x : qs_cur[0].y;
                const uint w1 = (ks_i == 0u) ? qs_cur[1].x : qs_cur[1].y;
                const f16vec2 wp0 = agx_e2m1_byte_to_f16vec2((w0 >> shift) & 0xFFu) * sc_cur[0].x;
                const f16vec2 wp1 = agx_e2m1_byte_to_f16vec2((w1 >> shift) & 0xFFu) * sc_cur[1].x;
                matA0[0] = wp0.x; matA0[1] = wp0.y;
                matA1[0] = wp1.x; matA1[1] = wp1.y;
                for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                    if (im_t < active_im) {
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, sh_off + (im_t * 8u) * SH_X_STRIDE + ks_i * 8u, SH_X_STRIDE,
                                    gl_CooperativeMatrixLayoutColumnMajor);
                        acc[0][im_t] = coopMatMulAdd(matA0, matB, acc[0][im_t]);
                        acc[1][im_t] = coopMatMulAdd(matA1, matB, acc[1][im_t]);
                    }
                }
            }

            if (has_next) {
                store_x_h4_sh(next_off, sh_dst0, xv_n0);
                store_x_h4_sh(next_off, sh_dst0 + 16u * SH_X_STRIDE, xv_n1);
            }

            // Phase 1: Copy live upper half (qs_cur.zw -> 4 GPR32, releasing qs_cur.xy!) before issuing W[next_k]
            const uvec2     qhi0 = qs_cur[0].zw;
            const uvec2     qhi1 = qs_cur[1].zw;
            const float16_t scy0 = sc_cur[0].y;
            const float16_t scy1 = sc_cur[1].y;

            if (has_next) {
                const uint next_tk = next_k >> 6;
                const uint next_kh = (next_k >> 5) & 1u;
                for (uint in_t = 0u; in_t < 2u; ++in_t) {
                    if (w_ok[in_t]) {
                        const uint sidx  = w_st_base[in_t] + next_tk;
                        const uint l_idx = w_l_base[in_t] | next_kh;
                        qs_cur[in_t] = st_buf.st[sidx].qs[l_idx];
                        sc_cur[in_t] = agx_ue4m3_pair_to_f16vec2(st_buf.st[sidx].d[l_idx]);
                    } else {
                        qs_cur[in_t] = uvec4(0u);
                        sc_cur[in_t] = f16vec2(float16_t(0.0));
                    }
                }
            }

            for (uint ks_i = 2u; ks_i < 4u; ++ks_i) {
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA0 =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA1 =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                const uint w0 = (ks_i == 2u) ? qhi0.x : qhi0.y;
                const uint w1 = (ks_i == 2u) ? qhi1.x : qhi1.y;
                const f16vec2 wp0 = agx_e2m1_byte_to_f16vec2((w0 >> shift) & 0xFFu) * scy0;
                const f16vec2 wp1 = agx_e2m1_byte_to_f16vec2((w1 >> shift) & 0xFFu) * scy1;
                matA0[0] = wp0.x; matA0[1] = wp0.y;
                matA1[0] = wp1.x; matA1[1] = wp1.y;
                for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                    if (im_t < active_im) {
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, sh_off + (im_t * 8u) * SH_X_STRIDE + ks_i * 8u, SH_X_STRIDE,
                                    gl_CooperativeMatrixLayoutColumnMajor);
                        acc[0][im_t] = coopMatMulAdd(matA0, matB, acc[0][im_t]);
                        acc[1][im_t] = coopMatMulAdd(matA1, matB, acc[1][im_t]);
                    }
                }
            }

            if (has_next) {
                buf_idx ^= 1u;
                barrier();
            }
        }
    }

#elif WEIGHT_MODE == 2
    // ------------------------------------------------------------------------
    // AGX_Q8_0_8BLK: TILE_K=32 double-buffered split-phase software-pipelined
    //   Compact f16vec4 xv_next + 1-at-a-time matB + streaming q1_cur/q0_next -> <=72 GPR32!
    // ------------------------------------------------------------------------
    {
        AgxBufQ8_8Blk qbuf  = AgxBufQ8_8Blk(w_base);
        const uint n_chunks = (pc.K + 255u) >> 8;
        const uint w_sub    = lc0 >> 2;         // 0 or 1
        const uint h_sh     = (lc0 & 2u) * 8u;  // 0 or 16

        bool ok_n[2];
        uint row_c_base[2];
        for (uint in_t = 0u; in_t < 2u; ++in_t) {
            const uint gn    = sg_n0 + in_t * 8u + lr;
            ok_n[in_t]       = (gn < row_limit);
            row_c_base[in_t] = gn * n_chunks;
        }

        // Prologue: load X[0..31] -> sh_x[0], sc_cur + q0_cur -> registers
        store_x_h4_sh(0u, sh_dst0, (x_lm0 < m_len && x_lk4 < K4)
            ? f16vec4(clamp(x_buf4.v[x_off0], vec4(-65504.0f), vec4(65504.0f))) : f16vec4(float16_t(0.0)));
        store_x_h4_sh(0u, sh_dst0 + 16u * SH_X_STRIDE, ((x_lm0 + 16u) < m_len && x_lk4 < K4)
            ? f16vec4(clamp(x_buf4.v[x_off1], vec4(-65504.0f), vec4(65504.0f))) : f16vec4(float16_t(0.0)));

        float16_t sc_cur[2];
        uvec2     q0_cur[2];
        for (uint in_t = 0u; in_t < 2u; ++in_t) {
            if (ok_n[in_t]) {
                const uint cidx = row_c_base[in_t];
                sc_cur[in_t] = unpackFloat2x16(uint(qbuf.blk[cidx].d[0])).x;
                q0_cur[in_t] = uvec2(qbuf.blk[cidx].qs[0][w_sub],
                                     qbuf.blk[cidx].qs[0][w_sub + 2u]);
            } else {
                sc_cur[in_t] = float16_t(0.0);
                q0_cur[in_t] = uvec2(0u);
            }
        }
        barrier();

        uint buf_idx = 0u;
        for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
            const uint sh_off   = buf_idx * SH_X_SLAB;
            const uint next_k   = k_base + TILE_K;
            const bool has_next = (next_k < pc.K);
            const uint next_off = (buf_idx ^ 1u) * SH_X_SLAB;
            const uint c_off    = k_base >> 8;
            const uint blk      = (k_base >> 5) & 7u;

            // Phase 0: Issue X[next_k] + q1_cur loads to overlap with ks_i = 0, 1 MMAs
            f16vec4 xv_n0 = f16vec4(float16_t(0.0));
            f16vec4 xv_n1 = f16vec4(float16_t(0.0));
            if (has_next) {
                const uint nkb4 = next_k >> 2;
                if (x_lm0 < m_len && (nkb4 + x_lk4) < K4) {
                    xv_n0 = f16vec4(clamp(x_buf4.v[x_off0 + nkb4], vec4(-65504.0f), vec4(65504.0f)));
                }
                if ((x_lm0 + 16u) < m_len && (nkb4 + x_lk4) < K4) {
                    xv_n1 = f16vec4(clamp(x_buf4.v[x_off1 + nkb4], vec4(-65504.0f), vec4(65504.0f)));
                }
            }
            uvec2 q1_cur[2];
            for (uint in_t = 0u; in_t < 2u; ++in_t) {
                if (ok_n[in_t]) {
                    const uint cidx = row_c_base[in_t] + c_off;
                    const uint vi1  = blk * 2u + 1u;
                    q1_cur[in_t] = uvec2(qbuf.blk[cidx].qs[vi1][w_sub],
                                         qbuf.blk[cidx].qs[vi1][w_sub + 2u]);
                } else {
                    q1_cur[in_t] = uvec2(0u);
                }
            }

            for (uint ks_j = 0u; ks_j < 2u; ++ks_j) {
                const uint ks = ks_j * 8u;
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA0 =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA1 =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                const uint w0 = (ks_j == 0u) ? q0_cur[0].x : q0_cur[0].y;
                const uint w1 = (ks_j == 0u) ? q0_cur[1].x : q0_cur[1].y;
                const f16vec2 wp0 = agx_q8_u16_magic_to_f16vec2((w0 >> h_sh) & 0xFFFFu) * sc_cur[0];
                const f16vec2 wp1 = agx_q8_u16_magic_to_f16vec2((w1 >> h_sh) & 0xFFFFu) * sc_cur[1];
                matA0[0] = wp0.x; matA0[1] = wp0.y;
                matA1[0] = wp1.x; matA1[1] = wp1.y;
                for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                    if (im_t < active_im) {
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, sh_off + (im_t * 8u) * SH_X_STRIDE + ks, SH_X_STRIDE,
                                    gl_CooperativeMatrixLayoutColumnMajor);
                        acc[0][im_t] = coopMatMulAdd(matA0, matB, acc[0][im_t]);
                        acc[1][im_t] = coopMatMulAdd(matA1, matB, acc[1][im_t]);
                    }
                }
            }

            if (has_next) {
                store_x_h4_sh(next_off, sh_dst0, xv_n0);
                store_x_h4_sh(next_off, sh_dst0 + 16u * SH_X_STRIDE, xv_n1);
            }

            // Phase 1: Issue sc_next + q0_next loads to overlap with ks_i = 2, 3 MMAs
            const float16_t sc0_save = sc_cur[0];
            const float16_t sc1_save = sc_cur[1];
            if (has_next) {
                const uint next_c   = next_k >> 8;
                const uint next_blk = (next_k >> 5) & 7u;
                const uint next_vi0 = next_blk * 2u;
                for (uint in_t = 0u; in_t < 2u; ++in_t) {
                    if (ok_n[in_t]) {
                        const uint cidx = row_c_base[in_t] + next_c;
                        sc_cur[in_t] = unpackFloat2x16(uint(qbuf.blk[cidx].d[next_blk])).x;
                        q0_cur[in_t] = uvec2(qbuf.blk[cidx].qs[next_vi0][w_sub],
                                             qbuf.blk[cidx].qs[next_vi0][w_sub + 2u]);
                    } else {
                        sc_cur[in_t] = float16_t(0.0);
                        q0_cur[in_t] = uvec2(0u);
                    }
                }
            }

            for (uint ks_j = 0u; ks_j < 2u; ++ks_j) {
                const uint ks = (2u + ks_j) * 8u;
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA0 =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA1 =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                const uint w0 = (ks_j == 0u) ? q1_cur[0].x : q1_cur[0].y;
                const uint w1 = (ks_j == 0u) ? q1_cur[1].x : q1_cur[1].y;
                const f16vec2 wp0 = agx_q8_u16_magic_to_f16vec2((w0 >> h_sh) & 0xFFFFu) * sc0_save;
                const f16vec2 wp1 = agx_q8_u16_magic_to_f16vec2((w1 >> h_sh) & 0xFFFFu) * sc1_save;
                matA0[0] = wp0.x; matA0[1] = wp0.y;
                matA1[0] = wp1.x; matA1[1] = wp1.y;
                for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                    if (im_t < active_im) {
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB;
                        coopMatLoad(matB, sh_x, sh_off + (im_t * 8u) * SH_X_STRIDE + ks, SH_X_STRIDE,
                                    gl_CooperativeMatrixLayoutColumnMajor);
                        acc[0][im_t] = coopMatMulAdd(matA0, matB, acc[0][im_t]);
                        acc[1][im_t] = coopMatMulAdd(matA1, matB, acc[1][im_t]);
                    }
                }
            }

            if (has_next) {
                buf_idx ^= 1u;
                barrier();
            }
        }
    }

#else
    for (uint k_base = 0u; k_base < pc.K; k_base += TILE_K) {
        const uint kb4 = k_base >> 2;
        store_x_h4_sh(0u, sh_dst0, (x_lm0 < m_len && (kb4 + x_lk4) < K4)
            ? f16vec4(clamp(x_buf4.v[x_off0 + kb4], vec4(-65504.0f), vec4(65504.0f))) : f16vec4(float16_t(0.0)));
        store_x_h4_sh(0u, sh_dst0 + 16u * SH_X_STRIDE, ((x_lm0 + 16u) < m_len && (kb4 + x_lk4) < K4)
            ? f16vec4(clamp(x_buf4.v[x_off1 + kb4], vec4(-65504.0f), vec4(65504.0f))) : f16vec4(float16_t(0.0)));
        barrier();

        for (uint ks = 0u; ks < TILE_K; ks += 8u) {
            coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> matB[SG_TILES_M];
            for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                if (im_t < active_im) {
                    coopMatLoad(matB[im_t], sh_x, (im_t * 8u) * SH_X_STRIDE + ks, SH_X_STRIDE,
                                gl_CooperativeMatrixLayoutColumnMajor);
                }
            }
            for (uint in_t = 0u; in_t < 2u; ++in_t) {
                const uint gn = sg_n0 + in_t * 8u + lr;
                const uint gk = k_base + ks + lc0;
                const f16vec2 wp = load_w_pair_f16(w_base, gn, row_limit, gk);
                coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> matA =
                    coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA>(float16_t(0.0));
                matA[0] = wp.x;
                matA[1] = wp.y;
                for (uint im_t = 0u; im_t < SG_TILES_M; ++im_t) {
                    if (im_t < active_im) {
                        acc[in_t][im_t] = coopMatMulAdd(matA, matB[im_t], acc[in_t][im_t]);
                    }
                }
            }
        }
        barrier();
    }
#endif

#if PASS_STAGE == 2
    const float s2 = (pc.w_scale_va != 0ul)
        ? AgxBufF32R(pc.w_scale_va).v[BufBucketArrR(pc.buckets_va).b[gl_WorkGroupID.y].expert_id]
        : 1.0f;
    AgxBufF32RW hid = AgxBufF32RW(pc.y_va);
    for (uint im_t = 0u; im_t < active_im; ++im_t) {
        for (uint in_t = 0u; in_t < 2u; ++in_t) {
            const uint sh_n = pair_half * 16u + in_t * 8u + lr;
            if (is_up) {
                sh_u_tile[lc0][sh_n]      = acc[in_t][im_t][0];
                sh_u_tile[lc0 + 1u][sh_n] = acc[in_t][im_t][1];
            } else {
                sh_g_tile[lc0][sh_n]      = acc[in_t][im_t][0];
                sh_g_tile[lc0 + 1u][sh_n] = acc[in_t][im_t][1];
            }
        }
        barrier();

        for (uint idx = tid; idx < 8u * 32u; idx += 128u) {
            const uint lm    = idx >> 5;
            const uint ln    = idx & 31u;
            const uint gm    = im_t * 8u + lm;
            const uint n_row = n_wg0 + ln;
            if (gm < m_len && n_row < pc.N) {
                hid.v[(tok_off + gm) * pc.N + n_row] = eval_moe_act(sh_g_tile[lm][ln] * s2, sh_u_tile[lm][ln] * s2);
            }
        }
        if (im_t + 1u < active_im) {
            barrier();
        }
    }

#else
    // Coalesced 128B-aligned epilogue via sh_y (8 rows x 64 cols = 2.17 KB SRAM!)
    const float s2 = (!raw_mmid && pc.w_scale_va != 0ul)
        ? AgxBufF32R(pc.w_scale_va).v[BufBucketArrR(pc.buckets_va).b[gl_WorkGroupID.y].expert_id]
        : 1.0f;
    AgxBufF32RW ybuf = AgxBufF32RW(pc.y_va);
    for (uint im_t = 0u; im_t < active_im; ++im_t) {
        for (uint in_t = 0u; in_t < 2u; ++in_t) {
            const uint sh_n = sg_id * 16u + in_t * 8u + lr;
            sh_y[lc0 * SH_Y_STRIDE + sh_n]        = acc[in_t][im_t][0];
            sh_y[(lc0 + 1u) * SH_Y_STRIDE + sh_n] = acc[in_t][im_t][1];
        }
        barrier();

        for (uint idx = tid; idx < 8u * 64u; idx += 128u) {
            const uint lm = idx >> 6; // 0..7
            const uint ln = idx & 63u; // 0..63 (2 x 128B contiguous writes per row!)
            const uint gm = im_t * 8u + lm;
            const uint gn = wg_n0 + ln;
            if (gm < m_len && gn < pc.N) {
                const float val = sh_y[lm * SH_Y_STRIDE + ln];
                if (raw_mmid) {
                    ybuf.v[sh_y_row[gm] * pc.N + gn] = val;
                } else {
                    precise float scaled = val * s2;
                    atomicAddF32(pc.y_va, sh_y_row[gm] * pc.N + gn, scaled * sh_w[gm]);
                }
            }
        }
        if (im_t + 1u < active_im) {
            barrier();
        }
    }
#endif
}

#endif // PASS_STAGE
