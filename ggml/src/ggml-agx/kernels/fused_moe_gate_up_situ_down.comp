                wb1 = agx_q8_u32_magic_to_f16vec4(qv1.y) * d1;
                wb2 = agx_q8_u32_magic_to_f16vec4(qv1.z) * d1;
                wb3 = agx_q8_u32_magic_to_f16vec4(qv1.w) * d1;
#else
                const uint k_off = k_base + (s_kp << 6u) + (fn2 << 4u);
  #if PASS_STAGE == 2
