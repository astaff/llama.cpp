    #if MERGED_GU != 0
                const uint row_u = row_g + pc.n_ff;
                moe_load_w16_generic(wg_va, row_g, pc.n_ff,      k_off, wa0, wa1, wa2, wa3);
                moe_load_w16_generic(wg_va, row_u, 2u * pc.n_ff, k_off, wb0, wb1, wb2, wb3);
    #else
                const uint row_u = sep_gu ? row_g : (row_g + pc.n_ff);
                moe_load_w16_generic(wg_va, row_g, pc.n_ff, k_off, wa0, wa1, wa2, wa3);
                moe_load_w16_generic(wu_va, row_u, sep_gu ? pc.N : 2u * pc.n_ff, k_off, wb0, wb1, wb2, wb3);
    #endif
  #else
                const uint row_0 = gl_WorkGroupID.x * MOE_WG_OUT + sg_id * 16u + fm;
                moe_load_w16_generic(wg_va, row_0,      pc.N, k_off, wa0, wa1, wa2, wa3);
                moe_load_w16_generic(wg_va, row_0 + 8u, pc.N, k_off, wb0, wb1, wb2, wb3);
  #endif
#endif

                // Single sh_x LDS read across wa & wb + pair-interleaved rtp=0,2 (matmad-gap 2 -> 4)!
#if GEMM_TILE_M >= 16
                [[unroll]] for (uint rtp = 0u; rtp < MOE_RT; rtp += 2u) {
                    const uint c0 = 8u * rtp + fn;
                    const uint c1 = c0 + 8u;
                    const f16vec4 ba0_0 = sh_x[c0 + 0u][sub_off + 0u];
                    const f16vec4 ba1_0 = sh_x[c0 + 0u][sub_off + 1u];
                    const f16vec4 bb0_0 = sh_x[c0 + 1u][sub_off + 0u];
                    const f16vec4 bb1_0 = sh_x[c0 + 1u][sub_off + 1u];
                    const f16vec4 ba0_1 = sh_x[c1 + 0u][sub_off + 0u];
                    const f16vec4 ba1_1 = sh_x[c1 + 0u][sub_off + 1u];
                    const f16vec4 bb0_1 = sh_x[c1 + 1u][sub_off + 0u];
                    const f16vec4 bb1_1 = sh_x[c1 + 1u][sub_off + 1u];
                    [[unroll]] for (uint s = 0u; s < 4u; ++s) {
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> ma0_0, ma1_0, ma0_1, ma1_1;
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb0_0, mb1_0, mb0_1, mb1_1;
                        ma0_0[0] = wa0[s]; ma0_0[1] = wa2[s];
                        ma1_0[0] = wa1[s]; ma1_0[1] = wa3[s];
                        ma0_1[0] = wb0[s]; ma0_1[1] = wb2[s];
                        ma1_1[0] = wb1[s]; ma1_1[1] = wb3[s];
                        mb0_0[0] = ba0_0[s]; mb0_0[1] = bb0_0[s];
                        mb0_1[0] = ba0_1[s]; mb0_1[1] = bb0_1[s];
                        mb1_0[0] = ba1_0[s]; mb1_0[1] = bb1_0[s];
                        mb1_1[0] = ba1_1[s]; mb1_1[1] = bb1_1[s];
                        acc[0][rtp]      = coopMatMulAdd(ma0_0, mb0_0, acc[0][rtp]);
                        acc[1][rtp]      = coopMatMulAdd(ma0_1, mb0_0, acc[1][rtp]);
                        acc[0][rtp + 1u] = coopMatMulAdd(ma0_0, mb0_1, acc[0][rtp + 1u]);
                        acc[1][rtp + 1u] = coopMatMulAdd(ma0_1, mb0_1, acc[1][rtp + 1u]);
                        acc[0][rtp]      = coopMatMulAdd(ma1_0, mb1_0, acc[0][rtp]);
                        acc[1][rtp]      = coopMatMulAdd(ma1_1, mb1_0, acc[1][rtp]);
                        acc[0][rtp + 1u] = coopMatMulAdd(ma1_0, mb1_1, acc[0][rtp + 1u]);
                        acc[1][rtp + 1u] = coopMatMulAdd(ma1_1, mb1_1, acc[1][rtp + 1u]);
                    }
                }
#else
                {
                    const uint c0 = fn;
                    const f16vec4 ba0 = sh_x[c0 + 0u][sub_off + 0u];
                    const f16vec4 ba1 = sh_x[c0 + 0u][sub_off + 1u];
                    const f16vec4 bb0 = sh_x[c0 + 1u][sub_off + 0u];
                    const f16vec4 bb1 = sh_x[c0 + 1u][sub_off + 1u];
                    [[unroll]] for (uint s = 0u; s < 4u; ++s) {
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> ma0_0, ma1_0, ma0_1, ma1_1;
                        coopmat<float16_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mb0, mb1;
                        ma0_0[0] = wa0[s]; ma0_0[1] = wa2[s];
                        ma1_0[0] = wa1[s]; ma1_0[1] = wa3[s];
                        ma0_1[0] = wb0[s]; ma0_1[1] = wb2[s];
                        ma1_1[0] = wb1[s]; ma1_1[1] = wb3[s];
                        mb0[0]   = ba0[s]; mb0[1]   = bb0[s];
                        mb1[0]   = ba1[s]; mb1[1]   = bb1[s];
                        acc[0][0] = coopMatMulAdd(ma0_0, mb0, acc[0][0]);
                        acc[1][0] = coopMatMulAdd(ma0_1, mb0, acc[1][0]);
                        acc[0][0] = coopMatMulAdd(ma1_0, mb1, acc[0][0]);
                        acc[1][0] = coopMatMulAdd(ma1_1, mb1, acc[1][0]);
                    }
                }
#endif
            }
        }
#endif // MOE_USE_PAIR_SWIZ
    }

#if PASS_STAGE == 2
    // Direct In-Register SiTU Epilogue (supports FP16 SLC-pinned hidden_bo & F32!)
    {
        const AgxMoeBucket ep_tile = BufBucketArrR(pc.buckets_va).b[tile_idx];
        const uint ep_tok_off = ep_tile.token_offset;
        const uint ep_fm      = agx_cmat8_row(lane);
        const uint ep_fn      = agx_cmat8_col0(lane);
        const uint n_row      = gl_WorkGroupID.x * MOE_WG_PAIRS + sg_id * 8u + ep_fm;
        if (n_row < pc.N) {
            const float s2 = (pc.w_scale_va != 0ul)
                ? AgxBufF32R(pc.w_scale_va).v[ep_tile.expert_id]
                : 1.0f;
            [[dont_unroll]] for (uint rt = 0u; rt < MOE_RT; ++rt) {
                const uint gm0 = rt * 8u + ep_fn;
                const uint gm1 = gm0 + 1u;
                if (gm0 < m_len) {
                    const float v0  = eval_moe_act(acc[0][rt][0] * s2, acc[1][rt][0] * s2);
                    const uint  di0 = (ep_tok_off + gm0) * pc.N + n_row;
#if INTER_F16 != 0
                    BufF16W(pc.y_va).v[di0]     = float16_t(v0);
#else
                    AgxBufF32RW(pc.y_va).v[di0] = v0;
#endif
                }
                if (gm1 < m_len) {
                    const float v1  = eval_moe_act(acc[0][rt][1] * s2, acc[1][rt][1] * s2);
                    const uint  di1 = (ep_tok_off + gm1) * pc.N + n_row;
#if INTER_F16 != 0
                    BufF16W(pc.y_va).v[di1]     = float16_t(v1);
#else
                    AgxBufF32RW(pc.y_va).v[di1] = v1;
#endif
                }
            }
        }
    }

#else
    // Direct 32-bit Indexed Epilogue Store (ZERO 64-bit y_va0/y_va1 regs, 0:0 spills at 64M!)
    {
        const AgxMoeBucket ep_tile = BufBucketArrR(pc.buckets_va).b[tile_idx];
        const bool ep_raw    = (pc.flags & MOE_FLAG_RAW_MMID) != 0u;
        const bool ep_direct = ep_raw || ((pc.flags & MOE_FLAG_DOWN_NOSCATTER) != 0u);
        const uint ep_fm     = agx_cmat8_row(lane);
        const uint ep_fn     = agx_cmat8_col0(lane);
        const uint ep_sg_n0  = gl_WorkGroupID.x * MOE_WG_OUT + sg_id * 16u;
        const float s2 = (!ep_raw && pc.w_scale_va != 0ul)
            ? AgxBufF32R(pc.w_scale_va).v[ep_tile.expert_id]
            : 1.0f;

        if (ep_direct) {
            AgxBufF32RW ybuf = AgxBufF32RW(pc.y_va);
            [[dont_unroll]] for (uint rt = 0u; rt < MOE_RT; ++rt) {
                const uint gm0   = rt * 8u + ep_fn;
                const uint gm1   = gm0 + 1u;
                const bool m0_ok = (gm0 < m_len);
                const bool m1_ok = (gm1 < m_len);
                if (m0_ok || m1_ok) {
#if MOE_SRAM_MINIMAL
                    const uint yr0 = m0_ok ? ((BufU32R(pc.sorted_tok_va).d[ep_tile.token_offset + gm0] * pc.top_k + BufU32R(pc.sorted_kslot_va).d[ep_tile.token_offset + gm0]) * pc.N) : 0u;
                    const uint yr1 = m1_ok ? ((BufU32R(pc.sorted_tok_va).d[ep_tile.token_offset + gm1] * pc.top_k + BufU32R(pc.sorted_kslot_va).d[ep_tile.token_offset + gm1]) * pc.N) : 0u;
#else
                    const uint yr0 = m0_ok ? (sh_y_row[gm0] * pc.N) : 0u;
                    const uint yr1 = m1_ok ? (sh_y_row[gm1] * pc.N) : 0u;
#endif
                    [[unroll]] for (uint t = 0u; t < 2u; ++t) {
                        const uint gn = ep_sg_n0 + t * 8u + ep_fm;
                        if (gn < pc.N) {
                            if (m0_ok) ybuf.v[yr0 + gn] = acc[t][rt][0] * s2;
                            if (m1_ok) ybuf.v[yr1 + gn] = acc[t][rt][1] * s2;
                        }
                    }
                }
            }
        } else {
            [[dont_unroll]] for (uint rt = 0u; rt < MOE_RT; ++rt) {
                const uint gm0   = rt * 8u + ep_fn;
                const uint gm1   = gm0 + 1u;
                const bool m0_ok = (gm0 < m_len);
                const bool m1_ok = (gm1 < m_len);
                if (m0_ok || m1_ok) {
#if MOE_SRAM_MINIMAL
                    const uint  yr0 = m0_ok ? (BufU32R(pc.sorted_tok_va).d[ep_tile.token_offset + gm0] * pc.N) : 0u;
                    const uint  yr1 = m1_ok ? (BufU32R(pc.sorted_tok_va).d[ep_tile.token_offset + gm1] * pc.N) : 0u;
                    const float tw0 = m0_ok ? AgxBufF32R(pc.sorted_w_va).v[ep_tile.token_offset + gm0] : 0.0f;
                    const float tw1 = m1_ok ? AgxBufF32R(pc.sorted_w_va).v[ep_tile.token_offset + gm1] : 0.0f;
#else
                    const uint  yr0 = m0_ok ? (sh_y_row[gm0] * pc.N) : 0u;
                    const uint  yr1 = m1_ok ? (sh_y_row[gm1] * pc.N) : 0u;
                    const float tw0 = m0_ok ? sh_tok_w[gm0] : 0.0f;
                    const float tw1 = m1_ok ? sh_tok_w[gm1] : 0.0f;
#endif
                    for (uint t = 0u; t < 2u; ++t) {
                        const uint gn = ep_sg_n0 + t * 8u + ep_fm;
                        if (gn < pc.N) {
                            if (m0_ok) {
                                precise float scaled = acc[t][rt][0] * s2;
                                atomicAddF32(pc.y_va, yr0 + gn, scaled * tw0);
                            }
                            if (m1_ok) {
                                precise float scaled = acc[t][rt][1] * s2;
                                atomicAddF32(pc.y_va, yr1 + gn, scaled * tw1);
                            }
                        }
                    }
                }
            }
        }
    }
#endif
}

#endif // PASS_STAGE
