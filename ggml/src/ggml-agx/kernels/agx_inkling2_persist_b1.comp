shared float    sh_buf[3072];       // 12,288 B: cached X / s_cur / sh_o / sh_exp / sh_gate / s_r / router
shared float    sh_red[5][8];       //    160 B: 8-sg reduction scratch (up to 5 channels)
shared float    sh_inv_rms[16];     //     64 B: depth-mix inv_rms
shared float    sh_prob[4][16];     //    256 B: depth-mix softmax weights
shared uint64_t sh_bva[8];          //     64 B: hoisted block VAs
